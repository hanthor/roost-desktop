+/// Schedule a page flip carrying an opaque kernel event value.
+/// This value is never interpreted as a pointer.
+pub fn page_flip_with_user_data(
+    fd: BorrowedFd<'_>,
+    crtc_id: u32,
+    fb_id: u32,
+    flags: u32,
+    sequence: u32,
+    user_data: u64,
+) -> io::Result<()> {
+    let mut flip = page_flip_request(crtc_id, fb_id, flags, sequence, user_data);
+
+    unsafe {
+        ioctl::mode::crtc_page_flip(fd, &mut flip)?;
+    }
+
+    Ok(())
+}
