+/// Actual fixed kernel fields, independent of any older-kernel userdata fallback.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct KernelVBlankEvent {
+    /// Kernel frame sequence (may wrap; never commit identity).
+    pub sequence: u32,
+    /// Kernel event timestamp, interpreted by the caller's device clock capability.
+    pub timestamp: Duration,
+    /// Actual kernel CRTC ID; zero remains zero.
+    pub crtc_id: u32,
+    /// Opaque full-width value supplied to the successful event-generating ioctl.
+    pub user_data: u64,
+}
+/// Cookie-preserving events; existing Event and public structs are unchanged.
+#[derive(Debug, PartialEq, Eq)]
+pub enum KernelEvent {
+    /// Vertical blank event.
+    Vblank(KernelVBlankEvent),
+    /// Page-flip completion event.
+    PageFlip(KernelVBlankEvent),
+    /// Complete unknown event bytes.
+    Unknown(Vec<u8>),
+}
+/// Bounded cookie-preserving iterator over one complete DRM read.
+pub struct EventsWithUserData {
+    event_buf: [u8; 1024],
+    amount: usize,
+    position: usize,
+}
+impl EventsWithUserData {
+    /// Accept a bounded read buffer; malformed records produce one error then stop.
+    pub fn with_event_buf(event_buf: [u8; 1024], amount: usize) -> io::Result<Self> {
+        if amount > event_buf.len() {
+            return Err(invalid_kernel_event());
+        }
+        Ok(Self {
+            event_buf,
+            amount,
+            position: 0,
+        })
+    }
+    fn parse_next(&mut self) -> io::Result<KernelEvent> {
+        let bytes = &self.event_buf[self.position..self.amount];
+        if bytes.len() < 8 {
+            return Err(invalid_kernel_event());
+        }
+        let kind = u32::from_ne_bytes(bytes[..4].try_into().unwrap());
+        let length = u32::from_ne_bytes(bytes[4..8].try_into().unwrap()) as usize;
+        if length < 8 || length > bytes.len() {
+            return Err(invalid_kernel_event());
+        }
+        let result = if kind == ffi::DRM_EVENT_VBLANK || kind == ffi::DRM_EVENT_FLIP_COMPLETE {
+            if length < 32 {
+                return Err(invalid_kernel_event());
+            }
+            let microseconds = u32::from_ne_bytes(bytes[20..24].try_into().unwrap());
+            if microseconds >= 1_000_000 {
+                return Err(invalid_kernel_event());
+            }
+            let event = KernelVBlankEvent {
+                user_data: u64::from_ne_bytes(bytes[8..16].try_into().unwrap()),
+                timestamp: Duration::new(
+                    u64::from(u32::from_ne_bytes(bytes[16..20].try_into().unwrap())),
+                    microseconds * 1000,
+                ),
+                sequence: u32::from_ne_bytes(bytes[24..28].try_into().unwrap()),
+                crtc_id: u32::from_ne_bytes(bytes[28..32].try_into().unwrap()),
+            };
+            if kind == ffi::DRM_EVENT_VBLANK {
+                KernelEvent::Vblank(event)
+            } else {
+                KernelEvent::PageFlip(event)
+            }
+        } else {
+            KernelEvent::Unknown(bytes[..length].to_vec())
+        };
+        self.position += length;
+        Ok(result)
+    }
+}
+fn invalid_kernel_event() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "invalid bounded DRM kernel event",
+    )
+}
+impl Iterator for EventsWithUserData {
+    type Item = io::Result<KernelEvent>;
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.position == self.amount {
+            return None;
+        }
+        let event = self.parse_next();
+        if event.is_err() {
+            self.position = self.amount;
+        }
+        Some(event)
