+#[cfg(test)]
+mod socket_preparation_tests {
+    use super::*;
+    use std::io::{Read, Write};
+
+    #[test]
+    fn prepared_socket_handoff_preserves_pending_client_bytes() {
+        let prepared = XWaylandSockets::prepare(None, false).unwrap();
+        let path = format!("/tmp/.X11-unix/X{}", prepared.display_number());
+        let mut client = UnixStream::connect(path).unwrap();
+        client.write_all(b"queued").unwrap();
+
+        // A server receives the same listening socket after ownership moves;
+        // the readiness observer never accepts or replaces the connection.
+        fn accept_after_handoff(prepared: XWaylandSockets) -> UnixStream {
+            let listener = prepared.listen_fds().next().unwrap();
+            UnixStream::from(rustix::net::accept(listener).unwrap())
+        }
+        let mut server = accept_after_handoff(prepared);
+        server
+            .set_read_timeout(Some(std::time::Duration::from_secs(1)))
+            .unwrap();
+        let mut bytes = [0; 6];
+        server.read_exact(&mut bytes).unwrap();
+        assert_eq!(&bytes, b"queued");
+    }
+}
