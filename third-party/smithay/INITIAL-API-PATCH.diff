 use super::x11_sockets::{prepare_x11_sockets, X11Lock};
+
+/// Reserved X11 display sockets, prepared without starting XWayland.
+///
+/// Keep this owner alive while advertising its display. Poll the borrowed
+/// listening descriptors for readability without accepting the connection;
+/// then move the owner into [`XWayland::spawn_on_sockets`]. The pending client
+/// remains queued on the same sockets handed to XWayland. Drop any cloned
+/// readiness descriptors when stopping or replacing this reservation.
+#[derive(Debug)]
+pub struct XWaylandSockets {
+    lock: X11Lock,
+    listen_sockets: Vec<UnixStream>,
+}
+
+impl XWaylandSockets {
+    /// Reserve a free display and its filesystem and optional abstract sockets.
+    /// No process is started and no Wayland client is inserted.
+    pub fn prepare(display: impl Into<Option<u32>>, open_abstract_socket: bool) -> std::io::Result<Self> {
+        let (lock, listen_sockets) = prepare_x11_sockets(display.into(), open_abstract_socket)?;
+        Ok(Self { lock, listen_sockets })
+    }
+
+    /// Display number suitable for advertising `DISPLAY` before server startup.
+    pub fn display_number(&self) -> u32 {
+        self.lock.display_number()
+    }
+
+    /// Non-consuming readiness handles for the listening sockets.
+    /// Readability means a pending connection can trigger server startup.
+    pub fn listen_fds(&self) -> impl Iterator<Item = BorrowedFd<'_>> {
+        self.listen_sockets.iter().map(AsFd::as_fd)
+    }
+}
 
