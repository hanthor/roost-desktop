#!/usr/bin/env bash
set -euo pipefail
[[ ${ROOST_CI_ONLY:-} == 1 ]] || { echo 'bell fixture build is CI-only' >&2; exit 1; }
bell_build_dir=$(mktemp -d)
trap 'rm -rf "$bell_build_dir"' EXIT
for item in xdg-shell xdg-system-bell; do
  case "$item" in
    xdg-shell) xml=/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml ;;
    xdg-system-bell) xml=/usr/share/wayland-protocols/staging/xdg-system-bell/xdg-system-bell-v1.xml ;;
  esac
  wayland-scanner client-header "$xml" "$bell_build_dir/$item-client.h"
  wayland-scanner private-code "$xml" "$bell_build_dir/$item-protocol.c"
  sha256sum "$xml" >> "$bell_build_dir/source-sha256sums"
done
bell_pkg_flags=$(pkg-config --cflags --libs wayland-client)
read -r -a bell_compiler_flags <<< "$bell_pkg_flags"
cc -std=c11 -O2 -Wall -Wextra -Werror -I"$bell_build_dir" \
  /build/roost-vm-bell.c "$bell_build_dir/"*-protocol.c \
  "${bell_compiler_flags[@]}" -o "$bell_build_dir/roost-vm-bell"
install -Dm755 "$bell_build_dir/roost-vm-bell" /usr/libexec/roost-vm-bell
install -Dm644 "$bell_build_dir/source-sha256sums" /usr/share/roost-vm-bell/source-sha256sums
pacman -Q wayland wayland-protocols gcc > /usr/share/roost-vm-bell/packages.txt
cc --version > /usr/share/roost-vm-bell/compiler.txt
sha256sum /build/roost-vm-bell.c /usr/libexec/roost-vm-bell > /usr/share/roost-vm-bell/build-sha256sums
