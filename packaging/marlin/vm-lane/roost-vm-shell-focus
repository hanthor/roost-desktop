#!/usr/bin/python
"""Read-only, bounded original AT-SPI focus receipts for public CI controls.

No synthetic AT-SPI actions, focus changes, text/value/description queries or
arbitrary names are recorded. Native QMP input performs every action.
Primary API: https://gnome.pages.gitlab.gnome.org/at-spi2-core/libatspi/
"""
import json
import os
import pathlib
import re
import sys
import time

PUBLIC_LABELS = {"Search", "Disks", "Take Screenshot", "Settings", "Lock", "Power Off Menu", "Mute", "Volume"}
PUBLIC_ROLES = {"entry", "text", "push button", "slider", "frame"}


def public_node(name, role, showing, focused, active):
    if name not in PUBLIC_LABELS or role not in PUBLIC_ROLES or not showing:
        return None
    return {"label": name, "role": role, "focused": bool(focused), "active": bool(active)}


def process_identity(pid, uid, ticks, executable, display):
    path = pathlib.Path(f"/proc/{pid}")
    info = (path / "stat").read_text().rsplit(")", 1)[1].split()
    actual = {"pid": pid, "uid": path.stat().st_uid, "start_ticks": int(info[19]),
              "executable": pathlib.Path(os.readlink(path / "exe")).name}
    with (path / "environ").open("rb") as stream:
        raw = stream.read(128 * 1024 + 1)
    if len(raw) > 128 * 1024:
        raise RuntimeError("process environment exceeds bound")
    displays = [entry.split(b"=", 1)[1].decode() for entry in raw.split(b"\0") if entry.startswith(b"WAYLAND_DISPLAY=")]
    if actual != {"pid": pid, "uid": uid, "start_ticks": ticks, "executable": executable} or displays != [display]:
        raise RuntimeError("original focus principal identity disagrees")
    return actual


def observe(pid, ticks, executable, display):
    import gi
    gi.require_version("Atspi", "2.0")
    from gi.repository import Atspi, Gio, GLib
    uid = os.getuid()
    if uid == 0 or executable not in {"roost-shell-gtk", "gnome-disks"}:
        raise RuntimeError("probe requires the original non-root session principal")
    state = pathlib.Path(f"/run/user/{uid}/roost-vm-state.json")
    if json.loads(state.read_text())["locked"]:
        raise RuntimeError("locked accessibility trees are never queried")
    original = process_identity(pid, uid, ticks, executable, display)
    Atspi.set_timeout(500, 500)
    deadline = time.monotonic() + 8
    def remaining_budget():
        if json.loads(state.read_text())["locked"]:
            raise RuntimeError("locked accessibility trees are never queried")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError("accessibility principal observation deadline exceeded")
        return max(1, int(remaining * 1000))

    def accessibility_query(method, *args):
        timeout = min(500, remaining_budget())
        Atspi.set_timeout(timeout, timeout)
        result = method(*args)
        remaining_budget()
        return result

    def bus_query(connection, destination, path, interface, method, parameters, reply_type):
        timeout = min(3000, remaining_budget())
        result = connection.call_sync(destination, path, interface, method, parameters, reply_type,
                                     Gio.DBusCallFlags.NONE, timeout, None)
        remaining_budget()
        return result

    desktop = accessibility_query(Atspi.get_desktop, 0)
    count = accessibility_query(desktop.get_child_count)
    if count > 64:
        raise RuntimeError("accessibility desktop exceeds bound")
    candidates = []
    for index in range(count):
        if time.monotonic() >= deadline:
            raise RuntimeError("accessibility principal observation deadline exceeded")
        app = accessibility_query(desktop.get_child_at_index, index)
        if app is not None and accessibility_query(app.get_process_id) == pid:
            candidates.append(app)
    if len(candidates) != 1:
        raise RuntimeError("one original accessibility principal is required")
    app = candidates[0]
    owner = app.app.bus_name
    if not isinstance(owner, str) or len(owner) > 64 or re.fullmatch(r":\d+\.\d+", owner) is None:
        raise RuntimeError("accessibility principal lacks a unique bus owner")
    remaining_budget()
    session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    address = bus_query(session, "org.a11y.Bus", "/org/a11y/bus", "org.a11y.Bus", "GetAddress", None,
                        GLib.VariantType.new("(s)")).unpack()[0]
    remaining_budget()
    bus = Gio.DBusConnection.new_for_address_sync(address,
        Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
    def credentials():
        values = {}
        for method in ("GetNameOwner", "GetConnectionUnixProcessID", "GetConnectionUnixUser"):
            values[method] = bus_query(bus, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                method, GLib.Variant("(s)", (owner,)), None).unpack()[0]
        if values != {"GetNameOwner": owner, "GetConnectionUnixProcessID": pid, "GetConnectionUnixUser": uid}:
            raise RuntimeError("original accessibility bus credentials disagree")
        return values
    before = credentials()
    nodes, pending, visited = [], [(app, 0)], 0
    while pending:
        if json.loads(state.read_text())["locked"]:
            raise RuntimeError("locked accessibility trees are never queried")
        if time.monotonic() >= deadline or visited >= 512:
            raise RuntimeError("accessibility focus observation exceeds bound")
        node, depth = pending.pop()
        visited += 1
        if depth > 32:
            raise RuntimeError("accessibility focus tree depth exceeds bound")
        accessibility_query(node.clear_cache)
        states = accessibility_query(node.get_state_set)
        showing = states.contains(Atspi.StateType.SHOWING)
        if depth and not showing:
            continue
        role = accessibility_query(node.get_role_name)
        if role in PUBLIC_ROLES:
            record = public_node(accessibility_query(node.get_name), role, showing,
                                 states.contains(Atspi.StateType.FOCUSED), states.contains(Atspi.StateType.ACTIVE))
            if record is not None:
                nodes.append(record)
        children = accessibility_query(node.get_child_count)
        if children > 128 or len(pending) + children > 512:
            raise RuntimeError("accessibility focus children exceed bound")
        for index in range(children):
            child = accessibility_query(node.get_child_at_index, index)
            if child is not None:
                pending.append((child, depth + 1))
    after = credentials()
    if process_identity(pid, uid, ticks, executable, display) != original or json.loads(state.read_text())["locked"]:
        raise RuntimeError("original focus principal changed or session locked")
    return {"principal": original, "atspi_owner": owner, "credentials_before": before,
            "credentials_after": after, "public_controls": nodes, "visited": visited,
            "guest_monotonic": time.monotonic(), "observation_only": True}


if __name__ == "__main__":
    try:
        print(json.dumps(observe(int(sys.argv[1]), int(sys.argv[2]), sys.argv[3], sys.argv[4])))
    except Exception as error:
        # No private names/buffers, exception strings, argv or environments.
        print(json.dumps({"focus_error_type": type(error).__name__}))
        raise SystemExit(1) from None
