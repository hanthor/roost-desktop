#!/usr/bin/python
"""Read-only, bounded original AT-SPI focus receipts for public CI controls.

Default observation has no text/value/description queries. The explicit controlled
overview mode compares only the known five-character fixture query in scratch
memory; no buffer is retained. No synthetic AT-SPI actions, focus changes or
arbitrary names are recorded. Native QMP input performs every action.
Primary API: https://gnome.pages.gitlab.gnome.org/at-spi2-core/libatspi/
"""
import json
import hashlib
import stat
import os
import pathlib
import re
import sys
import time

PUBLIC_LABELS = {"Search", "Disks", "Take Screenshot", "Settings", "Lock", "Power Off Menu", "Mute", "Volume"}
PUBLIC_ROLES = {"entry", "text", "push button", "slider", "frame"}


def public_node(name, role, showing, focused, active):
    if name not in PUBLIC_LABELS or role not in PUBLIC_ROLES or not showing:
        return None
    return {"label": name, "role": role, "focused": bool(focused), "active": bool(active)}


def process_identity(pid, uid, ticks, executable, display):
    path = pathlib.Path(f"/proc/{pid}")
    info = (path / "stat").read_text().rsplit(")", 1)[1].split()
    actual = {"pid": pid, "uid": path.stat().st_uid, "start_ticks": int(info[19]),
              "executable": pathlib.Path(os.readlink(path / "exe")).name}
    with (path / "environ").open("rb") as stream:
        raw = stream.read(128 * 1024 + 1)
    if len(raw) > 128 * 1024:
        raise RuntimeError("process environment exceeds bound")
    displays = [entry.split(b"=", 1)[1].decode() for entry in raw.split(b"\0") if entry.startswith(b"WAYLAND_DISPLAY=")]
    if actual != {"pid": pid, "uid": uid, "start_ticks": ticks, "executable": executable} or displays != [display]:
        raise RuntimeError("original focus principal identity disagrees")
    return actual


def controlled_query(entries, query):
    """Only the unique original public Search control, never arbitrary text."""
    if len(entries) != 1:
        return None
    text = query(entries[0].get_text_iface)
    if text is None:
        return False
    count = query(text.get_character_count)
    if type(count) is not int or count != 5:
        return False
    # Five Unicode characters bound transport; compare and immediately discard.
    return query(text.get_text, 0, 5) == "disks"


def resource_key(value):
    return (value.st_dev, value.st_ino, value.st_uid, value.st_mode, value.st_nlink,
            value.st_size, value.st_mtime_ns, value.st_ctime_ns)


def executable_key(value):
    return (value.st_dev, value.st_ino, value.st_uid, value.st_mode, value.st_size,
            value.st_mtime_ns // 1000000000, value.st_mtime_ns % 1000000000,
            value.st_ctime_ns // 1000000000, value.st_ctime_ns % 1000000000)


def catalog_receipt(pid, uid, ticks):
    """Original show_results sample, not independent parser/catalog inference."""
    path = pathlib.Path(f"/run/user/{uid}/roost-vm-public-search.json")
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as stream:
        before = os.fstat(stream.fileno())
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != uid or before.st_nlink != 1
                or stat.S_IMODE(before.st_mode) != 0o600 or not 0 < before.st_size <= 4096):
            raise ValueError("fixed public diagnostic resource")
        raw = stream.read(4097)
        after = os.fstat(stream.fileno())
        if len(raw) != before.st_size or resource_key(before) != resource_key(after) or resource_key(after) != resource_key(path.lstat()):
            raise ValueError("original public diagnostic changed")
    value = json.loads(raw)
    fields = {"schema","pid","uid","start_ticks","executed_key","sequence","sampled_monotonic_ns",
              "known_query_matches","expected_catalog_count","expected_label_matches","expected_ranked_count",
              "rendered_target_count","search_window_visible","results_container_visible","controlled_source_provenance","authentication_boundary"}
    if type(value) is not dict or set(value) != fields:
        raise ValueError("fixed public diagnostic schema")
    for key, expected in (("schema",1),("pid",pid),("uid",uid),("start_ticks",ticks)):
        if type(value[key]) is not int or value[key] != expected: raise ValueError("original public diagnostic principal")
    for key, limit in (("sequence",2**64-1),("sampled_monotonic_ns",2**64-1)):
        if type(value[key]) is not int or not 0 < value[key] <= limit: raise ValueError("fixed public diagnostic scalar")
    for key, limit in (("expected_catalog_count",4096),("expected_ranked_count",6),("rendered_target_count",6)):
        if type(value[key]) is not int or not 0 <= value[key] <= limit: raise ValueError("fixed public diagnostic count")
    if (value["known_query_matches"] is not True or type(value["expected_label_matches"]) is not bool
            or type(value["search_window_visible"]) is not bool or type(value["results_container_visible"]) is not bool
            or value["controlled_source_provenance"] is not True or value["authentication_boundary"] is not False
            or value["rendered_target_count"] != value["expected_ranked_count"]
            or (value["expected_label_matches"] and value["expected_catalog_count"] != 1)):
        raise ValueError("fixed public diagnostic flags")
    mapped = os.stat(f"/proc/{pid}/exe")
    named = pathlib.Path("/usr/bin/roost-shell-gtk").lstat()
    if (os.readlink(f"/proc/{pid}/exe") != "/usr/bin/roost-shell-gtk" or not stat.S_ISREG(named.st_mode)
            or named.st_uid != 0 or named.st_mode & 0o022
            or type(value["executed_key"]) is not list or len(value["executed_key"]) != 9
            or any(type(x) is not int for x in value["executed_key"])
            or tuple(value["executed_key"]) != executable_key(mapped) or executable_key(mapped) != executable_key(named)):
        raise ValueError("original public diagnostic executable")
    age = time.monotonic_ns() - value["sampled_monotonic_ns"]
    if not 0 <= age <= 30 * 1000000000:
        raise ValueError("original public diagnostic sample expired")
    # Retain both sampled source identity and independent original FD/hash.
    return {"sample":value,"fd_receipt":{"dev":before.st_dev,"inode":before.st_ino,"size":before.st_size,
            "mtime_ns":before.st_mtime_ns,"ctime_ns":before.st_ctime_ns,"sha256":hashlib.sha256(raw).hexdigest()},
            "sample_scope":"original-show-results","authentication_boundary":False}


def observe(pid, ticks, executable, display, controlled=False):
    import gi
    gi.require_version("Atspi", "2.0")
    from gi.repository import Atspi, Gio, GLib
    uid = os.getuid()
    if type(controlled) is not bool or (controlled and executable != "roost-shell-gtk"):
        raise RuntimeError("fixed controlled overview mode required")
    if uid == 0 or executable not in {"roost-shell-gtk", "gnome-disks"}:
        raise RuntimeError("probe requires the original non-root session principal")
    state = pathlib.Path(f"/run/user/{uid}/roost-vm-state.json")
    if json.loads(state.read_text())["locked"]:
        raise RuntimeError("locked accessibility trees are never queried")
    original = process_identity(pid, uid, ticks, executable, display)
    Atspi.set_timeout(500, 500)
    deadline = time.monotonic() + 8
    def remaining_budget():
        if json.loads(state.read_text())["locked"]:
            raise RuntimeError("locked accessibility trees are never queried")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError("accessibility principal observation deadline exceeded")
        return max(1, int(remaining * 1000))

    def accessibility_query(method, *args):
        timeout = min(500, remaining_budget())
        Atspi.set_timeout(timeout, timeout)
        result = method(*args)
        remaining_budget()
        return result

    def bus_query(connection, destination, path, interface, method, parameters, reply_type):
        timeout = min(3000, remaining_budget())
        result = connection.call_sync(destination, path, interface, method, parameters, reply_type,
                                     Gio.DBusCallFlags.NONE, timeout, None)
        remaining_budget()
        return result

    desktop = accessibility_query(Atspi.get_desktop, 0)
    count = accessibility_query(desktop.get_child_count)
    if count > 64:
        raise RuntimeError("accessibility desktop exceeds bound")
    candidates = []
    for index in range(count):
        if time.monotonic() >= deadline:
            raise RuntimeError("accessibility principal observation deadline exceeded")
        app = accessibility_query(desktop.get_child_at_index, index)
        if app is not None and accessibility_query(app.get_process_id) == pid:
            candidates.append(app)
    if len(candidates) != 1:
        raise RuntimeError("one original accessibility principal is required")
    app = candidates[0]
    owner = app.app.bus_name
    if not isinstance(owner, str) or len(owner) > 64 or re.fullmatch(r":\d+\.\d+", owner) is None:
        raise RuntimeError("accessibility principal lacks a unique bus owner")
    remaining_budget()
    session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    address = bus_query(session, "org.a11y.Bus", "/org/a11y/bus", "org.a11y.Bus", "GetAddress", None,
                        GLib.VariantType.new("(s)")).unpack()[0]
    remaining_budget()
    bus = Gio.DBusConnection.new_for_address_sync(address,
        Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
    def credentials():
        values = {}
        for method in ("GetNameOwner", "GetConnectionUnixProcessID", "GetConnectionUnixUser"):
            values[method] = bus_query(bus, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                method, GLib.Variant("(s)", (owner,)), None).unpack()[0]
        if values != {"GetNameOwner": owner, "GetConnectionUnixProcessID": pid, "GetConnectionUnixUser": uid}:
            raise RuntimeError("original accessibility bus credentials disagree")
        return values
    before = credentials()
    nodes, pending, visited = [], [(app, 0)], 0
    search_entries, target = [], {"showing":0,"focused":0,"present":0}
    focused_roles = []
    while pending:
        if json.loads(state.read_text())["locked"]:
            raise RuntimeError("locked accessibility trees are never queried")
        if time.monotonic() >= deadline or visited >= 512:
            raise RuntimeError("accessibility focus observation exceeds bound")
        node, depth = pending.pop()
        visited += 1
        if depth > 32:
            raise RuntimeError("accessibility focus tree depth exceeds bound")
        accessibility_query(node.clear_cache)
        states = accessibility_query(node.get_state_set)
        showing = states.contains(Atspi.StateType.SHOWING)
        if depth and not showing:
            continue
        role = accessibility_query(node.get_role_name)
        if role in PUBLIC_ROLES:
            record = public_node(accessibility_query(node.get_name), role, showing,
                                 states.contains(Atspi.StateType.FOCUSED), states.contains(Atspi.StateType.ACTIVE))
            if record is not None:
                nodes.append(record)
            if controlled:
                name = accessibility_query(node.get_name)
                if name == "Search" and role in {"entry","text"} and showing:
                    search_entries.append(node)
                if name == "Disks" and role == "push button":
                    target["present"] += 1
                    target["showing"] += int(showing)
                    target["focused"] += int(states.contains(Atspi.StateType.FOCUSED))
        if controlled and states.contains(Atspi.StateType.FOCUSED):
            focused_roles.append(role if role in PUBLIC_ROLES else "other")
        children = accessibility_query(node.get_child_count)
        if children > 128 or len(pending) + children > 512:
            raise RuntimeError("accessibility focus children exceed bound")
        for index in range(children):
            child = accessibility_query(node.get_child_at_index, index)
            if child is not None:
                pending.append((child, depth + 1))
    diagnostic = None
    if controlled:
        matches = controlled_query(search_entries, accessibility_query)
        diagnostic = {"known_query_matches":matches,"Disks_result":target,"focused_role_classes":focused_roles}
        if matches is True:
            remaining_budget()
            try: diagnostic["catalog"] = catalog_receipt(pid,uid,ticks)
            except (OSError,ValueError,UnicodeError,RecursionError): diagnostic["catalog"] = {"status":"withheld"}
            remaining_budget()
    after = credentials()
    if process_identity(pid, uid, ticks, executable, display) != original or json.loads(state.read_text())["locked"]:
        raise RuntimeError("original focus principal changed or session locked")
    result = {"principal": original, "atspi_owner": owner, "credentials_before": before,
            "credentials_after": after, "public_controls": nodes, "visited": visited,
            "guest_monotonic": time.monotonic(), "observation_only": True}
    if controlled:
        if diagnostic is not None and type(diagnostic.get("catalog")) is dict and "sample" in diagnostic["catalog"]:
            sample = diagnostic["catalog"]["sample"]
            if (tuple(sample["executed_key"]) != executable_key(os.stat(f"/proc/{pid}/exe"))
                    or tuple(sample["executed_key"]) != executable_key(pathlib.Path("/usr/bin/roost-shell-gtk").lstat())):
                diagnostic = {"status":"withheld"}
        if json.loads(state.read_text())["locked"]:
            raise RuntimeError("locked accessibility trees are never queried")
        result["controlled_overview_diagnostic"] = diagnostic
    return result


if __name__ == "__main__":
    try:
        if len(sys.argv) not in (5,6) or (len(sys.argv)==6 and sys.argv[5]!="controlled-overview"):
            raise ValueError("fixed observation mode")
        print(json.dumps(observe(int(sys.argv[1]), int(sys.argv[2]), sys.argv[3], sys.argv[4], len(sys.argv)==6)))
    except Exception as error:
        # No private names/buffers, exception strings, argv or environments.
        print(json.dumps({"focus_error_type": type(error).__name__}))
        raise SystemExit(1) from None
