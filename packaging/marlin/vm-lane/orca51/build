#!/usr/bin/env bash
# Executed only inside the CI package-builder stage, never on a desktop host.
set -euo pipefail
mkdir -p /orca51-artifacts
pacman -Q at-spi2-core > /orca51-artifacts/base-atspi.txt
pacman -Q orca > /orca51-artifacts/base-orca.txt
# Record the real base before installing build tools or replacing any package.
pacman -Syu --needed --noconfirm base-devel meson gettext itstool libxslt docbook-xsl pkgconf gobject-introspection glib2-devel python-gobject libx11 libxtst libxi libxml2
# Decide against the coherently upgraded package, not the earlier base receipt.
current_atspi=$(pacman -Q at-spi2-core | awk '{print $2}')
pacman -Q at-spi2-core > /orca51-artifacts/coherent-atspi.txt
useradd -m -U orca-builder
install -d -o orca-builder -g orca-builder /build/atspi /build/orca
if [[ $(vercmp "$current_atspi" 2.58.6) -lt 0 ]]; then
    install -m0644 /recipes/atspi.PKGBUILD /build/atspi/PKGBUILD
    chown orca-builder:orca-builder /build/atspi/PKGBUILD
    runuser -u orca-builder -- sh -c 'cd /build/atspi && makepkg --noconfirm'
    cp /build/atspi/at-spi2-core-*.pkg.tar.zst /orca51-artifacts/
    pacman -U --noconfirm /orca51-artifacts/at-spi2-core-*.pkg.tar.zst
fi
# A sufficiently new base must have genuine overrides; never downgrade it to
# conceal a missing Python integration. Meson repeats this check for Orca.
python -c 'import gi; gi.require_version("Atspi", "2.0"); from gi.repository import Atspi; assert Atspi.Accessible.__hash__.__module__ == "gi.overrides.Atspi"'
install -m0644 /recipes/orca.PKGBUILD /build/orca/PKGBUILD
chown orca-builder:orca-builder /build/orca/PKGBUILD
runuser -u orca-builder -- sh -c 'cd /build/orca && makepkg --noconfirm'
cp /build/orca/orca-*.pkg.tar.zst /orca51-artifacts/
sha256sum /orca51-artifacts/*.pkg.tar.zst > /orca51-artifacts/package-sha256.txt
for package in /orca51-artifacts/*.pkg.tar.zst; do
    bsdtar -xOf "$package" .BUILDINFO > "$package.buildinfo"
    bsdtar -xOf "$package" .PKGINFO > "$package.pkginfo"
done
cp /recipes/*.PKGBUILD /orca51-artifacts/
cp /build/orca/orca-51.0.tar.xz /orca51-artifacts/
sha256sum /orca51-artifacts/orca-51.0.tar.xz > /orca51-artifacts/source-sha256.txt
rm /orca51-artifacts/orca-51.0.tar.xz
if [[ -f /build/atspi/at-spi2-core-2.58.9.tar.xz ]]; then
    sha256sum /build/atspi/at-spi2-core-2.58.9.tar.xz >> /orca51-artifacts/source-sha256.txt
fi
printf '%s\n' 'Orca upstream tag 51.0: 856433b61385ba77a2960f281275419a0731b385' > /orca51-artifacts/upstream-tag.txt
pacman -Q at-spi2-core python-gobject python-dasbus speech-dispatcher > /orca51-artifacts/build-runtime-packages.txt
