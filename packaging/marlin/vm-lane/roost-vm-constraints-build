#!/usr/bin/env bash
# CI image only; never compile or generate protocol bindings locally.
set -euo pipefail
[[ ${ROOST_CI_ONLY:-} == 1 ]] || { echo "constraint client build is CI-only" >&2; exit 1; }
build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT
for item in pointer-constraints relative-pointer layer-shell; do
  case "$item" in
    pointer-constraints) xml=/usr/share/wayland-protocols/unstable/pointer-constraints/pointer-constraints-unstable-v1.xml ;;
    relative-pointer) xml=/usr/share/wayland-protocols/unstable/relative-pointer/relative-pointer-unstable-v1.xml ;;
    layer-shell) xml=/usr/share/wlr-protocols/unstable/wlr-layer-shell-unstable-v1.xml ;;
  esac
  wayland-scanner client-header "$xml" "$build_dir/$item-client.h"
  wayland-scanner private-code "$xml" "$build_dir/$item-protocol.c"
  sha256sum "$xml" >> "$build_dir/source-sha256sums"
done
cc -std=c11 -O2 -Wall -Wextra -Werror -I"$build_dir" \
  /build/roost-vm-constraints.c "$build_dir/"*-protocol.c \
  $(pkg-config --cflags --libs wayland-client) -o "$build_dir/roost-vm-constraints"
install -Dm755 "$build_dir/roost-vm-constraints" /usr/libexec/roost-vm-constraints
install -Dm644 "$build_dir/source-sha256sums" /usr/share/roost-vm-constraints/source-sha256sums
pacman -Q wayland wayland-protocols wlr-protocols gcc > /usr/share/roost-vm-constraints/packages.txt
cc --version > /usr/share/roost-vm-constraints/compiler.txt
sha256sum /build/roost-vm-constraints.c /usr/libexec/roost-vm-constraints > /usr/share/roost-vm-constraints/build-sha256sums
