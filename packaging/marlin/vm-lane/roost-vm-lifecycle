#!/usr/bin/env python3
"""CI-only root probes through QGA. Never print credentials or process argv."""
import json
import hashlib
import stat as file_stat
import os
import pathlib
import pwd
import subprocess
import sys
import time
import hashlib
import hashlib
import shlex



OWNER = pwd.getpwnam("roost-test")
RUNTIME = f"/run/user/{OWNER.pw_uid}"
STATE = pathlib.Path(RUNTIME, "roost-vm-state.json")


def call(*args, user=False, check=True):
    command = list(args)
    if user:
        command = ["runuser", "-u", OWNER.pw_name, "--", "env",
                   f"XDG_RUNTIME_DIR={RUNTIME}",
                   f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus", *command]
    return subprocess.run(command, capture_output=True, text=True,
                          timeout=15, check=check).stdout.strip()



def gpu_pci_caps():
    result = {}
    for card in pathlib.Path("/sys/class/drm").glob("card[0-9]*"):
        config = card / "device/config"
        if not config.exists():
            continue
        with config.open("rb") as stream:
            data = stream.read(256)
        if len(data) < 64:
            continue
        pm = pcie = 0
        offset, seen = data[0x34] & ~3, set()
        while 0x40 <= offset < len(data) - 1 and offset not in seen:
            seen.add(offset)
            if data[offset] == 1:
                pm = offset
            elif data[offset] == 0x10:
                pcie = offset
            offset = data[offset + 1] & ~3
        control = int.from_bytes(data[pm + 4:pm + 6], "little") if pm else 0
        result[card.name] = {"slot": (card / "device").resolve().name,
                             "pm_capability": pm, "pcie_capability": pcie,
                             "no_soft_reset": bool(control & 8), "power_state": control & 3}
    return result


def inventory():
    state = json.loads(STATE.read_text())
    processes = []
    for path in pathlib.Path("/proc").iterdir():
        if not path.name.isdigit():
            continue
        try:
            uid = path.stat().st_uid
            executable = pathlib.Path(os.readlink(path / "exe")).name
            if uid != OWNER.pw_uid or executable not in {
                "roost-compositor", "roost-shell-gtk", "gnome-disks",
                "gnome-system-monitor", "nautilus",
            }:
                continue
            stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
            processes.append({"pid": int(path.name), "uid": uid,
                              "executable": executable, "start_ticks": int(stat[19])})
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    sessions = [line.split() for line in call("loginctl", "list-sessions",
                                             "--no-legend", "--no-pager").splitlines()]
    owned = []
    for line in sessions:
        if len(line) < 2 or line[1] != str(OWNER.pw_uid):
            continue
        description = call("loginctl", "show-session", line[0], "--property=Id",
                           "--property=VTNr", "--property=User", "--property=Type",
                           "--property=Service", "--property=Class")
        properties = dict(item.split("=", 1) for item in description.splitlines())
        if (properties.get("Service") == "greetd" and properties.get("VTNr") == "1"
                and properties.get("User") == str(OWNER.pw_uid)
                and not properties.get("Class", "").startswith("manager")):
            owned.append(properties)
    if len(owned) != 1:
        raise RuntimeError("expected exactly one greetd user session on the configured VT")
    return {"probe_uid": os.geteuid(), "session_uid": OWNER.pw_uid,
            "session": owned[0],
            "state": {k: state[k] for k in ("locked", "windows", "focused", "active_workspace", "overview_open", "pointer_position", "native_relative_motion_count")}
                     | {k: state.get(k) for k in ("mouse_left_handed", "touchpad_left_handed", "hot_corners")},
            "processes": sorted(processes, key=lambda item: item["pid"])}


CONSTRAINT_OWNER = pathlib.Path("/run/roost-vm-constraint-owner.json")
CONSTRAINT_LOG = pathlib.Path("/run/roost-vm-constraint.stderr")
CONSTRAINT_EXE = pathlib.Path("/usr/libexec/roost-vm-constraints")


def constraint_process(pid):
    path = pathlib.Path(f"/proc/{pid}")
    executable = pathlib.Path(os.readlink(path / "exe"))
    if path.stat().st_uid != OWNER.pw_uid or executable != CONSTRAINT_EXE:
        raise RuntimeError("constraint client is not the actual original session executable")
    stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
    inode = (path / "exe").stat()
    return {"pid": pid, "uid": OWNER.pw_uid, "start_ticks": int(stat[19]),
            "executable": str(executable), "exe_inode": inode.st_ino,
            "exe_device": inode.st_dev, "exe_sha256": hashlib.sha256(CONSTRAINT_EXE.read_bytes()).hexdigest()}


def constraint_client(action):
    if action not in ("start", "status", "lock", "confine", "destroy", "empty", "restore", "quit"):
        raise ValueError("unknown fixed constraint action")
    if action == "start":
        if CONSTRAINT_OWNER.exists() or pathlib.Path(RUNTIME, "roost-vm-constraints.sock").exists():
            raise RuntimeError("original constraint principal already exists")
        compositor = next(process for process in inventory()["processes"] if process["executable"] == "roost-compositor")
        display = f"roost-nested-{compositor['pid']}"
        with CONSTRAINT_LOG.open("xb") as log:
            os.chmod(CONSTRAINT_LOG, 0o600)
            subprocess.Popen(["runuser", "-u", OWNER.pw_name, "--", "env", f"XDG_RUNTIME_DIR={RUNTIME}",
                              f"WAYLAND_DISPLAY={display}", str(CONSTRAINT_EXE)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log,
                             start_new_session=True)
        deadline = time.monotonic() + 5
        while not pathlib.Path(RUNTIME, "roost-vm-constraints.sock").exists():
            if time.monotonic() >= deadline:
                raise RuntimeError("actual constraint principal did not bind its session socket")
            time.sleep(0.05)
        snapshot = json.loads(call(str(CONSTRAINT_EXE), "--command", "status", user=True))
        identity = constraint_process(snapshot["pid"])
        record = {"identity": identity, "display": display,
                  "surface_id": snapshot["surface_id"], "pointer_id": snapshot["pointer_id"],
                  "relative_id": snapshot["relative_id"],
                  "build_metadata": {name: pathlib.Path("/usr/share/roost-vm-constraints", name).read_text()
                      for name in ("source-sha256sums", "build-sha256sums", "packages.txt", "compiler.txt")}}
        with CONSTRAINT_OWNER.open("x") as stream:
            os.chmod(CONSTRAINT_OWNER, 0o600)
            json.dump(record, stream)
    else:
        record = json.loads(CONSTRAINT_OWNER.read_text())
        identity = constraint_process(record["identity"]["pid"])
        if identity != record["identity"]:
            raise RuntimeError("actual original constraint client process changed")
        snapshot = json.loads(call(str(CONSTRAINT_EXE), "--command", action, user=True))
    if snapshot["uid"] != OWNER.pw_uid or snapshot["pid"] != record["identity"]["pid"]:
        raise RuntimeError("constraint response principal differs from original")
    if any(snapshot[key] != record[key] for key in ("surface_id", "pointer_id", "relative_id")):
        raise RuntimeError("original constraint protocol objects changed")
    if action == "quit":
        deadline = time.monotonic() + 5
        while pathlib.Path(f"/proc/{record['identity']['pid']}").exists():
            if time.monotonic() >= deadline:
                raise RuntimeError("actual original constraint client did not terminate")
            time.sleep(0.05)
    return {"principal": record, "client": snapshot}
def orca_read_error(error):
    """Bounded diagnostics only for the fixed credential-free read action."""
    result = {"exception_type": type(error).__name__}
    if isinstance(error, OSError):
        result["errno"] = error.errno
    if isinstance(error, subprocess.CalledProcessError):
        result["returncode"] = error.returncode
        command = error.cmd if isinstance(error.cmd, list) else []
        # Never serialize argv, environment or arbitrary helper stderr. The
        # fixed D-Bus reads take only public names and return no secret values.
        try:
            index = command.index("busctl")
            dbus = command[index:]
            method = dbus[6]
            safe = dbus[1:3] == ["--user", "call"] and (
                (len(dbus) == 9 and dbus[3:6] == ["org.freedesktop.DBus", "/org/freedesktop/DBus",
                                                "org.freedesktop.DBus"] and dbus[7] == "s"
                 and method in {"GetNameOwner", "GetConnectionUnixProcessID", "GetConnectionUnixUser"})
                or (len(dbus) == 7 and dbus[3].startswith(":") and method == "GetVersion"
                    and dbus[4:6] in [["/org/gnome/Orca/Service", "org.gnome.Orca.Service"],
                                     ["/org/gnome/Orca1/Service", "org.gnome.Orca1.Service"]]))
        except (ValueError, IndexError):
            safe = False
        if safe:
            result["dbus_method"] = method
            result["stderr"] = "".join(c for c in (error.stderr or "")[:512]
                                       if c.isprintable() or c in "\n\t")
    return result


def orca_child_diagnostic(state, pid):
    """Unready-child evidence only; never grants bus readiness or process authority."""
    if state.get("locked") is not False:
        return {"status": "locked"}
    if type(pid) is not int or pid <= 0:
        return {"status": "no-child"}
    def bounded(path, limit):
        with path.open("rb") as stream:
            data = stream.read(limit + 1)
        if len(data) > limit:
            raise OverflowError()
        return data
    try:
        process = pathlib.Path(f"/proc/{pid}")
        before = bounded(process / "stat", 4096).decode().rsplit(")", 1)[1].split()
        uid = process.stat().st_uid
        parent = int(before[1])
        ticks = int(before[19])
        executable = os.readlink(process / "exe")
        executed = os.stat(process / "exe")
        # Emit only known system Python/Orca executable names, never arbitrary paths.
        import re
        if not re.fullmatch(r"/usr/bin/(?:orca|python3(?:\.[0-9]{1,2})?)", executable):
            return {"status": "executable-refused"}
        parent_path = pathlib.Path(f"/proc/{parent}")
        parent_before = bounded(parent_path / "stat", 4096)
        if (uid != OWNER.pw_uid or parent_path.stat().st_uid != OWNER.pw_uid
                or os.readlink(parent_path / "exe") != "/usr/bin/roost-compositor"):
            return {"status": "principal-refused"}
        environment = bounded(process / "environ", 128 * 1024)
        expected = f"roost-nested-{parent}".encode()
        displays = [item.split(b"=", 1)[1] for item in environment.split(b"\0")
                    if item.startswith(b"WAYLAND_DISPLAY=")]
        session_buses = [item.split(b"=", 1)[1] for item in environment.split(b"\0")
                         if item.startswith(b"DBUS_SESSION_BUS_ADDRESS=")]
        expected_bus = f"unix:path={RUNTIME}/bus".encode()
        package = call("pacman", "-Qqo", executable)
        if package not in {"python", "orca"}:
            return {"status": "package-refused"}
        after = bounded(process / "stat", 4096).decode().rsplit(")", 1)[1].split()
        final_state = json.loads(bounded(STATE, 1024 * 1024))
        executed_after = os.stat(process / "exe")
        if (after[19] != before[19] or after[1] != before[1]
                or process.stat().st_uid != uid or os.readlink(process / "exe") != executable
                or bounded(parent_path / "stat", 4096).decode().rsplit(")", 1)[1].split()[19]
                   != parent_before.decode().rsplit(")", 1)[1].split()[19]
                or parent_path.stat().st_uid != OWNER.pw_uid
                or os.readlink(parent_path / "exe") != "/usr/bin/roost-compositor"
                or (executed_after.st_dev, executed_after.st_ino, executed_after.st_size)
                   != (executed.st_dev, executed.st_ino, executed.st_size)
                or type(final_state) is not dict or final_state.get("locked") is not False
                or final_state.get("screen_reader_pid") != pid):
            return {"status": "changed"}
        return {"status": "observed", "pid": pid, "uid": uid, "start_ticks": ticks,
                "parent_pid": parent, "executable": executable, "executable_package": package,
                "executed_dev": executed.st_dev, "executed_inode": executed.st_ino,
                "executed_size": executed.st_size,
                "display_matches_parent": displays == [expected],
                "session_bus_matches": session_buses == [expected_bus]}
    except (FileNotFoundError, ProcessLookupError):
        return {"status": "gone"}
    except PermissionError:
        return {"status": "permission"}
    except (OverflowError, ValueError, IndexError, UnicodeError):
        return {"status": "malformed"}
    except (OSError, subprocess.SubprocessError):
        return {"status": "acquisition-error"}


def orca_observation():
    state = json.loads(STATE.read_text())
    pid = int(state.get("screen_reader_pid") or 0)
    contracts = []
    for name, path, prefix in (("org.gnome.Orca1.Service", "/org/gnome/Orca1/Service", "51."),
                               ("org.gnome.Orca.Service", "/org/gnome/Orca/Service", "50.3")):
        reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                     "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
                     "s", name, user=True, check=False)
        parts = shlex.split(reply)
        if len(parts) == 2 and parts[0] == "s":
            contracts.append((name, path, prefix, parts[1], reply))
    owner = contracts[0][3] if contracts else None
    result = {"enabled": call("gsettings", "get", "org.gnome.desktop.a11y.applications",
                              "screen-reader-enabled", user=True) == "true",
              "state": state.get("screen_reader_state"), "pid": pid, "owner": owner,
              "package": call("pacman", "-Q", "orca"), "ready": False}
    if not owner:
        result["unready_child_diagnostic"] = orca_child_diagnostic(state, pid)
    if pid == 0 or not owner:
        return result
    name, path, version_prefix, owner, owner_reply = contracts[0]
    # Two supported names may only coexist for the same original owned child.
    for contract in contracts:
        for method, expected in (("GetConnectionUnixProcessID", pid),
                                 ("GetConnectionUnixUser", OWNER.pw_uid)):
            reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                         "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
                         "s", contract[3], user=True).split()
            if reply != ["u", str(expected)]:
                result["foreign_owner"] = True
                return result
    credentials = {}
    for method in ("GetConnectionUnixProcessID", "GetConnectionUnixUser"):
        reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                     "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
                     "s", owner, user=True).split()
        if len(reply) != 2 or reply[0] != "u":
            raise RuntimeError("invalid Orca bus credentials")
        credentials[method] = int(reply[1])
    process = pathlib.Path(f"/proc/{pid}")
    if (credentials["GetConnectionUnixProcessID"] != pid
            or credentials["GetConnectionUnixUser"] != OWNER.pw_uid):
        return result
    try:
        uid = process.stat().st_uid
        with (process / "environ").open("rb") as stream:
            environment = stream.read(128 * 1024 + 1)
        process_stat = (process / "stat").read_text().rsplit(")", 1)[1].split()
        ticks, parent_pid = int(process_stat[19]), int(process_stat[1])
    except (FileNotFoundError, ProcessLookupError):
        return result
    if len(environment) > 128 * 1024:
        raise RuntimeError("Orca environment exceeds bound")
    displays = [entry.split(b"=", 1)[1].decode() for entry in environment.split(b"\0")
                if entry.startswith(b"WAYLAND_DISPLAY=")]
    launcher = pathlib.Path("/usr/bin/orca")
    if launcher.stat().st_uid != 0:
        raise RuntimeError("Orca launcher not distribution-owned")
    launcher_owner = call("pacman", "-Qqo", str(launcher))
    version = shlex.split(call("busctl", "--user", "call", owner,
                              path, name, "GetVersion", user=True))
    stable = call("busctl", "--user", "call", "org.freedesktop.DBus",
                  "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
                  "s", name, user=True) == owner_reply
    compositor = next(item for item in inventory()["processes"]
                      if item["executable"] == "roost-compositor")
    expected_display = f"roost-nested-{compositor['pid']}"
    result.update({"uid": uid, "start_ticks": ticks, "display": displays,
                   "parent_pid": parent_pid, "compositor_pid": compositor["pid"],
                   "executable": os.readlink(process / "exe"), "version": version,
                   "bus_name": name, "bus_path": path,
                   "launcher_sha256": hashlib.sha256(launcher.read_bytes()).hexdigest(),
                   "bus_pid": credentials["GetConnectionUnixProcessID"],
                   "bus_uid": credentials["GetConnectionUnixUser"]})
    result["ready"] = (stable and uid == OWNER.pw_uid == credentials["GetConnectionUnixUser"]
                       and pid == credentials["GetConnectionUnixProcessID"]
                       and parent_pid == compositor["pid"]
                       and displays == [expected_display] and launcher_owner == "orca"
                       and len(version) == 2 and version[0] == "s" and version[1].startswith(version_prefix))
    return result


def background_user_diagnostics():
    if os.geteuid() != OWNER.pw_uid or OWNER.pw_uid == 0:
        raise RuntimeError("background reader must be the actual ordinary session owner")
    from gi.repository import Gio
    result = {"reader_uid": os.geteuid(), "runtime": os.environ.get("XDG_RUNTIME_DIR"),
              "settings": {}, "drop": {}}
    for schema in ("org.gnome.desktop.background", "org.gnome.desktop.screensaver"):
        try:
            source = Gio.SettingsSchemaSource.get_default().lookup(schema, True)
            if source is None:
                raise RuntimeError("actual schema missing")
            settings = Gio.Settings.new_full(source, None, None)
            result["settings"][schema] = {
                key: settings.get_value(key).unpack() for key in
                ("picture-uri", "picture-options", "primary-color", "secondary-color", "color-shading-type")}
            if source.has_key("picture-uri-dark"):
                result["settings"][schema]["picture-uri-dark"] = settings.get_string("picture-uri-dark")
        except Exception as error:
            result["settings"][schema] = {"error": str(error)}
    interface = Gio.Settings.new("org.gnome.desktop.interface")
    result["color_scheme"] = interface.get_string("color-scheme")
    path = pathlib.Path(RUNTIME, "roost-wallpaper")
    identity = lambda m: {"dev": m.st_dev, "ino": m.st_ino, "bytes": m.st_size,
                          "uid": m.st_uid, "mode": m.st_mode,
                          "mtime_ns": m.st_mtime_ns, "ctime_ns": m.st_ctime_ns}
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            before = os.fstat(fd)
            result["drop"]["before"] = identity(before)
            if not file_stat.S_ISREG(before.st_mode) or before.st_uid != OWNER.pw_uid or before.st_size > 16384:
                raise RuntimeError("private drop type/owner/size bound failed")
            data = bytearray()
            while len(data) <= 16384:
                chunk = os.read(fd, 16385 - len(data))
                if not chunk:
                    break
                data.extend(chunk)
            after = os.fstat(fd)
            named = path.lstat()
            result["drop"]["after"] = identity(after)
            result["drop"]["named"] = identity(named)
            if len(data) > 16384 or len(data) != before.st_size or identity(before) != identity(after) or identity(before) != identity(named):
                raise RuntimeError("private drop changed or exceeded bound")
            result["drop"].update(text=data.decode("utf-8"), sha256=hashlib.sha256(data).hexdigest())
        finally:
            os.close(fd)
    except (OSError, RuntimeError, UnicodeError) as error:
        result["drop"]["error"] = str(error)
    # The existing snapshot already excludes lock credential values. Retain
    # only the new in-memory wallpaper observations, and no window titles.
    try:
        fd = os.open(STATE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            before = os.fstat(fd)
            if not file_stat.S_ISREG(before.st_mode) or before.st_uid != OWNER.pw_uid or before.st_size > 1024 * 1024:
                raise RuntimeError("journey snapshot type/owner/size bound failed")
            with os.fdopen(os.dup(fd), "rb") as stream:
                data = stream.read(1024 * 1024 + 1)
            if len(data) > 1024 * 1024 or len(data) != before.st_size or identity(before) != identity(os.fstat(fd)) or identity(before) != identity(STATE.lstat()):
                raise RuntimeError("journey snapshot changed or exceeded bound")
        finally:
            os.close(fd)
        state = json.loads(data)
        result["compositor"] = {key: state.get(key) for key in
                                ("locked", "rendered_frames", "wallpaper_diagnostics")}
    except (OSError, RuntimeError, ValueError) as error:
        result["compositor"] = {"error": str(error)}
    return result


def valid_native_files_error(value,phase):
    stages={"context","start","guard-fast","guard-principals","guard-session","guard-route",
            "guard-accessibility","guard-fixture","guard-final","closed-state","window","tree",
            "tree-provider","provider-enumerate","provider-receipt","tree-walk",
            "cells","filesystem","cleanup","phase","final-guard","receipt"}
    allowed={"RuntimeError","ValueError","OSError","FileNotFoundError","PermissionError","CalledProcessError",
             "TimeoutExpired","TimeoutError","ImportError","ModuleNotFoundError","OtherError"}
    fields={"phase","stage","exception_type"}
    if type(value) is not dict or set(value) not in (fields,fields|{"query_context"},fields|{"sub_stage"}):return False
    if "sub_stage" in value and (value.get("stage")!="provider-receipt" or type(value["sub_stage"]) is not str or value["sub_stage"] not in {"owner-shape","owner-current","provider-identity","provider-stable","receipt-match"}):return False
    if "query_context" in value:
        query=value["query_context"]
        if (value.get("stage")!="cells" or type(query) is not dict or set(query)!={"operation","boundary","reason"}
                or type(query["operation"]) is not str or query["operation"] not in {"role","name","state"}
                or type(query["boundary"]) is not str or query["boundary"] not in {"guard-before","operation","guard-after"}
                or type(query["reason"]) is not str
                or (query["reason"] not in ({"rpc"} if query["boundary"]=="operation" else {"deadline","process","route","scene"}))):return False
    return (type(value) is dict
            and type(value["phase"]) is str and value["phase"]==phase
            and type(value["stage"]) is str and value["stage"] in stages
            and type(value["exception_type"]) is str and value["exception_type"] in allowed)


def main():
    if sys.argv[1] == "background-user-diagnostics":
        print(json.dumps(background_user_diagnostics()))
        return
    if os.geteuid() != 0 or OWNER.pw_uid == 0:
        raise RuntimeError("probe must be root and session owner must not be root")
    action = sys.argv[1]
    if action == "background-diagnostics":
        inventory()  # Verify the original actual greetd owner before re-exec.
        result = json.loads(call(sys.executable, __file__, "background-user-diagnostics", user=True))
    elif action == "inventory":
        result = inventory()
    elif action=='native-picker':
        phases={'start','parent','parent-clicked','parent-tested','grant-dialog','blocked','selected','granted','cancel-dialog','dismissed','restored-clicked','restored-tested','closed'}
        if len(sys.argv)!=3 or sys.argv[2] not in phases:raise ValueError('fixed native picker phase required')
        original=inventory();compositor=next(p for p in original['processes'] if p['executable']=='roost-compositor');phase=sys.argv[2]
        completed=subprocess.run(['runuser','-u',OWNER.pw_name,'--','env',
            f'XDG_RUNTIME_DIR={RUNTIME}',f'DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus',
            f"WAYLAND_DISPLAY=roost-nested-{compositor['pid']}",f"ROOST_VM_NATIVE_SESSION={original['session']['Id']}",
            'LC_ALL=C.UTF-8','GTK_A11Y=atspi','GDK_BACKEND=wayland','/usr/libexec/roost-vm-gtk-picker-pilot',phase],capture_output=True,timeout=28)
        if completed.returncode!=0 or len(completed.stdout)>16384:
            diagnostic={'phase':phase,'exception_type':'RuntimeError'}
            try:
                decoded=json.loads(completed.stdout) if len(completed.stdout)<=4096 else None
                candidate=decoded.get('native_picker_error') if type(decoded) is dict and set(decoded)=={'native_picker_error'} else None
                allowed={'RuntimeError','ValueError','OSError','FileNotFoundError','PermissionError','CalledProcessError','TimeoutExpired','TimeoutError','ImportError','ModuleNotFoundError','OtherError'}
                if type(candidate) is dict and set(candidate)=={'phase','exception_type'} and candidate['phase']==phase and type(candidate['exception_type']) is str and candidate['exception_type'] in allowed:diagnostic=candidate
            except (ValueError,TypeError,RecursionError):pass
            print(json.dumps({'native_picker_error':diagnostic}));sys.exit(completed.returncode if 0<completed.returncode<256 else 1)
        result=json.loads(completed.stdout)
    elif action == "native-files":
        phases={"start","mapped","dialog","create-typed","created","cancel-typed","cancelled","closed"}
        if len(sys.argv)!=3 or sys.argv[2] not in phases:
            raise ValueError("fixed native Files phase required")
        original=inventory()
        compositor=next(p for p in original["processes"] if p["executable"]=="roost-compositor")
        phase=sys.argv[2]
        result=subprocess.run(["runuser","-u",OWNER.pw_name,"--","env",
            f"XDG_RUNTIME_DIR={RUNTIME}",f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus",
            f"WAYLAND_DISPLAY=roost-nested-{compositor['pid']}",f"ROOST_VM_NATIVE_SESSION={original['session']['Id']}","LC_ALL=C.UTF-8","GTK_A11Y=atspi",
            "/usr/libexec/roost-vm-nautilus-pilot",phase],capture_output=True,timeout=28)
        # Fixed finite diagnostic only; no stderr/body forwarding on any failure.
        if result.returncode!=0 or len(result.stdout)>16384:
            diagnostic={"phase":phase,"stage":"diagnostic-transport","exception_type":"RuntimeError"}
            try:
                decoded=json.loads(result.stdout) if len(result.stdout)<=4096 else None
                candidate=decoded.get("native_files_error") if type(decoded) is dict and set(decoded)=={"native_files_error"} else None
                if valid_native_files_error(candidate,phase):diagnostic=candidate
            except (ValueError,TypeError,RecursionError):pass
            print(json.dumps({"native_files_error":diagnostic}))
            sys.exit(result.returncode if 0<result.returncode<256 else 1)
        result=json.loads(result.stdout)
    elif action == "orca-departed":
        pid, ticks = int(sys.argv[2]), int(sys.argv[3])
        try:
            process = pathlib.Path(f"/proc/{pid}")
            alive = (process.stat().st_uid == OWNER.pw_uid
                     and int((process / "stat").read_text().rsplit(")", 1)[1].split()[19]) == ticks)
        except (FileNotFoundError, ProcessLookupError):
            alive = False
        result = {"original_alive": alive, **orca_observation()}
    elif action == "orca-read":
        try:
            result = orca_observation()
        except Exception as error:
            print(json.dumps({"orca_read_error": orca_read_error(error)}))
            raise SystemExit(1) from None
    elif action in ("orca-off", "orca-on", "orca-reset"):
        if action == "orca-reset":
            call("gsettings", "reset", "org.gnome.desktop.a11y.applications",
                 "screen-reader-enabled", user=True)
        elif action != "orca-read":
            call("gsettings", "set", "org.gnome.desktop.a11y.applications",
                 "screen-reader-enabled", str(action == "orca-on").lower(), user=True)
        result = orca_observation()
    elif action in ("audio-amplification-off", "audio-amplification-on",
                    "audio-amplification-high", "audio-amplification-read",
                    "audio-amplification-reset"):
        schema, key = "org.gnome.desktop.sound", "allow-volume-above-100-percent"
        if action != "audio-amplification-read":
            if action == "audio-amplification-reset":
                call("gsettings", "reset", schema, key, user=True)
                level = "0.40"
            else:
                enabled = action != "audio-amplification-off"
                call("gsettings", "set", schema, key, str(enabled).lower(), user=True)
                level = "1.50" if action == "audio-amplification-high" else "0.98"
            call("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", level, user=True)
            call("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0", user=True)
        objects = json.loads(call("pw-dump", user=True))
        defaults = [entry for obj in objects if obj.get("props", {}).get("metadata.name") == "default"
                    for entry in obj.get("metadata", []) if entry.get("subject") == 0
                    and entry.get("key") == "default.audio.sink"]
        if len(defaults) != 1:
            raise RuntimeError("expected one real default audio sink")
        value = defaults[0]["value"]
        name = (json.loads(value) if isinstance(value, str) else value)["name"]
        sinks = [obj for obj in objects if obj.get("info", {}).get("props", {}).get("node.name") == name
                 and obj.get("info", {}).get("props", {}).get("media.class") == "Audio/Sink"]
        if len(sinks) != 1:
            raise RuntimeError("default audio sink is missing or ambiguous")
        props = sinks[0]["info"]["params"]["Props"][0]
        result = {"sink_id": sinks[0]["id"], "sink_name": name,
                  "percent": float(props["channelVolumes"][0]) ** (1 / 3) * 100,
                  "muted": bool(props.get("mute", False)),
                  "amplified": call("gsettings", "get", schema, key, user=True) == "true"}
    elif action == "suspend":
        # Queue real logind suspend, so QGA can reply before the guest sleeps.
        policy = {name: pathlib.Path(f"/sys/power/{name}").read_text().strip()
                  for name in ("state", "mem_sleep")}
        call("systemd-run", "--unit=roost-vm-suspend", "--collect", "--on-active=1s",
             "--timer-property=AccuracySec=100ms", "busctl", "--system", "call",
             "org.freedesktop.login1", "/org/freedesktop/login1",
             "org.freedesktop.login1.Manager", "Suspend", "b", "false")
        result = {"scheduled": "logind Manager.Suspend(false)", "power_policy": policy}
    elif action == "vt":
        target = int(sys.argv[2])
        if not 1 <= target <= 12:
            raise ValueError("VT outside test range")
        call("chvt", str(target))
        result = {"active_vt": pathlib.Path("/sys/class/tty/tty0/active").read_text().strip()}
    elif action == "diagnostics":
        # Names and kernel wait sites only: no argv, environment or input data.
        processes = []
        for path in pathlib.Path("/proc").iterdir():
            if not path.name.isdigit():
                continue
            try:
                stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
                name = (path / "comm").read_text().strip()
                if name in {"chvt", "python3", "roost-composito", "systemd-logind", "qemu-ga"}:
                    processes.append({"pid": int(path.name), "name": name, "state": stat[0],
                                      "wait_site": (path / "wchan").read_text().strip()})
            except (FileNotFoundError, PermissionError, ProcessLookupError):
                continue
        result = {"active_vt": pathlib.Path("/sys/class/tty/tty0/active").read_text().strip(),
                  "kernel_release": os.uname().release,
                  "gpu_pci_caps": gpu_pci_caps(),
                  "gpu_drivers": {path.name: (path / "device/driver").resolve().name
                                  for path in pathlib.Path("/sys/class/drm").glob("card[0-9]*")
                                  if (path / "device/driver").exists()},
                  "kernel_restore": call("journalctl", "--boot", "--dmesg", "--no-pager",
                                         "-n", "120", "-o", "short-monotonic", "--grep",
                                         "(virtio|drm|PM:|suspend|resume)", check=False)[-32768:],
                  "processes": sorted(processes, key=lambda item: item["pid"])}
    elif action == "lock":
        call("gdbus", "call", "--session", "--dest", "org.gnome.ScreenSaver",
             "--object-path", "/org/gnome/ScreenSaver", "--method", "org.gnome.ScreenSaver.Lock",
             user=True)
        result = {"requested": "lock"}
    elif action == "delay-unlock":
        service = pathlib.Path("/etc/pam.d/roost-lock")
        original = service.read_text()
        service.rename(service.with_suffix(".vm-backup"))
        # Keep the real PAM result below its 10-second authentication deadline,
        # while leaving time for the observed pending child to cross sleep.
        # Neither credentials nor outcomes are faked.
        service.write_text("auth required pam_exec.so /usr/bin/sleep 8\n" + original)
        result = {"pam": "real stack delayed"}
    elif action == "delayed-auth-state":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        waiting = False
        for path in pathlib.Path("/proc").iterdir():
            if not path.name.isdigit():
                continue
            try:
                stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
                if (path.stat().st_uid == OWNER.pw_uid and (path / "comm").read_text().strip() == "sleep"
                        and int(stat[1]) == compositor["pid"]):
                    waiting = True
            except (FileNotFoundError, PermissionError, ProcessLookupError):
                continue
        result = {"real_pam_delay_running": waiting}
    elif action == "deny-unlock":
        # Real PAM failure, not a substitute authenticator or fake daemon.
        service = pathlib.Path("/etc/pam.d/roost-lock")
        service.rename(service.with_suffix(".vm-backup"))
        service.write_text("auth required pam_deny.so\naccount required pam_deny.so\n")
        result = {"pam": "deny"}
    elif action == "restore-unlock":
        pathlib.Path("/etc/pam.d/roost-lock.vm-backup").rename("/etc/pam.d/roost-lock")
        result = {"pam": "restored"}
    elif action == "kill-shell":
        processes = inventory()["processes"]
        for process in processes:
            if process["executable"] == "roost-shell-gtk":
                os.kill(process["pid"], 9)
        result = {"killed": "shell"}
    elif action == "stop-portal":
        call("systemctl", "--user", "stop", "xdg-desktop-portal.service",
             "xdg-desktop-portal-gnome.service", user=True)
        result = {"stopped": "portal"}
    elif action == "capture-input":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        # The actual DRM session uses this socket, as runtime::default_for_pid does.
        display = f"WAYLAND_DISPLAY=roost-nested-{compositor['pid']}"
        def attempt(*args):
            try:
                result = subprocess.run(["runuser", "-u", OWNER.pw_name, "--", "env",
                                         f"XDG_RUNTIME_DIR={RUNTIME}", display, "timeout", "-s", "KILL", "5", *args],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                        timeout=7, check=False)
                return result.returncode
            except subprocess.TimeoutExpired:
                return -1
        result = {"connect_exit": attempt("wayland-info"),
                  "capture_exit": attempt("grim", "/tmp/roost-vm-forbidden-capture.png"),
                  "input_exit": attempt("wtype", "untrusted-input"),
                  "capture_file": pathlib.Path("/tmp/roost-vm-forbidden-capture.png").exists()}
    elif action == "start-input-probe":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        subprocess.Popen(["runuser", "-u", OWNER.pw_name, "--", "env",
                          f"XDG_RUNTIME_DIR={RUNTIME}",
                          f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus",
                          f"WAYLAND_DISPLAY=roost-nested-{compositor['pid']}",
                          "/usr/libexec/roost-vm-input"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        result = {"started": "count-only GTK input probe"}
    elif action == "constraint-log":
        with CONSTRAINT_LOG.open("rb") as stream:
            raw = stream.read(8193)
        result = {"stderr": raw[:8192].decode(errors="replace"), "truncated": len(raw) > 8192}
    elif action.startswith("constraint-"):
        result = constraint_client(action.removeprefix("constraint-"))
    elif action == "hot-corners":
        value = sys.argv[2]
        if value not in ("true", "false"):
            raise ValueError("hot corners must be true or false")
        call("gsettings", "set", "org.gnome.desktop.interface", "enable-hot-corners", value, user=True)
        result = {"stored": call("gsettings", "get", "org.gnome.desktop.interface", "enable-hot-corners", user=True) == value}
    elif action == "mouse-handedness":
        value = sys.argv[2]
        if value not in ("true", "false"):
            raise ValueError("mouse handedness must be true or false")
        call("gsettings", "set", "org.gnome.desktop.peripherals.mouse", "left-handed", value, user=True)
        result = {"stored": call("gsettings", "get", "org.gnome.desktop.peripherals.mouse", "left-handed", user=True) == value}
    elif action in ("input-count", "input-ready", "input-buttons"):
        result = json.loads(pathlib.Path(RUNTIME, "roost-vm-input.json").read_text())
        if pathlib.Path(f"/proc/{result['pid']}").stat().st_uid != OWNER.pw_uid:
            raise RuntimeError("input probe has the wrong owner")
        if action == "input-count":
            result = {key: result[key] for key in ("pid", "count")}
        elif action == "input-buttons":
            result = {key: result[key] for key in
                      ("pid", "buttons", "button_releases", "event_count", "motions", "gtk_version")}
    elif action == "logout":
        call("loginctl", "terminate-session", inventory()["session"]["Id"])
        result = {"requested": "terminate session"}
    elif action == "greeter":
        result = {"greetd_active": call("systemctl", "is-active", "greetd.service") == "active",
                  "greeter_pids": call("pgrep", "-x", "gtkgreet", check=False).splitlines(),
                  "compositor_pids": call("pgrep", "-u", str(OWNER.pw_uid), "-x",
                                          "roost-composito", check=False).splitlines()}
    else:
        raise ValueError("unknown lifecycle action")
    print(json.dumps(result))


if __name__ == "__main__":
    main()
