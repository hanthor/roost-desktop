#!/usr/bin/env python3
"""CI-only root probes through QGA. Never print credentials or process argv."""
import json
import os
import pathlib
import pwd
import subprocess
import sys
import hashlib
import shlex

OWNER = pwd.getpwnam("roost-test")
RUNTIME = f"/run/user/{OWNER.pw_uid}"
STATE = pathlib.Path(RUNTIME, "roost-vm-state.json")


def call(*args, user=False, check=True):
    command = list(args)
    if user:
        command = ["runuser", "-u", OWNER.pw_name, "--", "env",
                   f"XDG_RUNTIME_DIR={RUNTIME}",
                   f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus", *command]
    return subprocess.run(command, capture_output=True, text=True,
                          timeout=15, check=check).stdout.strip()



def gpu_pci_caps():
    result = {}
    for card in pathlib.Path("/sys/class/drm").glob("card[0-9]*"):
        config = card / "device/config"
        if not config.exists():
            continue
        with config.open("rb") as stream:
            data = stream.read(256)
        if len(data) < 64:
            continue
        pm = pcie = 0
        offset, seen = data[0x34] & ~3, set()
        while 0x40 <= offset < len(data) - 1 and offset not in seen:
            seen.add(offset)
            if data[offset] == 1:
                pm = offset
            elif data[offset] == 0x10:
                pcie = offset
            offset = data[offset + 1] & ~3
        control = int.from_bytes(data[pm + 4:pm + 6], "little") if pm else 0
        result[card.name] = {"slot": (card / "device").resolve().name,
                             "pm_capability": pm, "pcie_capability": pcie,
                             "no_soft_reset": bool(control & 8), "power_state": control & 3}
    return result


def inventory():
    state = json.loads(STATE.read_text())
    processes = []
    for path in pathlib.Path("/proc").iterdir():
        if not path.name.isdigit():
            continue
        try:
            uid = path.stat().st_uid
            executable = pathlib.Path(os.readlink(path / "exe")).name
            if uid != OWNER.pw_uid or executable not in {
                "roost-compositor", "roost-shell-gtk", "gnome-disks",
                "gnome-system-monitor", "nautilus",
            }:
                continue
            stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
            processes.append({"pid": int(path.name), "uid": uid,
                              "executable": executable, "start_ticks": int(stat[19])})
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    sessions = [line.split() for line in call("loginctl", "list-sessions",
                                             "--no-legend", "--no-pager").splitlines()]
    owned = []
    for line in sessions:
        if len(line) < 2 or line[1] != str(OWNER.pw_uid):
            continue
        description = call("loginctl", "show-session", line[0], "--property=Id",
                           "--property=VTNr", "--property=User", "--property=Type",
                           "--property=Service", "--property=Class")
        properties = dict(item.split("=", 1) for item in description.splitlines())
        if (properties.get("Service") == "greetd" and properties.get("VTNr") == "1"
                and properties.get("User") == str(OWNER.pw_uid)
                and not properties.get("Class", "").startswith("manager")):
            owned.append(properties)
    if len(owned) != 1:
        raise RuntimeError("expected exactly one greetd user session on the configured VT")
    return {"probe_uid": os.geteuid(), "session_uid": OWNER.pw_uid,
            "session": owned[0],
            "state": {k: state[k] for k in ("locked", "windows", "focused", "active_workspace", "overview_open", "pointer_position", "native_relative_motion_count")}
                     | {k: state.get(k) for k in ("mouse_left_handed", "touchpad_left_handed", "hot_corners")},
            "processes": sorted(processes, key=lambda item: item["pid"])}


def orca_observation():
    state = json.loads(STATE.read_text())
    pid = int(state.get("screen_reader_pid") or 0)
    contracts = []
    for name, path, prefix in (("org.gnome.Orca1.Service", "/org/gnome/Orca1/Service", "51."),
                               ("org.gnome.Orca.Service", "/org/gnome/Orca/Service", "50.3")):
        reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                     "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
                     "s", name, user=True, check=False)
        parts = shlex.split(reply)
        if len(parts) == 2 and parts[0] == "s":
            contracts.append((name, path, prefix, parts[1], reply))
    owner = contracts[0][3] if contracts else None
    result = {"enabled": call("gsettings", "get", "org.gnome.desktop.a11y.applications",
                              "screen-reader-enabled", user=True) == "true",
              "state": state.get("screen_reader_state"), "pid": pid, "owner": owner,
              "package": call("pacman", "-Q", "orca"), "ready": False}
    if pid == 0 or not owner:
        return result
    name, path, version_prefix, owner, owner_reply = contracts[0]
    # Two supported names may only coexist for the same original owned child.
    for contract in contracts:
        for method, expected in (("GetConnectionUnixProcessID", pid),
                                 ("GetConnectionUnixUser", OWNER.pw_uid)):
            reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                         "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
                         "s", contract[3], user=True).split()
            if reply != ["u", str(expected)]:
                result["foreign_owner"] = True
                return result
    credentials = {}
    for method in ("GetConnectionUnixProcessID", "GetConnectionUnixUser"):
        reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                     "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
                     "s", owner, user=True).split()
        if len(reply) != 2 or reply[0] != "u":
            raise RuntimeError("invalid Orca bus credentials")
        credentials[method] = int(reply[1])
    process = pathlib.Path(f"/proc/{pid}")
    if (credentials["GetConnectionUnixProcessID"] != pid
            or credentials["GetConnectionUnixUser"] != OWNER.pw_uid):
        return result
    try:
        uid = process.stat().st_uid
        with (process / "environ").open("rb") as stream:
            environment = stream.read(128 * 1024 + 1)
        process_stat = (process / "stat").read_text().rsplit(")", 1)[1].split()
        ticks, parent_pid = int(process_stat[19]), int(process_stat[1])
    except (FileNotFoundError, ProcessLookupError):
        return result
    if len(environment) > 128 * 1024:
        raise RuntimeError("Orca environment exceeds bound")
    displays = [entry.split(b"=", 1)[1].decode() for entry in environment.split(b"\0")
                if entry.startswith(b"WAYLAND_DISPLAY=")]
    launcher = pathlib.Path("/usr/bin/orca")
    if launcher.stat().st_uid != 0:
        raise RuntimeError("Orca launcher not distribution-owned")
    launcher_owner = call("pacman", "-Qqo", str(launcher))
    version = shlex.split(call("busctl", "--user", "call", owner,
                              path, name, "GetVersion", user=True))
    stable = call("busctl", "--user", "call", "org.freedesktop.DBus",
                  "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
                  "s", name, user=True) == owner_reply
    compositor = next(item for item in inventory()["processes"]
                      if item["executable"] == "roost-compositor")
    expected_display = f"roost-nested-{compositor['pid']}"
    result.update({"uid": uid, "start_ticks": ticks, "display": displays,
                   "parent_pid": parent_pid, "compositor_pid": compositor["pid"],
                   "executable": os.readlink(process / "exe"), "version": version,
                   "bus_name": name, "bus_path": path,
                   "launcher_sha256": hashlib.sha256(launcher.read_bytes()).hexdigest(),
                   "bus_pid": credentials["GetConnectionUnixProcessID"],
                   "bus_uid": credentials["GetConnectionUnixUser"]})
    result["ready"] = (stable and uid == OWNER.pw_uid == credentials["GetConnectionUnixUser"]
                       and pid == credentials["GetConnectionUnixProcessID"]
                       and parent_pid == compositor["pid"]
                       and displays == [expected_display] and launcher_owner == "orca"
                       and len(version) == 2 and version[0] == "s" and version[1].startswith(version_prefix))
    return result


def main():
    if os.geteuid() != 0 or OWNER.pw_uid == 0:
        raise RuntimeError("probe must be root and session owner must not be root")
    action = sys.argv[1]
    if action == "inventory":
        result = inventory()
    elif action == "orca-departed":
        pid, ticks = int(sys.argv[2]), int(sys.argv[3])
        try:
            process = pathlib.Path(f"/proc/{pid}")
            alive = (process.stat().st_uid == OWNER.pw_uid
                     and int((process / "stat").read_text().rsplit(")", 1)[1].split()[19]) == ticks)
        except (FileNotFoundError, ProcessLookupError):
            alive = False
        result = {"original_alive": alive, **orca_observation()}
    elif action in ("orca-off", "orca-on", "orca-read", "orca-reset"):
        if action == "orca-reset":
            call("gsettings", "reset", "org.gnome.desktop.a11y.applications",
                 "screen-reader-enabled", user=True)
        elif action != "orca-read":
            call("gsettings", "set", "org.gnome.desktop.a11y.applications",
                 "screen-reader-enabled", str(action == "orca-on").lower(), user=True)
        result = orca_observation()
    elif action in ("audio-amplification-off", "audio-amplification-on",
                    "audio-amplification-high", "audio-amplification-read",
                    "audio-amplification-reset"):
        schema, key = "org.gnome.desktop.sound", "allow-volume-above-100-percent"
        if action != "audio-amplification-read":
            if action == "audio-amplification-reset":
                call("gsettings", "reset", schema, key, user=True)
                level = "0.40"
            else:
                enabled = action != "audio-amplification-off"
                call("gsettings", "set", schema, key, str(enabled).lower(), user=True)
                level = "1.50" if action == "audio-amplification-high" else "0.98"
            call("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", level, user=True)
            call("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0", user=True)
        objects = json.loads(call("pw-dump", user=True))
        defaults = [entry for obj in objects if obj.get("props", {}).get("metadata.name") == "default"
                    for entry in obj.get("metadata", []) if entry.get("subject") == 0
                    and entry.get("key") == "default.audio.sink"]
        if len(defaults) != 1:
            raise RuntimeError("expected one real default audio sink")
        value = defaults[0]["value"]
        name = (json.loads(value) if isinstance(value, str) else value)["name"]
        sinks = [obj for obj in objects if obj.get("info", {}).get("props", {}).get("node.name") == name
                 and obj.get("info", {}).get("props", {}).get("media.class") == "Audio/Sink"]
        if len(sinks) != 1:
            raise RuntimeError("default audio sink is missing or ambiguous")
        props = sinks[0]["info"]["params"]["Props"][0]
        result = {"sink_id": sinks[0]["id"], "sink_name": name,
                  "percent": float(props["channelVolumes"][0]) ** (1 / 3) * 100,
                  "muted": bool(props.get("mute", False)),
                  "amplified": call("gsettings", "get", schema, key, user=True) == "true"}
    elif action == "suspend":
        # Queue real logind suspend, so QGA can reply before the guest sleeps.
        policy = {name: pathlib.Path(f"/sys/power/{name}").read_text().strip()
                  for name in ("state", "mem_sleep")}
        call("systemd-run", "--unit=roost-vm-suspend", "--collect", "--on-active=1s",
             "--timer-property=AccuracySec=100ms", "busctl", "--system", "call",
             "org.freedesktop.login1", "/org/freedesktop/login1",
             "org.freedesktop.login1.Manager", "Suspend", "b", "false")
        result = {"scheduled": "logind Manager.Suspend(false)", "power_policy": policy}
    elif action == "vt":
        target = int(sys.argv[2])
        if not 1 <= target <= 12:
            raise ValueError("VT outside test range")
        call("chvt", str(target))
        result = {"active_vt": pathlib.Path("/sys/class/tty/tty0/active").read_text().strip()}
    elif action == "diagnostics":
        # Names and kernel wait sites only: no argv, environment or input data.
        processes = []
        for path in pathlib.Path("/proc").iterdir():
            if not path.name.isdigit():
                continue
            try:
                stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
                name = (path / "comm").read_text().strip()
                if name in {"chvt", "python3", "roost-composito", "systemd-logind", "qemu-ga"}:
                    processes.append({"pid": int(path.name), "name": name, "state": stat[0],
                                      "wait_site": (path / "wchan").read_text().strip()})
            except (FileNotFoundError, PermissionError, ProcessLookupError):
                continue
        result = {"active_vt": pathlib.Path("/sys/class/tty/tty0/active").read_text().strip(),
                  "kernel_release": os.uname().release,
                  "gpu_pci_caps": gpu_pci_caps(),
                  "gpu_drivers": {path.name: (path / "device/driver").resolve().name
                                  for path in pathlib.Path("/sys/class/drm").glob("card[0-9]*")
                                  if (path / "device/driver").exists()},
                  "kernel_restore": call("journalctl", "--boot", "--dmesg", "--no-pager",
                                         "-n", "120", "-o", "short-monotonic", "--grep",
                                         "(virtio|drm|PM:|suspend|resume)", check=False)[-32768:],
                  "processes": sorted(processes, key=lambda item: item["pid"])}
    elif action == "lock":
        call("gdbus", "call", "--session", "--dest", "org.gnome.ScreenSaver",
             "--object-path", "/org/gnome/ScreenSaver", "--method", "org.gnome.ScreenSaver.Lock",
             user=True)
        result = {"requested": "lock"}
    elif action == "delay-unlock":
        service = pathlib.Path("/etc/pam.d/roost-lock")
        original = service.read_text()
        service.rename(service.with_suffix(".vm-backup"))
        # Keep the real PAM result below its 10-second authentication deadline,
        # while leaving time for the observed pending child to cross sleep.
        # Neither credentials nor outcomes are faked.
        service.write_text("auth required pam_exec.so /usr/bin/sleep 8\n" + original)
        result = {"pam": "real stack delayed"}
    elif action == "delayed-auth-state":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        waiting = False
        for path in pathlib.Path("/proc").iterdir():
            if not path.name.isdigit():
                continue
            try:
                stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
                if (path.stat().st_uid == OWNER.pw_uid and (path / "comm").read_text().strip() == "sleep"
                        and int(stat[1]) == compositor["pid"]):
                    waiting = True
            except (FileNotFoundError, PermissionError, ProcessLookupError):
                continue
        result = {"real_pam_delay_running": waiting}
    elif action == "deny-unlock":
        # Real PAM failure, not a substitute authenticator or fake daemon.
        service = pathlib.Path("/etc/pam.d/roost-lock")
        service.rename(service.with_suffix(".vm-backup"))
        service.write_text("auth required pam_deny.so\naccount required pam_deny.so\n")
        result = {"pam": "deny"}
    elif action == "restore-unlock":
        pathlib.Path("/etc/pam.d/roost-lock.vm-backup").rename("/etc/pam.d/roost-lock")
        result = {"pam": "restored"}
    elif action == "kill-shell":
        processes = inventory()["processes"]
        for process in processes:
            if process["executable"] == "roost-shell-gtk":
                os.kill(process["pid"], 9)
        result = {"killed": "shell"}
    elif action == "stop-portal":
        call("systemctl", "--user", "stop", "xdg-desktop-portal.service",
             "xdg-desktop-portal-gnome.service", user=True)
        result = {"stopped": "portal"}
    elif action == "capture-input":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        # The actual DRM session uses this socket, as runtime::default_for_pid does.
        display = f"WAYLAND_DISPLAY=roost-nested-{compositor['pid']}"
        def attempt(*args):
            try:
                result = subprocess.run(["runuser", "-u", OWNER.pw_name, "--", "env",
                                         f"XDG_RUNTIME_DIR={RUNTIME}", display, "timeout", "-s", "KILL", "5", *args],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                        timeout=7, check=False)
                return result.returncode
            except subprocess.TimeoutExpired:
                return -1
        result = {"connect_exit": attempt("wayland-info"),
                  "capture_exit": attempt("grim", "/tmp/roost-vm-forbidden-capture.png"),
                  "input_exit": attempt("wtype", "untrusted-input"),
                  "capture_file": pathlib.Path("/tmp/roost-vm-forbidden-capture.png").exists()}
    elif action == "start-input-probe":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        subprocess.Popen(["runuser", "-u", OWNER.pw_name, "--", "env",
                          f"XDG_RUNTIME_DIR={RUNTIME}",
                          f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus",
                          f"WAYLAND_DISPLAY=roost-nested-{compositor['pid']}",
                          "/usr/libexec/roost-vm-input"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        result = {"started": "count-only GTK input probe"}
    elif action == "hot-corners":
        value = sys.argv[2]
        if value not in ("true", "false"):
            raise ValueError("hot corners must be true or false")
        call("gsettings", "set", "org.gnome.desktop.interface", "enable-hot-corners", value, user=True)
        result = {"stored": call("gsettings", "get", "org.gnome.desktop.interface", "enable-hot-corners", user=True) == value}
    elif action == "mouse-handedness":
        value = sys.argv[2]
        if value not in ("true", "false"):
            raise ValueError("mouse handedness must be true or false")
        call("gsettings", "set", "org.gnome.desktop.peripherals.mouse", "left-handed", value, user=True)
        result = {"stored": call("gsettings", "get", "org.gnome.desktop.peripherals.mouse", "left-handed", user=True) == value}
    elif action in ("input-count", "input-ready", "input-buttons"):
        result = json.loads(pathlib.Path(RUNTIME, "roost-vm-input.json").read_text())
        if pathlib.Path(f"/proc/{result['pid']}").stat().st_uid != OWNER.pw_uid:
            raise RuntimeError("input probe has the wrong owner")
        if action == "input-count":
            result = {key: result[key] for key in ("pid", "count")}
        elif action == "input-buttons":
            result = {key: result[key] for key in
                      ("pid", "buttons", "button_releases", "event_count", "motions", "gtk_version")}
    elif action == "logout":
        call("loginctl", "terminate-session", inventory()["session"]["Id"])
        result = {"requested": "terminate session"}
    elif action == "greeter":
        result = {"greetd_active": call("systemctl", "is-active", "greetd.service") == "active",
                  "greeter_pids": call("pgrep", "-x", "gtkgreet", check=False).splitlines(),
                  "compositor_pids": call("pgrep", "-u", str(OWNER.pw_uid), "-x",
                                          "roost-composito", check=False).splitlines()}
    else:
        raise ValueError("unknown lifecycle action")
    print(json.dumps(result))


if __name__ == "__main__":
    main()
