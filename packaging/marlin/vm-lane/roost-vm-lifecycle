"""CI-only root probes through QGA. Never print credentials or process argv."""
import json
import os
import pathlib
import pwd
import subprocess
import sys
import time
import hashlib
import hashlib
import shlex
import time
import uuid
import base64
import stat
import contextlib

RECORDING_DIR = pathlib.Path("/run/roost-vm-orca-recordings")
RECORDING_STATE = RECORDING_DIR / "current.json"



OWNER = pwd.getpwnam("roost-test")
RUNTIME = f"/run/user/{OWNER.pw_uid}"
STATE = pathlib.Path(RUNTIME, "roost-vm-state.json")


def call(*args, user=False, check=True):
    command = list(args)
    if user:
        command = ["runuser", "-u", OWNER.pw_name, "--", "env",
                   f"XDG_RUNTIME_DIR={RUNTIME}",
                   f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus", *command]
    return subprocess.run(command, capture_output=True, text=True,
                          timeout=15, check=check).stdout.strip()



def gpu_pci_caps():
    result = {}
    for card in pathlib.Path("/sys/class/drm").glob("card[0-9]*"):
        config = card / "device/config"
        if not config.exists():
            continue
        with config.open("rb") as stream:
            data = stream.read(256)
        if len(data) < 64:
            continue
        pm = pcie = 0
        offset, seen = data[0x34] & ~3, set()
        while 0x40 <= offset < len(data) - 1 and offset not in seen:
            seen.add(offset)
            if data[offset] == 1:
                pm = offset
            elif data[offset] == 0x10:
                pcie = offset
            offset = data[offset + 1] & ~3
        control = int.from_bytes(data[pm + 4:pm + 6], "little") if pm else 0
        result[card.name] = {"slot": (card / "device").resolve().name,
                             "pm_capability": pm, "pcie_capability": pcie,
                             "no_soft_reset": bool(control & 8), "power_state": control & 3}
    return result


def inventory():
    state = json.loads(STATE.read_text())
    processes = []
    for path in pathlib.Path("/proc").iterdir():
        if not path.name.isdigit():
            continue
        try:
            uid = path.stat().st_uid
            executable = pathlib.Path(os.readlink(path / "exe")).name
            if uid != OWNER.pw_uid or executable not in {
                "roost-compositor", "roost-shell-gtk", "gnome-disks",
                "gnome-system-monitor", "nautilus",
            }:
                continue
            stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
            processes.append({"pid": int(path.name), "uid": uid,
                              "executable": executable, "start_ticks": int(stat[19])})
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    sessions = [line.split() for line in call("loginctl", "list-sessions",
                                             "--no-legend", "--no-pager").splitlines()]
    owned = []
    for line in sessions:
        if len(line) < 2 or line[1] != str(OWNER.pw_uid):
            continue
        description = call("loginctl", "show-session", line[0], "--property=Id",
                           "--property=VTNr", "--property=User", "--property=Type",
                           "--property=Service", "--property=Class")
        properties = dict(item.split("=", 1) for item in description.splitlines())
        if (properties.get("Service") == "greetd" and properties.get("VTNr") == "1"
                and properties.get("User") == str(OWNER.pw_uid)
                and not properties.get("Class", "").startswith("manager")):
            owned.append(properties)
    if len(owned) != 1:
        raise RuntimeError("expected exactly one greetd user session on the configured VT")
    return {"probe_uid": os.geteuid(), "session_uid": OWNER.pw_uid,
            "session": owned[0],
            "state": {k: state[k] for k in ("locked", "windows", "focused", "active_workspace", "overview_open", "pointer_position", "native_relative_motion_count")}
                     | {k: state.get(k) for k in ("mouse_left_handed", "touchpad_left_handed", "hot_corners")},
            "processes": sorted(processes, key=lambda item: item["pid"])}


def owned_compositor(processes):
    candidates = [process for process in processes
                  if process.get("executable") == "roost-compositor"
                  and process.get("uid") == OWNER.pw_uid]
    if len(candidates) != 1:
        raise RuntimeError("one original same-user compositor is required")
    return candidates[0]


def orca_read_error(error):
    """Bounded diagnostics only for the fixed credential-free read action."""
    result = {"exception_type": type(error).__name__}
    if isinstance(error, OSError):
        result["errno"] = error.errno
    if isinstance(error, subprocess.CalledProcessError):
        result["returncode"] = error.returncode
        command = error.cmd if isinstance(error.cmd, list) else []
        # Never serialize argv, environment or arbitrary helper stderr. The
        # fixed D-Bus reads take only public names and return no secret values.
        try:
            index = command.index("busctl")
            dbus = command[index:]
            method = dbus[6]
            safe = dbus[1:3] == ["--user", "call"] and (
                (len(dbus) == 9 and dbus[3:6] == ["org.freedesktop.DBus", "/org/freedesktop/DBus",
                                                "org.freedesktop.DBus"] and dbus[7] == "s"
                 and method in {"GetNameOwner", "GetConnectionUnixProcessID", "GetConnectionUnixUser"})
                or (len(dbus) == 7 and dbus[3].startswith(":") and method == "GetVersion"
                    and dbus[4:6] in [["/org/gnome/Orca/Service", "org.gnome.Orca.Service"],
                                     ["/org/gnome/Orca1/Service", "org.gnome.Orca1.Service"]]))
        except (ValueError, IndexError):
            safe = False
        if safe:
            result["dbus_method"] = method
            result["stderr"] = "".join(c for c in (error.stderr or "")[:512]
                                       if c.isprintable() or c in "\n\t")
    return result


CONSTRAINT_OWNER = pathlib.Path("/run/roost-vm-constraint-owner.json")
CONSTRAINT_LOG = pathlib.Path("/run/roost-vm-constraint.stderr")
CONSTRAINT_EXE = pathlib.Path("/usr/libexec/roost-vm-constraints")


def constraint_process(pid):
    path = pathlib.Path(f"/proc/{pid}")
    executable = pathlib.Path(os.readlink(path / "exe"))
    if path.stat().st_uid != OWNER.pw_uid or executable != CONSTRAINT_EXE:
        raise RuntimeError("constraint client is not the actual original session executable")
    stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
    inode = (path / "exe").stat()
    return {"pid": pid, "uid": OWNER.pw_uid, "start_ticks": int(stat[19]),
            "executable": str(executable), "exe_inode": inode.st_ino,
            "exe_device": inode.st_dev, "exe_sha256": hashlib.sha256(CONSTRAINT_EXE.read_bytes()).hexdigest()}


def constraint_client(action):
    if action not in ("start", "status", "lock", "confine", "destroy", "empty", "restore", "quit"):
        raise ValueError("unknown fixed constraint action")
    if action == "start":
        if CONSTRAINT_OWNER.exists() or pathlib.Path(RUNTIME, "roost-vm-constraints.sock").exists():
            raise RuntimeError("original constraint principal already exists")
        compositor = next(process for process in inventory()["processes"] if process["executable"] == "roost-compositor")
        display = f"roost-nested-{compositor['pid']}"
        with CONSTRAINT_LOG.open("xb") as log:
            os.chmod(CONSTRAINT_LOG, 0o600)
            subprocess.Popen(["runuser", "-u", OWNER.pw_name, "--", "env", f"XDG_RUNTIME_DIR={RUNTIME}",
                              f"WAYLAND_DISPLAY={display}", str(CONSTRAINT_EXE)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log,
                             start_new_session=True)
        deadline = time.monotonic() + 5
        while not pathlib.Path(RUNTIME, "roost-vm-constraints.sock").exists():
            if time.monotonic() >= deadline:
                raise RuntimeError("actual constraint principal did not bind its session socket")
            time.sleep(0.05)
        snapshot = json.loads(call(str(CONSTRAINT_EXE), "--command", "status", user=True))
        identity = constraint_process(snapshot["pid"])
        record = {"identity": identity, "display": display,
                  "surface_id": snapshot["surface_id"], "pointer_id": snapshot["pointer_id"],
                  "relative_id": snapshot["relative_id"],
                  "build_metadata": {name: pathlib.Path("/usr/share/roost-vm-constraints", name).read_text()
                      for name in ("source-sha256sums", "build-sha256sums", "packages.txt", "compiler.txt")}}
        with CONSTRAINT_OWNER.open("x") as stream:
            os.chmod(CONSTRAINT_OWNER, 0o600)
            json.dump(record, stream)
    else:
        record = json.loads(CONSTRAINT_OWNER.read_text())
        identity = constraint_process(record["identity"]["pid"])
        if identity != record["identity"]:
            raise RuntimeError("actual original constraint client process changed")
        snapshot = json.loads(call(str(CONSTRAINT_EXE), "--command", action, user=True))
    if snapshot["uid"] != OWNER.pw_uid or snapshot["pid"] != record["identity"]["pid"]:
        raise RuntimeError("constraint response principal differs from original")
    if any(snapshot[key] != record[key] for key in ("surface_id", "pointer_id", "relative_id")):
        raise RuntimeError("original constraint protocol objects changed")
    if action == "quit":
        deadline = time.monotonic() + 5
        while pathlib.Path(f"/proc/{record['identity']['pid']}").exists():
            if time.monotonic() >= deadline:
                raise RuntimeError("actual original constraint client did not terminate")
            time.sleep(0.05)
    return {"principal": record, "client": snapshot}


def orca_observation():
    state = json.loads(STATE.read_text())
    pid = int(state.get("screen_reader_pid") or 0)
    contracts = []
    for name, path, prefix in (("org.gnome.Orca1.Service", "/org/gnome/Orca1/Service", "51."),
                               ("org.gnome.Orca.Service", "/org/gnome/Orca/Service", "50.3")):
        reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                     "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
                     "s", name, user=True, check=False)
        parts = shlex.split(reply)
        if len(parts) == 2 and parts[0] == "s":
            contracts.append((name, path, prefix, parts[1], reply))
    owner = contracts[0][3] if contracts else None
    result = {"enabled": call("gsettings", "get", "org.gnome.desktop.a11y.applications",
                              "screen-reader-enabled", user=True) == "true",
              "state": state.get("screen_reader_state"), "pid": pid, "owner": owner,
              "package": call("pacman", "-Q", "orca"), "ready": False,
              "frames": state.get("rendered_frames"), "keyboard": state.get("a11y_keyboard")}
    if pid == 0 or not owner:
        return result
    name, path, version_prefix, owner, owner_reply = contracts[0]
    # Two supported names may only coexist for the same original owned child.
    for contract in contracts:
        for method, expected in (("GetConnectionUnixProcessID", pid),
                                 ("GetConnectionUnixUser", OWNER.pw_uid)):
            reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                         "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
                         "s", contract[3], user=True).split()
            if reply != ["u", str(expected)]:
                result["foreign_owner"] = True
                return result
    credentials = {}
    for method in ("GetConnectionUnixProcessID", "GetConnectionUnixUser"):
        reply = call("busctl", "--user", "call", "org.freedesktop.DBus",
                     "/org/freedesktop/DBus", "org.freedesktop.DBus", method,
                     "s", owner, user=True).split()
        if len(reply) != 2 or reply[0] != "u":
            raise RuntimeError("invalid Orca bus credentials")
        credentials[method] = int(reply[1])
    process = pathlib.Path(f"/proc/{pid}")
    if (credentials["GetConnectionUnixProcessID"] != pid
            or credentials["GetConnectionUnixUser"] != OWNER.pw_uid):
        return result
    try:
        uid = process.stat().st_uid
        with (process / "environ").open("rb") as stream:
            environment = stream.read(128 * 1024 + 1)
        process_stat = (process / "stat").read_text().rsplit(")", 1)[1].split()
        ticks, parent_pid = int(process_stat[19]), int(process_stat[1])
    except (FileNotFoundError, ProcessLookupError):
        return result
    if len(environment) > 128 * 1024:
        raise RuntimeError("Orca environment exceeds bound")
    displays = [entry.split(b"=", 1)[1].decode() for entry in environment.split(b"\0")
                if entry.startswith(b"WAYLAND_DISPLAY=")]
    launcher = pathlib.Path("/usr/bin/orca")
    if launcher.stat().st_uid != 0:
        raise RuntimeError("Orca launcher not distribution-owned")
    launcher_owner = call("pacman", "-Qqo", str(launcher))
    version = shlex.split(call("busctl", "--user", "call", owner,
                              path, name, "GetVersion", user=True))
    stable = call("busctl", "--user", "call", "org.freedesktop.DBus",
                  "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner",
                  "s", name, user=True) == owner_reply
    compositor = next(item for item in inventory()["processes"]
                      if item["executable"] == "roost-compositor")
    expected_display = f"roost-nested-{compositor['pid']}"
    result.update({"uid": uid, "start_ticks": ticks, "display": displays,
                   "parent_pid": parent_pid, "compositor_pid": compositor["pid"],
                   "executable": os.readlink(process / "exe"), "version": version,
                   "bus_name": name, "bus_path": path,
                   "launcher_sha256": hashlib.sha256(launcher.read_bytes()).hexdigest(),
                   "bus_pid": credentials["GetConnectionUnixProcessID"],
                   "bus_uid": credentials["GetConnectionUnixUser"]})
    result["ready"] = (stable and uid == OWNER.pw_uid == credentials["GetConnectionUnixUser"]
                       and pid == credentials["GetConnectionUnixProcessID"]
                       and parent_pid == compositor["pid"]
                       and displays == [expected_display] and launcher_owner == "orca"
                       and len(version) == 2 and version[0] == "s" and version[1].startswith(version_prefix))
    return result


def speech_selection(actual):
    """Read live SSIP-backed properties on the original genuine 51 connection."""
    if not actual["ready"] or actual["state"] != "active" or actual["version"] != ["s", "51.0"]:
        raise RuntimeError("original genuine Orca 51 is required for speech selection")
    values = {}
    for name in ("CurrentServer", "CurrentSynthesizer"):
        value = shlex.split(call("busctl", "--user", "get-property", actual["owner"],
            "/org/gnome/Orca1/Service/SpeechManager", "org.gnome.Orca1.SpeechManager", name, user=True))
        if len(value) != 2 or value[0] != "s":
            raise RuntimeError("invalid actual Orca speech selection property")
        values[name] = value[1]
    after = orca_observation()
    fields = ("pid", "start_ticks", "owner", "uid", "bus_pid", "bus_uid", "version",
              "display", "parent_pid", "compositor_pid", "bus_name")
    if not after["ready"] or after["state"] != "active" or any(after.get(k) != actual[k] for k in fields):
        raise RuntimeError("original Orca identity changed during speech selection")
    if values != {"CurrentServer": "Speech Dispatcher", "CurrentSynthesizer": "espeak-ng"}:
        raise RuntimeError("original Orca did not select the real espeak-ng Speech Dispatcher module")
    return {"selection": values, "orca": after, "guest_monotonic": time.monotonic()}


def process_receipt(pid):
    """Kernel process identity; PipeWire app properties remain hints only."""
    path = pathlib.Path(f"/proc/{int(pid)}")
    stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
    uid, ticks = path.stat().st_uid, int(stat[19])
    exe = pathlib.Path(os.readlink(path / "exe"))
    with exe.open("rb") as stream:
        image = stream.read(16 * 1024 * 1024 + 1)
    if uid != OWNER.pw_uid or len(image) > 16 * 1024 * 1024:
        raise RuntimeError("speech process identity exceeds user/size authority")
    result = {"pid": int(pid), "uid": uid, "start_ticks": ticks, "exe": str(exe),
              "exe_sha256": hashlib.sha256(image).hexdigest(), "package": call("pacman", "-Qqo", str(exe))}
    stable = (path / "stat").read_text().rsplit(")", 1)[1].split()
    if int(stable[19]) != ticks or path.stat().st_uid != uid or os.readlink(path / "exe") != str(exe):
        raise RuntimeError("speech process identity changed during receipt")
    return result


def speech_graph():
    # Bound the producer's bytes before Python captures/decodes JSON. The fixed
    # pipeline has no interpolated arguments or private data.
    raw = call("bash", "-o", "pipefail", "-c", "pw-dump | head -c 2097153", user=True)
    if len(raw.encode()) > 2 * 1024 * 1024:
        raise RuntimeError("speech graph exceeds evidence bound")
    objects = json.loads(raw)
    keys = {"object.serial", "client.id", "node.id", "node.name", "media.class", "audio.channel",
            "application.process.id", "application.process.binary", "pipewire.sec.pid", "pipewire.sec.uid",
            "pipewire.sec.gid", "protocol.name"}
    receipt = []
    for obj in objects:
        if obj.get("type") not in {"PipeWire:Interface:Node", "PipeWire:Interface:Port",
                                  "PipeWire:Interface:Link", "PipeWire:Interface:Client"}:
            continue
        info = obj.get("info", {})
        receipt.append({"id": obj["id"], "type": obj["type"],
            "info": {k: info[k] for k in ("state", "direction", "output-node-id", "output-port-id",
                     "input-node-id", "input-port-id") if k in info},
            "props": {k: v for k, v in info.get("props", {}).items() if k in keys}})
    if len(receipt) > 512 or len(json.dumps(receipt).encode()) > 128 * 1024:
        raise RuntimeError("speech graph receipt exceeds evidence bound")
    return {"guest_monotonic": time.monotonic(), "objects": receipt,
            "process_properties_are_hints": True, "client_credentials_verified": False,
            "mixed_sink": True, "exclusive_pcm": False}


def file_identity(info):
    if not stat.S_ISREG(info.st_mode):
        raise RuntimeError("recording evidence must be a regular file")
    return {"dev": info.st_dev, "ino": info.st_ino, "uid": info.st_uid,
            "gid": info.st_gid, "mode": stat.S_IMODE(info.st_mode)}


def create_evidence(path, uid, gid):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.fchown(fd, uid, gid)
        return file_identity(os.fstat(fd))
    finally:
        os.close(fd)


def read_evidence(path, identity, limit):
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), "rb") as stream:
        before = os.fstat(stream.fileno())
        if file_identity(before) != identity or file_identity(os.lstat(path)) != identity:
            raise RuntimeError("original recording file identity changed")
        data = stream.read(limit + 1)
        after = os.fstat(stream.fileno())
        if (file_identity(after) != identity or file_identity(os.lstat(path)) != identity
                or (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns)
                or len(data) != before.st_size or len(data) > limit):
            raise RuntimeError("original recording file changed or exceeded its bound")
        return data


def reserve_recording():
    with contextlib.suppress(FileExistsError):
        RECORDING_DIR.mkdir(mode=0o700)
    directory = RECORDING_DIR.lstat()
    if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != 0 or stat.S_IMODE(directory.st_mode) != 0o700:
        raise RuntimeError("recording state directory lacks root authority")
    # O_EXCL reserves authority before any presenter mutation. A second start
    # cannot close or overwrite another original capture through a late race.
    fd = os.open(RECORDING_STATE, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    return fd, file_identity(os.fstat(fd))


def save_recording(recording, reservation):
    fd, identity = reservation
    if file_identity(os.fstat(fd)) != identity or file_identity(RECORDING_STATE.lstat()) != identity:
        raise RuntimeError("original recording reservation changed")
    recording["state_identity"] = identity
    payload = json.dumps(recording).encode()
    if len(payload) > 512 * 1024:
        raise RuntimeError("recording state exceeds bound")
    os.lseek(fd, 0, os.SEEK_SET)
    with os.fdopen(os.dup(fd), "wb") as stream:
        stream.write(payload)
        stream.flush()
        os.ftruncate(fd, len(payload))


def load_recording():
    directory = RECORDING_DIR.lstat()
    if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != 0 or stat.S_IMODE(directory.st_mode) != 0o700:
        raise RuntimeError("recording state directory lacks root authority")
    info = RECORDING_STATE.lstat()
    identity = file_identity(info)
    if identity["uid"] != 0 or identity["mode"] != 0o600:
        raise RuntimeError("recording state lacks root authority")
    recording = json.loads(read_evidence(RECORDING_STATE, identity, 512 * 1024))
    if recording.get("capture_state") != "ready":
        raise RuntimeError("original recording setup has not completed")
    if recording["state_identity"] != identity:
        raise RuntimeError("original root recording state changed")
    return recording


def require_sink_graph(graph, sink, synth, recorder=None):
    objects = {obj["id"]: obj for obj in graph["objects"]}
    if len(objects) != len(graph["objects"]):
        raise RuntimeError("speech graph contains duplicate object IDs")
    for original in (sink, synth):
        actual = objects.get(original["id"], {})
        serial = original["props"].get("object.serial")
        if serial is None or actual.get("props", {}).get("object.serial") != serial:
            raise RuntimeError("original speech/sink graph identity changed")
    pairs = [(synth["id"], sink["id"])]
    if recorder is not None:
        pairs.append((sink["id"], recorder["id"]))
    for source, target in pairs:
        links = [o for o in graph["objects"] if o["type"] == "PipeWire:Interface:Link"
                 and o["info"].get("output-node-id") == source and o["info"].get("input-node-id") == target]
        if not links:
            raise RuntimeError("actual speech capture graph link is missing")
        for link in links:
            for direction, node in (("output", source), ("input", target)):
                port = objects.get(link["info"].get(direction + "-port-id"), {})
                if (port.get("type") != "PipeWire:Interface:Port" or port["info"].get("direction") != direction
                        or int(port["props"].get("node.id", -1)) != node):
                    raise RuntimeError("actual speech graph port/direction disagrees")


def recorder_owns_file(pid, identity):
    for index, entry in enumerate(pathlib.Path(f"/proc/{pid}/fd").iterdir()):
        if index >= 64:
            raise RuntimeError("recorder file descriptors exceed bound")
        with contextlib.suppress(FileNotFoundError):
            info = entry.stat()
            if stat.S_ISREG(info.st_mode) and file_identity(info) == identity:
                return True
    return False


def speech_error_type(error):
    value = type(error).__name__
    allowed = {"RuntimeError", "CalledProcessError", "FileNotFoundError", "ProcessLookupError",
               "PermissionError", "ValueError", "JSONDecodeError", "OSError", "TimeoutExpired"}
    return value if value in allowed else "OtherError"


def original_recorder_departed(original):
    path = pathlib.Path(f"/proc/{original['pid']}")
    try:
        before = int((path / "stat").read_text().rsplit(")", 1)[1].split()[19])
        after = int((path / "stat").read_text().rsplit(")", 1)[1].split()[19])
    except (FileNotFoundError, ProcessLookupError):
        return True
    if before != after:
        raise RuntimeError("recorder process identity changed during departure observation")
    return before != original["start_ticks"]


def recorder_unit_departure(stop_returncode, show_returncode, output, original_departed):
    # Only fixed public systemd properties are retained. Failed/empty/malformed
    # output cannot establish collection or departure of the original recorder.
    if any(type(value) is not int or not -255 <= value <= 255 for value in (stop_returncode, show_returncode)):
        raise RuntimeError("recording unit returncode receipt is invalid")
    if not isinstance(output, str) or len(output) > 256:
        raise RuntimeError("recording unit property receipt exceeds bound")
    rows = output.splitlines()
    props = {}
    for row in rows:
        key, separator, value = row.partition("=")
        if not separator or key not in {"LoadState", "ActiveState", "MainPID"} or key in props:
            raise RuntimeError("recording unit property receipt is not exact")
        props[key] = value
    if set(props) != {"LoadState", "ActiveState", "MainPID"} or props["MainPID"] != "0" or props["ActiveState"] != "inactive":
        raise RuntimeError("recording unit departure properties disagree")
    if props["LoadState"] == "not-found":
        if show_returncode not in (0, 4) or original_departed is not True:
            raise RuntimeError("collected unit lacks original recorder departure proof")
    elif props["LoadState"] == "loaded":
        if stop_returncode != 0 or show_returncode != 0 or original_departed is False:
            raise RuntimeError("loaded recording unit stop did not qualify")
    else:
        raise RuntimeError("recording unit load state does not qualify")
    return {"stop_returncode": stop_returncode, "show_returncode": show_returncode,
            "properties": props, "original_recorder_departed": original_departed}


def stop_recording_unit(recording):
    command = ["runuser", "-u", OWNER.pw_name, "--", "env", f"XDG_RUNTIME_DIR={RUNTIME}",
               f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus", "systemctl", "--user"]
    stop = subprocess.run([*command, "stop", recording["unit"]], capture_output=True, text=True, timeout=15)
    show = subprocess.run([*command, "show", recording["unit"], "--property=LoadState",
                           "--property=ActiveState", "--property=MainPID"], capture_output=True, text=True, timeout=15)
    try:
        original = recording.get("recorder")
        departed = original_recorder_departed(original) if original else None
        return recorder_unit_departure(stop.returncode, show.returncode, show.stdout, departed)
    except Exception as error:
        error.stop_returncode = stop.returncode
        error.show_returncode = show.returncode
        raise


def cleanup_speech(recording, token, unit_started=True, presenter_started=True):
    receipt = {"unit_departed": not unit_started, "presenter_closed": not presenter_started, "errors": []}
    def failure(stage, error):
        item = {"stage": stage, "exception_type": speech_error_type(error)}
        if isinstance(error, subprocess.CalledProcessError) and type(error.returncode) is int and -255 <= error.returncode <= 255:
            item["returncode"] = error.returncode
        for key in ("stop_returncode", "show_returncode"):
            value = getattr(error, key, None)
            if stage == "owned_unit_stop" and type(value) is int and -255 <= value <= 255:
                item[key] = value
        receipt["errors"].append(item)
    if unit_started:
        try:
            receipt["unit_stop"] = stop_recording_unit(recording)
            receipt["unit_departed"] = True
        except Exception as error:
            failure("owned_unit_stop", error)
    if presenter_started:
        try:
            if token is None:
                raise RuntimeError("original presenter token unavailable for close")
            reply = call("busctl", "--user", "call", recording["owner"],
                         "/org/gnome/Orca1/Service/SpeechPresenter", "org.gnome.Orca1.SpeechPresenter",
                         "SetLogFileForTesting", "ss", token, "", user=True)
            if reply != "b true":
                raise RuntimeError("original presenter refused close")
            original = recording["selection"]["orca"]
            actual = orca_observation()
            fields = ("pid", "start_ticks", "owner", "uid", "bus_pid", "bus_uid", "version")
            if any(actual.get(k) != original.get(k) for k in fields):
                raise RuntimeError("original presenter identity changed during close")
            if recorder_owns_file(original["pid"], recording["log_identity"]):
                raise RuntimeError("original presenter retains the original log file")
            after = orca_observation()
            if any(after.get(k) != original.get(k) for k in fields):
                raise RuntimeError("original presenter identity changed after FD close proof")
            receipt["presenter_closed"] = True
        except Exception as error:
            failure("owned_presenter_close", error)
    return receipt


def fail_speech(error, cleanup):
    diagnostic = {"exception_type": speech_error_type(error), "cleanup": cleanup}
    if isinstance(error, subprocess.CalledProcessError) and type(error.returncode) is int and -255 <= error.returncode <= 255:
        diagnostic["returncode"] = error.returncode
    print(json.dumps({"orca_speech_error": diagnostic}))
    # The original exception may contain token-bearing argv. Preserve only its
    # fixed public type/code and the failed exit, never an exception traceback.
    raise SystemExit(1) from None


def mutate_orca_setting(action):
    schema, key = "org.gnome.desktop.a11y.applications", "screen-reader-enabled"
    if action == "orca-reset":
        call("gsettings", "reset", schema, key, user=True)
        requested = None
    else:
        requested = action == "orca-on"
        call("gsettings", "set", schema, key, str(requested).lower(), user=True)
    value = call("gsettings", "get", schema, key, user=True)
    if value not in {"true", "false"} or (requested is not None and (value == "true") != requested):
        raise RuntimeError("screen reader setting readback disagrees with mutation")
    # Acknowledgment only. The host separately awaits strict owned process/bus lifecycle evidence.
    return {"requested_enabled": requested, "readback_enabled": value == "true"}


def shell_navigation_focus(kind, original_pid=None, original_ticks=None, controlled=False):
    actual = orca_observation()
    state = json.loads(STATE.read_text())
    if state["locked"] or not actual["ready"] or actual["state"] != "active":
        raise RuntimeError("public navigation requires an unlocked original genuine reader")
    executable = "roost-shell-gtk" if kind == "shell" else "gnome-disks"
    candidates = [p for p in inventory()["processes"] if p["executable"] == executable and p["uid"] == OWNER.pw_uid]
    if kind == "disks" or controlled:
        candidates = [p for p in candidates if p["pid"] == original_pid and p["start_ticks"] == original_ticks]
    if len(candidates) != 1:
        raise RuntimeError("one original navigation application principal is required")
    process = candidates[0]
    diagnostic_args = ("controlled-overview",) if controlled else ()
    receipt = json.loads(call("/usr/libexec/roost-vm-shell-focus", str(process["pid"]), str(process["start_ticks"]),
                              executable, actual["display"][0], *diagnostic_args, user=True))
    after = orca_observation()
    if any(actual[k] != after.get(k) for k in ("pid", "uid", "start_ticks", "owner", "bus_pid", "bus_uid", "version")) or not after["ready"]:
        raise RuntimeError("original genuine reader changed during navigation observation")
    state = json.loads(STATE.read_text())
    if state["locked"]:
        raise RuntimeError("public navigation observation crossed lock")
    result = {"orca": after, "focus": receipt, "overview_open": state["overview_open"], "focused_window": state["focused"]}
    if kind == "disks":
        desktop = pathlib.Path("/usr/share/applications/org.gnome.DiskUtility.desktop")
        info = desktop.lstat()
        metadata = read_evidence(desktop, file_identity(info), 65536)
        if info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022 or len(metadata) > 65536:
            raise RuntimeError("installed Disks desktop entry lacks bounded distribution authority")
        commands = [line[5:] for line in metadata.decode().splitlines() if line.startswith("Exec=")]
        if not commands or pathlib.Path(shlex.split(commands[0])[0]).name != "gnome-disks":
            raise RuntimeError("installed Disks desktop entry does not launch the actual frontend")
        exe = os.readlink(f"/proc/{process['pid']}/exe")
        package = call("pacman", "-Qqo", exe)
        if package != "gnome-disk-utility" or call("pacman", "-Qqo", str(desktop)) != package:
            raise RuntimeError("actual Disks frontend/desktop entry lack matching distribution package ownership")
        window = next((w for w in state["windows"] if w["id"] == state["focused"]), None)
        active = any(n["label"] == "Disks" and n["role"] == "frame" and n["active"] for n in receipt["public_controls"])
        result["launch_focus_ready"] = (window is not None and window["app_id"] == "org.gnome.DiskUtility"
                                         and active and not state["overview_open"])
        remaining = [p for p in inventory()["processes"] if p == process]
        if len(remaining) != 1 or json.loads(STATE.read_text())["locked"]:
            raise RuntimeError("original Disks frontend changed or locked during package observation")
        result["desktop"] = {"path": str(desktop), "uid": info.st_uid, "sha256": hashlib.sha256(metadata).hexdigest(), "package": package}
    return result


def speech_capture_profile(name):
    # Fixed CI-only real recorder profiles, never production reader settings.
    if type(name) is not str or name not in {"native-command", "public-navigation"}:
        raise RuntimeError("unknown fixed speech recording profile")
    return {"name": name, "rate": 24000, "channels": 1, "sample_width": 2,
            "sample_count": 192000 if name == "public-navigation" else 96000,
            "runtime_max_sec": 12 if name == "public-navigation" else 8}


def recording_profile(recording):
    profile = recording["profile"]
    if (type(profile) is not dict or type(profile.get("name")) is not str
            or any(type(profile.get(key)) is not int for key in
                   ("rate", "channels", "sample_width", "sample_count", "runtime_max_sec"))
            or profile != speech_capture_profile(profile["name"])):
        raise RuntimeError("original speech recording profile changed")
    return profile


def main():
    if os.geteuid() != 0 or OWNER.pw_uid == 0:
        raise RuntimeError("probe must be root and session owner must not be root")
    action = sys.argv[1]
    if action == "inventory":
        result = inventory()
    elif action == "orca-provenance":
        actual = orca_observation()
        directory = pathlib.Path("/usr/share/roost-vm-orca51")
        documents = {p.name: p.read_text() for p in directory.iterdir() if p.is_file()}
        if sum(len(text) for text in documents.values()) > 256 * 1024:
            raise RuntimeError("package provenance exceeds bound")
        runtime = json.loads(call("python", "-c",
            "import json,gi; gi.require_version('Atspi','2.0'); from gi.repository import Atspi; "
            "import gi.overrides.Atspi as override; print(json.dumps({'version': list(Atspi.get_version()), "
            "'override': Atspi.Accessible.__hash__.__module__, 'override_file': override.__file__}))", user=True))
        library_version = shlex.split(call("busctl", "--user", "call", actual["owner"],
            "/org/gnome/Orca1/Service", "org.gnome.Orca1.Service", "GetAtspiVersion", user=True))
        override = pathlib.Path(runtime["override_file"])
        result = {"orca": actual, "documents": documents, "runtime": runtime,
                  "loaded_atspi_version": library_version,
                  "override_package": call("pacman", "-Qqo", str(override)),
                  "override_sha256": hashlib.sha256(override.read_bytes()).hexdigest(),
                  "installed": call("pacman", "-Qi", "orca", "at-spi2-core")}
        result["qualified"] = (actual["ready"] and actual["version"][1].startswith("51.0")
            and actual["bus_name"] == "org.gnome.Orca1.Service"
            and runtime["override"] == "gi.overrides.Atspi"
            and result["override_package"] == "at-spi2-core"
            and tuple(runtime["version"]) >= (2, 58, 6)
            and library_version == ["s", ".".join(str(part) for part in runtime["version"])]
            and "8bc3e44bc5b7b66ec7e0cc5c82695c0075661922745d25724f5fc84a25602108" in documents["source-sha256.txt"]
            and actual["launcher_sha256"] in documents["launcher-sha256.txt"])
    elif action == "orca-rapid-toggle":
        samples = []
        for enabled in [True, False] * 10:
            call("gsettings", "set", "org.gnome.desktop.a11y.applications",
                 "screen-reader-enabled", str(enabled).lower(), user=True)
            time.sleep(0.02)
            state = json.loads(STATE.read_text())
            samples.append({"elapsed": time.monotonic(), "frames": state["rendered_frames"],
                            "pid": state.get("screen_reader_pid"), "state": state.get("screen_reader_state")})
        result = {"samples": samples}
    elif action == "orca-keyboard-negative":
        before = orca_observation()
        owner = shlex.split(call("busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                                 "org.freedesktop.DBus", "GetNameOwner", "s", "org.freedesktop.a11y.Manager", user=True))
        if len(owner) != 2 or owner[0] != "s":
            raise RuntimeError("native manager has no original bus owner")
        pid = call("busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                   "org.freedesktop.DBus", "GetConnectionUnixProcessID", "s", owner[1], user=True).split()
        compositor = owned_compositor(inventory()["processes"])
        if pid != ["u", str(compositor["pid"])]:
            raise RuntimeError("native keyboard manager is not the actual compositor")
        # GIO preserves the remote error name; busctl's translated human error
        # message is not a stable security assertion. This is a genuine separate
        # same-user process calling the original actual compositor connection.
        actor = json.loads(call("python3", "-c", '''
import json,os,sys
from gi.repository import Gio,GLib
result = {"caller_pid": os.getpid(), "caller_uid": os.getuid(), "accepted": False}
bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
try:
    bus.call_sync(sys.argv[1], "/org/freedesktop/a11y/Manager",
                  "org.freedesktop.a11y.KeyboardMonitor", "WatchKeyboard",
                  None, None, Gio.DBusCallFlags.NONE, 10000, None)
    result["accepted"] = True
except GLib.Error as error:
    result.update(error_name=Gio.DBusError.get_remote_error(error),
                  error_domain=error.domain, error_code=error.code,
                  access_denied=error.matches(Gio.dbus_error_quark(), Gio.DBusError.ACCESS_DENIED))
print(json.dumps(result))
''', owner[1], user=True))
        after = orca_observation()
        result = {"denied": (not actor["accepted"] and actor.get("access_denied") is True
                             and actor.get("error_name") == "org.freedesktop.DBus.Error.AccessDenied"
                             and actor["caller_uid"] == OWNER.pw_uid
                             and actor["caller_pid"] != before["pid"]),
                  "actor": actor,
                  "manager_pid": compositor["pid"], "before": before["keyboard"], "after": after["keyboard"]}
    elif action in {"orca-shell-focus", "orca-disks-focus"}:
        if action == "orca-shell-focus" and len(sys.argv) != 2:
            if len(sys.argv) != 5 or sys.argv[2] != "controlled-overview":
                raise ValueError("fixed controlled overview principal required")
            result = shell_navigation_focus("shell", int(sys.argv[3]), int(sys.argv[4]), controlled=True)
        else:
            result = (shell_navigation_focus("shell") if action == "orca-shell-focus"
                      else shell_navigation_focus("disks", int(sys.argv[2]), int(sys.argv[3])))
    elif action == "orca-speech-start":
        if len(sys.argv) not in (2, 3):
            raise RuntimeError("fixed speech recording profile argument required")
        profile = speech_capture_profile(sys.argv[2] if len(sys.argv) == 3 else "native-command")
        actual = orca_observation()
        if not actual["ready"] or actual["state"] != "active":
            raise RuntimeError("genuine owned Orca is required for speech capture")
        selection = speech_selection(actual)
        graph = speech_graph()
        synth = [o for o in graph["objects"] if o["type"] == "PipeWire:Interface:Node"
                 and o["props"].get("node.name") == "speech-dispatcher-espeak-ng"
                 and o["props"].get("media.class") == "Stream/Output/Audio"]
        if len(synth) != 1:
            raise RuntimeError("one actual real espeak-ng stream is required")
        speech_process = process_receipt(synth[0]["props"]["application.process.id"])
        if speech_process["package"] != "speech-dispatcher":
            raise RuntimeError("real speech process is not distribution package owned")
        token = pathlib.Path(RUNTIME, "roost-vm-orca-token").read_text()
        capture = uuid.uuid4().hex
        log = str(pathlib.Path(RUNTIME, "roost-vm-orca-speech-" + capture + ".jsonl"))
        pcm = str(pathlib.Path(RUNTIME, "roost-vm-orca-speech-" + capture + ".pcm"))
        pcm_identity = None
        log_identity = None
        unit = "roost-vm-orca-pcm-" + uuid.uuid4().hex
        presenter_started = False
        unit_started = False
        recorder = None
        reservation = None
        try:
            reservation = reserve_recording()
            pcm_identity = create_evidence(pcm, OWNER.pw_uid, OWNER.pw_gid)
            log_identity = create_evidence(log, OWNER.pw_uid, OWNER.pw_gid)
            presenter_started = True
            reply = call("busctl", "--user", "call", actual["owner"],
                         "/org/gnome/Orca1/Service/SpeechPresenter", "org.gnome.Orca1.SpeechPresenter",
                         "SetLogFileForTesting", "ss", token, log, user=True)
            if reply != "b true":
                raise RuntimeError("upstream presenter refused recording")
            raw = call("bash", "-o", "pipefail", "-c", "pw-dump | head -c 2097153", user=True)
            if len(raw.encode()) > 2 * 1024 * 1024:
                raise RuntimeError("speech metadata exceeds evidence bound")
            objects = json.loads(raw)
            defaults = [entry for obj in objects if obj.get("props", {}).get("metadata.name") == "default"
                        for entry in obj.get("metadata", []) if entry.get("subject") == 0
                        and entry.get("key") == "default.audio.sink"]
            if len(defaults) != 1:
                raise RuntimeError("one genuine default audio sink is required")
            value = defaults[0]["value"]
            target = (json.loads(value) if isinstance(value, str) else value)["name"]
            sinks = [o for o in graph["objects"] if o["type"] == "PipeWire:Interface:Node"
                     and o["props"].get("node.name") == target and o["props"].get("media.class") == "Audio/Sink"]
            if len(sinks) != 1:
                raise RuntimeError("actual real espeak stream was not linked to the selected recording sink")
            require_sink_graph(graph, sinks[0], synth[0])
            started = time.monotonic()
            unit_started = True
            call("systemd-run", "--user", "--quiet", "--collect", "--unit=" + unit,
                 "--service-type=exec", "--property=RuntimeMaxSec=" + str(profile["runtime_max_sec"]) + "s", "--property=UMask=0077", "/usr/bin/pw-record",
                 "--target=" + target, "--properties=" + json.dumps({"stream.capture.sink": True, "node.name": unit}),
                 "--raw", "--format=s16", "--rate=24000", "--channels=1", "--sample-count=" + str(profile["sample_count"]), pcm, user=True)
            main_pid = int(call("systemctl", "--user", "show", unit, "--property=MainPID", "--value", user=True))
            recorder = process_receipt(main_pid)
            if pathlib.Path(recorder["exe"]).name not in {"pw-cat", "pw-record"}:
                raise RuntimeError("owned recording unit did not launch the actual recorder")
            deadline = time.monotonic() + 1
            while True:
                graph_ready = speech_graph()
                nodes = [o for o in graph_ready["objects"] if o["type"] == "PipeWire:Interface:Node"
                         and o["props"].get("node.name") == unit]
                if len(nodes) == 1 and any(o["type"] == "PipeWire:Interface:Link"
                                          and o["info"].get("input-node-id") == nodes[0]["id"]
                                          and o["info"].get("output-node-id") == sinks[0]["id"]
                                          for o in graph_ready["objects"]):
                    break
                if time.monotonic() >= deadline:
                    raise RuntimeError("owned recorder did not establish actual graph input")
                time.sleep(0.05)
            require_sink_graph(graph_ready, sinks[0], synth[0], nodes[0])
            if not recorder_owns_file(main_pid, pcm_identity):
                raise RuntimeError("actual recorder did not retain the original PCM file")
            recorder_after = process_receipt(main_pid)
            current_main = int(call("systemctl", "--user", "show", unit, "--property=MainPID", "--value", user=True))
            if current_main != main_pid or any(recorder_after[key] != recorder[key]
                    for key in ("pid", "uid", "start_ticks", "exe")):
                raise RuntimeError("original recording process changed during file readiness")
            if file_identity(os.lstat(log)) != log_identity:
                raise RuntimeError("original presenter file identity changed")
            recording = {"profile": profile, "capture_state": "ready", "unit": unit, "pcm": pcm, "log": log, "owner": actual["owner"], "sink": target,
                         "pcm_identity": pcm_identity, "log_identity": log_identity, "sink_node": sinks[0],
                         "selection": selection, "graph_before": graph, "graph_ready": graph_ready,
                         "speech_process": speech_process, "synth_node": synth[0], "recorder": recorder,
                         "node_process_association": "unverified PipeWire property hint; proc identity is authoritative only for the process",
                         "started_monotonic": started, "ready_monotonic": time.monotonic()}
            save_recording(recording, reservation)
        except Exception as error:
            cleanup = cleanup_speech({"unit": unit, "owner": actual["owner"], "selection": selection,
                                      "log_identity": log_identity, "recorder": recorder}, token, unit_started, presenter_started)
            if reservation is not None:
                try:
                    if cleanup["unit_departed"] and cleanup["presenter_closed"]:
                        if file_identity(RECORDING_STATE.lstat()) != reservation[1]:
                            raise RuntimeError("original recording reservation changed during cleanup")
                        RECORDING_STATE.unlink()
                except Exception as release_error:
                    cleanup["errors"].append({"stage": "owned_state_release", "exception_type": speech_error_type(release_error)})
            fail_speech(error, cleanup)
        finally:
            if reservation is not None:
                os.close(reservation[0])
        result = {"orca": actual, "sink": target, "receipt": recording,
                  "recording": "fresh mixed-sink PCM; selected real espeak-ng, exclusive PCM origin unproven"}
    elif action == "orca-speech-trigger":
        result = {"selection": speech_selection(orca_observation()), "guest_monotonic": time.monotonic()}
    elif action == "orca-speech-end":
        recording = load_recording()
        if not recording["unit"].startswith("roost-vm-orca-pcm-"):
            raise RuntimeError("invalid recording unit")
        token = None
        primary = None
        try:
            token = pathlib.Path(RUNTIME, "roost-vm-orca-token").read_text()
            selection = speech_selection(orca_observation())
            graph_end = speech_graph()
            require_sink_graph(graph_end, recording["sink_node"], recording["synth_node"])
            ended = time.monotonic()
        except Exception as error:
            primary = error
        finally:
            cleanup = cleanup_speech(recording, token)
        if primary is not None or cleanup["errors"]:
            fail_speech(primary or RuntimeError("speech recording cleanup failed"), cleanup)
        try:
            profile = recording_profile(recording)
            pcm = read_evidence(recording["pcm"], recording["pcm_identity"],
                                profile["sample_count"] * profile["sample_width"])
            log = read_evidence(recording["log"], recording["log_identity"], 64 * 1024).decode("utf-8")
            if file_identity(RECORDING_STATE.lstat()) != recording["state_identity"]:
                raise RuntimeError("original root recording state changed before completion")
            RECORDING_STATE.unlink()
            streams = [{k: p[k] for k in ("node.name", "application.process.binary", "application.process.id") if k in p}
                       for obj in graph_end["objects"] if (p := obj["props"]).get("media.class") == "Stream/Output/Audio"]
            result = {"pcm": base64.b64encode(pcm).decode(), "speech": [json.loads(line) for line in log.splitlines()],
                      "sink": recording["sink"], "streams": streams, "orca": orca_observation(),
                      "receipt": {"profile": profile, "selection": selection, "graph_end": graph_end, "ended_monotonic": ended,
                                  "pcm_identity": recording["pcm_identity"], "log_identity": recording["log_identity"],
                                  "state_identity": recording["state_identity"],
                                  "pcm_bytes": len(pcm), "pcm_sha256": hashlib.sha256(pcm).hexdigest(),
                                  "cleanup": cleanup, "capture_route_observed": "readiness only; continuous route not proven",
                                  "mixed_sink": True, "exclusive_pcm": False}}
        except Exception as error:
            fail_speech(error, cleanup)
    elif action == "orca-departed":
        pid, ticks = int(sys.argv[2]), int(sys.argv[3])
        try:
            process = pathlib.Path(f"/proc/{pid}")
            alive = (process.stat().st_uid == OWNER.pw_uid
                     and int((process / "stat").read_text().rsplit(")", 1)[1].split()[19]) == ticks)
        except (FileNotFoundError, ProcessLookupError):
            alive = False
        result = {"original_alive": alive, **orca_observation()}
    elif action == "orca-read":
        try:
            result = orca_observation()
        except Exception as error:
            print(json.dumps({"orca_read_error": orca_read_error(error)}))
            raise SystemExit(1) from None
    elif action in ("orca-off", "orca-on", "orca-reset"):
        result = mutate_orca_setting(action)
    elif action in ("audio-amplification-off", "audio-amplification-on",
                    "audio-amplification-high", "audio-amplification-read",
                    "audio-amplification-reset"):
        schema, key = "org.gnome.desktop.sound", "allow-volume-above-100-percent"
        if action != "audio-amplification-read":
            if action == "audio-amplification-reset":
                call("gsettings", "reset", schema, key, user=True)
                level = "0.40"
            else:
                enabled = action != "audio-amplification-off"
                call("gsettings", "set", schema, key, str(enabled).lower(), user=True)
                level = "1.50" if action == "audio-amplification-high" else "0.98"
            call("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", level, user=True)
            call("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0", user=True)
        objects = json.loads(call("pw-dump", user=True))
        defaults = [entry for obj in objects if obj.get("props", {}).get("metadata.name") == "default"
                    for entry in obj.get("metadata", []) if entry.get("subject") == 0
                    and entry.get("key") == "default.audio.sink"]
        if len(defaults) != 1:
            raise RuntimeError("expected one real default audio sink")
        value = defaults[0]["value"]
        name = (json.loads(value) if isinstance(value, str) else value)["name"]
        sinks = [obj for obj in objects if obj.get("info", {}).get("props", {}).get("node.name") == name
                 and obj.get("info", {}).get("props", {}).get("media.class") == "Audio/Sink"]
        if len(sinks) != 1:
            raise RuntimeError("default audio sink is missing or ambiguous")
        props = sinks[0]["info"]["params"]["Props"][0]
        result = {"sink_id": sinks[0]["id"], "sink_name": name,
                  "percent": float(props["channelVolumes"][0]) ** (1 / 3) * 100,
                  "muted": bool(props.get("mute", False)),
                  "amplified": call("gsettings", "get", schema, key, user=True) == "true"}
    elif action == "suspend":
        # Queue real logind suspend, so QGA can reply before the guest sleeps.
        policy = {name: pathlib.Path(f"/sys/power/{name}").read_text().strip()
                  for name in ("state", "mem_sleep")}
        call("systemd-run", "--unit=roost-vm-suspend", "--collect", "--on-active=1s",
             "--timer-property=AccuracySec=100ms", "busctl", "--system", "call",
             "org.freedesktop.login1", "/org/freedesktop/login1",
             "org.freedesktop.login1.Manager", "Suspend", "b", "false")
        result = {"scheduled": "logind Manager.Suspend(false)", "power_policy": policy}
    elif action == "vt":
        target = int(sys.argv[2])
        if not 1 <= target <= 12:
            raise ValueError("VT outside test range")
        call("chvt", str(target))
        result = {"active_vt": pathlib.Path("/sys/class/tty/tty0/active").read_text().strip()}
    elif action == "diagnostics":
        # Names and kernel wait sites only: no argv, environment or input data.
        processes = []
        for path in pathlib.Path("/proc").iterdir():
            if not path.name.isdigit():
                continue
            try:
                stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
                name = (path / "comm").read_text().strip()
                if name in {"chvt", "python3", "roost-composito", "systemd-logind", "qemu-ga"}:
                    processes.append({"pid": int(path.name), "name": name, "state": stat[0],
                                      "wait_site": (path / "wchan").read_text().strip()})
            except (FileNotFoundError, PermissionError, ProcessLookupError):
                continue
        result = {"active_vt": pathlib.Path("/sys/class/tty/tty0/active").read_text().strip(),
                  "kernel_release": os.uname().release,
                  "gpu_pci_caps": gpu_pci_caps(),
                  "gpu_drivers": {path.name: (path / "device/driver").resolve().name
                                  for path in pathlib.Path("/sys/class/drm").glob("card[0-9]*")
                                  if (path / "device/driver").exists()},
                  "kernel_restore": call("journalctl", "--boot", "--dmesg", "--no-pager",
                                         "-n", "120", "-o", "short-monotonic", "--grep",
                                         "(virtio|drm|PM:|suspend|resume)", check=False)[-32768:],
                  "processes": sorted(processes, key=lambda item: item["pid"])}
    elif action == "lock":
        call("gdbus", "call", "--session", "--dest", "org.gnome.ScreenSaver",
             "--object-path", "/org/gnome/ScreenSaver", "--method", "org.gnome.ScreenSaver.Lock",
             user=True)
        result = {"requested": "lock"}
    elif action == "delay-unlock":
        service = pathlib.Path("/etc/pam.d/roost-lock")
        original = service.read_text()
        service.rename(service.with_suffix(".vm-backup"))
        # Keep the real PAM result below its 10-second authentication deadline,
        # while leaving time for the observed pending child to cross sleep.
        # Neither credentials nor outcomes are faked.
        service.write_text("auth required pam_exec.so /usr/bin/sleep 8\n" + original)
        result = {"pam": "real stack delayed"}
    elif action == "delayed-auth-state":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        waiting = False
        for path in pathlib.Path("/proc").iterdir():
            if not path.name.isdigit():
                continue
            try:
                stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
                if (path.stat().st_uid == OWNER.pw_uid and (path / "comm").read_text().strip() == "sleep"
                        and int(stat[1]) == compositor["pid"]):
                    waiting = True
            except (FileNotFoundError, PermissionError, ProcessLookupError):
                continue
        result = {"real_pam_delay_running": waiting}
    elif action == "deny-unlock":
        # Real PAM failure, not a substitute authenticator or fake daemon.
        service = pathlib.Path("/etc/pam.d/roost-lock")
        service.rename(service.with_suffix(".vm-backup"))
        service.write_text("auth required pam_deny.so\naccount required pam_deny.so\n")
        result = {"pam": "deny"}
    elif action == "restore-unlock":
        pathlib.Path("/etc/pam.d/roost-lock.vm-backup").rename("/etc/pam.d/roost-lock")
        result = {"pam": "restored"}
    elif action == "kill-shell":
        processes = inventory()["processes"]
        for process in processes:
            if process["executable"] == "roost-shell-gtk":
                os.kill(process["pid"], 9)
        result = {"killed": "shell"}
    elif action == "stop-portal":
        call("systemctl", "--user", "stop", "xdg-desktop-portal.service",
             "xdg-desktop-portal-gnome.service", user=True)
        result = {"stopped": "portal"}
    elif action == "capture-input":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        # The actual DRM session uses this socket, as runtime::default_for_pid does.
        display = f"WAYLAND_DISPLAY=roost-nested-{compositor['pid']}"
        def attempt(*args):
            try:
                result = subprocess.run(["runuser", "-u", OWNER.pw_name, "--", "env",
                                         f"XDG_RUNTIME_DIR={RUNTIME}", display, "timeout", "-s", "KILL", "5", *args],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                        timeout=7, check=False)
                return result.returncode
            except subprocess.TimeoutExpired:
                return -1
        result = {"connect_exit": attempt("wayland-info"),
                  "capture_exit": attempt("grim", "/tmp/roost-vm-forbidden-capture.png"),
                  "input_exit": attempt("wtype", "untrusted-input"),
                  "capture_file": pathlib.Path("/tmp/roost-vm-forbidden-capture.png").exists()}
    elif action == "start-input-probe":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        subprocess.Popen(["runuser", "-u", OWNER.pw_name, "--", "env",
                          f"XDG_RUNTIME_DIR={RUNTIME}",
                          f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus",
                          f"WAYLAND_DISPLAY=roost-nested-{compositor['pid']}",
                          "/usr/libexec/roost-vm-input"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        result = {"started": "count-only GTK input probe"}
    elif action == "constraint-log":
        with CONSTRAINT_LOG.open("rb") as stream:
            raw = stream.read(8193)
        result = {"stderr": raw[:8192].decode(errors="replace"), "truncated": len(raw) > 8192}
    elif action.startswith("constraint-"):
        result = constraint_client(action.removeprefix("constraint-"))
    elif action == "hot-corners":
        value = sys.argv[2]
        if value not in ("true", "false"):
            raise ValueError("hot corners must be true or false")
        call("gsettings", "set", "org.gnome.desktop.interface", "enable-hot-corners", value, user=True)
        result = {"stored": call("gsettings", "get", "org.gnome.desktop.interface", "enable-hot-corners", user=True) == value}
    elif action == "mouse-handedness":
        value = sys.argv[2]
        if value not in ("true", "false"):
            raise ValueError("mouse handedness must be true or false")
        call("gsettings", "set", "org.gnome.desktop.peripherals.mouse", "left-handed", value, user=True)
        result = {"stored": call("gsettings", "get", "org.gnome.desktop.peripherals.mouse", "left-handed", user=True) == value}
    elif action in ("input-count", "input-ready", "input-buttons"):
        result = json.loads(pathlib.Path(RUNTIME, "roost-vm-input.json").read_text())
        if pathlib.Path(f"/proc/{result['pid']}").stat().st_uid != OWNER.pw_uid:
            raise RuntimeError("input probe has the wrong owner")
        if action == "input-count":
            result = {key: result[key] for key in ("pid", "count")}
        elif action == "input-buttons":
            result = {key: result[key] for key in
                      ("pid", "buttons", "button_releases", "event_count", "motions", "gtk_version")}
    elif action == "logout":
        call("loginctl", "terminate-session", inventory()["session"]["Id"])
        result = {"requested": "terminate session"}
    elif action == "greeter":
        result = {"greetd_active": call("systemctl", "is-active", "greetd.service") == "active",
                  "greeter_pids": call("pgrep", "-x", "gtkgreet", check=False).splitlines(),
                  "compositor_pids": call("pgrep", "-u", str(OWNER.pw_uid), "-x",
                                          "roost-composito", check=False).splitlines()}
    else:
        raise ValueError("unknown lifecycle action")
    print(json.dumps(result))


if __name__ == "__main__":
    main()
