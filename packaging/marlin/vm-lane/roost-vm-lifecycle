#!/usr/bin/env python3
"""CI-only root probes through QGA. Never print credentials or process argv."""
import json
import os
import pathlib
import pwd
import subprocess
import sys

OWNER = pwd.getpwnam("roost-test")
RUNTIME = f"/run/user/{OWNER.pw_uid}"
STATE = pathlib.Path(RUNTIME, "roost-vm-state.json")


def call(*args, user=False, check=True):
    command = list(args)
    if user:
        command = ["runuser", "-u", OWNER.pw_name, "--", "env",
                   f"XDG_RUNTIME_DIR={RUNTIME}",
                   f"DBUS_SESSION_BUS_ADDRESS=unix:path={RUNTIME}/bus", *command]
    return subprocess.run(command, capture_output=True, text=True,
                          timeout=15, check=check).stdout.strip()


def inventory():
    state = json.loads(STATE.read_text())
    processes = []
    for path in pathlib.Path("/proc").iterdir():
        if not path.name.isdigit():
            continue
        try:
            uid = path.stat().st_uid
            executable = pathlib.Path(os.readlink(path / "exe")).name
            if uid != OWNER.pw_uid or executable not in {
                "roost-compositor", "roost-shell-gtk", "gnome-disks",
                "gnome-system-monitor", "nautilus",
            }:
                continue
            stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
            processes.append({"pid": int(path.name), "uid": uid,
                              "executable": executable, "start_ticks": int(stat[19])})
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    sessions = [line.split() for line in call("loginctl", "list-sessions",
                                             "--no-legend", "--no-pager").splitlines()]
    owned = [line[0] for line in sessions if len(line) > 1 and line[1] == str(OWNER.pw_uid)]
    if len(owned) != 1:
        raise RuntimeError("expected exactly one session for the test owner")
    session = call("loginctl", "show-session", owned[0], "--property=Id",
                   "--property=VTNr", "--property=User", "--property=Type", "--property=Service")
    return {"probe_uid": os.geteuid(), "session_uid": OWNER.pw_uid,
            "session": dict(line.split("=", 1) for line in session.splitlines()),
            "state": {k: state[k] for k in ("locked", "windows", "focused", "active_workspace")},
            "processes": sorted(processes, key=lambda item: item["pid"])}


def main():
    if os.geteuid() != 0 or OWNER.pw_uid == 0:
        raise RuntimeError("probe must be root and session owner must not be root")
    action = sys.argv[1]
    if action == "inventory":
        result = inventory()
    elif action == "suspend":
        # Queue real logind suspend, so QGA can reply before the guest sleeps.
        call("systemd-run", "--unit=roost-vm-suspend", "--collect", "--on-active=1s",
             "loginctl", "suspend")
        result = {"scheduled": "logind suspend"}
    elif action == "vt":
        target = int(sys.argv[2])
        if not 1 <= target <= 12:
            raise ValueError("VT outside test range")
        call("chvt", str(target))
        result = {"active_vt": pathlib.Path("/sys/class/tty/tty0/active").read_text().strip()}
    elif action == "lock":
        call("gdbus", "call", "--session", "--dest", "org.gnome.ScreenSaver",
             "--object-path", "/org/gnome/ScreenSaver", "--method", "org.gnome.ScreenSaver.Lock",
             user=True)
        result = {"requested": "lock"}
    elif action == "deny-unlock":
        # Real PAM failure, not a substitute authenticator or fake daemon.
        service = pathlib.Path("/etc/pam.d/roost-lock")
        service.rename(service.with_suffix(".vm-backup"))
        service.write_text("auth required pam_deny.so\naccount required pam_deny.so\n")
        result = {"pam": "deny"}
    elif action == "restore-unlock":
        pathlib.Path("/etc/pam.d/roost-lock.vm-backup").rename("/etc/pam.d/roost-lock")
        result = {"pam": "restored"}
    elif action == "kill-shell":
        processes = inventory()["processes"]
        for process in processes:
            if process["executable"] == "roost-shell-gtk":
                os.kill(process["pid"], 9)
        result = {"killed": "shell"}
    elif action == "stop-portal":
        call("systemctl", "--user", "stop", "xdg-desktop-portal.service",
             "xdg-desktop-portal-gnome.service", user=True)
        result = {"stopped": "portal"}
    elif action == "capture-input":
        compositor = next(p for p in inventory()["processes"] if p["executable"] == "roost-compositor")
        # The actual DRM session uses this socket, as runtime::default_for_pid does.
        display = f"WAYLAND_DISPLAY=roost-nested-{compositor['pid']}"
        def attempt(*args):
            try:
                result = subprocess.run(["runuser", "-u", OWNER.pw_name, "--", "env",
                                         f"XDG_RUNTIME_DIR={RUNTIME}", display, "timeout", "-s", "KILL", "5", *args],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                        timeout=7, check=False)
                return result.returncode
            except subprocess.TimeoutExpired:
                return -1
        result = {"connect_exit": attempt("wayland-info"),
                  "capture_exit": attempt("grim", "/tmp/roost-vm-forbidden-capture.png"),
                  "input_exit": attempt("wtype", "untrusted-input"),
                  "capture_file": pathlib.Path("/tmp/roost-vm-forbidden-capture.png").exists()}
    elif action == "logout":
        call("loginctl", "terminate-session", inventory()["session"]["Id"])
        result = {"requested": "terminate session"}
    elif action == "greeter":
        result = {"greetd_active": call("systemctl", "is-active", "greetd.service") == "active",
                  "greeter_pids": call("pgrep", "-x", "gtkgreet", check=False).splitlines(),
                  "compositor_pids": call("pgrep", "-u", str(OWNER.pw_uid), "-x",
                                          "roost-composito", check=False).splitlines()}
    else:
        raise ValueError("unknown lifecycle action")
    print(json.dumps(result))


if __name__ == "__main__":
    main()
