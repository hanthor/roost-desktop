# Sourced by greetd for the CI test user. The selected tuna-session command
# and all shipped binaries remain unchanged. Arch /bin/sh is verified Bash.
export XDG_SESSION_TYPE=wayland
export TUNA_COMPOSITOR_STATE="$XDG_RUNTIME_DIR/tuna-vm-state.json"
export TUNA_LOCK_TRACE=1  # Safe submitted/result milestones, never input values.
# Preserve greetd's selected command, but capture its actual output in the
# journal instead of losing it on the VT. No input or credentials are logged.
exec > >(systemd-cat --identifier=tuna-vm-session) 2>&1
