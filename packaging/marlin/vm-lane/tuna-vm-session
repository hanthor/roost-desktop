#!/bin/bash
set -eu
export XDG_SESSION_TYPE=wayland
# CI-only anonymous overview action-to-scanout trace, capped at 64 actions.
export TUNA_PERF_TRACE=1
export TUNA_COMPOSITOR_STATE="$XDG_RUNTIME_DIR/tuna-vm-state.json"
# greetd attaches session output to its VT. Route only this CI fixture's
# output to journald, whose existing fixture forwards it to the serial port.
exec systemd-cat --identifier=tuna-vm-session /usr/bin/tuna-session
