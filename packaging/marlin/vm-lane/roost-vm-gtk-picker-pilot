        if len(matches)!=1 or provider is None or app_count!=1:raise RuntimeError('original accessible fixture ambiguous')
        nodes,_count=files.walk_tree(matches[0],call,pyatspi.STATE_SHOWING,provider['owner'])
        if files.query_connection(connection,'GetConnectionUnixProcessID',provider['owner'])!=principal['pid'] or files.process(principal['pid'],EXE if principal is value['caller'] else '/usr/bin/nautilus')!=dict((k,principal[k]) for k in actual):raise RuntimeError('original provider changed after traversal')
