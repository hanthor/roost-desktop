    expected=[os.fsencode(str(Path(EXE).resolve())),os.fsencode(str(HERE/'roost-vm-gtk-picker-pilot')),b'client',os.fsencode(value['fixture'])]
    actual=files.bounded(Path(f"/proc/{original['pid']}/cmdline"),4096,uid=UID,proc=True).rstrip(b'\0').split(b'\0')
    # Python executable argv spelling is preserved by our original fixed launch.
    expected[0]=os.fsencode(EXE)
    if actual!=expected:raise RuntimeError('original caller command route changed')
