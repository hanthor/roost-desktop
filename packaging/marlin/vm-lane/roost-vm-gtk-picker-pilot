    desktops=env.get('XDG_CURRENT_DESKTOP','').lower().split(':')
    if not 1<=len(desktops)<=8 or desktops[0]!='roost' or any(re.fullmatch('[a-z][a-z0-9_-]{0,31}',v) is None for v in desktops):raise RuntimeError('original Roost portal desktop route')
