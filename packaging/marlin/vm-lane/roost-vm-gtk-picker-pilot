        for index in range(count):
            app=call(lambda:desktop.getChildAtIndex(index))
            if app is None:continue
            owner=call(lambda:app.app.bus_name)
            pid=files.query_connection(connection,'GetConnectionUnixProcessID',owner)
            if pid!=principal['pid']:continue
            app_count+=1
            actual=files.process(pid,EXE if principal is value['caller'] else '/usr/bin/nautilus')
            if any(actual[k]!=principal[k] for k in actual) or files.query_connection(connection,'GetConnectionUnixUser',owner)!=UID or files.query_connection(connection,'GetNameOwner',owner)!=owner:raise RuntimeError('original accessible provider changed')
