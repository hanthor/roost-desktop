    try:
        if (os.fstat(fd).st_dev,os.fstat(fd).st_ino)!=(info.st_dev,info.st_ino):raise RuntimeError('original directory changed on open')
        with os.scandir(fd) as entries:
            names=[]
            for entry in entries:
                if len(names)>=2:raise RuntimeError('unexpected controlled fixture member count')
                names.append(entry.name)
        if names!=[policy.SEED]:raise RuntimeError('unexpected controlled fixture members')
        seed=directory/policy.SEED;row=seed.lstat()
        if [row.st_dev,row.st_ino]!=value['seed_inode'] or row.st_nlink!=1 or row.st_mode&0o077:raise RuntimeError('original known seed replaced')
        if files.bounded(seed,len(policy.PAYLOAD),uid=UID,private=True)!=policy.PAYLOAD:raise RuntimeError('known seed bytes changed')
        if (directory.lstat().st_dev,directory.lstat().st_ino)!=(info.st_dev,info.st_ino):raise RuntimeError('original directory changed during observation')
    finally:os.close(fd)


def caller(value):
