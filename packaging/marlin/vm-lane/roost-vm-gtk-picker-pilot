def main():
    files.DEADLINE=time.monotonic()+25
    if len(sys.argv)==3 and sys.argv[1]=='client':
        files.DEADLINE=None
        return client(sys.argv[2])
    phase=sys.argv[1] if len(sys.argv)==2 else 'invalid'
    try:
        if phase not in policy.PHASES:raise ValueError('fixed native picker phase required')
        if phase=='start':result=start()
        else:
            value=context()
            while True:
                try:result=inspect(value,phase);break
                except files.ReadyLater:files.deadline();time.sleep(.1)
        policy.validate(result,phase);print(json.dumps(result,separators=(',',':')))
    except Exception as error:
        allowed={'RuntimeError','ValueError','OSError','FileNotFoundError','PermissionError','CalledProcessError','TimeoutExpired','TimeoutError','ImportError','ModuleNotFoundError'}
        print(json.dumps({'native_picker_error':{'phase':phase,'exception_type':type(error).__name__ if type(error).__name__ in allowed else 'OtherError'}}));return 1
    return 0


if __name__=='__main__':sys.exit(main())
