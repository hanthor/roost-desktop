#!/usr/bin/env bash
# Paired performance images must preserve every baseline package and its
# recorded kernel/initramfs/Mutter files. Extra candidate packages are allowed.
set -euo pipefail
baseline="${1:-/usr/share/tuna-perf-baseline-packages.txt}"
critical="${2:-/usr/share/tuna-perf-baseline-critical.sha256}"
test -s "$baseline"
test -s "$critical"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# Reject ambiguous inventories instead of letting join select a duplicate.
awk 'NF != 2 || seen[$1]++ { bad=1 } END { exit bad }' "$baseline"
LC_ALL=C sort -c "$baseline"
pacman -Q > "$work/packages-unsorted.txt"
awk 'NF != 2 || seen[$1]++ { bad=1 } END { exit bad }' "$work/packages-unsorted.txt"
LC_ALL=C sort "$work/packages-unsorted.txt" > "$work/packages.txt"
LC_ALL=C join -a 1 -e MISSING -o 1.1,1.2,2.2 "$baseline" "$work/packages.txt" > "$work/join.txt"
awk '$2 != $3 { print "changed baseline package:", $0; bad=1 } END { exit bad }' "$work/join.txt"
sha256sum -c "$critical"
