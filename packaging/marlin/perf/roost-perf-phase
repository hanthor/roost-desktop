#!/usr/bin/env python3
"""CI-only fixed guest-clock/notification probes, reached through QGA."""
import argparse
import base64
import hashlib
import json
import pwd
import os
from pathlib import Path
import signal
import stat
import re
import subprocess
import time


def notify(index):
    if not 0 <= index < 10:
        raise ValueError("notification index outside the fixed workload")
    uid = pwd.getpwnam("roost-test").pw_uid
    result = subprocess.run([
        "runuser", "-u", "roost-test", "--", "env", "-i", "PATH=/usr/bin:/bin",
        f"XDG_RUNTIME_DIR=/run/user/{uid}",
        f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
        "gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
        "--object-path", "/org/freedesktop/Notifications",
        "--method", "org.freedesktop.Notifications.Notify",
        "Roost performance fixture", "0", "dialog-information",
        f"Performance notification {index + 1}", "Fixed benchmark workload",
        "[]", "{}", "5000"], text=True, capture_output=True, timeout=15, check=True)
    match = re.fullmatch(r"\(uint32 ([0-9]+),\)\s*", result.stdout)
    if not match or int(match[1]) == 0:
        raise RuntimeError("notification service returned no valid notification ID")
    return int(match[1])


def frames():
    uid = pwd.getpwnam("roost-test").pw_uid
    marker = Path("/run/roost-perf-desktop.json")
    metadata = marker.stat()
    if (metadata.st_uid != 0 or metadata.st_mode & 0o022
            or not stat.S_ISREG(metadata.st_mode) or metadata.st_size > 4096):
        raise RuntimeError("desktop socket marker is not protected by root")
    target = json.loads(marker.read_text())
    name = target.get("socket", "")
    if target.get("uid") != uid or not re.fullmatch(r"(?:wayland-|roost-)[A-Za-z0-9_.-]+", name):
        raise RuntimeError("invalid observer desktop socket marker")
    runtime = f"/run/user/{uid}"
    metadata = (Path(runtime) / name).stat()
    if metadata.st_uid != uid or not stat.S_ISSOCK(metadata.st_mode):
        raise RuntimeError("desktop socket ownership/type changed")
    process = subprocess.Popen([
        "runuser", "-u", "roost-test", "--", "env", "-i", "PATH=/usr/bin:/bin",
        f"XDG_RUNTIME_DIR={runtime}", f"WAYLAND_DISPLAY={name}",
        "/usr/libexec/roost-frame-pacer"], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, start_new_session=True)
    try:
        output, errors = process.communicate(timeout=17)
        if process.returncode != 0 or len(output) > 128 * 1024:
            raise RuntimeError(f"native presentation probe failed: {errors[:4096]}")
        result = json.loads(output)
        result["socket"] = name
        return result
    finally:
        # Kill the owned runuser process group, including a child stuck during
        # a Wayland roundtrip. No probe process remains after the guest call.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.communicate()


def capture_writers(pid, metadata):
    """Observe original GNOME writer handles; file quietness is not a flush fence."""
    writers = []
    root = Path(f"/proc/{pid}")
    for descriptor in (root / "fd").iterdir():
        try:
            target = descriptor.stat()
            if (target.st_dev, target.st_ino) != (metadata.st_dev, metadata.st_ino):
                continue
            info = (root / "fdinfo" / descriptor.name).read_text()
        except FileNotFoundError:
            # A descriptor may close while its process remains alive.
            continue
        flags = next(int(line.split()[1], 8) for line in info.splitlines()
                     if line.startswith("flags:"))
        if flags & os.O_ACCMODE in (os.O_WRONLY, os.O_RDWR):
            writers.append({"fd": int(descriptor.name), "flags": flags})
    return sorted(writers, key=lambda row: row["fd"])


def gnome_trace(action, index):
    uid = pwd.getpwnam("roost-test").pw_uid
    if action in ("start", "stop"):
        process = subprocess.run([
            "runuser", "-u", "roost-test", "--", "env", "-i", "PATH=/usr/bin:/bin",
            f"XDG_RUNTIME_DIR=/run/user/{uid}",
            f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
            "/usr/libexec/roost-gnome-profiler", action],
            text=True, capture_output=True, timeout=12, check=True)
        provenance = dict(json.loads(process.stdout), guest_kernel=os.uname().release)
        if action == "start":
            return provenance
    path = Path(f"/run/user/{uid}/roost-perf-gnome.syscap")
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(descriptor, "rb") as stream:
        metadata = os.fstat(stream.fileno())
        if (metadata.st_uid != uid or metadata.st_mode & 0o077
                or not stat.S_ISREG(metadata.st_mode)
                or not 256 <= metadata.st_size <= 8 * 1024 * 1024):
            raise RuntimeError("invalid GNOME Sysprof capture ownership/size")
        if action == "stop":
            initial_writers = capture_writers(provenance["pid"], metadata)
            writers = initial_writers
            waiting_since = time.monotonic_ns()
            deadline = time.monotonic() + 5
            while writers and time.monotonic() < deadline:
                time.sleep(.05)
                writers = capture_writers(provenance["pid"], metadata)
            # Returning unclosed evidence preserves the complete rejected raw
            # capture on the host; only actual closure qualifies acquisition.
            closed_after = time.monotonic_ns()
            metadata = os.fstat(stream.fileno())
            raw = stream.read(8 * 1024 * 1024 + 1)
            after = os.fstat(stream.fileno())
            if (len(raw) != metadata.st_size or
                    (after.st_size, after.st_mtime_ns, after.st_ctime_ns) !=
                    (metadata.st_size, metadata.st_mtime_ns, metadata.st_ctime_ns)):
                raise RuntimeError("GNOME capture changed while reading")
            return dict(provenance, bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest(),
                        capture_writers_at_stop=initial_writers,
                        capture_writers_after_stop=writers,
                        capture_writer_close_wait_ns=closed_after - waiting_since,
                        capture_mtime_ns=after.st_mtime_ns)
        if type(index) is not int or not 0 <= index < 128:
            raise ValueError("invalid Sysprof capture chunk index")
        stream.seek(index * 65536)
        raw = stream.read(65536)
        if not raw:
            raise ValueError("Sysprof capture chunk beyond end")
        return dict(index=index, data=base64.b64encode(raw).decode("ascii"))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("clock", "notify", "frames",
                                          "gnome-trace-start", "gnome-trace-stop", "gnome-trace-read"))
    parser.add_argument("--index", type=int, default=0)
    args = parser.parse_args()
    result = {}
    if args.action == "notify":
        result["notification_id"] = notify(args.index)
    if args.action == "frames":
        result["presentation"] = frames()
    if args.action.startswith("gnome-trace-"):
        result["gnome_trace"] = gnome_trace(args.action.removeprefix("gnome-trace-"), args.index)
    result["boottime_s"] = time.clock_gettime(time.CLOCK_BOOTTIME)
    print(json.dumps(result))


if __name__ == "__main__":
    main()
