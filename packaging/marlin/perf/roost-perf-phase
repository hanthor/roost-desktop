#!/usr/bin/env python3
"""CI-only fixed guest-clock/notification probes, reached through QGA."""
import argparse
import base64
import hashlib
import json
import pwd
import os
from pathlib import Path
import signal
import stat
import re
import subprocess
import sys
from gnome_failed_capture import read_marker, write_marker, read_raw, identity, process_start, checked_file, validate_receipt
from perf_trace_diagnostics import decode, encode, Context
import time


def notify(index):
    if not 0 <= index < 10:
        raise ValueError("notification index outside the fixed workload")
    uid = pwd.getpwnam("roost-test").pw_uid
    result = subprocess.run([
        "runuser", "-u", "roost-test", "--", "env", "-i", "PATH=/usr/bin:/bin",
        f"XDG_RUNTIME_DIR=/run/user/{uid}",
        f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
        "gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
        "--object-path", "/org/freedesktop/Notifications",
        "--method", "org.freedesktop.Notifications.Notify",
        "Roost performance fixture", "0", "dialog-information",
        f"Performance notification {index + 1}", "Fixed benchmark workload",
        "[]", "{}", "5000"], text=True, capture_output=True, timeout=15, check=True)
    match = re.fullmatch(r"\(uint32 ([0-9]+),\)\s*", result.stdout)
    if not match or int(match[1]) == 0:
        raise RuntimeError("notification service returned no valid notification ID")
    return int(match[1])


def frames():
    uid = pwd.getpwnam("roost-test").pw_uid
    marker = Path("/run/roost-perf-desktop.json")
    metadata = marker.stat()
    if (metadata.st_uid != 0 or metadata.st_mode & 0o022
            or not stat.S_ISREG(metadata.st_mode) or metadata.st_size > 4096):
        raise RuntimeError("desktop socket marker is not protected by root")
    target = json.loads(marker.read_text())
    name = target.get("socket", "")
    if target.get("uid") != uid or not re.fullmatch(r"(?:wayland-|roost-)[A-Za-z0-9_.-]+", name):
        raise RuntimeError("invalid observer desktop socket marker")
    runtime = f"/run/user/{uid}"
    metadata = (Path(runtime) / name).stat()
    if metadata.st_uid != uid or not stat.S_ISSOCK(metadata.st_mode):
        raise RuntimeError("desktop socket ownership/type changed")
    process = subprocess.Popen([
        "runuser", "-u", "roost-test", "--", "env", "-i", "PATH=/usr/bin:/bin",
        f"XDG_RUNTIME_DIR={runtime}", f"WAYLAND_DISPLAY={name}",
        "/usr/libexec/roost-frame-pacer"], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, start_new_session=True)
    try:
        output, errors = process.communicate(timeout=17)
        if process.returncode != 0 or len(output) > 128 * 1024:
            raise RuntimeError(f"native presentation probe failed: {errors[:4096]}")
        result = json.loads(output)
        result["socket"] = name
        return result
    finally:
        # Kill the owned runuser process group, including a child stuck during
        # a Wayland roundtrip. No probe process remains after the guest call.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.communicate()


def capture_writers(pid, metadata):
    """Observe original GNOME writer handles; file quietness is not a flush fence."""
    writers = []
    root = Path(f"/proc/{pid}")
    with os.scandir(root / "fd") as descriptors:
        for index,entry in enumerate(descriptors):
            if index>=4096 or not entry.name.isdecimal() or len(entry.name)>10:
                raise ValueError("original capture descriptor inventory bound")
            descriptor=Path(entry.path)
            try:
                target = descriptor.stat()
                if (target.st_dev, target.st_ino) != (metadata.st_dev, metadata.st_ino):
                    continue
                with (root / "fdinfo" / descriptor.name).open() as stream:
                    info=stream.read(4097)
                if len(info)>4096:raise ValueError("original capture fdinfo bound")
            except FileNotFoundError:
                # A descriptor may close while its process remains alive.
                continue
            rows=[line for line in info.splitlines() if line.startswith("flags:")]
            if len(rows)!=1:raise ValueError("original capture fd flags refused")
            flags=int(rows[0].split()[1],8)
            if flags & os.O_ACCMODE in (os.O_WRONLY, os.O_RDWR):
                writers.append({"fd":int(descriptor.name),"flags":flags})
                if len(writers)>64:raise ValueError("original capture writer count bound")
    return sorted(writers, key=lambda row: row["fd"])


def gnome_trace(action, index):
    uid = pwd.getpwnam("roost-test").pw_uid
    if action in ("start", "stop", "failed-stop"):
        try:
            process = subprocess.run([
                "runuser", "-u", "roost-test", "--", "env", "-i", "PATH=/usr/bin:/bin",
                f"XDG_RUNTIME_DIR=/run/user/{uid}",
                f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
                "/usr/libexec/roost-gnome-profiler", action],
                text=True, capture_output=True, timeout=20 if action in ("stop","failed-stop") else 12, check=True)
        except subprocess.CalledProcessError as error:
            # Forward only the strict public receipt. Unknown/raw error output
            # is never transported, and the observed nonzero result survives.
            observed=error.returncode if type(error.returncode) is int and -255 <= error.returncode <= 255 and error.returncode!=0 else 1
            try:
                receipt=decode(error.stdout,"stop" if action=="failed-stop" else action)
            except (ValueError,TypeError,RecursionError):
                context=Context("stop" if action=="failed-stop" else action);context.stage="diagnostic-transport"
                receipt=context.failure(error)
                receipt["trace_failure"].update(payload_rejected=True,subprocess_returncode=observed)
            print(encode(receipt,"stop" if action=="failed-stop" else action).decode())
            exit_status=observed if observed>0 else 128-observed
            raise SystemExit(exit_status if 1 <= exit_status <= 255 else 1) from None
        payload=json.loads(process.stdout)
        if isinstance(payload,dict) and "trace_failure" in payload:
            raise ValueError("trace failure cannot qualify a successful subprocess")
        provenance = payload if action == "failed-stop" else dict(payload, guest_kernel=os.uname().release)
        if action == "start":
            return provenance
    path = Path(f"/run/user/{uid}/roost-perf-gnome.syscap")
    failed_receipt = Path("/run/roost-perf-gnome-failed-capture.json")
    if action == "failed-stop-read":
        if type(index) is not int or not 0 <= index < 128:
            raise ValueError("invalid failed capture chunk index")
        provenance = validate_receipt(read_marker(failed_receipt, 0))
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(descriptor, "rb") as stream:
        metadata = os.fstat(stream.fileno())
        if (metadata.st_uid != uid or metadata.st_mode & 0o077
                or not stat.S_ISREG(metadata.st_mode)
                or not 256 <= metadata.st_size <= 8 * 1024 * 1024):
            raise RuntimeError("invalid GNOME Sysprof capture ownership/size")
        if action == "failed-stop":
            if provenance.get("qualified") is not False or process_start(provenance["pid"])!=provenance["process_start"]:
                raise RuntimeError("failed capture original process refused")
            initial_writers = capture_writers(provenance["pid"], metadata)
            writers = initial_writers
            waiting_since = time.monotonic_ns()
            deadline = time.monotonic() + 5
            while writers and time.monotonic() < deadline:
                time.sleep(.05)
                if process_start(provenance["pid"])!=provenance["process_start"]:
                    raise RuntimeError("failed capture original process changed")
                writers = capture_writers(provenance["pid"],metadata)
            if writers:
                raise RuntimeError("original failed capture writer did not close")
            raw_receipt = read_raw(stream.fileno(),path,provenance["capture_identity"],uid)
            if capture_writers(provenance["pid"],os.fstat(stream.fileno())):
                raise RuntimeError("original failed capture writer reopened")
            if process_start(provenance["pid"])!=provenance["process_start"]:
                raise RuntimeError("failed capture original process changed")
            receipt = dict(provenance,**raw_receipt,
                           capture_writers_at_failure=initial_writers,
                           capture_writers_after_failure=writers,
                           capture_writer_close_wait_ns=time.monotonic_ns()-waiting_since,
                           writer_closure_observed=writers==[],qualified=False)
            validate_receipt(receipt)
            write_marker(failed_receipt,receipt,0)
            return receipt
        if action == "failed-stop-read":
            before=os.fstat(stream.fileno())
            if (provenance.get("qualified") is not False
                    or provenance.get("writer_closure_observed") is not True
                    or provenance.get("capture_writers_after_failure") != []
                    or capture_writers(provenance["pid"],before)
                    or identity(before)!=provenance["capture_identity"]
                    or before.st_size!=provenance["bytes"]
                    or before.st_mtime_ns!=provenance["capture_mtime_ns"]
                    or process_start(provenance["pid"])!=provenance["process_start"]):
                raise RuntimeError("failed capture original chunk binding refused")
            stream.seek(index*65536);raw=stream.read(65536)
            after=os.fstat(stream.fileno());named=os.stat(path,follow_symlinks=False)
            checked_file(after,uid);checked_file(named,uid)
            if (identity(after)!=identity(before) or identity(named)!=identity(before)
                    or (after.st_size,after.st_mtime_ns,after.st_ctime_ns)!=
                       (before.st_size,before.st_mtime_ns,before.st_ctime_ns)
                    or process_start(provenance["pid"])!=provenance["process_start"]
                    or capture_writers(provenance["pid"],after)
                    or len(raw)!=min(65536,provenance["bytes"]-index*65536) or not raw):
                raise RuntimeError("failed capture original chunk changed")
            return dict(index=index,data=base64.b64encode(raw).decode("ascii"),
                        capture_identity=identity(after))
        if action == "stop":
            initial_writers = capture_writers(provenance["pid"], metadata)
            writers = initial_writers
            waiting_since = time.monotonic_ns()
            deadline = time.monotonic() + 5
            while writers and time.monotonic() < deadline:
                time.sleep(.05)
                writers = capture_writers(provenance["pid"], metadata)
            # Returning unclosed evidence preserves the complete rejected raw
            # capture on the host; only actual closure qualifies acquisition.
            closed_after = time.monotonic_ns()
            metadata = os.fstat(stream.fileno())
            raw = stream.read(8 * 1024 * 1024 + 1)
            after = os.fstat(stream.fileno())
            if (len(raw) != metadata.st_size or
                    (after.st_size, after.st_mtime_ns, after.st_ctime_ns) !=
                    (metadata.st_size, metadata.st_mtime_ns, metadata.st_ctime_ns)):
                raise RuntimeError("GNOME capture changed while reading")
            return dict(provenance, bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest(),
                        capture_writers_at_stop=initial_writers,
                        capture_writers_after_stop=writers,
                        capture_writer_close_wait_ns=closed_after - waiting_since,
                        capture_mtime_ns=after.st_mtime_ns)
        if type(index) is not int or not 0 <= index < 128:
            raise ValueError("invalid Sysprof capture chunk index")
        stream.seek(index * 65536)
        raw = stream.read(65536)
        if not raw:
            raise ValueError("Sysprof capture chunk beyond end")
        return dict(index=index, data=base64.b64encode(raw).decode("ascii"))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("clock", "notify", "frames",
                                          "gnome-trace-start", "gnome-trace-stop", "gnome-trace-read",
                                          "gnome-trace-failed-stop", "gnome-trace-failed-stop-read"))
    parser.add_argument("--index", type=int, default=0)
    args = parser.parse_args()
    result = {}
    if args.action == "notify":
        result["notification_id"] = notify(args.index)
    if args.action == "frames":
        result["presentation"] = frames()
    if args.action.startswith("gnome-trace-"):
        try:
            result["gnome_trace"] = gnome_trace(args.action.removeprefix("gnome-trace-"), args.index)
        except Exception as error:
            if args.action != "gnome-trace-failed-stop":
                raise
            context=Context("stop");context.stage="failed-capture-acquisition"
            print(encode(context.failure(error),"stop").decode())
            raise SystemExit(1) from None
    result["boottime_s"] = time.clock_gettime(time.CLOCK_BOOTTIME)
    print(json.dumps(result))


if __name__ == "__main__":
    main()
