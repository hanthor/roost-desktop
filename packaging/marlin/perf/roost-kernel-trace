ROOT = Path('/run/roost-kernel-trace')
TRACE = Path('/sys/kernel/tracing')
MAX_RAW = 64 * 1024 * 1024
MAX_SECONDS = 120
EVENTS = ('drm/drm_vblank_event', 'drm/drm_vblank_event_queued',
          'drm/drm_vblank_event_delivered', 'timer/hrtimer_start',
          'timer/hrtimer_expire_entry', 'timer/hrtimer_expire_exit',
          'timer/hrtimer_cancel')


def bounded(path, limit):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        metadata = os.fstat(stream.fileno())
        if metadata.st_uid != 0 or not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError(f'unsafe observer file: {path}')
        raw = stream.read(limit + 1)
    if len(raw) > limit:
        raise RuntimeError(f'observer file exceeds bound: {path}')
    return raw


def save(path, value):
    with path.open('x') as stream:
        os.chmod(path, 0o600)
        json.dump(value, stream, indent=2)


def read_json(path):
    return json.loads(bounded(path, 2 * 1024 * 1024))


def probe_command(command):
    # FileIO append initialization seeks SEEK_END, which seq_lseek rejects.
    # Raw append preserves other observers' definitions without that seek or
    # O_TRUNC (the latter deletes every kprobe owned by the tracefs control).
    raw = (command + '\n').encode('ascii')
    if len(raw) > 4096 or '\n' in command:
        raise ValueError('invalid bounded probe command')
    fd = os.open(TRACE / 'kprobe_events',
                 os.O_WRONLY | os.O_APPEND | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        if os.write(fd, raw) != len(raw):
            raise OSError('short actual probe command write')
    finally:
        os.close(fd)


class Btf:
    """Read native little-endian BTF and split module BTF with its live base."""
    PAYLOAD = {1: (4, 0), 2: (0, 0), 3: (12, 0), 4: (0, 12),
               5: (0, 12), 6: (0, 8), 7: (0, 0), 8: (0, 0),
               9: (0, 0), 10: (0, 0), 11: (0, 0), 12: (0, 0),
               13: (0, 8), 14: (4, 0), 15: (0, 12), 16: (0, 0),
               17: (4, 0), 18: (0, 0), 19: (0, 12)}

    def __init__(self, raw, base=None):
        if len(raw) < 24:
            raise ValueError('short BTF header')
        magic, version, flags, length, type_off, type_len, str_off, str_len = struct.unpack_from('<HBBIIIII', raw)
        if magic != 0xeb9f or version != 1 or flags != 0 or length < 24:
            raise ValueError('unsupported BTF header')
        for offset, size in ((type_off, type_len), (str_off, str_len)):
            if length + offset + size > len(raw):
                raise ValueError('BTF section outside source')
        if type_off + type_len > str_off:
            raise ValueError('overlapping BTF sections')
        strings = raw[length + str_off:length + str_off + str_len]
        if not strings or strings[-1] != 0 or (base is None and strings[0] != 0):
            raise ValueError('invalid BTF strings')
        self.strings = (base.strings if base else b'') + strings
        self.types = dict(base.types) if base else {}
        self.local_ids = []
        index = max(self.types, default=0) + 1
        cursor, end = length + type_off, length + type_off + type_len
        while cursor < end:
            if cursor + 12 > end:
                raise ValueError('short BTF type')
            name_off, info, size_type = struct.unpack_from('<III', raw, cursor)
            kind, count, flag = (info >> 24) & 31, info & 65535, bool(info >> 31)
            if kind not in self.PAYLOAD or info & 0x60ff0000:
                raise ValueError('unsupported BTF type encoding')
            fixed, per = self.PAYLOAD[kind]
            payload_size = fixed + per * count
            if cursor + 12 + payload_size > end:
                raise ValueError('short BTF payload')
            payload = raw[cursor + 12:cursor + 12 + payload_size]
            self.types[index] = {'name': self.string(name_off), 'kind': kind,
                                 'vlen': count, 'flag': flag, 'size_type': size_type,
                                 'payload': payload}
            self.local_ids.append(index)
            index += 1
            cursor += 12 + payload_size
        if cursor != end:
            raise ValueError('BTF trailing type data')

    def string(self, offset):
        if offset >= len(self.strings):
            raise ValueError('BTF name outside strings')
        stop = self.strings.find(b'\0', offset)
        if stop < 0 or stop - offset > 1024:
            raise ValueError('invalid BTF name')
        return self.strings[offset:stop].decode('ascii')

    def unwrap(self, index):
        visited = set()
        while index:
            if index in visited or index not in self.types:
                raise ValueError('invalid recursive BTF type')
            visited.add(index)
            item = self.types[index]
            if item['kind'] not in (8, 9, 10, 11, 18):
                return index
            index = item['size_type']
        return 0

    def named(self, name, kind):
        ids = [index for index, item in self.types.items()
               if item['name'] == name and item['kind'] == kind]
        if len(ids) != 1:
            raise ValueError(f'BTF type is not unique: {name}')
        return ids[0]

    def member(self, index, name):
        item = self.types[self.unwrap(index)]
        if item['kind'] not in (4, 5):
            raise ValueError('BTF member parent is not struct/union')
        found = []
        for pos in range(item['vlen']):
            name_off, type_id, offset = struct.unpack_from('<III', item['payload'], pos * 12)
            if self.string(name_off) != name:
                continue
            bits = offset >> 24 if item['flag'] else 0
            offset = offset & 0xffffff if item['flag'] else offset
            if bits or offset % 8:
                raise ValueError('bitfield cannot be used as a pointer probe field')
            found.append((offset // 8, type_id))
        if len(found) != 1:
            raise ValueError(f'BTF member is not unique: {name}')
        return found[0]

    def offset(self, struct_name, *members):
        index, offset = self.named(struct_name, 4), 0
        for member in members:
            extra, index = self.member(index, member)
            offset += extra
        final = self.types[self.unwrap(index)]
        if final['kind'] == 2:
            size = 8
        elif final['kind'] in (1, 4, 5, 6, 16, 19):
            size = final['size_type']
        else:
            raise ValueError('unsupported final BTF member type')
        if offset + size > self.types[self.named(struct_name, 4)]['size_type']:
            raise ValueError('BTF field exceeds containing struct')
        return offset, size

    def signature(self, name, argument_structs, return_kind):
        function = self.types[self.named(name, 12)]
        proto = self.types[self.unwrap(function['size_type'])]
        if proto['kind'] != 13 or proto['vlen'] != len(argument_structs):
            raise ValueError(f'BTF function arity differs: {name}')
        returned = self.unwrap(proto['size_type'])
        if return_kind == 'void':
            if returned != 0:
                raise ValueError(f'BTF function return differs: {name}')
        elif returned == 0 or self.types[returned]['kind'] != 1 or self.types[returned]['size_type'] != 8:
            raise ValueError(f'BTF return is not a 64-bit scalar: {name}')
        for number, expected in enumerate(argument_structs):
            _, index = struct.unpack_from('<II', proto['payload'], number * 8)
            item = self.types[self.unwrap(index)]
            if expected == 'scalar64':
                if item['kind'] != 1 or item['size_type'] != 8:
                    raise ValueError(f'BTF argument is not 64-bit scalar: {name}')
            else:
                if item['kind'] != 2:
                    raise ValueError(f'BTF argument is not pointer: {name}')
                pointed = self.types[self.unwrap(item['size_type'])]
                if expected == 'scalar64ptr':
                    valid = pointed['kind'] == 1 and pointed['size_type'] == 8
                else:
                    valid = pointed['kind'] == 4 and pointed['name'] == expected
                if not valid:
                    raise ValueError(f'BTF argument target differs: {name}')


def build_probes(base, drm, virtio, group, drm_module=True):
    offsets = {}
    def field(owner, typename, path, size):
        offset, actual = owner.offset(typename, *path.split('.'))
        if actual != size:
            raise ValueError(f'BTF field size differs: {typename}.{path}')
        offsets[f'{typename}.{path}'] = {'offset': offset, 'bytes': actual}
        return offset
    crtc_id = field(drm, 'drm_crtc', 'base.id', 4)
    index = field(drm, 'drm_crtc', 'index', 4)
    dev = field(drm, 'drm_crtc', 'dev', 8)
    primary = field(drm, 'drm_device', 'primary', 8)
    minor_index = field(drm, 'drm_minor', 'index', 4)
    sequence = field(drm, 'drm_pending_vblank_event', 'sequence', 8)
    pipe = field(drm, 'drm_pending_vblank_event', 'pipe', 4)
    userdata = field(drm, 'drm_pending_vblank_event', 'event.vbl.user_data', 8)
    file = field(drm, 'drm_pending_vblank_event', 'base.file_priv', 8)
    timer_offset = field(drm, 'drm_vblank_crtc_timer', 'timer', base.types[base.named('hrtimer', 4)]['size_type'])
    interval = field(drm, 'drm_vblank_crtc_timer', 'interval', 8) - timer_offset
    timer_crtc = field(drm, 'drm_vblank_crtc_timer', 'crtc', 8) - timer_offset
    expires = field(base, 'hrtimer', 'node.expires', 8)
    drm.signature('drm_crtc_arm_vblank_event', ['drm_crtc', 'drm_pending_vblank_event'], 'void')
    drm.signature('drm_crtc_accurate_vblank_count', ['drm_crtc'], 'scalar64')
    drm.signature('drm_crtc_vblank_get_vblank_timeout', ['drm_crtc', 'scalar64ptr'], 'void')
    drm.signature('send_vblank_event', ['drm_device', 'drm_pending_vblank_event', 'scalar64', 'scalar64'], 'void')
    virtio.signature('virtio_gpu_crtc_atomic_flush', ['drm_crtc', 'drm_atomic_commit'], 'void')
    # Timer callback returns an enum. Its pointer argument is checked separately.
    timer_function = drm.types[drm.named('drm_vblank_timer_function', 12)]
    timer_proto = drm.types[drm.unwrap(timer_function['size_type'])]
    if timer_proto['kind'] != 13 or timer_proto['vlen'] != 1:
        raise ValueError('BTF timer callback signature differs')
    _, timer_arg = struct.unpack_from('<II', timer_proto['payload'])
    arg = drm.types[drm.unwrap(timer_arg)]
    if arg['kind'] != 2 or drm.types[drm.unwrap(arg['size_type'])]['name'] != 'hrtimer':
        raise ValueError('BTF timer callback argument differs')
    drm_owner = 'drm:' if drm_module else ''
    crtc = f'crtc=$arg1:x64 object=+{crtc_id}($arg1):u32 pipe=+{index}($arg1):u32 dev=+{dev}($arg1):x64 minor=+{minor_index}(+{primary}(+{dev}($arg1))):s32'
    pending = f'event=$arg2:x64 file=+{file}($arg2):x64 userdata=+{userdata}($arg2):x64'
    timer = f'timer=$arg1:x64 crtc=+{timer_crtc}($arg1):x64 interval=+{interval}($arg1):s64 expires=+{expires}($arg1):s64 object=+{crtc_id}(+{timer_crtc}($arg1)):u32 pipe=+{index}(+{timer_crtc}($arg1)):u32 dev=+{dev}(+{timer_crtc}($arg1)):x64 minor=+{minor_index}(+{primary}(+{dev}(+{timer_crtc}($arg1)))):s32'
    return [
        f'p:{group}/{group}_flush virtio_gpu:virtio_gpu_crtc_atomic_flush {crtc} commit=$arg2:x64',
        f'p:{group}/{group}_arm {drm_owner}drm_crtc_arm_vblank_event {crtc} {pending}',
        f'r64:{group}/{group}_arm_return {drm_owner}drm_crtc_arm_vblank_event {crtc} {pending} target=+{sequence}($arg2):u64 event_pipe=+{pipe}($arg2):u32',
        f'p:{group}/{group}_accurate {drm_owner}drm_crtc_accurate_vblank_count {crtc}',
        f'r64:{group}/{group}_accurate_return {drm_owner}drm_crtc_accurate_vblank_count {crtc} count=$retval:u64',
        f'p:{group}/{group}_timeout {drm_owner}drm_crtc_vblank_get_vblank_timeout {crtc} output=$arg2:x64',
        f'r64:{group}/{group}_timeout_return {drm_owner}drm_crtc_vblank_get_vblank_timeout {crtc} output=$arg2:x64 value=+0($arg2):s64',
        f'p:{group}/{group}_timer {drm_owner}drm_vblank_timer_function {timer}',
        f'r64:{group}/{group}_timer_return {drm_owner}drm_vblank_timer_function {timer} restart=$retval:s32',
        f'p:{group}/{group}_send {drm_owner}send_vblank_event dev=$arg1:x64 minor=+{minor_index}(+{primary}($arg1)):s32 {pending} sequence=$arg3:u64 timestamp=$arg4:s64 event_pipe=+{pipe}($arg2):u32',
    ], offsets


def write(path, value):
    with path.open('w') as stream:
        stream.write(value + '\n')


def profiles(group):
    raw = bounded(TRACE / 'kprobe_profile', 1024 * 1024).decode()
    result = {}
    for line in raw.splitlines():
        columns = line.split()
        if len(columns) == 3 and columns[0].startswith(group + '_'):
            if not all(value.isdigit() for value in columns[1:]):
                raise RuntimeError('invalid actual probe profile')
            result[columns[0]] = {'hits': int(columns[1]), 'misses': int(columns[2])}
    return result


def validate_trace_fields(raw, group, definitions):
    text = raw.decode('utf-8', errors='strict')
    required = {}
    for definition in definitions:
        name = definition.split()[0].split('/', 1)[1]
        required[name] = set(re.findall(r" ([a-z_]+)=", definition))
    counts = {name: 0 for name in required}
    for line in text.splitlines():
        matched = re.search(r"\b(" + re.escape(group) + r"_[a-z_]+):", line)
        if not matched:
            continue
        name = matched[1]
        if name not in required:
            raise ValueError('unexpected observer probe record')
        fields = dict((key, int(value, 16) if value.lower().startswith('0x') else int(value))
                      for key, value in re.findall(r"\b([a-z_]+)=(-?0x[0-9a-fA-F]+|-?[0-9]+)(?=\s|$)", line))
        if set(fields) != required[name]:
            raise ValueError('actual probe field is missing or faulted: ' + name)
        for key in ('crtc', 'dev', 'object', 'event', 'file', 'commit', 'timer', 'output', 'expires', 'timestamp', 'value', 'target'):
            if key in fields and fields[key] <= 0:
                raise ValueError('invalid actual pointer/time probe field: ' + name + '.' + key)
        for key in ('pipe', 'event_pipe', 'minor'):
            if key in fields and not 0 <= fields[key] < 32:
                raise ValueError('invalid actual device/index probe field')
        if 'restart' in fields and fields['restart'] not in (0, 1):
            raise ValueError('invalid timer callback return value')
        if 'interval' in fields and fields['interval'] < 0:
            raise ValueError('invalid observed timer interval')
        counts[name] += 1
    if not any(counts.values()):
        raise ValueError('trace lacks any actual observer records')
    return counts


def timer_mappings(raw, group, expected=None):
    mappings = {}
    crtcs = {}
    for line in raw.decode('utf-8', errors='strict').splitlines():
        if expected is not None and re.search(r'\b' + re.escape(group) + r'_[a-z_]+:', line):
            observed = {key: int(value, 16) if value.startswith('0x') else int(value)
                        for key, value in re.findall(r'\b([a-z_]+)=(0x[0-9a-fA-F]+|[0-9]+)(?=\s|$)', line)}
            if 'crtc' in observed and not any(all(observed.get(key) == identity[key] for key in ('crtc', 'object', 'pipe', 'dev', 'minor')) for identity in expected.values()):
                raise ValueError('measurement CRTC escaped discovered timer inventory')
            if 'event_pipe' in observed and not any(all(observed.get(key) == identity[target] for key, target in [('dev', 'dev'), ('minor', 'minor'), ('event_pipe', 'pipe')]) for identity in expected.values()):
                raise ValueError('measurement event escaped discovered timer inventory')
        matched = re.search(r'\b' + re.escape(group) + r'_(timer|timer_return):', line)
        if not matched:
            continue
        fields = {key: int(value, 16) if value.startswith('0x') else int(value)
                  for key, value in re.findall(r'\b([a-z_]+)=(0x[0-9a-fA-F]+|[0-9]+)(?=\s|$)', line)}
        required = {'timer', 'crtc', 'object', 'pipe', 'dev', 'minor'}
        if not required <= fields.keys():
            raise ValueError('actual timer identity fields are missing')
        identity = {key: fields[key] for key in required}
        if any(identity[key] <= 0 for key in ('timer', 'crtc', 'object', 'dev')) or not all(0 <= identity[key] < 32 for key in ('pipe', 'minor')):
            raise ValueError('invalid actual timer identity')
        timer = str(identity['timer'])
        crtc = str(identity['crtc'])
        if timer in mappings and mappings[timer] != identity or crtc in crtcs and crtcs[crtc] != timer:
            raise ValueError('inconsistent actual timer/CRTC mapping')
        mappings[timer] = identity
        crtcs[crtc] = timer
        if len(mappings) > 8:
            raise ValueError('actual timer inventory exceeds bound')
        if expected is not None and expected.get(timer) != identity:
            raise ValueError('measurement timer escaped discovered kernel filter identity')
    if not mappings:
        raise ValueError('no actual timer identity was observed')
    return mappings


def timer_filter(timer_inventory, actual_format):
    if not re.search(r'field:void \* hrtimer;\s*offset:[0-9]+;\s*size:8;\s*signed:0;', actual_format):
        raise ValueError('actual hrtimer filter field differs')
    if not 1 <= len(timer_inventory) <= 8:
        raise ValueError('actual timer filter inventory exceeds bound')
    return ' || '.join('hrtimer == ' + hex(int(timer)) for timer in sorted(timer_inventory, key=int))


def cpu_stats(instance, cpus):
    stats = {}
    for cpu in sorted((instance / 'per_cpu').glob('cpu[0-9]*')):
        values = {}
        for line in bounded(cpu / 'stats', 65536).decode().splitlines():
            if ':' in line:
                key, value = (part.strip() for part in line.split(':', 1))
                values[key] = value
        stats[cpu.name] = values
    if len(stats) != cpus:
        raise RuntimeError('actual per-CPU trace statistics are incomplete')
    return stats


def retain_raw(path, raw):
    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(raw)
    return {'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}


def cleanup(marker):
    instance = TRACE / 'instances' / marker['group']
    errors = []
    if marker.get('instance_created') and instance.exists():
        for path in ('tracing_on', 'events/enable'):
            try:
                write(instance / path, '0')
            except OSError as error:
                errors.append(str(error))
    for definition in marker['definitions']:
        event = definition.split()[0].split(':', 1)[1]
        try:
            probe_command(f'-:{event}')
        except OSError as error:
            errors.append(str(error))
    try:
        if marker.get('instance_created') and instance.exists():
            instance.rmdir()
    except OSError as error:
        errors.append(str(error))
    return errors


@contextlib.contextmanager
def lock():
    fd = os.open('/run/roost-kernel-trace.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        metadata = os.fstat(fd)
        if metadata.st_uid != 0 or metadata.st_mode & 0o077 or not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError('unsafe observer lock')
        deadline = time.monotonic() + 5
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError('observer lifecycle lock deadline exceeded')
                time.sleep(.05)
        yield
    finally:
        os.close(fd)


def start():
    try:
        return start_observer()
    except BaseException as error:
        # Preflight BTF/ABI failures also produce an honest diagnostic artifact.
        # Existing result/active sessions remain owned by their original marker.
        if ROOT.exists() and not (ROOT / 'result.json').exists() and not (ROOT / 'marker.json').exists():
            metadata = ROOT.stat()
            if metadata.st_uid == 0 and not metadata.st_mode & 0o077 and not ROOT.is_symlink():
                preflight = {}
                for name in ('inventory', 'vmlinux', 'virtio_gpu', 'drm'):
                    path = ROOT / ('preflight-' + name + '.json')
                    if path.exists():
                        preflight[name] = read_json(path)
                save(ROOT / 'result.json', {'preflight': preflight, 'group': 'roost_vblank_' + os.urandom(8).hex(),
                     'qualified_acquisition': False, 'stage': 'preflight',
                     'errors': [str(error)[:2048]], 'diagnostic_only': True})
        raise


def start_observer():
    if ROOT.exists():
        previous = read_json(ROOT / 'result.json')
        group = previous['group']
        if not re.fullmatch(r'roost_vblank_[0-9a-f]{16}', group):
            raise RuntimeError('invalid completed observer identity')
        if len(list(ROOT.parent.glob('roost-kernel-trace-complete-*'))) >= 16:
            raise RuntimeError('retained observer session count exceeds bound')
        ROOT.rename(ROOT.parent / ('roost-kernel-trace-complete-' + group))
    ROOT.mkdir(mode=0o700)
    metadata = ROOT.stat()
    if metadata.st_uid != 0 or metadata.st_mode & 0o077 or ROOT.is_symlink():
        raise RuntimeError('unsafe observer root')
    if os.uname().machine != 'x86_64':
        raise RuntimeError('observer ABI is qualified only for x86-64')
    cpus = os.cpu_count()
    if not cpus or cpus > 8:
        raise RuntimeError('observer CPU count exceeds fixed allocation bound')
    if not (TRACE / 'kprobe_events').exists():
        subprocess.run(['/usr/bin/mount', '-t', 'tracefs', '-o', 'nosuid,nodev,noexec', 'tracefs', str(TRACE)],
                       check=True, capture_output=True, timeout=5)
    observer_raw = bounded(Path(__file__), 1024 * 1024)
    # DRM may be built into vmlinux. The actual loaded module inventory
    # and live BTF function definitions determine namespace, not filename
    # assumptions or a fallback when a loaded module's BTF is missing.
    module_inventory = bounded(Path('/proc/modules'), 1024 * 1024).decode()
    module_names = {line.split()[0] for line in module_inventory.splitlines() if line.split()}
    drm_module = 'drm' in module_names
    if 'virtio_gpu' not in module_names:
        raise RuntimeError('actual virtio_gpu module is not loaded')
    inventory = {'kernel_release': os.uname().release, 'proc_modules': module_inventory,
                 'drm_owner': 'drm' if drm_module else 'vmlinux', 'virtio_owner': 'virtio_gpu'}
    save(ROOT / 'preflight-inventory.json', inventory)
    btf_sources = {}
    loaded = {}
    for name in ('vmlinux', 'virtio_gpu') + (('drm',) if drm_module else ()):
        raw = bounded(Path('/sys/kernel/btf') / name, 64 * 1024 * 1024)
        btf_sources[name] = {'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}
        save(ROOT / ('preflight-' + name + '.json'), btf_sources[name])
        loaded[name] = Btf(raw, loaded.get('vmlinux'))
    group = 'roost_vblank_' + os.urandom(8).hex()
    definitions, offsets = build_probes(loaded['vmlinux'], loaded['drm'] if drm_module else loaded['vmlinux'],
                                      loaded['virtio_gpu'], group, drm_module=drm_module)
    marker = {'group': group, 'definitions': [], 'offsets': offsets, 'btf': btf_sources, 'source_inventory': inventory,
              'started_monotonic_ns': time.monotonic_ns(), 'cpus': cpus,
              'limit_seconds': MAX_SECONDS, 'buffer_kb_per_cpu': 2048,
              'observer': {'bytes': len(observer_raw), 'sha256': hashlib.sha256(observer_raw).hexdigest(), 'python': sys.version},
              'return_argument_provenance': {'source': 'https://github.com/archlinux/linux/blob/v7.2.9-arch1/kernel/trace/trace_kprobe.c',
                  'mechanism': 'trace_kprobe_entry_handler saves arguments in ri->data; __kretprobe_trace_func consumes that exact instance data'},
              'diagnostic_only': True, 'overhead': 'tracepoints and entry/return probes; not final performance parity'}
    instance = TRACE / 'instances' / group
    try:
        instance.mkdir()
        marker['instance_created'] = True
        write(instance / 'tracing_on', '0')
        write(instance / 'current_tracer', 'nop')
        write(instance / 'buffer_size_kb', '2048')
        marker['actual_buffer_size_kb'] = bounded(instance / 'buffer_size_kb', 4096).decode().strip()
        if marker['actual_buffer_size_kb'] != '2048':
            raise RuntimeError('actual trace buffer allocation differs from fixed bound')
        write(instance / 'options/overwrite', '0')
        write(instance / 'trace_clock', 'mono')
        clock = bounded(instance / 'trace_clock', 4096).decode()
        if '[mono]' not in clock:
            raise RuntimeError('actual trace clock is not mono')
        formats = {}
        for event in EVENTS:
            formats[event] = bounded(instance / 'events' / event / 'format', 65536).decode()
            if not event.startswith('timer/'):
                write(instance / 'events' / event / 'enable', '1')
        for definition in definitions:
            probe_command(definition)
            marker['definitions'].append(definition)
            event = definition.split()[0].split(':', 1)[1]
            formats[event] = bounded(instance / 'events' / event / 'format', 65536).decode()
            write(instance / 'events' / event / 'enable', '1')
        marker['profiles_before'] = profiles(group)
        if len(marker['profiles_before']) != len(definitions):
            raise RuntimeError('actual probe profile inventory is incomplete')
        save(ROOT / 'formats.json', formats)
        formats_raw = bounded(ROOT / 'formats.json', 2 * 1024 * 1024)
        marker['formats'] = {'bytes': len(formats_raw), 'sha256': hashlib.sha256(formats_raw).hexdigest()}
        marker['capture_filter'] = 'actual-native-timer-inventory-v1'
        marker['discovery_started_monotonic_ns'] = time.monotonic_ns()
        write(instance / 'tracing_on', '1')
        # Observe actual native timers before profiler Start. No injected
        # event, guessed address, buffer reset, consuming read or scope trim.
        time.sleep(.5)
        discovery = bounded(instance / 'trace', 2 * 1024 * 1024)
        marker['discovery_raw'] = retain_raw(ROOT / 'discovery.txt', discovery)
        marker['discovery_finished_monotonic_ns'] = time.monotonic_ns()
        if marker['discovery_finished_monotonic_ns'] - marker['discovery_started_monotonic_ns'] > 1_000_000_000:
            raise RuntimeError('actual timer discovery exceeded its one-second bound')
        marker['discovery_cpu_stats'] = cpu_stats(instance, cpus)
        marker['discovery_profiles'] = profiles(group)
        validate_trace_fields(discovery, group, marker['definitions'])
        inventory = timer_mappings(discovery, group)
        marker['timer_inventory'] = inventory
        marker['timer_filters'] = {}
        for event in EVENTS:
            if not event.startswith('timer/'):
                continue
            expression = timer_filter(inventory, formats[event])
            write(instance / 'events' / event / 'filter', expression)
            actual = bounded(instance / 'events' / event / 'filter', 65536).decode().strip()
            if actual != expression:
                raise ValueError('kernel timer filter readback differs')
            marker['timer_filters'][event] = {'requested': expression, 'actual': actual}
            write(instance / 'events' / event / 'enable', '1')
        marker['filters_ready_monotonic_ns'] = time.monotonic_ns()
        marker['generic_pointer_limitation'] = 'Generic trace text prints hashed %p; kernel filters compare actual raw hrtimer fields. No hash-to-pointer causal join is inferred.'
        save(ROOT / 'marker.json', marker)
        subprocess.Popen([sys.executable, __file__, 'watchdog', '--group', group],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return marker
    except BaseException as error:
        cleanup_errors = cleanup(marker)
        result = dict(marker, qualified_acquisition=False, errors=[str(error)[:2048]], cleanup_errors=cleanup_errors)
        save(ROOT / 'result.json', result)
        raise


def stop(watchdog=False):
    if (ROOT / 'result.json').exists():
        return read_json(ROOT / 'result.json')
    marker = read_json(ROOT / 'marker.json')
    instance = TRACE / 'instances' / marker['group']
    result = dict(marker, stopped_monotonic_ns=time.monotonic_ns(), watchdog_expired=watchdog)
    errors = []
    for path in ('tracing_on', 'events/enable'):
        try:
            write(instance / path, '0')
        except OSError as error:
            errors.append(str(error))
    # Retain whole raw bytes before counter/provenance/semantic validation.
    try:
        raw = bounded(instance / 'trace', MAX_RAW)
        result['raw'] = retain_raw(ROOT / 'capture.txt', raw)
        formats_raw = bounded(ROOT / 'formats.json', 2 * 1024 * 1024)
        result['formats'] = {'bytes': len(formats_raw), 'sha256': hashlib.sha256(formats_raw).hexdigest()}
    except Exception as error:
        errors.append(str(error)[:2048])
        raw = None
    try:
        result['profiles_after'] = profiles(marker['group'])
        observer_raw = bounded(Path(__file__), 1024 * 1024)
        if hashlib.sha256(observer_raw).hexdigest() != marker['observer']['sha256']:
            errors.append('installed observer changed during capture')
        for name, original in marker['btf'].items():
            raw_btf = bounded(Path('/sys/kernel/btf') / name, 64 * 1024 * 1024)
            if len(raw_btf) != original['bytes'] or hashlib.sha256(raw_btf).hexdigest() != original['sha256']:
                errors.append('live BTF changed during capture: ' + name)
        stats = cpu_stats(instance, marker['cpus'])
        result['cpu_stats'] = stats
        result['timer_filters_after'] = {}
        for event, proof in marker['timer_filters'].items():
            actual = bounded(instance / 'events' / event / 'filter', 65536).decode().strip()
            result['timer_filters_after'][event] = actual
            if actual != proof['actual']:
                errors.append('actual kernel timer filter changed during measurement')
        if raw is not None:
            try:
                counts = validate_trace_fields(raw, marker['group'], marker['definitions'])
                result['actual_record_counts'] = counts
                result['unobserved_branches'] = [name for name, count in counts.items() if not count]
                timer_mappings(raw, marker['group'], marker['timer_inventory'])
            except ValueError as error:
                errors.append(str(error))
        if watchdog or (result['stopped_monotonic_ns'] - marker['started_monotonic_ns']) > MAX_SECONDS * 1_000_000_000:
            errors.append('observer exceeded its real duration bound')
        for values in stats.values():
            for key in ('overrun', 'commit overrun', 'dropped events'):
                if key not in values or not values[key].isdigit() or int(values[key]) != 0:
                    errors.append('actual trace buffer loss/missing loss field')
        for name, before in marker['profiles_before'].items():
            after = result['profiles_after'].get(name)
            if not after or after['misses'] != before['misses'] or after['hits'] < before['hits']:
                errors.append('actual probe missed events or counters regressed: ' + name)
    except Exception as error:
        errors.append(str(error)[:2048])
    result['cleanup_errors'] = cleanup(marker)
    errors.extend(result['cleanup_errors'])
    result['qualified_acquisition'] = not errors
    result['errors'] = errors
    save(ROOT / 'result.json', result)
    return result


def watchdog(group):
    marker = read_json(ROOT / 'marker.json')
    if marker['group'] != group:
        raise RuntimeError('watchdog does not own observer')
    while not (ROOT / 'result.json').exists():
        if read_json(ROOT / 'marker.json')['group'] != group:
            return
        if time.monotonic_ns() - marker['started_monotonic_ns'] > MAX_SECONDS * 1_000_000_000:
            with lock():
                if read_json(ROOT / 'marker.json')['group'] == group:
                    stop(watchdog=True)
            return
        time.sleep(.2)


def read(index, kind):
    if type(index) is not int or not 0 <= index < 1024:
        raise ValueError('invalid kernel trace chunk index')
    paths = {'trace': 'capture.txt', 'formats': 'formats.json', 'discovery': 'discovery.txt'}
    path = ROOT / paths[kind]
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        metadata = os.fstat(stream.fileno())
        if metadata.st_uid != 0 or metadata.st_mode & 0o077 or not stat.S_ISREG(metadata.st_mode) or metadata.st_size > MAX_RAW:
            raise RuntimeError('unsafe retained observer artifact')
        stream.seek(index * 65536)
        raw = stream.read(65536)
    if not raw:
        raise ValueError('kernel trace chunk beyond end')
    return {'index': index, 'data': base64.b64encode(raw).decode('ascii')}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('start', 'stop', 'read', 'watchdog'))
    parser.add_argument('--index', type=int, default=0)
    parser.add_argument('--kind', choices=('trace', 'formats', 'discovery'), default='trace')
    parser.add_argument('--group')
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise RuntimeError('kernel observer requires the CI root probe')
    if args.action in ('start', 'stop'):
        with lock():
            result = start() if args.action == 'start' else stop()
    elif args.action == 'read': result = read(args.index, args.kind)
    else:
        watchdog(args.group)
        return
    print(json.dumps(result))


if __name__ == '__main__':
    main()
