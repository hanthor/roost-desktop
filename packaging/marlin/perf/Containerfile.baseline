# CI-only GNOME 51 baseline derived from the recorded Marlin image.
# Arch stable currently ships GNOME 50.5; enable both testing repositories
# together and perform a complete upgrade to avoid a partial Arch upgrade.
ARG BASE_IMAGE=ghcr.io/tuna-os/marlin:gnome
FROM ${BASE_IMAGE} AS gnome-baseline
RUN sed -i '/^\[core\]/i [core-testing]\nInclude = /etc/pacman.d/mirrorlist\n\n[extra-testing]\nInclude = /etc/pacman.d/mirrorlist\n' /etc/pacman.conf && \
    pacman -Syu --noconfirm gnome-shell mutter gdm \
        evolution-data-server gnome-keyring xdg-desktop-portal-gnome xdg-desktop-portal-gtk \
        gst-plugin-pipewire gst-plugins-good orca speech-dispatcher \
        python python-gobject wayland-utils qemu-guest-agent gcc pkgconf wayland-protocols && \
    kernel_count=0 && \
    for module_dir in /usr/lib/modules/*; do \
        test -d "$module_dir" || continue; \
        kernel="${module_dir##*/}"; \
        test -f "$module_dir/vmlinuz" || continue; \
        kernel_count=$((kernel_count + 1)); \
        depmod "$kernel" && dracut --force "$module_dir/initramfs.img" "$kernel" || exit 1; \
    done && \
    test "$kernel_count" -eq 1 && \
    gnome-shell --version | grep -Eq '^GNOME Shell 51([. ]|$)' && \
    pacman -Q > /tmp/roost-baseline-packages.txt && \
    LC_ALL=C sort /tmp/roost-baseline-packages.txt > /usr/share/roost-perf-baseline-packages.txt && \
    rm /tmp/roost-baseline-packages.txt

# Build the pinned Arch 51.0 diagnostic variant with closed writer and source IDs.
# Toolchain and source files remain in this build stage, outside the measured image.
FROM gnome-baseline AS mutter-profiler-build
COPY packaging/marlin/perf/mutter-profiler /build/mutter-profiler
RUN pacman -S --needed --noconfirm base-devel git sudo && \
    useradd --create-home --user-group profiler-builder && \
    printf '%s\n' 'profiler-builder ALL=(ALL) NOPASSWD: /usr/bin/pacman' > /etc/sudoers.d/profiler-builder && \
    chmod 0440 /etc/sudoers.d/profiler-builder && \
    chown -R profiler-builder:profiler-builder /build/mutter-profiler && \
    cd /build/mutter-profiler && \
    runuser -u profiler-builder -- makepkg --syncdeps --noconfirm --cleanbuild && \
    mkdir /profiler-package && \
    cp mutter-51.0-1.2-x86_64.pkg.tar.zst /profiler-package/ && \
    cp PKGBUILD release-trace-context.patch frame-source-evidence.patch /profiler-package/ && \
    cd /profiler-package && \
    sha256sum PKGBUILD release-trace-context.patch frame-source-evidence.patch mutter-51.0-1.2-x86_64.pkg.tar.zst > sha256sums

FROM gnome-baseline
COPY --from=mutter-profiler-build /profiler-package /usr/share/roost-perf-mutter-profiler
RUN cd /usr/share/roost-perf-mutter-profiler && sha256sum -c sha256sums && \
    pacman -U --noconfirm mutter-51.0-1.2-x86_64.pkg.tar.zst && \
    pacman -Q mutter | grep -qx 'mutter 51.0-1.2' && \
    pacman -Q > /tmp/roost-baseline-packages.txt && \
    LC_ALL=C sort /tmp/roost-baseline-packages.txt > /usr/share/roost-perf-baseline-packages.txt && \
    pacman -Qlq linux mutter > /tmp/roost-baseline-critical-files.txt && \
    for module_dir in /usr/lib/modules/*; do \
        if test -f "$module_dir/vmlinuz"; then \
            test -s "$module_dir/vmlinuz" && test -s "$module_dir/initramfs.img" && test -s "$module_dir/modules.dep" && \
                printf '%s\n' "$module_dir/vmlinuz" "$module_dir/initramfs.img" "$module_dir/modules.dep" || exit 1; \
        fi; \
    done >> /tmp/roost-baseline-critical-files.txt && \
    while IFS= read -r path; do \
        test ! -f "$path" || sha256sum "$path" || exit 1; \
    done < /tmp/roost-baseline-critical-files.txt > /usr/share/roost-perf-baseline-critical.sha256 && \
    test -s /usr/share/roost-perf-baseline-critical.sha256 && \
    rm /tmp/roost-baseline-packages.txt /tmp/roost-baseline-critical-files.txt
