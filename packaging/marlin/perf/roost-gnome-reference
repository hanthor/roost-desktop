#!/usr/bin/env python3
"""Read-only genuine stock Shell admission, with no Sysprof Start or fallback."""
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import stat
import subprocess
from gnome_reference import validate_image, validate_reference
from gnome_failed_capture import process_start


def protected(path, limit):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_mode & 0o022 or not 0 < before.st_size <= limit:
            raise ValueError('reference protected file refused')
        raw = stream.read(limit + 1)
        after = os.fstat(stream.fileno())
        named = os.stat(path, follow_symlinks=False)
        keys = lambda info: (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
        if len(raw) != before.st_size or keys(before) != keys(after) or keys(after) != keys(named):
            raise ValueError('reference file changed')
    return raw


def image(profile):
    receipt = validate_image(json.loads(protected('/usr/share/roost-perf-reference.json', 4096)), profile)
    for key, path in (('packages_sha256', '/usr/share/roost-perf-baseline-packages.txt'), ('critical_sha256', '/usr/share/roost-perf-baseline-critical.sha256')):
        if hashlib.sha256(protected(path, 16 * 1024 * 1024)).hexdigest() != receipt[key]:
            raise ValueError('reference manifest changed')
    return receipt


def main():
    from gi.repository import Gio, GLib
    uid = os.getuid()
    if uid <= 0:
        raise ValueError('reference requires original ordinary session user')
    receipt = image('stock')
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def call(method, signature, argument):
        return bus.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus', method,
                             GLib.Variant('(s)', (argument,)), GLib.VariantType.new(signature), Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]

    owner = call('GetNameOwner', '(s)', 'org.gnome.Shell')
    pid = call('GetConnectionUnixProcessID', '(u)', owner)
    start = int(process_start(pid))

    def recheck():
        if (call('GetNameOwner', '(s)', 'org.gnome.Shell') != owner
                or call('GetConnectionUnixProcessID', '(u)', owner) != pid
                or call('GetConnectionUnixUser', '(u)', owner) != uid
                or int(process_start(pid)) != start
                or Path(f'/proc/{pid}/exe').resolve(strict=True) != Path('/usr/bin/gnome-shell').resolve(strict=True)):
            raise ValueError('original Shell principal changed')
    recheck()
    # Reuse the existing bounded original-FD mapped-library validation without
    # changing any diagnostic Start/Stop admission or exact diagnostic package.
    loader = importlib.machinery.SourceFileLoader('reference_profiler', '/usr/libexec/roost-gnome-profiler')
    spec = importlib.util.spec_from_loader(loader.name, loader)
    profiler = importlib.util.module_from_spec(spec)
    loader.exec_module(profiler)
    modules = profiler.mutter_libraries_provenance(pid)
    critical = {}
    for row in protected('/usr/share/roost-perf-baseline-critical.sha256', 16 * 1024 * 1024).decode().splitlines():
        digest, path = row.split('  ', 1)
        if path in critical and critical[path] != digest:
            raise ValueError('ambiguous critical image identity')
        critical[path] = digest
    for module in modules.values():
        if module['package'] != receipt['mutter_package'] or critical.get(module['path']) != module['sha256']:
            raise ValueError('loaded module differs from original stock image')
    executable = '/usr/bin/gnome-shell'
    shell = protected(executable, 16 * 1024 * 1024)
    if critical.get(executable) != hashlib.sha256(shell).hexdigest():
        raise ValueError('Shell executable differs from original stock image')
    if subprocess.check_output(['pacman', '-Qqo', executable], text=True, timeout=5).strip() != 'gnome-shell':
        raise ValueError('Shell package owner changed')
    if subprocess.check_output(['pacman', '-Q', 'gnome-shell'], text=True, timeout=5).strip() != receipt['shell_package']:
        raise ValueError('Shell package version changed')
    if subprocess.check_output(['pacman', '-Q', 'mutter'], text=True, timeout=5).strip() != receipt['mutter_package']:
        raise ValueError('Mutter package version changed')
    version = subprocess.check_output([executable, '--version'], text=True, timeout=5).strip()
    recheck()
    if image('stock') != receipt:
        raise ValueError('stock image receipt changed')
    result = {'image': receipt, 'principal': {'uid': uid, 'pid': pid, 'start': start, 'owner': owner},
              'shell_version': version, 'shell_sha256': hashlib.sha256(shell).hexdigest(), 'modules': modules}
    print(json.dumps(validate_reference(result, 'stock')))


if __name__ == '__main__':
    main()
