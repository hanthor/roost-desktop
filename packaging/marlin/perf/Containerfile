# CI-only identical image, different GDM session; no shipping defaults changed.
ARG BASE_IMAGE=localhost/marlin-tuna-preview:perf
FROM ${BASE_IMAGE}
ARG DESKTOP
COPY packaging/marlin/vm-lane/custom.conf /etc/gdm/custom.conf
COPY packaging/marlin/vm-lane/tuna-vm-lane.tmpfiles /usr/lib/tmpfiles.d/tuna-vm-lane.conf
COPY packaging/marlin/vm-lane/journald.conf /usr/lib/systemd/journald.conf.d/90-tuna-vm-lane.conf
COPY packaging/marlin/vm-lane/kargs.toml /usr/lib/bootc/kargs.d/90-tuna-vm-lane.toml
COPY scripts/lib/tuna-perf-guest.py /usr/libexec/tuna-perf-guest
COPY scripts/tuna-frame-pacer-build /tmp/frame-pacer/scripts/tuna-frame-pacer-build
COPY scripts/lib/tuna-frame-pacer.c /tmp/frame-pacer/scripts/lib/tuna-frame-pacer.c
COPY packaging/marlin/perf/tuna-perf-session /usr/libexec/tuna-perf-session
COPY scripts/lib/tuna_overview_receipts.py /usr/libexec/tuna_overview_receipts.py
COPY packaging/marlin/perf/tuna-perf-phase /usr/libexec/tuna-perf-phase
COPY packaging/marlin/perf/tuna-kernel-trace /usr/libexec/tuna-kernel-trace
COPY packaging/marlin/perf/tuna-gnome-profiler /usr/libexec/tuna-gnome-profiler
COPY scripts/lib/gnome_reference.py /usr/libexec/gnome_reference.py
COPY packaging/marlin/perf/tuna-gnome-reference /usr/libexec/tuna-gnome-reference
COPY scripts/lib/perf_trace_diagnostics.py /usr/libexec/perf_trace_diagnostics.py
COPY scripts/lib/gnome_failed_capture.py /usr/libexec/gnome_failed_capture.py
COPY packaging/marlin/perf/tuna-perf.service /usr/lib/systemd/system/tuna-perf.service
RUN case "$DESKTOP" in gnome|tuna) ;; *) exit 1 ;; esac && \
    /usr/libexec/tuna-pinned-baseline && \
    pacman -S --needed --noconfirm python python-gobject wayland-utils qemu-guest-agent gcc pkgconf wayland-protocols && \
    /usr/libexec/tuna-pinned-baseline && \
    bash /tmp/frame-pacer/scripts/tuna-frame-pacer-build /tmp/frame-pacer/build && \
    install -Dm755 /tmp/frame-pacer/build/tuna-frame-pacer /usr/libexec/tuna-frame-pacer && \
    rm -rf /tmp/frame-pacer && \
    chmod 0755 /usr/libexec/tuna-perf-session /usr/libexec/tuna-perf-phase /usr/libexec/tuna-gnome-profiler /usr/libexec/tuna-kernel-trace && \
    useradd -M -d /home/tuna-test -s /bin/bash -U tuna-test && \
    echo 'tuna-test:tuna' | chpasswd && \
    sed -i "s/DefaultSession=tuna.desktop/DefaultSession=${DESKTOP}.desktop/" /etc/gdm/custom.conf && \
    sed -i "s/Session=tuna/Session=${DESKTOP}/" /usr/lib/tmpfiles.d/tuna-vm-lane.conf && \
    test -f "/usr/share/wayland-sessions/${DESKTOP}.desktop" && \
    if [ "$DESKTOP" = tuna ]; then sed -i 's|^Exec=.*|Exec=/usr/libexec/tuna-perf-session|' /usr/share/wayland-sessions/tuna.desktop; fi && \
    systemctl enable tuna-perf.service qemu-guest-agent.service
