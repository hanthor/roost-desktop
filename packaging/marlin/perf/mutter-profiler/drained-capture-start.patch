+      /* Owned cleanup is not a successful drain or a qualified boundary. */
+      stop_tracing_now (profiler);
+      g_dbus_method_invocation_return_error (gate->invocation, G_DBUS_ERROR,
+                                             failure_code, "%s", failure);
+      return G_SOURCE_REMOVE;
+    }
+  /* The final owned clock observation and disable share one main callback;
+   * no dispatch can intervene. Normal scheduling is never inhibited/reset. */
+  COGL_TRACE_MESSAGE ("Roost::CaptureStopBoundary",
+                      "output=%s clock=%p next=%" G_GINT64_FORMAT
+                      " pending=%u depth=%u dispatched=%d state=%s"
+                      " requested_us=%" G_GINT64_FORMAT " closing_us=%" G_GINT64_FORMAT
+                      " samples=%u",
+                      state.output, profiler->capture_clock, state.next_counter,
+                      state.pending, state.depth, state.dispatched, state.state,
+                      gate->requested_us, g_get_monotonic_time (), gate->samples);
+  stop_tracing_now (profiler);
+  meta_dbus_sysprof3_profiler_complete_stop (META_DBUS_SYSPROF3_PROFILER (profiler),
+                                            gate->invocation);
+  return G_SOURCE_REMOVE;
+}
