+static void
+capture_gate_free (gpointer data)
+{
+  CaptureGate *gate = data;
+  gate->profiler->capture_gate = NULL;
+  g_clear_object (&gate->stage);
+  g_clear_object (&gate->view);
+  g_clear_object (&gate->clock);
+  g_clear_object (&gate->invocation);
+  g_clear_object (&gate->fd_list);
+  g_variant_unref (gate->options);
+  g_variant_unref (gate->fd_variant);
+  g_object_unref (gate->profiler);
+  g_free (gate);
+}
+
+static void
+emit_capture_boundary (MetaProfiler *profiler)
+{
+  CaptureGate *gate = profiler->capture_gate;
+  ClutterFrameClockCaptureState state;
+  g_autofree char *description = NULL;
+  clutter_frame_clock_get_capture_state (gate->clock, &state);
+  /* Same main-context callback: no dispatch may intervene after drain. */
+  g_assert (g_main_context_is_owner (profiler->main_thread_context));
+  g_assert (!state.pending && !state.depth && !state.dispatched);
+  description = g_strdup_printf ("output=%s clock=%p next=%" G_GINT64_FORMAT
+                                  " pending=%u depth=%u dispatched=%d state=%s"
+                                  " requested_us=%" G_GINT64_FORMAT " enabled_us=%" G_GINT64_FORMAT
+                                  " samples=%u",
+                                  state.output, gate->clock, state.next_counter,
+                                  state.pending, state.depth, state.dispatched, state.state,
+                                  gate->requested_us, g_get_monotonic_time (), gate->samples);
+  COGL_TRACE_MESSAGE ("Roost::CaptureBoundary", "%s", description);
+}
+
+static gboolean
+capture_gate_tick (gpointer data)
+{
+  CaptureGate *gate = data;
+  MetaProfiler *profiler = gate->profiler;
+  g_autoptr (MetaContext) context = g_weak_ref_get (&profiler->context);
+  MetaBackend *backend = context ? meta_context_get_backend (context) : NULL;
+  ClutterActor *actor = backend ? meta_backend_get_stage (backend) : NULL;
+  GList *views = actor ? clutter_stage_peek_stage_views (CLUTTER_STAGE (actor)) : NULL;
+  ClutterFrameClockCaptureState state;
+  gint64 now = g_get_monotonic_time ();
+  gate->samples++;
+  if (!g_main_context_is_owner (profiler->main_thread_context) || !actor ||
+      CLUTTER_STAGE (actor) != gate->stage || !views || views->next ||
+      views->data != gate->view || clutter_stage_view_get_frame_clock (gate->view) != gate->clock)
+    {
+      g_dbus_method_invocation_return_error (gate->invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED, "Owned capture stage/view/clock changed");
+      return G_SOURCE_REMOVE;
+    }
+  clutter_frame_clock_get_capture_state (gate->clock, &state);
+  if (!state.output || strcmp (state.output, "Virtual-1") || state.next_counter < 0)
+    {
+      g_dbus_method_invocation_return_error (gate->invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED, "Capture requires one actual Virtual-1 frame clock");
+      return G_SOURCE_REMOVE;
+    }
+  if (now - gate->requested_us >= 5 * G_USEC_PER_SEC || gate->samples > 5000)
+    {
+      g_dbus_method_invocation_return_error (gate->invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_TIMED_OUT,
+                                             "No actual drain in 5s: pending=%u depth=%u dispatched=%d state=%s samples=%u",
+                                             state.pending, state.depth, state.dispatched, state.state, gate->samples);
+      return G_SOURCE_REMOVE;
+    }
+  if (state.pending || state.depth || state.dispatched)
+    return G_SOURCE_CONTINUE;
+  /* Scope the original owned context while enabling. Cogl also checks
+   * ownership: GLib represents a pushed global-default context as NULL,
+   * so pointer equality alone would still defer enable past this boundary. */
+  g_main_context_push_thread_default (profiler->main_thread_context);
+  handle_start_now (META_DBUS_SYSPROF3_PROFILER (profiler), gate->invocation,
+                    gate->fd_list, gate->options, gate->fd_variant);
+  g_main_context_pop_thread_default (profiler->main_thread_context);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+handle_start (MetaDBusSysprof3Profiler *dbus_profiler,
+              GDBusMethodInvocation *invocation,
+              GUnixFDList *fd_list,
+              GVariant *options,
+              GVariant *fd_variant)
+{
+  MetaProfiler *profiler = META_PROFILER (dbus_profiler);
+  g_autoptr (GVariant) option = g_variant_lookup_value (options, "roost-require-drained", NULL);
+  g_autoptr (MetaContext) context = NULL;
+  MetaBackend *backend;
+  ClutterActor *actor;
+  GList *views;
+  CaptureGate *gate;
+  GSource *source;
+  g_autoptr (GError) fd_error = NULL;
+  int position;
+  int checked_fd;
+  if (profiler->capture_gate)
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED, "Capture Start already pending");
+      return TRUE;
+    }
+  if (!option || (g_variant_is_of_type (option, G_VARIANT_TYPE_BOOLEAN) && !g_variant_get_boolean (option)))
+    return handle_start_now (dbus_profiler, invocation, fd_list, options, fd_variant);
+  if (!g_variant_is_of_type (option, G_VARIANT_TYPE_BOOLEAN) || profiler->running || !fd_list)
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED, "Invalid drained Start or profiler already running");
+      return TRUE;
+    }
+  g_variant_get (fd_variant, "h", &position);
+  checked_fd = g_unix_fd_list_get (fd_list, position, &fd_error);
+  if (checked_fd == -1)
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_INVALID_ARGS,
+                                             "Invalid drained capture handle: %s",
+                                             fd_error ? fd_error->message : "no descriptor");
+      return TRUE;
+    }
+  close (checked_fd);
+  context = g_weak_ref_get (&profiler->context);
+  backend = context ? meta_context_get_backend (context) : NULL;
+  actor = backend ? meta_backend_get_stage (backend) : NULL;
+  views = actor ? clutter_stage_peek_stage_views (CLUTTER_STAGE (actor)) : NULL;
+  if (!actor || !views || views->next || !clutter_stage_view_get_frame_clock (views->data))
+    {
+      g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+                                             G_DBUS_ERROR_FAILED, "Drained Start requires one actual owned stage view");
+      return TRUE;
+    }
+  gate = g_new0 (CaptureGate, 1);
+  gate->profiler = g_object_ref (profiler);
+  gate->invocation = g_object_ref (invocation);
+  gate->fd_list = g_object_ref (fd_list);
+  gate->options = g_variant_ref (options);
+  gate->fd_variant = g_variant_ref (fd_variant);
+  gate->stage = g_object_ref (CLUTTER_STAGE (actor));
+  gate->view = g_object_ref (views->data);
+  gate->clock = g_object_ref (clutter_stage_view_get_frame_clock (gate->view));
+  gate->requested_us = g_get_monotonic_time ();
+  profiler->capture_gate = gate;
+  source = g_timeout_source_new (1);
+  g_source_set_callback (source, capture_gate_tick, gate, capture_gate_free);
+  g_source_attach (source, profiler->main_thread_context);
+  g_source_unref (source);
   return TRUE;
 }
 
