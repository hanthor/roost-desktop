#!/usr/bin/python3
"""Bounded, private nested-session churn; metrics are samples, not a 24h soak."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent


def worker():
    os.environ.setdefault("GSK_RENDERER", "cairo")
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import GLib, Gtk
    loop = GLib.MainLoop()
    windows, batches = [], 0

    def churn():
        nonlocal batches
        for window in windows:
            window.destroy()
        windows.clear()
        if batches == 10:
            loop.quit()
            return False
        for index in range(10):
            window = Gtk.Window(title=f"Stress {os.getpid()} {batches} {index}")
            window.set_default_size(200, 140)
            window.set_child(Gtk.Label(label="Churn fixture"))
            window.present()
            windows.append(window)
        batches += 1
        return True

    GLib.timeout_add(100, churn)
    loop.run()
    # Flush destruction before disconnecting the client.
    for _ in range(10):
        while GLib.MainContext.default().iteration(False):
            pass
        time.sleep(0.01)


def wait_for(condition, timeout=30):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        if condition():
            return
        time.sleep(0.1)
    raise RuntimeError("condition exceeded its wall-clock deadline")


def metrics(root_pid):
    pairs = subprocess.check_output(["ps", "-eo", "pid=,ppid="], text=True)
    children = {root_pid}
    edges = [tuple(map(int, line.split())) for line in pairs.splitlines()]
    while True:
        expanded = children | {pid for pid, parent in edges if parent in children}
        if expanded == children:
            break
        children = expanded
    pss, rss, fds = 0, 0, 0
    for pid in children:
        proc = Path(f"/proc/{pid}")
        try:
            values = {}
            for line in (proc / "smaps_rollup").read_text().splitlines():
                parts = line.split()
                if parts[0] in ("Pss:", "Rss:"):
                    values[parts[0]] = int(parts[1])
            pss += values.get("Pss:", 0)
            rss += values.get("Rss:", 0)
            fds += len(list((proc / "fd").iterdir()))
        except FileNotFoundError:
            pass
    return {"elapsed_s": time.monotonic(), "pss_kib": pss, "rss_kib": rss,
            "fds": fds, "processes": len(children)}


def run(args):
    out = Path(args.out).resolve()
    if out.exists() and any(out.iterdir()):
        raise RuntimeError("stress artifacts must be a fresh empty directory")
    out.mkdir(parents=True, exist_ok=True)
    private = out / "private"
    private.mkdir(mode=0o700, exist_ok=True)
    os.chmod(private, 0o700)
    env = os.environ.copy()
    env.update(XDG_RUNTIME_DIR=str(private), GSK_RENDERER="cairo",
               GSETTINGS_BACKEND="memory", ADW_DISABLE_PORTAL="1",
               ROOST_COMPOSITOR_STATE=str(out / "state.json"),
               XDG_CONFIG_HOME=str(private / "config"),
               XDG_STATE_HOME=str(private / "state"),
               XDG_DATA_HOME=str(private / "data"))
    logs, processes, samples = [], [], []
    assertions = {}
    start = time.monotonic()

    def launch(command, name, child_env=env):
        log = (out / f"{name}.log").open("w")
        logs.append(log)
        process = subprocess.Popen(command, env=child_env, stdout=log, stderr=log,
                                   start_new_session=True)
        processes.append(process)
        return process

    def state():
        try:
            return json.loads((out / "state.json").read_text())
        except (FileNotFoundError, json.JSONDecodeError):
            return {}

    def sample():
        if compositor.poll() is not None:
            raise RuntimeError("compositor exited during stress")
        value = metrics(compositor.pid)
        value["elapsed_s"] = round(value["elapsed_s"] - start, 3)
        samples.append(value)
        with (out / "metrics.jsonl").open("a") as stream:
            stream.write(json.dumps(value) + "\n")
        return value

    try:
        launch(["Xvfb", "-displayfd", "1", "-screen", "0", "1280x800x24", "-nolisten", "tcp"], "xvfb")
        def display_number():
            return next((line for line in (out / "xvfb.log").read_text().splitlines()
                         if line.isdigit()), None)
        wait_for(display_number)
        env["DISPLAY"] = ":" + display_number()
        wait_for(lambda: subprocess.run(["xdotool", "getdisplaygeometry"], env=env,
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0)
        compositor = launch([str(ROOT / "target/debug/roost-compositor"), "--backend", "winit",
                             "--socket", "roost-stress",
                             "--shell-bin", str(ROOT / "target/debug/roost-shell-gtk")], "nested")
        wait_for(lambda: state().get("layers"))
        wait_for(lambda: (private / "roost-stress").exists())
        windows = subprocess.check_output(["xdotool", "search", "--name", "Smithay"], env=env, text=True)
        wid = windows.splitlines()[0]
        subprocess.run(["xdotool", "windowfocus", wid], env=env, check=True)
        client_env = env | {"WAYLAND_DISPLAY": "roost-stress", "GDK_BACKEND": "wayland"}

        def churn_round(index):
            workers = [launch([sys.executable, str(Path(__file__).resolve()), "--worker"],
                              f"churn-{index}-{n}", client_env) for n in range(4)]
            seen = False
            deadline = time.monotonic() + 30
            while any(process.poll() is None for process in workers):
                seen = seen or bool(state().get("windows"))
                if time.monotonic() > deadline:
                    raise RuntimeError("window churn worker hung")
                time.sleep(0.05)
            if not seen or any(process.returncode != 0 for process in workers):
                raise RuntimeError("churn failed to map windows or a worker crashed")
            wait_for(lambda: state().get("windows") == [])

        # Settle renderer caches before the measured rounds.
        for index in range(3):
            churn_round(f"warmup-{index}")
        time.sleep(2)
        baseline = sample()
        for index in range(args.rounds):
            churn_round(index)
            # Input must still reach the shell after every client flood.
            subprocess.run(["xdotool", "key", "--clearmodifiers", "Escape"], env=env, check=True)
            wait_for(lambda: state().get("overview_open") is False)
            subprocess.run(["xdotool", "key", "--clearmodifiers", "Super_L"], env=env, check=True)
            wait_for(lambda: state().get("overview_open") is True)
            sample()
        assertions["S-CHURN"] = [True, f"{(args.rounds + 3) * 400} windows across four concurrent clients"]
        assertions["S-INPUT"] = [True, "overview input responded after every churn round"]

        import gi
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        ids = []
        for index in range(1000):
            answer = bus.call_sync("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                                   "org.freedesktop.Notifications", "Notify",
                                   GLib.Variant("(susssasa{sv}i)", ("Stress", 0, "", f"Flood {index}",
                                                                  "Fixture", [], {}, 1000)),
                                   GLib.VariantType.new("(u)"), Gio.DBusCallFlags.NONE, 5000, None)
            ids.append(answer.unpack()[0])
        for notification in ids:
            bus.call_sync("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                          "org.freedesktop.Notifications", "CloseNotification",
                          GLib.Variant("(u)", (notification,)), None, Gio.DBusCallFlags.NONE, 5000, None)
        assertions["S-NOTIFY"] = [True, "1000 notifications and 1000 closes responded"]
        time.sleep(5)
        final = sample()
        # Diagnostic limits for this bounded workload, not GNOME performance targets.
        pss_limit = baseline["pss_kib"] * 1.25 + 65536
        fd_limit = baseline["fds"] + 32
        assertions["S-GROWTH"] = [final["pss_kib"] <= pss_limit and final["fds"] <= fd_limit,
                                  f"PSS {final['pss_kib']}/{int(pss_limit)} KiB; fds {final['fds']}/{fd_limit}"]
        text = (out / "nested.log").read_text()
        assertions["S-LIVE"] = [compositor.poll() is None and "panicked" not in text,
                                "compositor remained alive without panic"]
    except Exception as error:
        assertions["S-HARNESS"] = [False, str(error)]
    finally:
        for process in reversed(processes):
            if process.poll() is None:
                os.killpg(process.pid, 15)
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, 9)
                    process.wait()
        for log in logs:
            log.close()
        (out / "assertions.txt").write_text("".join(
            f"{name} {'pass' if value[0] else 'fail'} {value[1]}\n" for name, value in assertions.items()))
        (out / "report.json").write_text(json.dumps({
            "commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
            "rounds": args.rounds, "samples": samples, "assertions": assertions,
            "kernel": os.uname().release, "resolution": "1280x800",
            "growth_limit": "warmup PSS * 1.25 + 64 MiB; warmup fd count + 32",
            "scope": "bounded nested churn; frame pacing and 24-hour VM soak are not measured",
        }, indent=2))
    if not assertions or not all(value[0] for value in assertions.values()):
        raise SystemExit("roost-stress: stress gate failed; see retained artifacts")
    print("roost-stress: bounded churn, input, notification and growth gates passed")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--rounds", type=int, default=10)
    parser.add_argument("--out", default="stress-artifacts")
    args = parser.parse_args()
    if args.worker:
        worker()
    else:
        if not 1 <= args.rounds <= 5000:
            parser.error("--rounds must be between 1 and 5000")
        if not os.environ.get("ROOST_STRESS_PRIVATE_BUS"):
            os.execvpe("dbus-run-session", ["dbus-run-session", "--", sys.executable,
                       str(Path(__file__).resolve()), *sys.argv[1:]],
                       os.environ | {"ROOST_STRESS_PRIVATE_BUS": "1"})
        run(args)


if __name__ == "__main__":
    main()
