#!/usr/bin/env python3
"""roost-vm-lane — boot the Marlin Roost disk and prove the hardware session (#68).

Boots a raw disk installed from the CI-only test layer
(packaging/marlin/vm-lane/Containerfile: greetd initial session of roost-test
into "Roost (preview)", journal mirrored on ttyS0) in QEMU/KVM on OVMF at
1280x800 with virtio-vga, then asserts from outside the guest:

  V-DRM      the serial journal shows roost-compositor lit an output on
             the DRM/KMS backend ("roost-compositor: drm: output ...")
  V-SHELL    the GTK shell came up ("roost-shell-gtk: keybindings: ...")
             and supervision never exhausted its restart budget
  V-PANEL    after Escape leaves the startup overview, a QMP screendump
             shows the GNOME 51-style pure black top panel across the
             width at y=5, over a non-uniform desktop (not a blank or
             splash screen)
  V-NOPANIC  no "panicked" anywhere in the serial log

Writes to --out: serial.log, roost-lines.log (every roost-* line),
boot-NNN.png frames, V-OVERVIEW.png (the login overview),
V-SESSION.png (the desktop), assertions.txt ("<ID> pass|fail
<desc>", the format scripts/roost-ledger reads) and manifest.json.
On timeout or failure, prints log excerpts and exits nonzero.

With --tour, once the assertions pass it drives a scripted feature tour
through QMP input (overview and search, app grid, quick settings,
calendar, three apps and Alt+Tab, scroll mode, lock and unlock), screendumps
it twice a second, splices in the title cards from scripts/lib/
vm-tour-cards, and writes tour/roost-tour.webm, tour/preview.webp and a
T-<section>.png still per section (needs ffmpeg with libvpx and libwebp).

Usage:
  scripts/roost-vm-lane --disk DISK.raw [--out DIR] [--timeout S] [--tour]
                        [--meta KEY=VALUE ...]

Needs qemu-system-x86_64 and OVMF; KVM strongly recommended. Reuses the
QMP client from scripts/roost-baseline.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
_loader = importlib.machinery.SourceFileLoader("roost_baseline",
                                               os.path.join(HERE, "roost-baseline"))
_spec = importlib.util.spec_from_loader("roost_baseline", _loader)
baseline = importlib.util.module_from_spec(_spec)
_loader.exec_module(baseline)
_guest_loader = importlib.machinery.SourceFileLoader("vm_guest_agent", os.path.join(HERE, "lib", "vm_guest_agent.py"))
_guest_spec = importlib.util.spec_from_loader("vm_guest_agent", _guest_loader)
guest_agent = importlib.util.module_from_spec(_guest_spec)
_guest_loader.exec_module(guest_agent)

WIDTH, HEIGHT = baseline.WIDTH, baseline.HEIGHT
DRM_RE = re.compile(r"roost-compositor: drm: output (\S+) (\d+)x(\d+)")
SHELL_RE = re.compile(r"roost-shell-gtk: keybindings: ")
EXHAUSTED = "shell supervision: BudgetExhausted"
CARDS = os.path.join(HERE, "lib", "vm-tour-cards")
TOUR_FPS = 2        # frames captured per second during the tour
PLAY_FPS = 4        # playback rate: the tour plays at 2x
CARD_HOLD = 10      # frames a title card is held (2.5 s at PLAY_FPS)
OVMF = ("/usr/share/ovmf/OVMF.fd", "/usr/share/OVMF/OVMF_CODE.fd", "/usr/share/qemu/OVMF.fd")


def log(msg):
    print(f"roost-vm-lane: {msg}", flush=True)


def read_text(path):
    try:
        with open(path, "rb") as fh:
            return fh.read().decode("utf-8", "replace")
    except FileNotFoundError:
        return ""


def excerpt(serial, n=60):
    lines = serial.splitlines()
    interesting = [ln for ln in lines if re.search(
        r"roost|greetd|panicked|session-|Failed|error", ln, re.I)]
    return ("--- last relevant serial lines ---\n" + "\n".join(interesting[-n:]) +
            "\n--- last raw serial lines ---\n" + "\n".join(lines[-40:]))


def read_ppm(path):
    """Parse a binary P6 PPM (QMP screendump's default format)."""
    with open(path, "rb") as fh:
        data = fh.read()
    fields, pos = [], 0
    while len(fields) < 4:
        while data[pos:pos + 1].isspace():
            pos += 1
        if data[pos:pos + 1] == b"#":
            pos = data.index(b"\n", pos) + 1
            continue
        end = pos
        while not data[end:end + 1].isspace():
            end += 1
        fields.append(data[pos:end])
        pos = end
    if fields[0] != b"P6" or int(fields[3]) != 255:
        raise ValueError(f"unexpected PPM header {fields}")
    w, h = int(fields[1]), int(fields[2])
    return w, h, data[pos + 1:pos + 1 + w * h * 3]


def check_panel(path):
    """Black panel strip at y=5 over a non-uniform desktop."""
    w, h, px = read_ppm(path)

    def pixel(x, y):
        i = (y * w + x) * 3
        return px[i], px[i + 1], px[i + 2]

    row = [pixel(x, 5) for x in range(w)]
    black = sum(1 for p in row if max(p) <= 8) / w
    body = {tuple(c >> 4 for c in pixel(x, y))
            for y in range(h // 4, h * 3 // 4, 8) for x in range(0, w, 8)}
    ok = (w, h) == (WIDTH, HEIGHT) and black >= 0.9 and len(body) >= 8
    return ok, f"{w}x{h}, y=5 row {black:.0%} black, {len(body)} body colors"


def run_lifecycle(qmp, agent, out, serial_path, record, orca_contract="distribution"):
    """Actual DRM/logind lifecycle on the final boot, with unchanged app identities."""
    evidence = os.path.join(out, "lifecycle")
    os.makedirs(evidence, exist_ok=True)

    def inventory(label):
        state = agent.run("inventory")
        with open(os.path.join(evidence, f"{label}.json"), "w") as stream:
            json.dump(state, stream, indent=2)
        return state

    def await_state(predicate, timeout=15, label=None):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            state = inventory(label) if label else agent.run("inventory")
            if predicate(state):
                return state
            time.sleep(0.2)
        raise RuntimeError("lifecycle state did not arrive within its deadline")

    def frame(label):
        qmp.frame(os.path.join(evidence, f"{label}.png"))
        ppm = os.path.join(evidence, f"{label}.ppm")
        qmp.cmd("screendump", filename=ppm, format="ppm")
        return read_ppm(ppm)

    def difference(left, right):
        if left[:2] != right[:2]:
            raise RuntimeError("lifecycle frame dimensions changed")
        width, height = left[:2]
        first = width * 64 * 3  # Clock/panel changes are outside the repaint comparison.
        changed = sum(max(abs(a - b) for a, b in zip(left[2][i:i+3], right[2][i:i+3])) > 24
                      for i in range(first, width * height * 3, 3))
        return changed / (width * (height - 64))

    def varied_mask(image):
        # The inactive QEMU placeholder has only two quantized colors.
        width, height, pixels = image
        colors = {tuple(value >> 4 for value in pixels[(y * width + x) * 3:(y * width + x) * 3 + 3])
                  for y in range(64, height, 8) for x in range(0, width, 8)}
        return len(colors) >= 8 and difference(base_frame, image) > 0.25

    def same_apps(before, after, shell=True):
        names = {"roost-compositor", "gnome-disks", "gnome-system-monitor", "nautilus"}
        if shell:
            names.add("roost-shell-gtk")
        identities = lambda value: [p for p in value["processes"] if p["executable"] in names]
        return (before["state"]["windows"] == after["state"]["windows"]
                and identities(before) == identities(after))

    def changed_pixels(left, right, rect):
        if left[:2] != right[:2]:
            raise RuntimeError("client repaint frame dimensions changed")
        x, y, width, height = rect
        image_width, image_height = left[:2]
        changed = 0
        for row in range(max(0, y), min(image_height, y + height)):
            for column in range(max(0, x), min(image_width, x + width)):
                offset = (row * image_width + column) * 3
                changed += max(abs(a - b) for a, b in zip(left[2][offset:offset+3],
                                                          right[2][offset:offset+3])) > 24
        return changed

    agent.run("start-input-probe")
    probe = await_state(lambda state: any(w["app_id"] == "org.roost.VmInput" for w in state["state"]["windows"]), label="input-created")
    probe_window = next(w for w in probe["state"]["windows"] if w["app_id"] == "org.roost.VmInput")
    x, y, width, height = probe_window["rect"]
    # The compositor model can precede the client's first mapped buffer. Its
    # proposed size may also exceed GTK's initial 400x240 buffer: click inside
    # that buffer, then require the real client to observe keyboard activation.
    for require_active in (False, True):
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            readiness = agent.run("input-ready")
            with open(os.path.join(evidence, "input-ready.json"), "w") as stream:
                json.dump(readiness, stream, indent=2)
            if (readiness["mapped"] and readiness["width"] > 100
                    and readiness["height"] > 100
                    and (not require_active or readiness["active"])):
                break
            time.sleep(0.1)
        else:
            raise RuntimeError("real GTK input probe did not map/activate within its deadline")
        if not require_active:
            # Initial model registration precedes place_committed: the first
            # real buffer can move a floating window from its provisional
            # rectangle. Click its current placement, never the pre-map origin.
            probe = inventory("input-mapped")
            probe_window = next(w for w in probe["state"]["windows"]
                                if w["app_id"] == "org.roost.VmInput")
            x, y, width, height = probe_window["rect"]
            click_x = x + min(100, width // 2, readiness["width"] // 2)
            click_y = y + min(100, height // 2, readiness["height"] // 2)
            if not (0 <= click_x < WIDTH and 0 <= click_y < HEIGHT):
                raise RuntimeError("mapped GTK input probe lies outside the output")
            qmp.click(click_x, click_y)
    frame("input-ready")
    initial_input = agent.run("input-count")
    qmp.keys("x")
    time.sleep(0.5)
    delivered_input = agent.run("input-count")
    record("V-NORMAL-INPUT", delivered_input["pid"] == initial_input["pid"]
           and delivered_input["count"] > initial_input["count"],
           "real non-root GTK application receives ordinary QMP keyboard input while unlocked; count only")
    # GNOME's primary-button setting must affect real libinput delivery,
    # including live changes in both directions. Counts contain no input text.
    handedness = []
    try:
        for swapped in (False, True, False):
            if not agent.run("mouse-handedness", str(swapped).lower())["stored"]:
                raise RuntimeError("GNOME primary-button setting did not persist")
            await_state(lambda value: value["state"]["mouse_left_handed"] is swapped,
                        label=f"mouse-handedness-{str(swapped).lower()}")
            for physical, logical in (("left", "3" if swapped else "1"),
                                      ("right", "1" if swapped else "3"),
                                      ("middle", "2")):
                before_click = agent.run("input-buttons")
                qmp.click(click_x, click_y, button=physical)
                deadline = time.monotonic() + 2
                while time.monotonic() < deadline:
                    after_click = agent.run("input-buttons")
                    if after_click["buttons"] != before_click["buttons"]:
                        break
                    time.sleep(0.05)
                expected_buttons = dict(before_click["buttons"])
                expected_buttons[logical] += 1
                ok = (after_click["pid"] == before_click["pid"]
                      and after_click["buttons"] == expected_buttons)
                handedness.append({"swapped": swapped, "physical": physical,
                                   "logical": logical, "before": before_click,
                                   "after": after_click, "ok": ok})
                if not ok:
                    raise RuntimeError(f"physical {physical} did not arrive as logical button {logical}")
        record("V-MOUSE-HANDEDNESS", True,
               "GNOME primary button changes live false→true→false; GTK sees left/right swap and unchanged middle")
    finally:
        agent.run("mouse-handedness", "false")
        with open(os.path.join(evidence, "mouse-handedness.json"), "w") as stream:
            json.dump(handedness, stream, indent=2)
    before = inventory("before")
    expected = {"roost-compositor", "roost-shell-gtk", "gnome-disks", "gnome-system-monitor", "nautilus"}
    nonroot = (before["probe_uid"] == 0 and before["session_uid"] != 0
               and before["session"]["User"] == str(before["session_uid"])
               and before["session"]["Service"] == "greetd"
               and all(p["uid"] == before["session_uid"] for p in before["processes"]))
    intact = expected <= {p["executable"] for p in before["processes"]} and len(before["state"]["windows"]) >= 3
    record("V-LIFECYCLE-OWNER", nonroot and intact, "root probe, non-root greetd session and three real app processes/surfaces")
    if not nonroot or not intact or before["state"]["locked"]:
        raise RuntimeError("lifecycle preconditions failed")
    # Real distribution Orca owns a credential-verified bus name under the ordinary
    # session user. Settings writes trigger Roost's consumer, not test start/stop.
    orca_observations = []
    def await_orca(enabled):
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            actual = agent.run("orca-read")
            orca_observations.append(actual)
            if (actual["enabled"] is enabled
                    and ((enabled and actual["ready"] and actual["state"] == "active")
                         or (not enabled and actual["pid"] == 0 and actual["owner"] is None
                             and actual["state"] == "disabled"))):
                return actual
            time.sleep(0.2)
        raise RuntimeError("GNOME Screen Reader preference did not control genuine distribution Orca")
    try:
        first_orca = None
        for enabled in (False, True, False, True, False):
            agent.run("orca-on" if enabled else "orca-off")
            actual = await_orca(enabled)
            if enabled:
                identity = (actual["pid"], actual["start_ticks"])
                if first_orca == identity:
                    raise RuntimeError("Orca retained the stopped process identity")
                first_orca = identity
        rapid = agent.run("orca-rapid-toggle")
        with open(os.path.join(evidence, "orca-rapid-toggle.json"), "w") as stream:
            json.dump(rapid, stream, indent=2)
        samples = rapid["samples"]
        progress = samples[0]["elapsed"]
        longest = 0
        previous_frames = samples[0]["frames"]
        for sample in samples[1:]:
            longest = max(longest, sample["elapsed"] - progress)
            if sample["frames"] > previous_frames:
                progress = sample["elapsed"]
                previous_frames = sample["frames"]
        if samples[-1]["frames"] <= samples[0]["frames"] or longest > 0.75:
            raise RuntimeError("genuine Orca rapid preference toggles stalled native frame progress")
        await_orca(False)
        agent.run("orca-on")
        reader = await_orca(True)
        keyboard = reader["keyboard"]
        if not keyboard or keyboard["reader_pid"] != reader["pid"] or not keyboard["watch"] or not (keyboard["modifier_count"] or keyboard["keystroke_count"]):
            raise RuntimeError("genuine Orca did not establish native keyboard monitoring/grabs")
        negative = agent.run("orca-keyboard-negative")
        with open(os.path.join(evidence, "orca-keyboard-negative.json"), "w") as stream:
            json.dump(negative, stream, indent=2)
        if not negative["denied"] or negative["before"] != negative["after"]:
            raise RuntimeError("same-user non-reader obtained or changed native keyboard authority")
        if orca_contract == "upstream51":
            provenance = agent.run("orca-provenance")
            with open(os.path.join(evidence, "orca51-runtime-provenance.json"), "w") as stream:
                json.dump(provenance, stream, indent=2)
            if not provenance["qualified"]:
                raise RuntimeError("upstream51 lane lacks actual packaged 51/AT-SPI override/version provenance")
            start_speech = agent.run("orca-speech-start")
            time.sleep(0.4)
            qmp.keys("insert-h")
            time.sleep(1.2)
            learn = agent.run("orca-read")
            if not learn["keyboard"]["grab_all"]:
                raise RuntimeError("real Orca modifier command did not enter learned keyboard grab")
            qmp.keys("shift-f4")
            time.sleep(1.4)
            qmp.keys("esc")
            time.sleep(1.1)
            speech = agent.run("orca-speech-end")
            import base64
            import array
            import wave
            pcm = base64.b64decode(speech.pop("pcm"), validate=True)
            with wave.open(os.path.join(evidence, "orca-native-command.wav"), "wb") as stream:
                stream.setnchannels(1)
                stream.setsampwidth(2)
                stream.setframerate(24000)
                stream.writeframes(pcm)
            with open(os.path.join(evidence, "orca-native-command.json"), "w") as stream:
                json.dump({"start": start_speech, "learn": learn, "end": speech}, stream, indent=2)
            values = array.array("h")
            values.frombytes(pcm)
            spoken = " ".join(entry.get("text", "") for entry in speech["speech"] if entry.get("kind") == "speech").lower()
            if len(values) < 24000 or max((abs(v) for v in values), default=0) <= 32 or "learn mode" not in spoken or speech["orca"]["keyboard"]["grab_all"]:
                raise RuntimeError("native Orca command lacked paired genuine presenter/PCM evidence or failed to ungrab")
            if not any("speech" in stream.get("application.process.binary", "") or "sd_" in stream.get("application.process.binary", "") for stream in speech["streams"]):
                raise RuntimeError("no genuine Speech Dispatcher output stream accompanied Orca command")
            record("V-ORCA-NATIVE-KEYBOARD", True,
                   "genuine Insert+h enters learn mode, shifted key is consumed, Escape ungrabs; upstream JSONL paired with real Speech Dispatcher/PipeWire PCM")
        agent.run("orca-off")
        await_orca(False)
        record("V-ORCA-ACTIVATION", True,
               "live GNOME key starts/stops genuine distribution Orca; bus PID/UID, package hash, compositor parent and display verified")
    finally:
        agent.run("orca-reset")
        with open(os.path.join(evidence, "orca-activation.json"), "w") as stream:
            json.dump(orca_observations, stream, indent=2)

    # Real GNOME sound preference and virtual HDA/PipeWire data, not OSD state.
    amplified_observations = []
    try:
        for mode, expected in (("off", 100.0), ("on", 104.0), ("high", 152.52), ("off", 100.0)):
            initial = agent.run("audio-amplification-" + mode)
            time.sleep(0.3)
            qmp.keys("volumeup")
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                actual = agent.run("audio-amplification-read")
                if (abs(actual["percent"] - expected) < 0.001 and not actual["muted"]
                        and actual["amplified"] == (mode != "off")
                        and actual["sink_id"] == initial["sink_id"]
                        and actual["sink_name"].startswith("alsa_output")):
                    break
                time.sleep(0.2)
            else:
                raise RuntimeError("live GNOME overamplification did not update the real PipeWire sink")
            amplified_observations.append(actual)
        with open(os.path.join(evidence, "audio-amplification.json"), "w") as stream:
            json.dump(amplified_observations, stream, indent=2)
        record("V-AUDIO-AMPLIFICATION", True,
               "real HDA/PipeWire output obeys live disable/enable, GNOME +11dB ceiling and disable reset")
    finally:
        agent.run("audio-amplification-reset")

    # Capture the stable desktop after the final key OSD has disappeared.
    time.sleep(2)

    base_frame = frame("before-vt")
    vt = int(before["session"]["VTNr"])
    away = 2 if vt != 2 else 3
    offset = len(read_text(serial_path))
    switched = agent.run("vt", away)
    time.sleep(2)
    frame("vt-away")
    returned = agent.run("vt", vt)
    time.sleep(3)
    after_vt = inventory("after-vt")
    vt_frame = frame("after-vt")
    delta = difference(base_frame, vt_frame)
    events = read_text(serial_path)[offset:]
    qmp.keys("x")
    deadline = time.monotonic() + 5
    repaint_pixels = 0
    updated_input = delivered_input
    while time.monotonic() < deadline:
        updated_input = agent.run("input-count")
        repaint_pixels = changed_pixels(vt_frame, frame("vt-client-repaint"), probe_window["rect"])
        if (updated_input["pid"] == delivered_input["pid"]
                and updated_input["count"] > delivered_input["count"] and repaint_pixels >= 8):
            break
        time.sleep(0.1)
    repainted = (updated_input["pid"] == delivered_input["pid"]
                 and updated_input["count"] > delivered_input["count"] and repaint_pixels >= 8)
    delivered_input = updated_input
    record("V-VT", switched["active_vt"] == f"tty{away}" and returned["active_vt"] == f"tty{vt}"
           and "drm: session paused" in events and "drm: session activated" in events
           and same_apps(before, after_vt) and delta < 0.20 and repainted,
           f"actual VT away/back, exact app/process identities, body difference {delta:.2%}, fresh count/client repaint {repaint_pixels} pixels")

    def suspend_and_check(label="", test_id="V-SUSPEND"):
        def gpu_snapshot(phase):
            # Retain device/console selection alongside guest DRM ownership.
            # QEMU monitor output contains hardware configuration, not app input.
            with open(os.path.join(evidence, f"{label}{phase}-gpu.json"), "w") as stream:
                json.dump({"pci": qmp.cmd("query-pci"),
                           "device_tree": qmp.cmd("human-monitor-command",
                                                  **{"command-line": "info qtree"})[:65536],
                           "guest": agent.run("diagnostics")}, stream, indent=2)

        gpu_snapshot("before-suspend")
        with open(os.path.join(evidence, f"{label}before-suspend-gpu.json")) as stream:
            caps = json.load(stream)["guest"]["gpu_pci_caps"]
        pm_ready = (len(caps) == 1 and all(item["pcie_capability"] and item["pm_capability"]
                                         and item["no_soft_reset"] for item in caps.values()))
        record(f"{test_id}-GPU-PM", pm_ready,
               "actual guest PCIe GPU advertises PM no-soft-reset; shared preserved-resource profile")
        if not pm_ready:
            raise RuntimeError("guest GPU lacks the required actual PM preservation capability")
        gpu_events = ("virtio_gpu_cmd_set_scanout", "virtio_gpu_cmd_res_create_2d",
                      "virtio_gpu_cmd_res_unref", "virtio_gpu_cmd_res_back_attach",
                      "virtio_gpu_cmd_res_back_detach")
        for event in gpu_events:
            qmp.cmd("trace-event-set-state", name=event, enable=True)
        gpu_log = os.path.join(out, "qemu-gpu-resource.log")
        with open(os.path.join(evidence, f"{label}gpu-trace-start.json"), "w") as stream:
            json.dump({"log": os.path.basename(gpu_log), "offset": os.path.getsize(gpu_log)
                       if os.path.exists(gpu_log) else 0, "events": gpu_events}, stream, indent=2)
        request = agent.run("suspend")
        with open(os.path.join(evidence, f"{label}suspend-request.json"), "w") as stream:
            json.dump(request, stream, indent=2)
        deadline = time.monotonic() + 30
        suspended = False
        while time.monotonic() < deadline:
            if qmp.cmd("query-status")["status"] == "suspended":
                suspended = True
                break
            time.sleep(0.2)
        if not suspended:
            record(test_id, False, "logind suspend never reached QEMU SUSPENDED; no pause substitute")
            raise RuntimeError("real suspend did not occur")
        suspended_frame = frame(f"{label}suspended")
        wake_trace_offset = os.path.getsize(gpu_log) if os.path.exists(gpu_log) else 0
        with open(os.path.join(evidence, f"{label}gpu-trace-wake.json"), "w") as stream:
            json.dump({"log": os.path.basename(gpu_log), "offset": wake_trace_offset}, stream, indent=2)
        qmp.cmd("system_wakeup")
        # The first response after wake must already be locked. Waiting for a
        # later transition would hide an exposed desktop during resume.
        resumed = inventory(f"{label}first-resume")
        resumed_frame = frame(f"{label}first-resume")
        if not resumed["state"]["locked"]:
            record(test_id, False, "first resume snapshot exposed an unlocked session")
            raise RuntimeError("first resume snapshot exposed an unlocked session")
        # QEMU's inactive-output placeholder differs from the desktop too. While
        # every state remains locked, observe whether the actual varied lock
        # mask repaints. Mask paint is platform GPU behavior, not a gate:
        # S3 resume can leave scanout black with no errors while locked.
        deadline = time.monotonic() + 5
        repainted = False
        while True:
            repainted = (varied_mask(resumed_frame)
                         and difference(suspended_frame, resumed_frame) < 0.20)
            if repainted or time.monotonic() >= deadline:
                break
            time.sleep(0.1)
            state = inventory(f"{label}resume-repaint")
            if not state["state"]["locked"] or not same_apps(before, state):
                raise RuntimeError("resume repaint exposed or replaced the session")
            resumed_frame = frame(f"{label}resumed-locked")
        gpu_snapshot("post-resume")
        if os.path.exists(gpu_log):
            with open(gpu_log, "rb") as stream:
                stream.seek(wake_trace_offset)
                uploaded = stream.read().decode("utf-8", errors="replace")
        else:
            uploaded = ""
        queues_alive = ("virtio_gpu_cmd_res_create_2d" in uploaded
                        and "virtio_gpu_cmd_res_back_attach" in uploaded
                        and bool(re.search(r"virtio_gpu_cmd_set_scanout id 0, res 0x[1-9a-f]", uploaded)))
        record(f"{test_id}-GPU-UPLOAD", queues_alive,
               "host trace receives fresh resource creation, backing attachment and nonzero scanout after actual wake")
        fail_closed = (same_apps(before, resumed)
                       and difference(base_frame, resumed_frame) > 0.25)
        record(test_id, fail_closed,
               f"actual SUSPENDED → system_wakeup, first state locked, fail-closed (differs from desktop), unchanged app IDs/rectangles and process start times")
        log(f"{test_id}-MASK observation (non-gating): real lock mask repainted={repainted}")
        if not fail_closed or not queues_alive:
            raise RuntimeError("resume exposed/replaced the session or fresh host GPU uploads are missing")

        return resumed

    # Preserve the authorized single-S3 contract for this performance lane.
    # It combines plain and stale-auth wake checks with a prelocked session;
    # the main lifecycle lane separately qualified prepare-for-sleep locking
    # from an unlocked desktop. Keep fresh GPU upload and client repaint gates.
    # Submit a correct password to a real delayed PAM stack before sleep.
    # Its later success must not unlock the new sleep-lock generation.
    agent.run("delay-unlock")
    try:
        agent.run("lock")
        await_state(lambda state: state["state"]["locked"])
        qmp.keys("esc")
        qmp.keys("ret")
        time.sleep(1)
        qmp.keys("ctrl", "a")
        qmp.type_text("roost")
        stale_auth_offset = len(read_text(serial_path))
        qmp.keys("ret")
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if agent.run("delayed-auth-state")["real_pam_delay_running"]:
                break
            time.sleep(0.1)
        else:
            raise RuntimeError("actual PAM delay child did not start before suspend")
    finally:
        # The executing PAM context has already loaded its real stack.
        agent.run("restore-unlock")
    resumed = suspend_and_check()
    deadline = time.monotonic() + 25
    stale_rejected = False
    while time.monotonic() < deadline:
        state = inventory("sleep-auth-pending")
        if not state["state"]["locked"] or not same_apps(before, state):
            record("V-SLEEP-AUTH-FAIL-CLOSED", False, "pre-sleep PAM result exposed or replaced the session")
            raise RuntimeError("pre-sleep authentication unlocked the resumed session")
        trace = read_text(serial_path)[stale_auth_offset:]
        stale_rejected = ("lock authentication finished accepted=true applied=false" in trace
                          and "roost-shell-gtk: lock command result applied=false" in trace)
        if stale_rejected:
            break
        time.sleep(0.2)
    record("V-SLEEP-AUTH-FAIL-CLOSED", stale_rejected,
           "real delayed PAM accepts correct pre-sleep password, but stale generation is refused and locked apps stay intact")
    if not stale_rejected:
        raise RuntimeError("actual successful pre-sleep PAM rejection was not observed")
    qmp.keys("ctrl", "a")
    qmp.type_text("roost")
    qmp.keys("ret")
    fresh = await_state(lambda state: not state["state"]["locked"], timeout=15)
    record("V-SLEEP-FRESH-AUTH", same_apps(before, fresh),
           "fresh correct PAM submission after stale-result refusal unlocks the same session")
    client_before = frame("resume-client-before")
    qmp.click(x + width // 2, y + height // 2)
    qmp.keys("x")
    deadline = time.monotonic() + 5
    resume_pixels = 0
    while time.monotonic() < deadline:
        updated_input = agent.run("input-count")
        resume_pixels = changed_pixels(client_before, frame("resume-client-repaint"), probe_window["rect"])
        if (updated_input["pid"] == delivered_input["pid"]
                and updated_input["count"] > delivered_input["count"] and resume_pixels >= 8):
            break
        time.sleep(0.1)
    record("V-SLEEP-CLIENT-REPAINT", updated_input["pid"] == delivered_input["pid"]
           and updated_input["count"] > delivered_input["count"] and resume_pixels >= 8,
           f"same real GTK app receives fresh keyboard input and repaints {resume_pixels} pixels after wake/unlock")
    delivered_input = updated_input
    agent.run("lock")
    await_state(lambda state: state["state"]["locked"])
    time.sleep(1)
    qmp.type_text("probe")
    time.sleep(0.5)
    locked_input = agent.run("input-count")
    record("V-NORMAL-INPUT-FAIL-CLOSED", locked_input == delivered_input,
           "same real GTK client receives no ordinary QMP keys while locked; no key values recorded")
    capture = agent.run("capture-input")
    rejected = lambda code: 0 < code < 124  # A hung or unconnectable probe is not a denial proof.
    record("V-CAPTURE-INPUT-FAIL-CLOSED", capture["connect_exit"] == 0
           and rejected(capture["capture_exit"]) and rejected(capture["input_exit"])
           and not capture["capture_file"] and inventory("capture-denied")["state"]["locked"],
           "reachable untrusted real grim/wtype clients are denied capture/virtual-keyboard interfaces while locked")
    # Repeat the real VT transition with the lock engaged, not only on the desktop.
    agent.run("vt", away)
    time.sleep(1)
    agent.run("vt", vt)
    time.sleep(2)
    locked_vt = inventory("locked-vt")
    record("V-VT-FAIL-CLOSED", locked_vt["state"]["locked"] and same_apps(before, locked_vt)
           and varied_mask(frame("locked-vt")),
           "VT away/back while locked repaints the mask and preserves app/process identities")

    agent.run("deny-unlock")
    try:
        qmp.keys("esc")
        qmp.keys("ret")
        time.sleep(1)
        qmp.keys("ctrl", "a")
        qmp.type_text("roost")
        auth_offset = len(read_text(serial_path))
        qmp.keys("ret")
        time.sleep(12)
        denied = inventory("pam-denied")
        auth_trace = read_text(serial_path)[auth_offset:]
        attempted = ("roost-shell-gtk: lock password submitted" in auth_trace
                     and "roost-shell-gtk: lock command result applied=false" in auth_trace)
        record("V-AUTH-FAIL-CLOSED", attempted and denied["state"]["locked"] and same_apps(before, denied),
               "fresh submitted/refused milestones: real pam_deny service rejects the correct fixture password; apps remain inaccessible")
    finally:
        agent.run("restore-unlock")
    agent.run("stop-portal")
    agent.run("kill-shell")
    killed_mask = varied_mask(frame("shell-killed"))
    recovered = await_state(lambda state: state["state"]["locked"] and
                            any(p["executable"] == "roost-shell-gtk" and p not in resumed["processes"]
                                for p in state["processes"]), timeout=30, label="shell-recovering")
    time.sleep(2)
    recovered = inventory("shell-recovered")
    record("V-SHELL-FAIL-CLOSED", killed_mask and recovered["state"]["locked"] and same_apps(before, recovered, shell=False)
           and agent.run("input-count") == delivered_input
           and varied_mask(frame("shell-recovered")),
           "portal stopped and lock UI killed; supervisor replacement stays locked/masked with original apps alive")
    qmp.keys("ret")
    time.sleep(1)
    qmp.keys("ctrl", "a")
    qmp.type_text("roost")
    qmp.keys("ret")
    await_state(lambda state: not state["state"]["locked"])
    inventory("authenticated")
    agent.run("orca-on")
    departing_orca = await_orca(True)
    with open(os.path.join(evidence, "orca-before-logout.json"), "w") as stream:
        json.dump(departing_orca, stream, indent=2)
    agent.run("logout")
    deadline = time.monotonic() + 30
    greeter = {}
    greeter_visible = False
    while time.monotonic() < deadline:
        greeter = agent.run("greeter")
        if greeter["greetd_active"] and greeter["greeter_pids"] and not greeter["compositor_pids"]:
            width, height, pixels = frame("logout-greeter")
            # The CI greeter stylesheet has a #222226 window background.
            # Require that painted surface plus visible light controls/text;
            # process startup, a black scanout or a uniform fill cannot pass.
            background = sum(all(abs(pixels[i + channel] - value) <= 4
                                 for channel, value in enumerate((34, 34, 38)))
                             for i in range(0, len(pixels), 3)) / (width * height)
            light = sum(min(pixels[i:i + 3]) > 160 for i in range(0, len(pixels), 3))
            greeter["paint"] = {"background_fraction": background, "light_pixels": light}
            greeter_visible = background > 0.25 and light >= 100
            if greeter_visible:
                break
        time.sleep(0.5)
    with open(os.path.join(evidence, "greeter.json"), "w") as stream:
        json.dump(greeter, stream, indent=2)
    record("V-LOGOUT", greeter_visible,
           "real session termination returns to a painted gtkgreet surface under active greetd, with no original compositor")
    closed_orca = agent.run("orca-departed", departing_orca["pid"], departing_orca["start_ticks"])
    with open(os.path.join(evidence, "orca-after-logout.json"), "w") as stream:
        json.dump(closed_orca, stream, indent=2)
    record("V-ORCA-LOGOUT", closed_orca["owner"] is None and not closed_orca["original_alive"],
           "hardware logout stops only session-owned Orca; no original child/bus owner survives")
    if closed_orca["owner"] is not None or closed_orca["original_alive"]:
        raise RuntimeError("Orca survived the hardware session logout")
    if not greeter_visible:
        raise RuntimeError("live gtkgreet did not paint its actual visible surface after logout")
    record("V-LIFECYCLE", True, "all lifecycle operations completed; individual assertions remain mandatory")


class Recorder:
    """Screendump the VM TOUR_FPS times a second into numbered PNGs while
    the tour drives input; marks splice a title card in at a frame index."""

    def __init__(self, qmp, out):
        self.qmp, self.dir = qmp, os.path.join(out, "frames")
        os.makedirs(self.dir, exist_ok=True)
        self.lock, self.stop, self.n, self.marks = threading.Lock(), threading.Event(), 0, []
        self.stills = {}
        cmd = qmp.cmd

        def locked(command, **args):
            with self.lock:
                return cmd(command, **args)
        qmp.cmd = locked
        self.thread = threading.Thread(target=self._run, daemon=True)

    def _run(self):
        while not self.stop.is_set():
            t = time.time()
            try:
                self.qmp.cmd("screendump", filename=os.path.join(self.dir, f"f{self.n:06d}.png"),
                             format="png")
                self.n += 1
            except (OSError, RuntimeError, ValueError) as e:
                log(f"tour: screendump failed: {e}")
            self.stop.wait(max(0.0, 1 / TOUR_FPS - (time.time() - t)))

    def mark(self, card):
        log(f"tour: {card}")
        self.marks.append((self.n, card))

    def still(self, card, delay=0.0):
        """Keep the next captured frame as this section's still."""
        time.sleep(delay)
        self.stills[card] = self.n + 1


def run_tour(qmp, out, serial_path):
    """Scripted feature tour through QMP input, recorded to a WebM with a
    title card per section. Returns a manifest entry."""
    tour = os.path.join(out, "tour")
    scratch = os.path.join(tour, ".work")
    os.makedirs(scratch, exist_ok=True)
    rec = Recorder(qmp, scratch)
    keys, wait = qmp.keys, time.sleep

    def launch(query):
        keys("meta_l")
        wait(1.5)
        qmp.type_text(query)
        wait(2.5)
        keys("ret")
        wait(7)

    rec.thread.start()
    try:
        rec.mark("intro")
        wait(4)
        rec.still("intro")
        rec.mark("overview")
        keys("esc")
        wait(2)
        keys("meta_l")
        wait(2.5)
        qmp.type_text("files")
        wait(3)
        rec.still("overview")
        keys("esc")
        wait(1)
        keys("esc")
        wait(2)
        rec.mark("app-grid")
        keys("meta_l", "a")
        wait(4)
        rec.still("app-grid")
        keys("esc")
        wait(1)
        keys("esc")
        wait(2)
        # Actual PipeWire sink on the virtual HDA device. Guest health
        # samples each completed mutation; allow a sample between keys.
        for media_key in ("volumeup", "volumedown", "audiomute", "audiomute"):
            keys(media_key)
            wait(3)
        rec.mark("quick-settings")
        qmp.click(WIDTH - 40, 12)
        wait(4)
        rec.still("quick-settings")
        keys("esc")
        wait(2)
        rec.mark("calendar")
        qmp.click(WIDTH // 2, 12)
        wait(4)
        rec.still("calendar")
        keys("esc")
        wait(2)
        # Apps the Marlin GNOME image ships (its app grid has no Text
        # Editor, and Settings opens slowly outside gnome-session).
        rec.mark("alt-tab")
        for query in ("disks", "system monitor", "files"):
            launch(query)
        keys("alt", "tab", hold_ms=1500)
        rec.still("alt-tab", delay=1.0)
        wait(3)
        keys("alt", "tab", hold_ms=1500)
        wait(3)
        rec.mark("scroll")
        keys("meta_l", "shift", "t")
        wait(3)
        keys("meta_l", "r")
        wait(2.5)
        keys("meta_l", "left")
        wait(2.5)
        rec.still("scroll")
        keys("meta_l", "left")
        wait(2.5)
        keys("meta_l", "right")
        wait(2.5)
        keys("meta_l", "shift", "t")
        wait(3)
        # Exercise the hardware shortcut and the real PAM unlock stack.
        rec.mark("lock")
        keys("meta_l", "l")
        wait(5)
        rec.still("lock")
        # Shift alone intentionally leaves GNOME's curtain in place.
        # Return reveals the focused prompt without adding a character.
        keys("ret")
        wait(2)
        keys("ctrl", "a")
        qmp.type_text("roost")
        wait(1)
        serial_offset = len(read_text(serial_path))
        keys("ret")
        # PAM is asynchronous and has a ten-second deadline. Observe the
        # actual authenticated unlock, rather than stopping after five seconds.
        deadline = time.monotonic() + 15
        unlocked = False
        while time.monotonic() < deadline:
            if "roost-vm-health: lock active=(false,)" in read_text(serial_path)[serial_offset:]:
                unlocked = True
                break
            wait(0.2)
        if not unlocked:
            log("tour: PAM unlock did not arrive within 15 seconds")
            qmp.frame(os.path.join(out, "V-UNLOCK-FAILED.png"))
        wait(1)
    finally:
        rec.stop.set()
        rec.thread.join(timeout=10)

    # Final sequence: captured frames with CARD_HOLD copies of each card
    # spliced in at its mark. Cards are converted to RGB at the capture
    # size so ffmpeg sees one pixel format throughout.
    seq = os.path.join(scratch, "seq")
    os.makedirs(seq, exist_ok=True)
    cards, at = {}, {}
    for idx, card in rec.marks:
        at.setdefault(idx, []).append(card)
    count = 0

    def put(src):
        nonlocal count
        dst = os.path.join(seq, f"f{count:06d}.png")
        try:
            os.link(src, dst)
        except OSError:
            shutil.copyfile(src, dst)
        count += 1

    for i in range(rec.n + 1):
        for card in at.get(i, []):
            if card not in cards:
                dst = os.path.join(scratch, f"card-{card}.png")
                subprocess.run(["ffmpeg", "-loglevel", "error", "-y",
                                "-i", os.path.join(CARDS, f"{card}.png"),
                                "-vf", f"scale={WIDTH}:{HEIGHT}", "-pix_fmt", "rgb24", dst],
                               check=True)
                cards[card] = dst
            for _ in range(CARD_HOLD):
                put(cards[card])
        frame = os.path.join(rec.dir, f"f{i:06d}.png")
        if os.path.exists(frame) and os.path.getsize(frame) > 0:
            put(frame)
    pattern = os.path.join(seq, "f%06d.png")
    webm = os.path.join(tour, "roost-tour.webm")
    subprocess.run(["ffmpeg", "-loglevel", "warning", "-y", "-framerate", str(PLAY_FPS),
                    "-i", pattern, "-c:v", "libvpx-vp9", "-crf", "36", "-b:v", "0", "-row-mt", "1", "-cpu-used", "4",
                    "-pix_fmt", "yuv420p", webm], check=True)
    subprocess.run(["ffmpeg", "-loglevel", "warning", "-y", "-framerate", str(PLAY_FPS),
                    "-i", pattern, "-vf", "scale=640:-2:flags=lanczos", "-loop", "0",
                    "-c:v", "libwebp", "-quality", "60", "-compression_level", "6",
                    os.path.join(tour, "preview.webp")], check=False)
    for card, idx in rec.stills.items():
        frame = os.path.join(rec.dir, f"f{min(idx, rec.n - 1):06d}.png")
        if os.path.exists(frame):
            shutil.copyfile(frame, os.path.join(tour, f"T-{card}.png"))
    shutil.rmtree(scratch, ignore_errors=True)
    ok = os.path.exists(webm) and os.path.getsize(webm) > 0
    log(f"tour: {rec.n} frames, {len(rec.marks)} sections -> {webm if ok else 'NO VIDEO'}")
    return {"video": "tour/roost-tour.webm" if ok else None, "frames": rec.n,
            "sections": [c for _, c in rec.marks], "capture_fps": TOUR_FPS,
            "playback_fps": PLAY_FPS}


def boot(disk, out, scratch, timeout, *, guest_agent=False):
    ovmf = next((p for p in OVMF if os.path.exists(p)), None)
    if not ovmf:
        sys.exit("roost-vm-lane: OVMF firmware not found (install ovmf)")
    kvm = os.access("/dev/kvm", os.R_OK | os.W_OK)
    qmp_path = os.path.join(scratch, "qmp.sock")
    agent_path = os.path.join(scratch, "qga.sock")
    serial = os.path.join(out, "serial.log")
    qemu = ["qemu-system-x86_64", "-machine", "q35", "-m", "6144", "-smp", "4",
            "-bios", ovmf, "-snapshot",
            "-drive", f"file={disk},format=raw,if=virtio,cache=unsafe",
            *baseline.gpu_devices(),
            "-device", "qemu-xhci", "-device", "usb-tablet", "-device", "usb-kbd",
            # The virtio keyboard carries multimedia evdev codes; USB's
            # boot-protocol keyboard has no consumer-control usages.
            "-device", "virtio-keyboard-pci",
            "-audiodev", "none,id=roost-audio",
            "-device", "ich9-intel-hda",
            "-device", "hda-duplex,audiodev=roost-audio",
            "-display", "none", "-serial", f"file:{serial}",
            "-qmp", f"unix:{qmp_path},server=on,wait=off",
            "-nic", "user,model=virtio-net-pci"]
    if guest_agent:
        qemu.extend(["-device", "virtio-serial-pci",
                     "-chardev", f"socket,path={agent_path},server=on,wait=off,id=roost-qga",
                     "-device", "virtserialport,chardev=roost-qga,name=org.qemu.guest_agent.0",
                     "-D", os.path.join(out, "qemu-gpu-resource.log")])
    if kvm:
        qemu[1:1] = ["-enable-kvm", "-cpu", "host"]
    log(f"booting {disk} (kvm={kvm})")
    result = subprocess.Popen(qemu), qmp_path, serial, kvm
    return (*result, agent_path) if guest_agent else result


def repeat_boots(args):
    """Keep per-boot evidence and aggregate gates for the parity ledger."""
    out = os.path.abspath(args.out)
    os.makedirs(out, exist_ok=True)
    manifests, combined = [], {}
    for index in range(1, args.boots + 1):
        target = out if index == args.boots else os.path.join(out, f"repeat-{index:02d}")
        command = [sys.executable, __file__, "--disk", args.disk, "--out", target,
                   "--timeout", str(args.timeout)]
        if args.tour and index == args.boots:
            command.append("--tour")
        command.extend(["--orca-contract", args.orca_contract])
        for value in args.meta:
            command.extend(["--meta", value])
        result = subprocess.run(command, check=False)
        path = os.path.join(target, "manifest.json")
        if not os.path.exists(path):
            sys.exit(f"roost-vm-lane: boot {index} produced no manifest")
        with open(path) as stream:
            manifest = json.load(stream)
        manifests.append(manifest)
        for name, assertion in manifest["assertions"].items():
            combined[name] = combined.get(name, True) and assertion["pass"]
        if result.returncode:
            break
    combined["V-REPEAT"] = len(manifests) == args.boots and all(combined.values())
    with open(os.path.join(out, "repeat-manifest.json"), "w") as stream:
        json.dump({"requested_boots": args.boots, "boots": manifests}, stream, indent=2)
    with open(os.path.join(out, "assertions.txt"), "w") as stream:
        for name, passed in combined.items():
            stream.write(f"{name} {'pass' if passed else 'fail'} repeated pristine boots ({len(manifests)}/{args.boots})\n")
    if not all(combined.values()):
        sys.exit("roost-vm-lane: repeated boot gate failed")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--disk", required=True)
    ap.add_argument("--out", default="vm-lane-artifacts")
    ap.add_argument("--timeout", type=int, default=900)
    ap.add_argument("--tour", action="store_true",
                    help="after the assertions, record the feature tour video")
    ap.add_argument("--meta", action="append", default=[], metavar="KEY=VALUE")
    ap.add_argument("--orca-contract", choices=("distribution", "upstream51"), default="distribution",
                    help="required reader qualification variant; upstream51 requires genuine packaged 51 principal/speech proof")
    ap.add_argument("--boots", type=int, default=1,
                    help="repeat pristine snapshot boots; tour only on the last boot")
    a = ap.parse_args()
    if not 1 <= a.boots <= 10:
        ap.error("--boots must be between 1 and 10")
    if a.boots > 1:
        repeat_boots(a)
        return
    out = os.path.abspath(a.out)
    scratch = os.path.join(out, ".scratch")
    os.makedirs(scratch, exist_ok=True)
    results = {}

    def record(test_id, ok, desc):
        results[test_id] = (ok, desc)
        log(f"{test_id} {'pass' if ok else 'FAIL'}: {desc}")

    vm, qmp_path, serial_path, kvm, agent_path = boot(os.path.abspath(a.disk), out, scratch, a.timeout, guest_agent=True)
    start = time.time()
    drm = shell = None
    elapsed = 0.0
    tour_info = None
    panel_desc = "never checked"
    tour_serial_end = None
    manager_ready = False
    try:
        qmp = baseline.Qmp(qmp_path)
        n = 0
        while time.time() - start < a.timeout and vm.poll() is None:
            text = read_text(serial_path)
            drm = drm or DRM_RE.search(text)
            shell = shell or SHELL_RE.search(text)
            if n % 3 == 0:
                qmp.frame(os.path.join(out, f"boot-{n // 3:03d}.png"))
            n += 1
            if EXHAUSTED in text or "panicked" in text:
                log("shell supervision gave up or something panicked")
                break
            if drm and shell:
                break
            time.sleep(5)
        elapsed = time.time() - start
        if drm and shell:
            log(f"session up after {elapsed:.0f}s; letting the shell settle")
            time.sleep(30)
            # roost-session opens on the overview, where the panel is
            # transparent as in GNOME; keep that frame, then Escape to the
            # desktop, where the panel is the solid black strip.
            qmp.frame(os.path.join(out, "V-OVERVIEW.png"))
            qmp.keys("esc")
            time.sleep(3)
            for attempt in range(8):
                ppm = os.path.join(scratch, f"session-{attempt}.ppm")
                qmp.cmd("screendump", filename=ppm, format="ppm")
                for _ in range(50):
                    if os.path.exists(ppm) and os.path.getsize(ppm) > 0:
                        break
                    time.sleep(0.1)
                qmp.frame(os.path.join(out, "V-SESSION.png"))
                ok, panel_desc = check_panel(ppm)
                if ok:
                    break
                time.sleep(5)
            else:
                ok = False
            record("V-PANEL", ok, f"screendump: {panel_desc}")
            agent = None
            try:
                agent = guest_agent.GuestAgent(agent_path)
                owner = agent.run("inventory")
                manager_ready = (owner["probe_uid"] == 0 and owner["session_uid"] != 0
                                 and owner["session"]["User"] == str(owner["session_uid"])
                                 and owner["session"]["Service"] == "greetd"
                                 and any(p["executable"] == "roost-compositor" and p["uid"] == owner["session_uid"]
                                         for p in owner["processes"]))
                with open(os.path.join(out, "session-owner.json"), "w") as stream:
                    json.dump(owner, stream, indent=2)
            except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
                log(f"guest session ownership probe failed: {error}")
            finally:
                if agent is not None:
                    agent.close()
            if a.tour:
                try:
                    tour_info = run_tour(qmp, out, serial_path)
                    tour_serial_end = len(read_text(serial_path))
                    agent = guest_agent.GuestAgent(agent_path)
                    try:
                        run_lifecycle(qmp, agent, out, serial_path, record, a.orca_contract)
                    finally:
                        agent.close()
                except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as e:
                    record("V-LIFECYCLE", False, f"tour/lifecycle failed: {e}")
                    try:
                        diagnostic_agent = guest_agent.GuestAgent(agent_path)
                        try:
                            diagnostics = diagnostic_agent.run("diagnostics")
                            with open(os.path.join(out, "lifecycle-failure-diagnostics.json"), "w") as stream:
                                json.dump(diagnostics, stream, indent=2)
                        finally:
                            diagnostic_agent.close()
                    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
                        log(f"bounded lifecycle failure diagnostics unavailable: {error}")
        # Give activation probes a bounded chance to report before shutdown.
        deadline = time.time() + 180
        while drm and shell and time.time() < deadline:
            text = read_text(serial_path)
            if all(f"roost-vm-health: {name} ready" in text for name in ("calendar", "portal", "portal-gnome")):
                break
            time.sleep(2)
        qmp.cmd("quit")
    finally:
        try:
            vm.wait(timeout=30)
        except subprocess.TimeoutExpired:
            vm.kill()

    text = read_text(serial_path)
    drm = drm or DRM_RE.search(text)
    shell = shell or SHELL_RE.search(text)
    record("V-DRM", bool(drm), f"DRM/KMS output lit: {drm.group(0) if drm else 'no drm: output line'}")
    record("V-SHELL", bool(shell) and EXHAUSTED not in text,
           "roost-shell-gtk started under supervision" if shell
           else "no roost-shell-gtk: keybindings line")
    results.setdefault("V-PANEL", (False, "session never came up, no screendump checked"))
    # GDM starting its greeter on the login VT takes DRM master from the
    # running session; say so instead of leaving a bare pixel failure.
    paused = "roost-compositor: drm: session paused" in text
    greeter = re.search(r"New session '\d+' of user '[^']*' with class 'greeter'", text)
    if paused and not results["V-PANEL"][0]:
        results["V-PANEL"] = (False, results["V-PANEL"][1] + "; Roost lost the display"
                              + (" to a GDM greeter session" if greeter else ""))
    record("V-DISPLAY-MANAGER", manager_ready,
           "real logind greetd session and non-root compositor UID verified; intentional lifecycle VT pauses are permitted")
    for name in ("calendar", "portal", "portal-gnome"):
        record(f"V-{name.upper()}", f"roost-vm-health: {name} ready" in text and (name != "portal" or "roost-vm-health: portal-gnome ready" in text),
               f"guest user bus {name} activation responds")
    if a.tour:
        volumes = re.findall(r"roost-vm-health: volume=(0\.[0-9]+)( \[MUTED\])?", text)
        observed = [(round(float(level), 2), bool(muted)) for level, muted in volumes]
        expected = [(0.40, False), (0.46, False), (0.40, False), (0.40, True), (0.40, False)]
        record("V-MEDIA-VOLUME", "roost-vm-health: audio-hda ready" in text and observed[:5] == expected,
               f"virtual HDA output: up/down/mute/unmute {observed}")
    if a.tour:
        transitions = re.findall(r"roost-vm-health: lock active=\((true|false),\)", text[:tour_serial_end])
        record("V-LOCK", transitions == ["false", "true", "false"],
               f"Super+L and PAM unlock transitions: {transitions}")
    panics = [ln for ln in text.splitlines() if "panicked" in ln]
    record("V-NOPANIC", not panics, panics[0] if panics else "no panicked in serial log")

    with open(os.path.join(out, "roost-lines.log"), "w") as fh:
        fh.writelines(ln + "\n" for ln in text.splitlines() if "roost-" in ln)
    with open(os.path.join(out, "assertions.txt"), "w") as fh:
        for test_id in results:
            ok, desc = results[test_id]
            fh.write(f"{test_id} {'pass' if ok else 'fail'} {desc}\n")
    qemu_version = subprocess.run(["qemu-system-x86_64", "--version"], capture_output=True,
                                  text=True).stdout.splitlines()[0]
    manifest = {
        "lane": "marlin-vm",
        "orca_contract": a.orca_contract,
        "session": "Roost (preview) via CI-only greetd initial session, DRM/KMS backend",
        "disk": os.path.basename(a.disk),
        "resolution": f"{WIDTH}x{HEIGHT}",
        "kvm": kvm,
        "qemu": qemu_version,
        "gpu_profile": baseline.GPU_PROFILE,
        "gpu_devices": baseline.gpu_devices(),
        "session_up_s": round(elapsed) if drm and shell else None,
        "drm_session_paused": paused,
        "captured_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "tour": tour_info,
        "assertions": {k: {"pass": v[0], "detail": v[1]} for k, v in results.items()},
    }
    for kv in a.meta:
        key, _, value = kv.partition("=")
        manifest[key] = value
    with open(os.path.join(out, "manifest.json"), "w") as fh:
        json.dump(manifest, fh, indent=2)
    for name in os.listdir(scratch):
        os.remove(os.path.join(scratch, name))
    os.rmdir(scratch)

    failed = [k for k, (ok, _) in results.items() if not ok]
    if a.tour and not failed and not (tour_info and tour_info["video"]):
        sys.exit("roost-vm-lane: assertions passed but the tour video was not produced")
    if failed:
        print(excerpt(text), file=sys.stderr)
        sys.exit(f"roost-vm-lane: FAILED {', '.join(sorted(failed))} "
                 f"(after {elapsed:.0f}s of {a.timeout}s)")
    log(f"OK: Roost hardware session up on Marlin in {elapsed:.0f}s; artifacts in {out}")


if __name__ == "__main__":
    main()
