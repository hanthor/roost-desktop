#!/bin/sh
# tuna-capture — scripted demo-media capture for the release walkthrough.
#
# Usage:
#   scripts/tuna-capture [--display :N] [--artifacts DIR] [--socket NAME] [--help]
#   scripts/tuna-capture --render-walkthrough vX.Y.Z [--artifacts DIR]
#
# --render-walkthrough stamps docs/walkthrough-template.md into
# docs/walkthrough.md for the given release tag (run by the release
# checklist after uploading the media bundle as release assets).
#
# Drives one nested session per core-tour feature (overview, app-launch,
# tiling-scroll, quick-settings, notifications, lock-screen) under Xvfb,
# recording each with ffmpeg x11grab while replaying the pinned interaction
# sequence, plus one still per feature. Emits <feature>.mp4 + <feature>.png
# under stable names; the same feature yields the same shots every release
# unless the feature changed.
#
# Requires ffmpeg for clips; stills fall back to scrot alone when ffmpeg is
# absent (clips are then skipped, not faked).
set -eu

unset CDPATH

ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
DISPLAY_ARG=""
ARTIFACTS="$ROOT/capture-artifacts"
SOCKET="tuna-capture-$$"
WIDTH=1280
HEIGHT=800

RENDER_TAG=""
# Walkthrough blurbs for the segments whose drivers are still being pinned;
# finalized with the capture segments. Overridable from the environment.
QUICK_SETTINGS_BLURB="${QUICK_SETTINGS_BLURB:-The panel status indicators open menus carrying the quick toggles.}"
NOTIFICATIONS_BLURB="${NOTIFICATIONS_BLURB:-Notification banners stack over the session.}"
LOCK_BLURB="${LOCK_BLURB:-Idle lock blanks the session; any keypress wakes it.}"
# The six-feature core tour. This list is the contract: every segment
# must produce a clip plus a still below, and the walkthrough template
# must link both under the release-asset URL for each name.
SEGMENTS="overview app-launch tiling-scroll notifications quick-settings lock-screen"

check_walkthrough() {
    # Template/segment agreement: adding or renaming a segment must
    # update docs/walkthrough-template.md in the same change, or the
    # release page links media the capture never produced (or the
    # capture produces media no page shows).
    for seg in $SEGMENTS; do
        for ext in mp4 png; do
            if ! grep -q "$seg\\.$ext" "$ROOT/docs/walkthrough-template.md"; then
                echo "tuna-capture: template missing $seg.$ext link" >&2
                exit 1
            fi
        done
    done
}

check_rendered() {
    # Rendered page must have no leftover placeholders: every
    # @VERSION@ and @BLURB@ resolves or the release page ships
    # literal placeholder text.
    if grep -q "@[A-Z_]*@" "$1"; then
        echo "tuna-capture: rendered page has placeholder" >&2
        grep -n "@[A-Z_]*@" "$1" >&2
        exit 1
    fi
}

while [ $# -gt 0 ]; do
    case "$1" in
        --display) DISPLAY_ARG="$2"; shift 2 ;;
        --artifacts) ARTIFACTS="$2"; shift 2 ;;
        --socket) SOCKET="$2"; shift 2 ;;
        --render-walkthrough) RENDER_TAG="$2"; shift 2 ;;
        --help | -h) sed -n '2,14p' "$0"; exit 0 ;;
        *) echo "tuna-capture: unknown argument $1" >&2; exit 1 ;;
    esac
done

if [ -n "$RENDER_TAG" ]; then
    case "$RENDER_TAG" in
        v*) ;;
        *) echo "tuna-capture: tag must look like vX.Y.Z" >&2; exit 1 ;;
    esac
    mkdir -p "$ARTIFACTS"
    sed -e "s/@VERSION@/$RENDER_TAG/g" \
        -e "s/@QUICK_SETTINGS_BLURB@/$QUICK_SETTINGS_BLURB/g" \
        -e "s/@NOTIFICATIONS_BLURB@/$NOTIFICATIONS_BLURB/g" \
        -e "s/@LOCK_BLURB@/$LOCK_BLURB/g" \
        "$ROOT/docs/walkthrough-template.md" >"$ROOT/docs/walkthrough.md"
    check_walkthrough
    check_rendered "$ROOT/docs/walkthrough.md"
    echo "tuna-capture: rendered docs/walkthrough.md for $RENDER_TAG"
    exit 0
fi

mkdir -p "$ARTIFACTS"
ARTIFACTS="$(cd "$ARTIFACTS" && pwd)"
LOG="$ARTIFACTS/nested.log"

# Probe app so the app-launch segment shows a genuine launch: typing the
# query then Enter spawns it (marker file below), mirroring tuna-journey.
PROBE_HOME="$ARTIFACTS/probe-home"
MARKER="$ARTIFACTS/launch-marker"
rm -f "$MARKER"
mkdir -p "$PROBE_HOME/applications"
cat >"$PROBE_HOME/applications/tunaterm-probe.desktop" <<EOF
[Desktop Entry]
Name=Tunaterm Probe
Exec=touch "$MARKER"
Type=Application
EOF
XDG_DATA_HOME="$PROBE_HOME"
export XDG_DATA_HOME
# Hermetic shell state: the notification queue (and any future shell
# state) must resolve under the probe home, never the runner's real
# ~/.local/state — otherwise ambient entries leak into the capture and
# the notifications segment is not reproducible release to release.
XDG_STATE_HOME="$PROBE_HOME"
export XDG_STATE_HOME
# Deterministic banner set: start each capture with an empty queue so
# the notifications segment shows exactly the banner it posts.
rm -f "$PROBE_HOME/tuna-shell/notifications.json"
COMPOSITOR_PID=""
OWNED_XVFB=""
BUS_PID=""
HAVE_FFMPEG=""

if command -v ffmpeg >/dev/null 2>&1; then
    HAVE_FFMPEG=1
fi

cleanup() {
    if [ -n "$COMPOSITOR_PID" ] && kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
        kill "$COMPOSITOR_PID" 2>/dev/null || true
        wait "$COMPOSITOR_PID" 2>/dev/null || true
    fi
    if [ -n "$OWNED_XVFB" ]; then
        kill "$OWNED_XVFB" 2>/dev/null || true
        wait "$OWNED_XVFB" 2>/dev/null || true
    fi
    if [ -n "$BUS_PID" ]; then
        kill "$BUS_PID" 2>/dev/null || true
        wait "$BUS_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

# Private session bus: the shell serves org.freedesktop.Notifications on
# it, so the notifications segment can post a banner with gdbus.
command -v dbus-daemon >/dev/null 2>&1 || {
    echo "tuna-capture: dbus-daemon is required" >&2
    exit 1
}
command -v gdbus >/dev/null 2>&1 || {
    echo "tuna-capture: gdbus is required" >&2
    exit 1
}
BUS_ADDRESS_FILE="$ARTIFACTS/bus-address"
dbus-daemon --session --fork --print-address=1 --print-pid=1 \
    >"$BUS_ADDRESS_FILE" 2>"$ARTIFACTS/bus.log" || {
    echo "tuna-capture: dbus-daemon failed to start" >&2
    exit 1
}
DBUS_SESSION_BUS_ADDRESS="$(sed -n '1p' "$BUS_ADDRESS_FILE")"
BUS_PID="$(sed -n '2p' "$BUS_ADDRESS_FILE")"
export DBUS_SESSION_BUS_ADDRESS
echo "tuna-capture: private bus $DBUS_SESSION_BUS_ADDRESS (pid $BUS_PID)"

display_works() {
    xdotool getdisplaygeometry >/dev/null 2>&1
}

if [ -n "$DISPLAY_ARG" ]; then
    DISPLAY="$DISPLAY_ARG"
    export DISPLAY
fi
if ! display_works; then
    DISPLAY=":97"
    export DISPLAY
    echo "tuna-capture: starting Xvfb on $DISPLAY"
    Xvfb "$DISPLAY" -screen 0 "${WIDTH}x${HEIGHT}x24" >"$ARTIFACTS/xvfb.log" 2>&1 &
    OWNED_XVFB=$!
    for _ in $(seq 1 30); do
        if display_works; then
            break
        fi
        sleep 1
    done
    display_works || {
        echo "tuna-capture: Xvfb never answered on $DISPLAY" >&2
        exit 1
    }
fi
echo "tuna-capture: display $DISPLAY geometry $(xdotool getdisplaygeometry)"

echo "tuna-capture: building"
cargo build --quiet --manifest-path "$ROOT/Cargo.toml" \
    -p tuna-compositor -p tuna-shell-host

# Short idle timeout so the lock-screen segment engages by holding still.
# Production default (five minutes) applies whenever this is unset.
TUNA_IDLE_TIMEOUT_MS=15000
export TUNA_IDLE_TIMEOUT_MS

echo "tuna-capture: starting compositor on socket $SOCKET"
"$ROOT/target/debug/tuna-compositor" --socket "$SOCKET" \
    --shell-bin "$ROOT/target/debug/tuna-shell-host" \
    >"$LOG" 2>&1 &
COMPOSITOR_PID=$!

echo "tuna-capture: waiting for the nested window"
WID=""
for _ in $(seq 1 60); do
    if ! kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
        echo "tuna-capture: compositor died during startup" >&2
        tail -30 "$LOG" >&2 || true
        exit 1
    fi
    WID="$(xdotool search --name Smithay 2>/dev/null | head -1 || true)"
    if [ -n "$WID" ]; then
        break
    fi
    sleep 1
done
if [ -z "$WID" ]; then
    echo "tuna-capture: no Smithay window found" >&2
    exit 1
fi
xdotool windowfocus --sync "$WID"
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2)) click 1
sleep 3

# --- media helpers -------------------------------------------------------
# record_start <feature>: begin ffmpeg x11grab into <feature>.raw.mp4.
# record_stop: stop the recorder and remux to <feature>.mp4.
REC_PID=""
REC_FEATURE=""

record_start() {
    REC_FEATURE="$1"
    if [ -z "$HAVE_FFMPEG" ]; then
        return 0
    fi
    ffmpeg -hide_banner -loglevel error -y -f x11grab -framerate 15 \
        -video_size "${WIDTH}x${HEIGHT}" -i "$DISPLAY" \
        -c:v libx264 -preset veryfast -pix_fmt yuv420p \
        "$ARTIFACTS/$REC_FEATURE.raw.mp4" >/dev/null 2>&1 &
    REC_PID=$!
    # Let the recorder grab a settled first frame before interaction.
    sleep 1
}

record_stop() {
    if [ -z "$HAVE_FFMPEG" ] || [ -z "$REC_PID" ]; then
        return 0
    fi
    kill -INT "$REC_PID" 2>/dev/null || true
    wait "$REC_PID" 2>/dev/null || true
    mv "$ARTIFACTS/$REC_FEATURE.raw.mp4" "$ARTIFACTS/$REC_FEATURE.mp4"
    echo "tuna-capture: clip $REC_FEATURE.mp4"
    REC_PID=""
}

shot() {
    # Stills come from the clip, not scrot: scrot reads back black for the
    # GL-rendered nested window, while x11grab sees full content. This also
    # guarantees each still matches its clip.
    if [ -n "$HAVE_FFMPEG" ]; then
        # Settle one second before the end: every segment holds its final
        # state (open menu, up banner, engaged lock) through record_stop.
        ffmpeg -hide_banner -loglevel error -y -sseof -1 -i "$ARTIFACTS/$1.mp4" \
            -frames:v 1 "$ARTIFACTS/$1.png" >/dev/null 2>&1
    else
        scrot "$ARTIFACTS/$1.png" >/dev/null
    fi
    echo "tuna-capture: still $1.png"
}

check_media() {
    for f in "$@"; do
        if [ ! -s "$ARTIFACTS/$f" ]; then
            echo "tuna-capture: missing artifact $f" >&2
            exit 1
        fi
    done
}


# --- segment: overview ---------------------------------------------------
record_start "overview"
xdotool key Super_L
sleep 2
record_stop
shot "overview"

# --- segment: app-launch ---------------------------------------------------
# Escape back to the desktop first so the launch starts from rest.
xdotool key Escape
sleep 1
record_start "app-launch"
xdotool key Super_L
sleep 1
xdotool type "tunaterm"
sleep 2
xdotool key Return
sleep 3
LAUNCHED=""
for _ in $(seq 1 6); do
    if [ -f "$MARKER" ]; then
        LAUNCHED=1
        break
    fi
    xdotool key Return
    sleep 3
done
if [ -z "$LAUNCHED" ]; then
    echo "tuna-capture: probe app never launched (no marker at $MARKER)" >&2
    tail -30 "$LOG" >&2 || true
    exit 1
fi
xdotool key Escape
sleep 1
record_stop
shot "app-launch"

# --- segment: tiling-scroll ------------------------------------------------
# Strip-mode flip plus one width preset step on the empty session.
record_start "tiling-scroll"
xdotool key Super_L+Shift+T
sleep 2
xdotool key Super_L+R
sleep 2
record_stop
shot "tiling-scroll"

# --- segment: notifications -------------------------------------------------
# Post a banner over the bus the shell serves, then hold the frame so the
# clip shows it stacked over the session.
record_start "notifications"
gdbus call --session \
    --dest org.freedesktop.Notifications \
    --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify \
    "tuna-capture" 0 "" "Capture demo" "A notification banner, pinned for the walkthrough." \
    "[]" "{}" 8000 >/dev/null
sleep 5
record_stop
shot "notifications"

# --- segment: quick-settings -------------------------------------------------
# No unified quick-settings panel exists yet; the panel status tiles open
# menus carrying the quick toggles. Click the network tile (rightmost dot,
# strip index 0) to open its menu; its radio toggle keeps the menu open
# on the pending face for the shot. (The power tile sits one dot left and
# would arm the lock instead.)
record_start "quick-settings"
xdotool mousemove --window "$WID" 1263 16 click 1
sleep 2
record_stop
shot "quick-settings"
xdotool key Escape
sleep 1

# --- segment: lock-screen (last: the session stays locked) -----------------
# Idle-driven: the compositor started with a short TUNA_IDLE_TIMEOUT_MS,
# so holding still past the timeout engages the lock with no input at all.
record_start "lock-screen"
sleep 25
record_stop
shot "lock-screen"
if grep -q "panicked" "$LOG"; then
    echo "tuna-capture: panic in nested log" >&2
    grep "panicked" "$LOG" >&2
    exit 1
fi

CLIPS=""
STILLS=""
for seg in $SEGMENTS; do
    CLIPS="$CLIPS $seg.mp4"
    STILLS="$STILLS $seg.png"
done
# shellcheck disable=SC2086
if [ -n "$HAVE_FFMPEG" ]; then
    check_media $CLIPS
fi
# shellcheck disable=SC2086
check_media $STILLS
check_walkthrough

echo "tuna-capture: OK, artifacts in $ARTIFACTS"
