#!/bin/sh
# Focused source GTK proof; use an immutable, source-matched GTK test executable.
set -eu
if [ "$#" -ne 3 ]; then
    echo "usage: $0 GTK_TEST_EXECUTABLE SOURCE_COMMIT ARTIFACT_DIRECTORY" >&2
    exit 2
fi
if [ "${TUNA_A11Y_PRIVATE_SESSION:-}" != 1 ]; then
    exec dbus-run-session -- env TUNA_A11Y_PRIVATE_SESSION=1 "$0" "$@"
fi
TEST_BIN=$(realpath "$1")
SOURCE_COMMIT=$2
ARTIFACTS=$(realpath -m "$3")
mkdir -p "$ARTIFACTS"
# A reused directory must not supply a previous run's receipt.
rm -f "$ARTIFACTS/result.txt" "$ARTIFACTS/manifest.json" "$ARTIFACTS/owned-accessibility.json"
XDG_RUNTIME_DIR=$(mktemp -d /tmp/tuna-a11y-runtime.XXXXXX)
chmod 0700 "$XDG_RUNTIME_DIR"
export XDG_RUNTIME_DIR
X_PID=; AT_PID=; GUARD_PID=
cleanup() {
    proof_status=$?
    if [ -n "$GUARD_PID" ]; then
        touch "$ARTIFACTS/guard-stop"
        if ! wait "$GUARD_PID"; then proof_status=1; fi
    fi
    if [ -n "$AT_PID" ]; then kill "$AT_PID" 2>/dev/null || true; wait "$AT_PID" 2>/dev/null || true; fi
    if [ -n "$X_PID" ]; then kill "$X_PID" 2>/dev/null || true; wait "$X_PID" 2>/dev/null || true; fi
    rm -rf "$XDG_RUNTIME_DIR"
    if [ -e "$XDG_RUNTIME_DIR" ]; then proof_status=1; fi
    /usr/bin/python3 - "$ARTIFACTS/manifest.json" <<'PY_CLEANUP'
import json,pathlib,sys
path=pathlib.Path(sys.argv[1])
if path.exists():
    data=json.loads(path.read_text())
    data['runtime_removed']=not pathlib.Path(data['runtime_directory']).exists()
    path.write_text(json.dumps(data,indent=2)+'\n')
PY_CLEANUP
    trap - EXIT INT TERM
    exit "$proof_status"
}
trap cleanup EXIT INT TERM
# Xvfb chooses a free server without sharing a pre-existing graphical session.
Xvfb -displayfd 3 -screen 0 1280x800x24 3>"$ARTIFACTS/display-number" >"$ARTIFACTS/xvfb.log" 2>&1 &
X_PID=$!
for _ in $(seq 1 100); do [ -s "$ARTIFACTS/display-number" ] && break; sleep .1; done
DISPLAY=:$(cat "$ARTIFACTS/display-number")
export DISPLAY
unset WAYLAND_DISPLAY WAYLAND_SOCKET
/usr/libexec/at-spi-bus-launcher --launch-immediately >"$ARTIFACTS/atspi.log" 2>&1 &
AT_PID=$!
AT_SPI_BUS_ADDRESS=$(/usr/bin/python3 - <<'PY'
import time
from gi.repository import Gio
bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
for i in range(100):
    try:
        print(bus.call_sync('org.a11y.Bus', '/org/a11y/bus', 'org.a11y.Bus', 'GetAddress', None, None, Gio.DBusCallFlags.NO_AUTO_START, 2000, None).unpack()[0])
        break
    except Exception:
        if i == 99: raise
        time.sleep(.1)
PY
)
export AT_SPI_BUS_ADDRESS
/usr/bin/python3 - <<'PY_ADDRESS'
import os
assert os.environ['XDG_RUNTIME_DIR'] in os.environ['AT_SPI_BUS_ADDRESS']
PY_ADDRESS
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
rm -f "$ARTIFACTS/guard-ready" "$ARTIFACTS/guard-stop"
/usr/bin/python3 "$SCRIPT_DIR/lib/tuna-a11y-proof-guard.py" "$AT_SPI_BUS_ADDRESS" "$ARTIFACTS" >"$ARTIFACTS/guard.log" 2>&1 &
GUARD_PID=$!
for _ in $(seq 1 100); do
    [ -s "$ARTIFACTS/guard-ready" ] && break
    kill -0 "$GUARD_PID" 2>/dev/null || { cat "$ARTIFACTS/guard.log" >&2; exit 1; }
    sleep .1
done
[ -s "$ARTIFACTS/guard-ready" ] || { echo "accessibility guard did not become ready" >&2; exit 1; }
TUNA_A11Y_TEST_SCHEMA_DIR="$ARTIFACTS/schema"
mkdir -p "$TUNA_A11Y_TEST_SCHEMA_DIR"
cat >"$TUNA_A11Y_TEST_SCHEMA_DIR/org.tuna.FocusPolicy.gschema.xml" <<'XML'
<schemalist><schema id="org.tuna.FocusPolicy" path="/org/tuna/focus-policy/"><key name="keyboard-focus-visible-timeout" type="i"><default>-1</default></key></schema></schemalist>
XML
glib-compile-schemas "$TUNA_A11Y_TEST_SCHEMA_DIR"
GDK_BACKEND=x11
GTK_A11Y=atspi
GSETTINGS_BACKEND=memory
TUNA_A11Y_RECEIPT="$ARTIFACTS/result.txt"
export TUNA_A11Y_TEST_SCHEMA_DIR GDK_BACKEND GTK_A11Y GSETTINGS_BACKEND TUNA_A11Y_RECEIPT
/usr/bin/python3 - "$TEST_BIN" "$SOURCE_COMMIT" "$ARTIFACTS/manifest.json" "$0" "$SCRIPT_DIR/lib/tuna-a11y-proof-guard.py" <<'PY'
import hashlib,json,os,pathlib,subprocess,sys
runtime=pathlib.Path(os.environ['XDG_RUNTIME_DIR'])
assert runtime.stat().st_mode & 0o777 == 0o700
assert str(runtime) in os.environ['AT_SPI_BUS_ADDRESS']
manifest={'scope':'actual GTK widgets and timers on private Xvfb; source proof, not installed/native-Wayland/GNOME comparison', 'binary_build_commit':sys.argv[2], 'test_binary':sys.argv[1], 'test_binary_sha256':hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest(), 'gtk_version':subprocess.check_output(['pkg-config','--modversion','gtk4'],text=True).strip(), 'runtime_directory':str(runtime), 'runtime_mode':'0700','display':os.environ['DISPLAY'],'session_bus':os.environ['DBUS_SESSION_BUS_ADDRESS'],'accessibility_bus':os.environ['AT_SPI_BUS_ADDRESS']}
manifest['proof_script_sha256']=hashlib.sha256(pathlib.Path(sys.argv[4]).read_bytes()).hexdigest()
manifest['guard_sha256']=hashlib.sha256(pathlib.Path(sys.argv[5]).read_bytes()).hexdigest()
pathlib.Path(sys.argv[3]).write_text(json.dumps(manifest,indent=2)+'\n')
PY
"$TEST_BIN" accessibility::tests::live_menu_and_focus_settings --ignored --test-threads=1 --nocapture >"$ARTIFACTS/test.log" 2>&1
cat "$ARTIFACTS/test.log"
cat "$TUNA_A11Y_RECEIPT"
