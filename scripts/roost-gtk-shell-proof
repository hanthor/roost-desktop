#!/bin/sh
# roost-gtk-shell-proof — GTK shell (ADR 0006) inside the nested session.
#
# Usage:
#   scripts/roost-gtk-shell-proof [--display :N] [--artifacts DIR]
#
# Runs the nested compositor with roost-shell-gtk as its supervised shell
# on a private session bus with the AT-SPI accessibility bus, then:
#   G-PANEL     the panel maps (frame differs from the bare session)
#   A11Y-PANEL  the panel controls are exposed to screen readers by name
#   G-CAL-OPEN  clicking the clock opens the calendar popover (xdg popup
#               on the layer surface, #88)
#   G-QS-OPEN   clicking the system indicators opens quick settings
#   A11Y-QS     quick-settings toggles and the volume slider are exposed
#   G-WINDOWS   three libadwaita app windows map
#   G-OV-OPEN   Super opens the overview with a preview per window (#54)
#   G-OV-PICK   clicking a preview focuses that window, closes overview
#   G-APP-POPOVER an app's menu popover opens (xdg popups, #88)
#   G-APP-INSTALLED an app installed mid-session shows in search
#   G-SEARCH-PROVIDER  typing lists a D-Bus search provider's result (#57)
#   G-SEARCH-VIEW      while search shows results the workspace view hides
#   G-SEARCH-ACTIVATE  clicking it calls ActivateResult, closes overview
#   G-NOTIFY-BANNER  a D-Bus notification shows a banner (#56)
#   G-NOTIFY-EXPIRE  the banner goes away by itself
#   G-NOTIFY-LIST    the calendar lists it instead of "No Notifications"
#   G-NOTIFY-CLEAR   Clear empties the list
#   G-NOTIFY-DND     with Do Not Disturb on, no banner, but listed
#   G-QS-SERVICES    quick settings shows the tiles of the services on
#                    the bus (stub daemons on a private system bus, #55)
#   G-QS-WIFI        the Wi-Fi tile turns NetworkManager's radio off
#   G-QS-BLUETOOTH   the Bluetooth tile powers the BlueZ adapter off
#   G-QS-POWER       the Power Mode tile switches to power saver
#   G-QS-DARK        the Dark Style tile writes GNOME's color-scheme key
#   G-QS-BRIGHTNESS  the brightness slider sets the backlight via logind
#   G-QS-VOLUME      the volume slider sets the PipeWire sink volume
#   G-QS-ABSENT      with the daemons gone, their tiles hide (no hang)
#   G-GL-WINDOW      a GTK window on the GL renderer maps and paints
#                    (linux-dmabuf, #89)
#   G-OV-SHELL-UI  the overview shows the search entry and the dash
#   G-OV-SEARCH typing lists matching apps (#57)
#   G-OV-LAUNCH Enter launches the top result and closes the overview
#   G-OV-APPGRID Show Apps opens the app grid
#   G-X11-APP      XWayland is on by default: an X11 app launched from
#                  overview search gets DISPLAY and maps a window (#59)
#   G-SETTINGS-CLOCK GNOME's clock-show-seconds key changes the panel clock
#   G-SETTINGS-IDLE GNOME's idle-delay and lock-enabled keys set the
#                  compositor's idle lock live (#63)
#   G-POWER-MENU   the power button opens GNOME's menu (Suspend,
#                  Restart…, Power Off…, Log Out…) (#62)
#   G-POWER-DIALOG Power Off… opens the 60 s end-session dialog, and
#                  Cancel closes it with nothing done
#   G-POWER-OFF    confirming the dialog asks logind to power off
#   G-SUSPEND-LOCK Suspend asks logind, and its PrepareForSleep locks
#                  the session before sleep
#   A11Y-GOLDEN    the panel, calendar, quick settings and overview
#                  accessible trees match tests/a11y/ (#71)
#   G-SHELL-STABLE the shell never exits or restarts during the journey

#   G-APP-DRAG  dragging an app's header bar moves the window (#58)
#   G-TRAY      an AppIndicator item shows in the panel and its menu
#               row reaches the item (P-TR-01)
#   G-SWITCHER  Alt+Tab shows the switcher with every window, and
#               releasing Alt focuses the highlighted one
# Frames and accessibility dumps land in the artifacts dir; assertions in
# assertions.txt for the parity ledger.
set -eu
if [ -z "${ROOST_PROOF_PRIVATE_BUS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    ROOST_PROOF_PRIVATE_BUS=1 exec dbus-run-session -- "$0" "$@"
fi
unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
DISPLAY_ARG=""
ARTIFACTS="$ROOT/gtk-shell-artifacts"
WIDTH=1280
HEIGHT=800
while [ $# -gt 0 ]; do
    case "$1" in
        --display) DISPLAY_ARG="$2"; shift 2 ;;
        --artifacts) ARTIFACTS="$2"; shift 2 ;;
        --help|-h) sed -n '2,17p' "$0"; exit 0 ;;
        *) echo "roost-gtk-shell-proof: unknown argument $1" >&2; exit 1 ;;
    esac
done
mkdir -p "$ARTIFACTS"
ARTIFACTS="$(cd "$ARTIFACTS" && pwd)"
LOG="$ARTIFACTS/nested.log"
ASSERTIONS="$ARTIFACTS/assertions.txt"
: >"$ASSERTIONS"
XDG_STATE_HOME="$ARTIFACTS/state"
XDG_DATA_HOME="$ARTIFACTS/data"
export XDG_STATE_HOME XDG_DATA_HOME
# The dash shows only the proof's own windows: pin a favourite no
# runner has, so the host's apps (GitHub's runners now ship Firefox,
# which GNOME's default favourites name) never reach the a11y goldens.
mkdir -p "$XDG_DATA_HOME/roost-shell"
echo '["org.roost.ProofNoFavorite.desktop"]' >"$XDG_DATA_HOME/roost-shell/favorites.json"
# Launch probe for overview search: only this journey has it, and its
# Exec leaves a marker, proving search-to-launch end to end.
PROBE_MARKER="$ARTIFACTS/probe-marker"
rm -f "$PROBE_MARKER"
mkdir -p "$XDG_DATA_HOME/applications"
cat >"$XDG_DATA_HOME/applications/roost-probe.desktop" <<EOF
[Desktop Entry]
Name=Roost Probe
Exec=touch $PROBE_MARKER
Icon=applications-system
Type=Application
EOF
# A GNOME Shell search provider owned by the probe app (#57).
SEARCH_MARKER="$ARTIFACTS/search-marker"
rm -f "$SEARCH_MARKER"
mkdir -p "$XDG_DATA_HOME/gnome-shell/search-providers"
cat >"$XDG_DATA_HOME/gnome-shell/search-providers/roost-probe-search.ini" <<INI
[Shell Search Provider]
DesktopId=roost-probe.desktop
BusName=org.roost.ProbeSearch
ObjectPath=/org/roost/ProbeSearch
Version=2
INI
# X11 probe app for G-X11-APP: records the DISPLAY it was launched with.
# Written before the shell starts, which reads desktop entries once.
X11_MARKER="$ARTIFACTS/x11-marker"
rm -f "$X11_MARKER"
mkdir -p "$ARTIFACTS/bin"
cat >"$ARTIFACTS/bin/roost-x-probe" <<XPROBE
#!/bin/sh
echo "\$DISPLAY" >"$X11_MARKER"
exec xeyes
XPROBE
chmod +x "$ARTIFACTS/bin/roost-x-probe"
cat >"$XDG_DATA_HOME/applications/roost-x-probe.desktop" <<XDESK
[Desktop Entry]
Name=Roost X Probe
Exec=$ARTIFACTS/bin/roost-x-probe
Type=Application
XDESK
PROVIDER_PID=""
TRAY_PID=""
OWNED_XVFB=""
COMPOSITOR_PID=""
STUBS_PID=""
SYSBUS_PID=""
cleanup() {
    if [ -n "$COMPOSITOR_PID" ]; then kill "$COMPOSITOR_PID" 2>/dev/null || true; fi
    if [ -n "$OWNED_XVFB" ]; then kill "$OWNED_XVFB" 2>/dev/null || true; fi
    if [ -n "$STUBS_PID" ]; then kill "$STUBS_PID" 2>/dev/null || true; fi
    if [ -n "$PROVIDER_PID" ]; then kill "$PROVIDER_PID" 2>/dev/null || true; fi
    if [ -n "$TRAY_PID" ]; then kill "$TRAY_PID" 2>/dev/null || true; fi
    if [ -n "$SYSBUS_PID" ]; then kill "$SYSBUS_PID" 2>/dev/null || true; fi
}
trap cleanup EXIT INT TERM
# RGB of one pixel of a PNG, as "r g b".
px() {
    ffmpeg -loglevel error -i "$1" -vf "crop=1:1:$2:$3" -f rawvideo -pix_fmt rgb24 - |
        od -An -tu1 | tr -s ' ' | sed 's/^ //; s/ $//'
}
pass() { echo "$1 pass $2" >>"$ASSERTIONS"; echo "roost-gtk-shell-proof: $1 pass: $2"; }
fail() {
    echo "$1 fail $2" >>"$ASSERTIONS"
    echo "roost-gtk-shell-proof: $1 FAIL: $2" >&2
    tail -30 "$LOG" >&2 || true
    exit 1
}

# pyatspi ships with the distro Python, which a user-local Python
# (Homebrew, pyenv) may shadow on PATH.
PY=/usr/bin/python3
[ -x "$PY" ] || PY=python3

# Compositor-side state (overview, focus, previews) for app stages.
CSTATE="$ARTIFACTS/compositor-state.json"
ROOST_COMPOSITOR_STATE="$CSTATE"
export ROOST_COMPOSITOR_STATE

# Accessibility bus for GTK's AT-SPI backend.
if [ -x /usr/libexec/at-spi-bus-launcher ]; then
    /usr/libexec/at-spi-bus-launcher --launch-immediately >"$ARTIFACTS/atspi.log" 2>&1 &
fi

[ -n "$DISPLAY_ARG" ] && DISPLAY="$DISPLAY_ARG" && export DISPLAY
if ! xdotool getdisplaygeometry >/dev/null 2>&1; then
    DISPLAY=":96"
    export DISPLAY
    Xvfb "$DISPLAY" -screen 0 "${WIDTH}x${HEIGHT}x24" >"$ARTIFACTS/xvfb.log" 2>&1 &
    OWNED_XVFB=$!
    for _ in $(seq 1 30); do xdotool getdisplaygeometry >/dev/null 2>&1 && break; sleep 1; done
fi

# Settings land in a private keyfile so the proof can read them back.
GSETTINGS_BACKEND=keyfile
XDG_CONFIG_HOME="$ARTIFACTS/config"
export GSETTINGS_BACKEND XDG_CONFIG_HOME
# Quick-settings daemons: stubs on a private "system" bus (#55), a fake
# backlight, and a fake wpctl that records the sink volume.
BACKLIGHT="$ARTIFACTS/backlight/roost-bl"
mkdir -p "$BACKLIGHT" "$ARTIFACTS/bin"
echo 1000 >"$BACKLIGHT/max_brightness"
echo 500 >"$BACKLIGHT/brightness"
ROOST_BACKLIGHT_ROOT="$ARTIFACTS/backlight"
export ROOST_BACKLIGHT_ROOT
VOLUME_FILE="$ARTIFACTS/volume"
echo 0.80 >"$VOLUME_FILE"
cat >"$ARTIFACTS/bin/wpctl" <<WPCTL
#!/bin/sh
case "\$1" in
    get-volume) echo "Volume: \$(cat "$VOLUME_FILE")" ;;
    set-volume) echo "\$3" >"$VOLUME_FILE" ;;
    *) ;;
esac
WPCTL
chmod +x "$ARTIFACTS/bin/wpctl"
PATH="$ARTIFACTS/bin:$PATH"
export PATH
SYSBUS_INFO="$(dbus-daemon --session --fork --print-address=1 --print-pid=1)"
DBUS_SYSTEM_BUS_ADDRESS="$(echo "$SYSBUS_INFO" | sed -n 1p)"
SYSBUS_PID="$(echo "$SYSBUS_INFO" | sed -n 2p)"
export DBUS_SYSTEM_BUS_ADDRESS
"$PY" "$ROOT/scripts/lib/roost-service-stubs.py" "$BACKLIGHT" >"$ARTIFACTS/stubs.log" 2>&1 &
STUBS_PID=$!
for _ in $(seq 1 20); do grep -q ready "$ARTIFACTS/stubs.log" 2>/dev/null && break; sleep 0.5; done
"$PY" "$ROOT/scripts/lib/roost-search-provider-stub.py" "$SEARCH_MARKER" >"$ARTIFACTS/provider.log" 2>&1 &
PROVIDER_PID=$!
for _ in $(seq 1 20); do grep -q ready "$ARTIFACTS/provider.log" 2>/dev/null && break; sleep 0.5; done

# The full power menu needs a hardware session; logind is the stub.
ROOST_SESSION_KIND=hardware
export ROOST_SESSION_KIND

cargo build --quiet --manifest-path "$ROOT/Cargo.toml" -p roost-compositor -p roost-shell-gtk
"$ROOT/target/debug/roost-compositor" --backend winit --socket "roost-gtk-proof-$$" \
    --shell-bin "${ROOST_PROOF_SHELL_BIN:-$ROOT/target/debug/roost-shell-gtk}" >"$LOG" 2>&1 &
COMPOSITOR_PID=$!

WID=""
for _ in $(seq 1 60); do
    kill -0 "$COMPOSITOR_PID" 2>/dev/null || fail G-PANEL "compositor exited during startup"
    WID="$(xdotool search --name Smithay 2>/dev/null | head -1 || true)"
    [ -n "$WID" ] && break
    sleep 1
done
[ -n "$WID" ] || fail G-PANEL "no nested window"
xdotool windowfocus --sync "$WID"
# Park the pointer mid-screen: (0,0) is the hot corner, which opens the
# overview (and the overview then claims Escape).
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))

# The panel is up once the shell registers on the a11y bus with its
# controls; that also proves the accessible tree.
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-panel.json" 60 ||
    fail A11Y-PANEL "shell never registered on the accessibility bus"
sleep 2
scrot "$ARTIFACTS/01-panel.png" >/dev/null
# GNOME 51's top bar is pure black; the session background is not. An
# empty spot in the strip must be black and the desktop below must not.
strip="$(px "$ARTIFACTS/01-panel.png" 300 5)"
desk="$(px "$ARTIFACTS/01-panel.png" 300 200)"
[ "$strip" = "0 0 0" ] || fail G-PANEL "panel strip is '$strip', not black"
[ "$desk" != "0 0 0" ] || fail G-PANEL "desktop below the panel is black too"
pass G-PANEL "GTK panel mapped as a black top strip"
for label in "Activities" "Date and Time" "System"; do
    jq -e --arg n "$label" 'any(.[]; .name == $n)' "$ARTIFACTS/a11y-panel.json" >/dev/null ||
        fail A11Y-PANEL "no accessible control named '$label'"
done
pass A11Y-PANEL "Activities, Date and Time, System exposed"

# A popover counts as open only when its contents are showing in the
# accessible tree: a pixel diff passes on a mere hover highlight.
showing() {
    jq -e --arg n "$2" 'any(.[]; .name == $n and .showing)' "$1" >/dev/null
}

xdotool mousemove --window "$WID" $((WIDTH / 2)) 16 click 1
sleep 2
scrot "$ARTIFACTS/02-calendar.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-calendar.json" 20 ||
    fail G-CAL-OPEN "accessibility dump failed"
showing "$ARTIFACTS/a11y-calendar.json" "No Notifications" ||
    fail G-CAL-OPEN "calendar popover contents not showing"
pass G-CAL-OPEN "clock opens the calendar and notification list"
xdotool key Escape
sleep 1

xdotool mousemove --window "$WID" $((WIDTH - 50)) 16 click 1
sleep 2
scrot "$ARTIFACTS/03-quick-settings.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs.json" 20 ||
    fail G-QS-OPEN "accessibility dump failed"
showing "$ARTIFACTS/a11y-qs.json" "Dark Style" ||
    fail G-QS-OPEN "quick settings contents not showing"
pass G-QS-OPEN "system indicators open quick settings"
for label in "Wired" "Dark Style" "Do Not Disturb" "Volume" "Lock"; do
    showing "$ARTIFACTS/a11y-qs.json" "$label" ||
        fail A11Y-QS "no showing accessible control named '$label'"
done
pass A11Y-QS "quick-settings toggles, slider, and lock exposed"

xdotool key Escape
sleep 1

# Tray (P-TR-01): an item registers, shows, and its menu fires.
TRAY_MARKER="$ARTIFACTS/tray-marker"
rm -f "$TRAY_MARKER"
"$PY" "$ROOT/scripts/lib/roost-tray-item-stub.py" "$TRAY_MARKER" >"$ARTIFACTS/tray.log" 2>&1 &
TRAY_PID=$!
for _ in $(seq 1 30); do grep -q registered "$ARTIFACTS/tray.log" 2>/dev/null && break; sleep 0.5; done
for _ in $(seq 1 20); do
    "$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-tray.json" 20 >/dev/null 2>&1
    showing "$ARTIFACTS/a11y-tray.json" "Roost Tray Probe" && break
    sleep 0.5
done
showing "$ARTIFACTS/a11y-tray.json" "Roost Tray Probe" ||
    fail G-TRAY "the registered item never showed in the panel"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-tray-menu.json" 20 \
    --press "Roost Tray Probe" || fail G-TRAY "could not open the item"
scrot "$ARTIFACTS/03b-tray-menu.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-tray-fire.json" 20 \
    --press "Open Probe" || fail G-TRAY "the item's menu row never showed"
end=$(($(date +%s) + 10))
until [ -s "$TRAY_MARKER" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "^clicked 1" "$TRAY_MARKER" 2>/dev/null || fail G-TRAY "the menu row never reached the item"
kill "$TRAY_PID" 2>/dev/null || true
pass G-TRAY "an AppIndicator item shows and its menu row reaches it"
xdotool key Escape
sleep 1

# App stages: three libadwaita windows (scripts/lib/roost-test-window.py).
cstate() {
    end=$(($(date +%s) + ${3:-20}))
    while [ "$(date +%s)" -le "$end" ]; do
        [ -s "$CSTATE" ] && jq -e "$1" "$CSTATE" >/dev/null 2>&1 && return 0
        sleep 0.3
    done
    echo "roost-gtk-shell-proof: compositor state was:" >&2
    cat "$CSTATE" >&2 2>/dev/null || true
    return 1
}
SOCKET_NAME="$(sed -n 's/.*nested session on \([^ ]*\) .*/\1/p' "$LOG" | head -1)"
for spec in Alpha:#3584e4 Beta:#2ec27e Gamma:#e66100; do
    WAYLAND_DISPLAY="$SOCKET_NAME" "$PY" "$ROOT/scripts/lib/roost-test-window.py" \
        "${spec%%:*}" "${spec#*:}" >"$ARTIFACTS/window-${spec%%:*}.log" 2>&1 &
done
cstate '(.windows | length) == 3' "three app windows" ||
    fail G-WINDOWS "three libadwaita windows never mapped"
pass G-WINDOWS "three libadwaita windows mapped"
sleep 2
scrot "$ARTIFACTS/04-windows.png" >/dev/null

xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key Super_L
cstate '.overview_open and (.previews | length) == 3' "overview" ||
    fail G-OV-OPEN "Super did not open the overview with three previews"
pass G-OV-OPEN "Super opens the overview with three window previews"
sleep 1
scrot "$ARTIFACTS/05-overview.png" >/dev/null

beta="$(jq -r '.previews[] | select(.app_id == "roost-test-beta") | .rect | "\(.[0] + .[2] / 2) \(.[1] + .[3] / 2)"' "$CSTATE")"
[ -n "$beta" ] || fail G-OV-PICK "no preview for roost-test-beta"
# shellcheck disable=SC2086
xdotool mousemove --window "$WID" $beta click 1
cstate '(.overview_open | not) and .focused_app_id == "roost-test-beta"' "pick" ||
    fail G-OV-PICK "clicking Beta's preview did not focus it and close the overview"
pass G-OV-PICK "clicking a preview focuses that window and closes the overview"
sleep 1
scrot "$ARTIFACTS/06-picked.png" >/dev/null

menu="$(jq -r '.windows[] | select(.app_id == "roost-test-beta") | .rect | "\(.[0] + .[2] - 64) \(.[1] + 22)"' "$CSTATE")"
# shellcheck disable=SC2086
xdotool mousemove --window "$WID" $menu click 1
sleep 2
scrot "$ARTIFACTS/07-app-popover.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-test-beta "$ARTIFACTS/a11y-beta.json" 20 ||
    fail G-APP-POPOVER "test window never registered on the accessibility bus"
showing "$ARTIFACTS/a11y-beta.json" "Popover content" ||
    fail G-APP-POPOVER "app menu popover did not open (xdg popup)"
pass G-APP-POPOVER "an app's menu popover opens (xdg popup, #88)"


xdotool key Escape
sleep 1
# Header-bar drag: GTK sends xdg_toplevel.move, the compositor owns the
# pointer until release (#58).
read -r bx by <<EOF2
$(jq -r '.windows[] | select(.app_id == "roost-test-beta") | .rect | "\(.[0]) \(.[1])"' "$CSTATE")
EOF2
xdotool mousemove --window "$WID" $((bx + 120)) $((by + 20))
xdotool mousedown 1
for step in 1 2 3 4 5 6; do
    xdotool mousemove --window "$WID" $((bx + 120 + step * 25)) $((by + 20 + step * 10))
    sleep 0.1
done
xdotool mouseup 1
# GTK starts the move after its drag threshold, so the window follows
# the pointer from there: it moves by most, not all, of the drag.
cstate ".windows[] | select(.app_id == \"roost-test-beta\") | (.rect[0] - $bx) >= 75 and (.rect[0] - $bx) <= 150 and (.rect[1] - $by) >= 30 and (.rect[1] - $by) <= 60" "drag" ||
    fail G-APP-DRAG "dragging Beta's header bar did not move it by the drag distance"
pass G-APP-DRAG "dragging an app's header bar moves the window (#58)"

# Alt-Tab (P-WM-01): hold Alt, step once, read the switcher, release.
xdotool keydown Alt_L
xdotool key Tab
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-switcher.json" 20 ||
    { xdotool keyup Alt_L; fail G-SWITCHER "accessibility dump failed"; }
scrot "$ARTIFACTS/08b-switcher.png" >/dev/null
items="$(jq '[.[] | select(.role == "list item" and .showing)] | length' "$ARTIFACTS/a11y-switcher.json")"
picked="$(jq -r '[.[] | select(.role == "list item" and .showing and .selected)][0].name // ""' "$ARTIFACTS/a11y-switcher.json")"
xdotool keyup Alt_L
[ "$items" = 3 ] || fail G-SWITCHER "switcher shows $items windows, not 3"
case "$picked" in
    *": "*) ;;
    *) fail G-SWITCHER "no highlighted window in the switcher" ;;
esac
title="${picked#*: }"
# Test windows carry app id roost-test-<lowercased title>.
want="roost-test-$(echo "$title" | tr '[:upper:]' '[:lower:]')"
cstate ".focused_app_id == \"$want\"" "switched" ||
    fail G-SWITCHER "releasing Alt did not focus '$title'"
pass G-SWITCHER "Alt+Tab shows every window and focuses the highlighted one"
scrot "$ARTIFACTS/08-dragged.png" >/dev/null

# Overview shell surfaces (#54, #57): search entry, dash, app grid.
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key Super_L
cstate '.overview_open' "overview" || fail G-OV-SHELL-UI "overview did not open"
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-overview.json" 20 ||
    fail G-OV-SHELL-UI "accessibility dump failed"
if ! showing "$ARTIFACTS/a11y-overview.json" "Search" ||
    ! showing "$ARTIFACTS/a11y-overview.json" "Show Apps"; then
    fail G-OV-SHELL-UI "search entry or dash missing from the overview"
fi
pass G-OV-SHELL-UI "overview shows the search entry and the dash"
scrot "$ARTIFACTS/09-overview-shell.png" >/dev/null

xdotool type --delay 40 "roost probe"
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-search.json" 20 ||
    fail G-OV-SEARCH "accessibility dump failed"
showing "$ARTIFACTS/a11y-search.json" "Roost Probe" ||
    fail G-OV-SEARCH "typing did not list the probe app"
pass G-OV-SEARCH "typing in the overview lists matching apps"
scrot "$ARTIFACTS/10-search.png" >/dev/null

xdotool key Return
end=$(($(date +%s) + 15))
until [ -f "$PROBE_MARKER" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
[ -f "$PROBE_MARKER" ] || fail G-OV-LAUNCH "Enter did not launch the top result"
cstate '.overview_open | not' "closed" || fail G-OV-LAUNCH "overview stayed open after launch"
pass G-OV-LAUNCH "Enter launches the top result and closes the overview"

# An app installed while the shell runs is searchable at once (GNOME
# watches the application directories too).
cat >"$XDG_DATA_HOME/applications/roost-late-arrival.desktop" <<LATE
[Desktop Entry]
Name=Roost Late Arrival
Exec=true
Type=Application
LATE
sleep 1
xdotool key Super_L
cstate '.overview_open' "overview" || fail G-APP-INSTALLED "overview did not open"
sleep 1
xdotool type --delay 40 "late arrival"
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-late-app.json" 20 ||
    fail G-APP-INSTALLED "accessibility dump failed"
showing "$ARTIFACTS/a11y-late-app.json" "Roost Late Arrival" ||
    fail G-APP-INSTALLED "an app installed mid-session did not show in search"
pass G-APP-INSTALLED "an app installed mid-session shows in search"
xdotool key Escape
cstate '.overview_open | not' "closed" || { xdotool key Escape; cstate '.overview_open | not' "closed" || fail G-APP-INSTALLED "overview stayed open"; }

# Search providers (#57): a D-Bus provider's result lists under the
# apps, and clicking it hands the result back to the provider.
xdotool key Super_L
cstate '.overview_open' "overview" || fail G-SEARCH-PROVIDER "overview did not reopen"
sleep 1
xdotool type --delay 40 "report"
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-provider.json" 20 ||
    fail G-SEARCH-PROVIDER "accessibility dump failed"
scrot "$ARTIFACTS/10b-search-provider.png" >/dev/null
showing "$ARTIFACTS/a11y-provider.json" "Quarterly Report.odt" ||
    fail G-SEARCH-PROVIDER "the provider's result is not listed"
pass G-SEARCH-PROVIDER "typing lists a D-Bus search provider's result"
cstate '.overview_search' "search view" ||
    fail G-SEARCH-VIEW "the compositor kept the workspace view during search"
pass G-SEARCH-VIEW "search results replace the workspace view"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-provider-press.json" 20 \
    --press "Quarterly Report.odt" || fail G-SEARCH-ACTIVATE "could not press the result"
end=$(($(date +%s) + 10))
until [ -s "$SEARCH_MARKER" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "^activate doc-1 report" "$SEARCH_MARKER" 2>/dev/null ||
    fail G-SEARCH-ACTIVATE "ActivateResult never reached the provider"
cstate '.overview_open | not' "closed" || fail G-SEARCH-ACTIVATE "overview stayed open"
cstate '.overview_search | not' "search reset" ||
    fail G-SEARCH-ACTIVATE "search state outlived the overview"
pass G-SEARCH-ACTIVATE "clicking a provider result activates it and closes the overview"

xdotool key Super_L
cstate '.overview_open' "overview" || fail G-OV-APPGRID "overview did not reopen"
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-grid.json" 20 --press "Show Apps" ||
    fail G-OV-APPGRID "could not press Show Apps"
showing "$ARTIFACTS/a11y-grid.json" "Roost Probe" ||
    fail G-OV-APPGRID "app grid does not list installed apps"
pass G-OV-APPGRID "Show Apps opens the app grid"
scrot "$ARTIFACTS/11-app-grid.png" >/dev/null
xdotool key Escape

# Notifications (#56). Close whatever the grid left open first (#97).
xdotool key Escape
if ! cstate '.overview_open | not' "closed" 3; then
    xdotool key Super_L
    cstate '.overview_open | not' "closed" || fail G-NOTIFY-BANNER "overview would not close"
fi
sleep 1
notify() {
    gdbus call --session --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        -- "Roost Proof" 0 "" "$1" "$2" "[]" "{}" -1 >>"$ARTIFACTS/notify.log" 2>&1
}
open_calendar() {
    xdotool mousemove --window "$WID" $((WIDTH / 2)) 16 click 1
    sleep 2
}
notify "Proof Banner" "Sent over D-Bus" || fail G-NOTIFY-BANNER "Notify call failed"
sleep 1
scrot "$ARTIFACTS/12-banner.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-banner.json" 20 ||
    fail G-NOTIFY-BANNER "accessibility dump failed"
showing "$ARTIFACTS/a11y-banner.json" "Proof Banner" ||
    fail G-NOTIFY-BANNER "no banner showing for the notification"
pass G-NOTIFY-BANNER "a D-Bus notification shows a banner"

sleep 6
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-expired.json" 20 ||
    fail G-NOTIFY-EXPIRE "accessibility dump failed"
if showing "$ARTIFACTS/a11y-expired.json" "Proof Banner"; then
    fail G-NOTIFY-EXPIRE "banner still showing after its timeout"
fi
pass G-NOTIFY-EXPIRE "the banner expires by itself"

open_calendar
scrot "$ARTIFACTS/13-notification-list.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-list.json" 20 ||
    fail G-NOTIFY-LIST "accessibility dump failed"
showing "$ARTIFACTS/a11y-list.json" "Proof Banner" ||
    fail G-NOTIFY-LIST "the calendar does not list the notification"
if showing "$ARTIFACTS/a11y-list.json" "No Notifications"; then
    fail G-NOTIFY-LIST "the empty state shows next to a notification"
fi
pass G-NOTIFY-LIST "the calendar lists the notification"

"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-cleared.json" 20 --press "Clear" ||
    fail G-NOTIFY-CLEAR "could not press Clear"
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-cleared.json" 20 ||
    fail G-NOTIFY-CLEAR "accessibility dump failed"
showing "$ARTIFACTS/a11y-cleared.json" "No Notifications" ||
    fail G-NOTIFY-CLEAR "Clear did not empty the list"
pass G-NOTIFY-CLEAR "Clear empties the list"

xdotool key Escape
sleep 1
# Do Not Disturb from the quick-settings tile (the calendar's switch
# shares the same store).
xdotool mousemove --window "$WID" $((WIDTH - 50)) 16 click 1
sleep 2
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-dnd.json" 20 --press "Do Not Disturb" ||
    fail G-NOTIFY-DND "could not press Do Not Disturb"
xdotool key Escape
sleep 1
notify "Quiet Note" "Held back by Do Not Disturb" || fail G-NOTIFY-DND "Notify call failed"
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-dnd-banner.json" 20 ||
    fail G-NOTIFY-DND "accessibility dump failed"
if showing "$ARTIFACTS/a11y-dnd-banner.json" "Quiet Note"; then
    fail G-NOTIFY-DND "a banner showed with Do Not Disturb on"
fi
open_calendar
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-dnd-list.json" 20 ||
    fail G-NOTIFY-DND "accessibility dump failed"
showing "$ARTIFACTS/a11y-dnd-list.json" "Quiet Note" ||
    fail G-NOTIFY-DND "the held-back notification is missing from the list"
pass G-NOTIFY-DND "Do Not Disturb holds banners back but keeps the list"
scrot "$ARTIFACTS/14-dnd-list.png" >/dev/null
xdotool key Escape

# Quick-settings services (#55): each toggle is read back from its daemon.
sysprop() {
    gdbus call --system --dest "$1" --object-path "$2" \
        --method org.freedesktop.DBus.Properties.Get "$3" "$4" 2>>"$ARTIFACTS/stubs.log"
}
open_qs() {
    xdotool mousemove --window "$WID" $((WIDTH - 50)) 16 click 1
    sleep 2
}
qs_press() {
    "$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-$2.json" 20 --press "$1"
}
open_qs
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-services.json" 20 ||
    fail G-QS-SERVICES "accessibility dump failed"
scrot "$ARTIFACTS/15-quick-settings-services.png" >/dev/null
for label in "Wi-Fi" "Wired" "Bluetooth" "Power Mode" "Brightness" "Volume"; do
    showing "$ARTIFACTS/a11y-qs-services.json" "$label" ||
        fail G-QS-SERVICES "no '$label' control with its daemon on the bus"
done
pass G-QS-SERVICES "quick settings shows a tile per service on the bus"

qs_press "Wi-Fi" wifi || fail G-QS-WIFI "could not press Wi-Fi"
sysprop org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
    org.freedesktop.NetworkManager WirelessEnabled | grep -q false ||
    fail G-QS-WIFI "NetworkManager's WirelessEnabled is still true"
pass G-QS-WIFI "the Wi-Fi tile turns NetworkManager's radio off"

qs_press "Bluetooth" bt || fail G-QS-BLUETOOTH "could not press Bluetooth"
sysprop org.bluez /org/bluez/hci0 org.bluez.Adapter1 Powered | grep -q false ||
    fail G-QS-BLUETOOTH "the BlueZ adapter is still powered"
pass G-QS-BLUETOOTH "the Bluetooth tile powers the adapter off"

qs_press "Power Mode" power || fail G-QS-POWER "could not press Power Mode"
sysprop org.freedesktop.UPower.PowerProfiles /org/freedesktop/UPower/PowerProfiles \
    org.freedesktop.UPower.PowerProfiles ActiveProfile | grep -q power-saver ||
    fail G-QS-POWER "power-profiles-daemon did not switch to power-saver"
pass G-QS-POWER "the Power Mode tile switches to power saver"

qs_press "Dark Style" dark || fail G-QS-DARK "could not press Dark Style"
scheme="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)"
[ "$scheme" = "'prefer-dark'" ] ||
    fail G-QS-DARK "color-scheme is $scheme, not 'prefer-dark'"
pass G-QS-DARK "the Dark Style tile writes GNOME's color-scheme key"

"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-brightness.json" 20 \
    --set Brightness 30 || fail G-QS-BRIGHTNESS "could not set Brightness"
[ "$(cat "$BACKLIGHT/brightness")" = 300 ] ||
    fail G-QS-BRIGHTNESS "backlight is $(cat "$BACKLIGHT/brightness"), not 300"
pass G-QS-BRIGHTNESS "the brightness slider sets the backlight through logind"

"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-volume.json" 20 \
    --set Volume 40 || fail G-QS-VOLUME "could not set Volume"
[ "$(cat "$VOLUME_FILE")" = 0.40 ] ||
    fail G-QS-VOLUME "sink volume is $(cat "$VOLUME_FILE"), not 0.40"
pass G-QS-VOLUME "the volume slider sets the PipeWire sink volume"
scrot "$ARTIFACTS/16-quick-settings-toggled.png" >/dev/null
xdotool key Escape
sleep 1

kill "$STUBS_PID" 2>/dev/null || true
STUBS_PID=""
sleep 2
scrot "$ARTIFACTS/17-before-absent.png" >/dev/null
open_qs
scrot "$ARTIFACTS/18-quick-settings-absent.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-absent.json" 20 ||
    fail G-QS-ABSENT "accessibility dump failed (shell hung?)"
for label in "Wi-Fi" "Bluetooth" "Power Mode"; do
    if showing "$ARTIFACTS/a11y-qs-absent.json" "$label"; then
        fail G-QS-ABSENT "'$label' still showing with its daemon gone"
    fi
done
showing "$ARTIFACTS/a11y-qs-absent.json" "Dark Style" ||
    fail G-QS-ABSENT "the settings tiles went away with the daemons"
pass G-QS-ABSENT "tiles hide when their daemons leave the bus"
xdotool key Escape

# GPU clients (#89): with linux-dmabuf advertised, a GTK window on the
# GL renderer maps and paints instead of hanging.
WAYLAND_DISPLAY="$SOCKET_NAME" GSK_RENDERER=gl "$PY" "$ROOT/scripts/lib/roost-test-window.py" \
    Delta "#c01c28" >"$ARTIFACTS/window-Delta.log" 2>&1 &
cstate '.windows | any(.app_id == "roost-test-delta")' "gl window" ||
    fail G-GL-WINDOW "a GL-rendered GTK window never mapped"
sleep 2
scrot "$ARTIFACTS/19-gl-window.png" >/dev/null
centre="$(jq -r '.windows[] | select(.app_id == "roost-test-delta") | .rect | "\(.[0] + .[2] / 2) \(.[1] + .[3] / 3)"' "$CSTATE")"
# shellcheck disable=SC2086
set -- $centre
rgb="$(px "$ARTIFACTS/19-gl-window.png" "${1%.*}" "${2%.*}")"
# shellcheck disable=SC2086
set -- $rgb
if [ "$1" -lt 150 ] || [ "$2" -gt 80 ] || [ "$3" -gt 80 ]; then
    fail G-GL-WINDOW "GL window did not paint its red body (pixel $rgb)"
fi
pass G-GL-WINDOW "a GL-rendered GTK window maps and paints"

# X11 by default (#59): the compositor starts XWayland when it is
# installed, tells the shell DISPLAY, and apps launched from search get it.
if command -v Xwayland >/dev/null 2>&1 && command -v xeyes >/dev/null 2>&1; then
    cstate '.x11_display != null' "xwayland" 30 || fail G-X11-APP "XWayland never came up"
    x11_display="$(jq -r '.x11_display' "$CSTATE")"
    before="$(jq '.windows | length' "$CSTATE")"
    xdotool key Super_L
    cstate '.overview_open' "overview" || fail G-X11-APP "overview did not open"
    sleep 1
    xdotool type --delay 40 "roost x probe"
    sleep 1
    xdotool key Return
    end=$(($(date +%s) + 15))
    until [ -s "$X11_MARKER" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
    [ "$(cat "$X11_MARKER" 2>/dev/null)" = "$x11_display" ] ||
        fail G-X11-APP "launched app saw DISPLAY='$(cat "$X11_MARKER" 2>/dev/null)', not $x11_display"
    cstate "(.windows | length) > $before" "x11 window" 20 ||
        fail G-X11-APP "the X11 app never mapped a window"
    # Like a native app: focused, and placed below the top bar.
    cstate '.focused_app_id == "XEyes"' "x11 focus" ||
        fail G-X11-APP "the X11 window was not focused after launch"
    cstate '.windows[] | select(.app_id == "XEyes") | .rect[1] >= 32' "x11 placement" ||
        fail G-X11-APP "the X11 window was placed under the top bar"
    sleep 1
    scrot "$ARTIFACTS/20-x11-app.png" >/dev/null
    pass G-X11-APP "an X11 app launched from search gets DISPLAY $x11_display and maps"
else
    echo "roost-gtk-shell-proof: G-X11-APP skipped (no Xwayland or xeyes)"
fi

# GNOME's clock keys reach the panel clock within its 1 s tick.
gsettings set org.gnome.desktop.interface clock-show-seconds true
sleep 2
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-clock.json" 20 ||
    fail G-SETTINGS-CLOCK "accessibility dump failed"
jq -e 'any(.[]; .role == "label" and (.name | test("[0-9]+:[0-9]{2}:[0-9]{2}")))' \
    "$ARTIFACTS/a11y-clock.json" >/dev/null ||
    fail G-SETTINGS-CLOCK "clock-show-seconds did not add seconds to the panel clock"
gsettings set org.gnome.desktop.interface clock-show-seconds false
pass G-SETTINGS-CLOCK "GNOME's clock-show-seconds changes the panel clock"

# GNOME settings (#63): the idle lock follows idle-delay and
# lock-enabled as they change.
gsettings set org.gnome.desktop.session idle-delay 600
cstate '.idle_timeout_ms == 600000' "idle 600" ||
    fail G-SETTINGS-IDLE "idle-delay 600 did not reach the compositor"
gsettings set org.gnome.desktop.screensaver lock-enabled false
cstate '.idle_timeout_ms > 1e18' "lock off" ||
    fail G-SETTINGS-IDLE "lock-enabled false did not turn the idle lock off"
gsettings set org.gnome.desktop.screensaver lock-enabled true
gsettings set org.gnome.desktop.session idle-delay 300
cstate '.idle_timeout_ms == 300000' "idle 300" ||
    fail G-SETTINGS-IDLE "the idle lock did not follow back to 300 s"
pass G-SETTINGS-IDLE "GNOME's idle-delay and lock-enabled set the idle lock live"

# Power (#62), against the logind stub (restarted: G-QS-ABSENT stopped
# it). The proof runs the shell as a hardware session for the full menu.
POWER_LOG="$ARTIFACTS/power-log"
: >"$POWER_LOG"
"$PY" "$ROOT/scripts/lib/roost-service-stubs.py" "$BACKLIGHT" "$POWER_LOG" >>"$ARTIFACTS/stubs.log" 2>&1 &
STUBS_PID=$!
sleep 2
open_power_menu() {
    open_qs
    "$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-$1.json" 20 --press "Power Off"
}
open_power_menu power-menu || fail G-POWER-MENU "could not press the power button"
scrot "$ARTIFACTS/21-power-menu.png" >/dev/null
for label in "Suspend" "Restart…" "Power Off…" "Log Out…"; do
    showing "$ARTIFACTS/a11y-power-menu.json" "$label" ||
        fail G-POWER-MENU "no '$label' row in the power menu"
done
pass G-POWER-MENU "the power button opens Suspend, Restart…, Power Off…, Log Out…"

"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-dialog.json" 20 \
    --press "Power Off…" || fail G-POWER-DIALOG "could not press Power Off…"
scrot "$ARTIFACTS/22-end-session.png" >/dev/null
jq -e 'any(.[]; .showing and (.name | test("will power off automatically in [0-9]+ seconds")))' \
    "$ARTIFACTS/a11y-power-dialog.json" >/dev/null ||
    fail G-POWER-DIALOG "no end-session countdown showing"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-cancel.json" 20 \
    --press "Cancel" || fail G-POWER-DIALOG "could not press Cancel"
if jq -e 'any(.[]; .showing and (.name | test("automatically in")))' "$ARTIFACTS/a11y-power-cancel.json" >/dev/null; then
    fail G-POWER-DIALOG "the dialog stayed open after Cancel"
fi
[ ! -s "$POWER_LOG" ] || fail G-POWER-DIALOG "Cancel still called logind: $(cat "$POWER_LOG")"
pass G-POWER-DIALOG "Power Off… opens the countdown dialog and Cancel does nothing"

open_power_menu power-menu-2 || fail G-POWER-OFF "could not reopen the power menu"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-dialog-2.json" 20 \
    --press "Power Off…" || fail G-POWER-OFF "could not press Power Off…"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-confirm.json" 20 \
    --press "Power Off" || fail G-POWER-OFF "could not confirm"
end=$(($(date +%s) + 10))
until grep -q PowerOff "$POWER_LOG" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q PowerOff "$POWER_LOG" || fail G-POWER-OFF "logind never got PowerOff"
pass G-POWER-OFF "confirming the dialog asks logind to power off"

open_power_menu power-menu-3 || fail G-SUSPEND-LOCK "could not reopen the power menu"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-suspend.json" 20 \
    --press "Suspend" || fail G-SUSPEND-LOCK "could not press Suspend"
end=$(($(date +%s) + 10))
until grep -q Suspend "$POWER_LOG" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q Suspend "$POWER_LOG" || fail G-SUSPEND-LOCK "logind never got Suspend"
cstate '.locked' "locked" 10 || fail G-SUSPEND-LOCK "PrepareForSleep did not lock the session"
scrot "$ARTIFACTS/23-locked-after-suspend.png" >/dev/null
pass G-SUSPEND-LOCK "Suspend asks logind, and PrepareForSleep locks the session"

"$ROOT/scripts/roost-a11y-golden" check "$ARTIFACTS" ||
    fail A11Y-GOLDEN "accessible trees differ from tests/a11y/ (see above)"
pass A11Y-GOLDEN "panel, calendar, quick settings and overview trees match their goldens"

grep -q panicked "$LOG" && fail G-NOPANIC "panic in nested log"
# The shell must survive the whole journey: a crash the supervisor
# quietly restarts is still a failure (the overview-close teardown bug
# hid behind exactly that).
if grep -q 'ShellExited' "$LOG"; then
    fail G-SHELL-STABLE "the shell exited during the journey: $(grep -c ShellExited "$LOG") time(s)"
fi
pass G-SHELL-STABLE "the shell never exited or restarted"
echo "roost-gtk-shell-proof: OK, artifacts in $ARTIFACTS"
