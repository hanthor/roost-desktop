# The shell hides its overview surfaces on its next frame: let it.
sleep 1
pass G-KEYBINDINGS "Super+S, Super+V and Super+A open GNOME's menus and the app grid"

# GNOME's window menu on a header bar's right click: Always on Top, then
# Hide; the hidden window still shows in the overview, and picking it
# there brings it back.
pick_alpha() {
    xdotool key Super_L
    cstate '.overview_open and (.previews | length) > 0' "overview" || return 1
    sleep 1
    alpha="$(jq -r '.previews[] | select(.app_id == "roost-test-alpha") | .rect | "\(.[0] + .[2] / 2) \(.[1] + .[3] / 2)"' "$CSTATE")"
    [ -n "$alpha" ] || return 1
    # shellcheck disable=SC2086
    xdotool mousemove --window "$WID" $alpha click 1
    cstate '(.overview_open | not) and .focused_app_id == "roost-test-alpha"' "alpha"
}
window_menu() {
    header="$(jq -r '.focused_rect | "\(.[0] + 60) \(.[1] + 20)"' "$CSTATE")"
    # shellcheck disable=SC2086
    xdotool mousemove --window "$WID" $header click 3
    sleep 1.5
}
pick_alpha || fail G-WINDOW-MENU "could not focus Alpha from the overview"
alpha_id="$(jq -r .focused "$CSTATE")"
window_menu
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-window-menu.json" 20 ||
    fail G-WINDOW-MENU "accessibility dump failed"
showing "$ARTIFACTS/a11y-window-menu.json" "Hide" ||
    fail G-WINDOW-MENU "the right click opened no window menu"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-window-menu-press.json" 20 \
    --press "Always on Top" || fail G-WINDOW-MENU "the window menu has no Always on Top"
cstate "any(.above[]; . == $alpha_id)" "above" ||
    fail G-WINDOW-MENU "Always on Top did not keep the window above"
window_menu
scrot "$ARTIFACTS/24d-window-menu.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-window-menu-2.json" 20 \
    --press "Hide" || fail G-WINDOW-MENU "could not press Hide"
cstate "any(.minimized[]; . == $alpha_id) and .focused != $alpha_id" "hidden" ||
    fail G-WINDOW-MENU "Hide did not take the window away"
pick_alpha || fail G-WINDOW-MENU "the hidden window could not be picked from the overview"
cstate "any(.minimized[]; . == $alpha_id) | not" "restored" ||
    fail G-WINDOW-MENU "picking the hidden window did not bring it back"
pass G-WINDOW-MENU "the header-bar menu keeps a window on top, hides it, and the overview brings it back"

# GNOME's window-manager keys (org.gnome.desktop.wm.keybindings).
sleep 1
xdotool key alt+space
sleep 1.5
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-wm-menu.json" 20 ||
    fail G-WM-KEYS "accessibility dump failed"
showing "$ARTIFACTS/a11y-wm-menu.json" "Hide" || fail G-WM-KEYS "Alt+Space opened no window menu"
xdotool key Escape
sleep 1
before_w="$(jq -r '.focused_rect[2]' "$CSTATE")"
xdotool key alt+F10
cstate ".focused_rect[2] == $WIDTH" "maximized" || fail G-WM-KEYS "Alt+F10 did not maximize"
xdotool key alt+F10
cstate ".focused_rect[2] == $before_w" "restored" || fail G-WM-KEYS "Alt+F10 again did not restore"
first_ws="$(jq -r '.active_workspace' "$CSTATE")"
xdotool key super+End
cstate ".active_workspace != $first_ws" "last workspace" || fail G-WM-KEYS "Super+End stayed put"
xdotool key super+Home
cstate ".active_workspace == $first_ws" "first workspace" || fail G-WM-KEYS "Super+Home did not come back"
pass G-WM-KEYS "Alt+Space, Alt+F10 and Super+End/Home do what GNOME's window-manager keys do"

# The window-manager keys follow org.gnome.desktop.wm.keybindings, the
# compositor's defaults standing aside: rebinding maximize moves it.
cstate ".focused_rect[2] != $WIDTH" "not maximized" ||
    fail G-WM-REBIND "the focused window is maximized before the test"
gsettings set org.gnome.desktop.wm.keybindings maximize "['<Super>F9']"
for _ in $(seq 1 20); do grep -qF 'maximize on ["<Super>F9"]' "$LOG" && break; sleep 0.3; done
sleep 0.5
xdotool key super+Up
sleep 1.5
cstate ".focused_rect[2] != $WIDTH" "unbound" 3 ||
    fail G-WM-REBIND "Super+Up still maximized after maximize moved to Super+F9"
xdotool key super+F9
cstate ".focused_rect[2] == $WIDTH" "rebound" || fail G-WM-REBIND "Super+F9 did not maximize"
xdotool key super+Down
cstate ".focused_rect[2] != $WIDTH" "restored" || fail G-WM-REBIND "Super+Down did not restore"
gsettings reset org.gnome.desktop.wm.keybindings maximize
sleep 1
pass G-WM-REBIND "GNOME's maximize key rebinds: the old chord stops and the new one maximizes"

# The switcher's keys rebind too: switch-applications on Ctrl+J steps
# and commits on Control's release, and Alt+Tab is left to apps.
gsettings set org.gnome.desktop.wm.keybindings switch-applications "['<Control>j']"
sleep 1.5
steps="$(grep -c 'switcher Step' "$LOG")"
xdotool key alt+Tab
sleep 1
[ "$(grep -c 'switcher Step' "$LOG")" = "$steps" ] ||
    fail G-SWITCHER-REBIND "Alt+Tab still stepped the switcher after switch-applications moved"
commits="$(grep -c 'switcher Commit' "$LOG")"
xdotool keydown Control_L
xdotool key j
sleep 0.5
xdotool keyup Control_L
sleep 1
[ "$(grep -c 'switcher Step' "$LOG")" -gt "$steps" ] ||
    fail G-SWITCHER-REBIND "Ctrl+J did not step the switcher"
[ "$(grep -c 'switcher Commit' "$LOG")" -gt "$commits" ] ||
    fail G-SWITCHER-REBIND "releasing Control did not commit the switcher"
gsettings reset org.gnome.desktop.wm.keybindings switch-applications
sleep 1
pass G-SWITCHER-REBIND "GNOME's switch-applications rebinds: Ctrl+J steps and commits, Alt+Tab goes to apps"

# GNOME's workspace switcher popup: a dark pill above the bottom edge
# right after a workspace key.
xdotool key super+Page_Down
sleep 0.3
scrot "$ARTIFACTS/24f-workspace-popup.png" >/dev/null
# shellcheck disable=SC2046
set -- $(px "$ARTIFACTS/24f-workspace-popup.png" $((WIDTH / 2 - 20)) $((HEIGHT - 59 - 28)))
xdotool key super+Page_Up
if [ "${1:-0}" -ge 70 ] || [ "${2:-0}" -ge 70 ] || [ "${3:-0}" -ge 75 ]; then
    fail G-WS-POPUP "no switcher pill above the bottom edge (pixel ${1:-?} ${2:-?} ${3:-?})"
fi
pass G-WS-POPUP "a workspace key shows GNOME's workspace switcher popup"
sleep 1

# GNOME's workspace thumbnails: a window moved one workspace right makes
# three (the trailing empty one included), so the overview shows the
# strip; a thumbnail click switches there with the overview still open.
home_ws="$(jq -r '.active_workspace' "$CSTATE")"
moved="$(jq -r .focused "$CSTATE")"
window_menu
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-ws-right.json" 20 \
    --press "Move to Workspace Right" || fail G-WS-THUMBS "the window menu has no Move to Workspace Right"
cstate ".active_workspace == $home_ws and any(.windows[]; .id == $moved and .workspace == $home_ws + 1)" \
    "moved" || fail G-WS-THUMBS "the window did not move one workspace right"
sleep 1
xdotool key Super_L
cstate '.overview_open and (.thumbnails | length) == 3' "strip" ||
    fail G-WS-THUMBS "the overview shows no three-thumbnail strip"
sleep 1.5
scrot "$ARTIFACTS/24g-workspace-thumbnails.png" >/dev/null
ring="$(jq -r '.thumbnails[] | select(.active) | .rect | "\(.[0] - 2) \(.[1] + .[3] / 2)"' "$CSTATE")"
# shellcheck disable=SC2046,SC2086
set -- $(px "$ARTIFACTS/24g-workspace-thumbnails.png" $ring)
if [ "${3:-0}" -le 180 ] || [ "${1:-255}" -ge 100 ]; then
    fail G-WS-THUMBS "no accent indicator around the active thumbnail (pixel ${1:-?} ${2:-?} ${3:-?})"
fi
target="$(jq -r ".thumbnails[] | select(.workspace == $home_ws + 1) | .rect | \"\(.[0] + .[2] / 2) \(.[1] + .[3] / 2)\"" "$CSTATE")"
# shellcheck disable=SC2086
xdotool mousemove --window "$WID" $target click 1
cstate ".overview_open and .active_workspace == $home_ws + 1" "switched" ||
    fail G-WS-THUMBS "a thumbnail click did not switch workspace"
xdotool key Escape
cstate "(.overview_open | not) and .focused == $moved" "closed" ||
    fail G-WS-THUMBS "closing the overview did not focus the moved window"
pass G-WS-THUMBS "three workspaces show GNOME's thumbnails strip and a thumbnail click switches"
# Put the window back where the journey expects it.
sleep 1
window_menu
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-ws-left.json" 20 \
    --press "Move to Workspace Left" || fail G-WS-THUMBS "the window menu has no Move to Workspace Left"
xdotool key super+Page_Up
cstate ".active_workspace == $home_ws and .focused == $moved" "home" ||
    fail G-WS-THUMBS "could not return the window home"
sleep 1

# GNOME's window drag in the overview: a preview dropped on the right
# neighbor's card moves that window one workspace right.
xdotool key Super_L
cstate ".overview_open and any(.previews[]; .id == $moved)" "overview" ||
    fail G-OV-DND "the overview shows no preview of the window"
sleep 1
read -r px0 py0 <<EOF2
$(jq -r ".previews[] | select(.id == $moved) | .rect | \"\(.[0] + .[2] / 2 | floor) \(.[1] + .[3] / 2 | floor)\"" "$CSTATE")
EOF2
xdotool mousemove --window "$WID" "$px0" "$py0"
xdotool mousedown 1
for step in $(seq 1 12); do
    xdotool mousemove --window "$WID" $((px0 + (WIDTH - 50 - px0) * step / 12)) $((py0 + (HEIGHT / 2 - py0) * step / 12))
    sleep 0.05
done
sleep 0.5
scrot "$ARTIFACTS/24h-overview-drag.png" >/dev/null
xdotool mouseup 1
cstate ".overview_open and any(.windows[]; .id == $moved and .workspace == $home_ws + 1)" "dropped" ||
    fail G-OV-DND "dropping the preview on the next card did not move the window there"
pass G-OV-DND "dragging a preview onto the next workspace's card moves the window there"
xdotool key Escape
sleep 1
xdotool key super+Page_Down
cstate ".focused == $moved" "on the next workspace" || fail G-OV-DND "could not reach the moved window"
window_menu
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-dnd-left.json" 20 \
    --press "Move to Workspace Left" || fail G-OV-DND "the window menu has no Move to Workspace Left"
xdotool key super+Page_Up
cstate ".active_workspace == $home_ws and .focused == $moved" "home" ||
    fail G-OV-DND "could not return the window home"
sleep 1

# Screenshots (#61): GNOME Shell's interface, as the portal calls it.
SHOT="$ARTIFACTS/screenshot.png"
reply="$(gdbus call --session --dest org.gnome.Shell.Screenshot \
    --object-path /org/gnome/Shell/Screenshot \
    --method org.gnome.Shell.Screenshot.Screenshot false false "$SHOT" 2>&1)" ||
    fail G-SCREENSHOT "Screenshot call failed: $reply"
case "$reply" in
    "(true, '$SHOT')") ;;
    *) fail G-SCREENSHOT "unexpected reply: $reply" ;;
esac
dims="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$SHOT")"
[ "$dims" = "$WIDTH,$HEIGHT" ] || fail G-SCREENSHOT "screenshot is $dims, not $WIDTH,$HEIGHT"
# The top bar is black and the desktop below is not: right way up.
[ "$(px "$SHOT" 300 5)" = "0 0 0" ] || fail G-SCREENSHOT "top of the screenshot is not the black bar (flipped?)"
[ "$(px "$SHOT" 5 $((HEIGHT - 5)))" != "0 0 0" ] || fail G-SCREENSHOT "bottom of the screenshot is black (flipped?)"
pass G-SCREENSHOT "org.gnome.Shell.Screenshot saves the screen the right way up"

WSHOT="$ARTIFACTS/screenshot-window.png"
reply="$(gdbus call --session --dest org.gnome.Shell.Screenshot \
    --object-path /org/gnome/Shell/Screenshot \
    --method org.gnome.Shell.Screenshot.ScreenshotWindow true false false "$WSHOT" 2>&1)" ||
    fail G-SCREENSHOT-WINDOW "ScreenshotWindow call failed: $reply"
[ "$reply" = "(true, '$WSHOT')" ] || fail G-SCREENSHOT-WINDOW "unexpected reply: $reply"
dims="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$WSHOT")"
want="$(jq -r '.focused as $f | .windows[] | select(.id == $f) | .rect | "\(.[2]),\(.[3])"' "$CSTATE" | head -1)"
if [ -z "$want" ] || [ "$dims" != "$want" ]; then
    fail G-SCREENSHOT-WINDOW "window screenshot is $dims, focused window is ${want:-none}"
fi
pass G-SCREENSHOT-WINDOW "ScreenshotWindow saves the focused window ($dims)"

open_qs
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-shot.json" 20 \
    --press "Take Screenshot" || fail G-SCREENSHOT-BUTTON "could not press Take Screenshot"
end=$(($(date +%s) + 15))
until [ -n "$(find "$XDG_PICTURES_DIR/Screenshots" -name 'Screenshot From *.png' 2>/dev/null)" ] ||
    [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
[ -n "$(find "$XDG_PICTURES_DIR/Screenshots" -name 'Screenshot From *.png' 2>/dev/null)" ] ||
    fail G-SCREENSHOT-BUTTON "no Pictures/Screenshots/Screenshot From *.png"
sleep 1
xdotool mousemove --window "$WID" $((WIDTH / 2)) 16 click 1
sleep 2
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-shot-list.json" 20 ||
    fail G-SCREENSHOT-BUTTON "accessibility dump failed"
showing "$ARTIFACTS/a11y-shot-list.json" "Screenshot captured" ||
    fail G-SCREENSHOT-BUTTON "no 'Screenshot captured' notification"
xdotool key Escape
sleep 1
pass G-SCREENSHOT-BUTTON "the button saves to Pictures/Screenshots and notifies"

# GNOME's screenshot UI on Print: Screen, then Capture saves the whole
# screen where GNOME does.
before="$(find "$XDG_PICTURES_DIR/Screenshots" -name 'Screenshot From *.png' 2>/dev/null | wc -l)"
xdotool key Print
end=$(($(date +%s) + 20))
until "$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-shot-ui.json" 5 >/dev/null 2>&1 &&
    showing "$ARTIFACTS/a11y-shot-ui.json" "Capture" || [ "$(date +%s)" -gt "$end" ]; do sleep 0.5; done
showing "$ARTIFACTS/a11y-shot-ui.json" "Capture" || fail G-SCREENSHOT-UI "Print did not open the screenshot UI"
scrot "$ARTIFACTS/24e-screenshot-ui.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-shot-ui-screen.json" 20 \
    --press "Screen" || fail G-SCREENSHOT-UI "could not choose Screen"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-shot-ui-capture.json" 20 \
    --press "Capture" || fail G-SCREENSHOT-UI "could not press Capture"
end=$(($(date +%s) + 15))
until [ "$(find "$XDG_PICTURES_DIR/Screenshots" -name 'Screenshot From *.png' 2>/dev/null | wc -l)" -gt "$before" ] ||
    [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
newest="$(find "$XDG_PICTURES_DIR/Screenshots" -name 'Screenshot From *.png' -newer "$ARTIFACTS/24e-screenshot-ui.png" 2>/dev/null | head -1)"
[ -n "$newest" ] || fail G-SCREENSHOT-UI "Capture saved nothing"
dims="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$newest")"
[ "$dims" = "$WIDTH,$HEIGHT" ] || fail G-SCREENSHOT-UI "the Screen capture is $dims, not $WIDTH,$HEIGHT"
pass G-SCREENSHOT-UI "Print opens GNOME's screenshot UI; Screen and Capture save the whole screen"

# Screen sharing (#61): the portal's calls, a frame over PipeWire.
if [ -n "$PW_PIDS" ] && command -v gst-launch-1.0 >/dev/null 2>&1; then
    CAST="$ARTIFACTS/screencast.png"
    "$PY" "$ROOT/scripts/lib/roost-screencast-client.py" "$CAST" >"$ARTIFACTS/screencast.log" 2>&1 ||
        fail G-SCREENCAST "cast failed: $(tail -3 "$ARTIFACTS/screencast.log")"
    dims="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$CAST")"
    [ "$dims" = "$WIDTH,$HEIGHT" ] || fail G-SCREENCAST "cast frame is $dims, not $WIDTH,$HEIGHT"
    [ "$(px "$CAST" 300 5)" = "0 0 0" ] || fail G-SCREENCAST "cast frame does not show the top bar"
    pass G-SCREENCAST "monitor recorded over Mutter ScreenCast, frame pulled from PipeWire ($(cat "$ARTIFACTS/screencast.log"))"
    WCAST="$ARTIFACTS/window-cast.png"
    "$PY" "$ROOT/scripts/lib/roost-screencast-client.py" "$WCAST" --window \
        >"$ARTIFACTS/window-cast.log" 2>&1 ||
        fail G-WINDOW-CAST "window cast failed: $(tail -3 "$ARTIFACTS/window-cast.log")"
    # "node N window ID WxH TITLE": the frame is the window's own size.
    size="$(awk '{print $5}' "$ARTIFACTS/window-cast.log")"
    dims="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$WCAST")"
    [ "$dims" = "$(echo "$size" | tr x ,)" ] ||
        fail G-WINDOW-CAST "window frame is $dims, not the window's $size"
    [ "$dims" != "$WIDTH,$HEIGHT" ] || fail G-WINDOW-CAST "window frame is the whole screen"
    pass G-WINDOW-CAST "a window shared over Introspect and RecordWindow ($(cat "$ARTIFACTS/window-cast.log"))"
else
    echo "roost-gtk-shell-proof: G-SCREENCAST skipped (no pipewire, wireplumber or gstreamer)"
fi

# Display settings (#59): what GNOME Settings' Displays panel sends.
apply_display() {
    gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
        --object-path /org/gnome/Mutter/DisplayConfig \
        --method org.gnome.Mutter.DisplayConfig.ApplyMonitorsConfig \
        -- 0 "$1" "[(0, 0, $2, uint32 0, true, [('roost-0', '${WIDTH}x${HEIGHT}@60.000', @a{sv} {})])]" \
        "@a{sv} {}" >>"$ARTIFACTS/display-settings.log" 2>&1
}
apply_display 2 1.25 || fail G-DISPLAY-SETTINGS "ApplyMonitorsConfig failed: $(tail -2 "$ARTIFACTS/display-settings.log")"
cstate '.layers | any(.namespace == "roost-panel" and .rect[2] == 1024)' "125 percent" ||
    fail G-DISPLAY-SETTINGS "the layout did not follow scale 1.25"
grep -q '<scale>1.25</scale>' "$XDG_CONFIG_HOME/roost/monitors.xml" 2>/dev/null ||
    fail G-DISPLAY-SETTINGS "the arrangement was not saved to roost/monitors.xml"
scrot "$ARTIFACTS/24-scale-125.png" >/dev/null
apply_display 1 1 || fail G-DISPLAY-SETTINGS "restoring scale 1 failed"
cstate ".layers | any(.namespace == \"roost-panel\" and .rect[2] == $WIDTH)" "100 percent" ||
    fail G-DISPLAY-SETTINGS "the layout did not return to scale 1"
pass G-DISPLAY-SETTINGS "ApplyMonitorsConfig changes the scale live and saves it"

# Power (#62), against the logind stub (restarted: G-QS-ABSENT stopped
# it). The proof runs the shell as a hardware session for the full menu.
POWER_LOG="$ARTIFACTS/power-log"
: >"$POWER_LOG"
"$PY" "$ROOT/scripts/lib/roost-service-stubs.py" "$BACKLIGHT" "$POWER_LOG" >>"$ARTIFACTS/stubs.log" 2>&1 &
STUBS_PID=$!

# GNOME Shell's brightness keys step the backlight through logind (back
# on the bus now) and show the brightness OSD.
sleep 2
before="$(cat "$BACKLIGHT/brightness")"
xdotool key XF86MonBrightnessUp
end=$(($(date +%s) + 5))
until [ "$(cat "$BACKLIGHT/brightness")" != "$before" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
after="$(cat "$BACKLIGHT/brightness")"
[ "$after" -gt "$before" ] ||
    fail G-KEY-BRIGHTNESS "the brightness key left the backlight at $after (was $before)"
scrot "$ARTIFACTS/24c-brightness-osd.png" >/dev/null
pass G-KEY-BRIGHTNESS "the brightness key steps the backlight by a twentieth through logind"

# GNOME Shell as the polkit agent: polkit (the Authority stub, back on
# the bus) asks the agent to authenticate; a wrong password says so and
# asks again, the right one authorizes.
end=$(($(date +%s) + 15))
until [ -s "$ROOST_STUB_POLKIT_LOG" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
[ -s "$ROOST_STUB_POLKIT_LOG" ] || fail G-POLKIT "the shell never registered a polkit agent"
read -r agent_name agent_path <"$ROOST_STUB_POLKIT_LOG"
gdbus call --system --dest "$agent_name" --object-path "$agent_path" \
    --method org.freedesktop.PolicyKit1.AuthenticationAgent.BeginAuthentication \
    org.roost.proof "Authentication is required to run the Roost proof." "" "{}" cookie-1 \
    "[('unix-user', {'uid': <uint32 $(id -u)>})]" >"$ARTIFACTS/polkit-reply" 2>&1 &
end=$(($(date +%s) + 15))
until "$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-polkit.json" 5 >/dev/null 2>&1 &&
    showing "$ARTIFACTS/a11y-polkit.json" "Authenticate" || [ "$(date +%s)" -gt "$end" ]; do sleep 0.5; done
showing "$ARTIFACTS/a11y-polkit.json" "Authenticate" || fail G-POLKIT "no Authentication Required dialog"
sleep 1
scrot "$ARTIFACTS/24g-polkit.png" >/dev/null
xdotool type --delay 30 "not-it"
xdotool key Return
sleep 1.5
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-polkit-failed.json" 20 ||
    fail G-POLKIT "accessibility dump failed"
showing "$ARTIFACTS/a11y-polkit-failed.json" "Sorry, that didn’t work. Please try again." ||
    fail G-POLKIT "a wrong password did not say so"
xdotool type --delay 30 "roost-proof"
xdotool key Return
end=$(($(date +%s) + 10))
until grep -q "^()" "$ARTIFACTS/polkit-reply" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "^()" "$ARTIFACTS/polkit-reply" ||
    fail G-POLKIT "the right password did not authorize: $(cat "$ARTIFACTS/polkit-reply")"
pass G-POLKIT "polkit's request shows GNOME's dialog; a wrong password is refused, the right one authorizes"
sleep 2
open_power_menu() {
    open_qs
    "$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-$1.json" 20 --press "Power Off Menu"
}
open_power_menu power-menu || fail G-POWER-MENU "could not press the power button"
scrot "$ARTIFACTS/21-power-menu.png" >/dev/null
for label in "Suspend" "Restart…" "Power Off…" "Log Out…"; do
    showing "$ARTIFACTS/a11y-power-menu.json" "$label" ||
        fail G-POWER-MENU "no '$label' row in the power menu"
done
pass G-POWER-MENU "the power button opens Suspend, Restart…, Power Off…, Log Out…"

"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-dialog.json" 20 \
    --press "Power Off…" || fail G-POWER-DIALOG "could not press Power Off…"
scrot "$ARTIFACTS/22-end-session.png" >/dev/null
jq -e 'any(.[]; .showing and (.name | test("will power off automatically in [0-9]+ seconds")))' \
    "$ARTIFACTS/a11y-power-dialog.json" >/dev/null ||
    fail G-POWER-DIALOG "no end-session countdown showing"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-cancel.json" 20 \
    --press "Cancel" || fail G-POWER-DIALOG "could not press Cancel"
if jq -e 'any(.[]; .showing and (.name | test("automatically in")))' "$ARTIFACTS/a11y-power-cancel.json" >/dev/null; then
    fail G-POWER-DIALOG "the dialog stayed open after Cancel"
fi
[ ! -s "$POWER_LOG" ] || fail G-POWER-DIALOG "Cancel still called logind: $(cat "$POWER_LOG")"
pass G-POWER-DIALOG "Power Off… opens the countdown dialog and Cancel does nothing"

# Escape cancels too, as in GNOME: the dialog holds the keyboard
# (layer-shell keyboard exclusivity).
open_power_menu power-menu-esc || fail G-POWER-ESCAPE "could not reopen the power menu"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-esc.json" 20 \
    --press "Log Out…" || fail G-POWER-ESCAPE "could not press Log Out…"
sleep 1
xdotool key Escape
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-esc-after.json" 20 ||
    fail G-POWER-ESCAPE "accessibility dump failed"
if jq -e 'any(.[]; .showing and (.name | test("automatically in")))' "$ARTIFACTS/a11y-power-esc-after.json" >/dev/null; then
    fail G-POWER-ESCAPE "Escape left the end-session dialog up"
fi
pass G-POWER-ESCAPE "Escape dismisses the end-session dialog"

open_power_menu power-menu-2 || fail G-POWER-OFF "could not reopen the power menu"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-dialog-2.json" 20 \
    --press "Power Off…" || fail G-POWER-OFF "could not press Power Off…"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-power-confirm.json" 20 \
    --press "Power Off" || fail G-POWER-OFF "could not confirm"
end=$(($(date +%s) + 10))
until grep -q PowerOff "$POWER_LOG" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q PowerOff "$POWER_LOG" || fail G-POWER-OFF "logind never got PowerOff"
pass G-POWER-OFF "confirming the dialog asks logind to power off"

open_power_menu power-menu-3 || fail G-SUSPEND-LOCK "could not reopen the power menu"
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-suspend.json" 20 \
    --press "Suspend" || fail G-SUSPEND-LOCK "could not press Suspend"
end=$(($(date +%s) + 10))
until grep -q Suspend "$POWER_LOG" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q Suspend "$POWER_LOG" || fail G-SUSPEND-LOCK "logind never got Suspend"
cstate '.locked' "locked" 10 || fail G-SUSPEND-LOCK "PrepareForSleep did not lock the session"
scrot "$ARTIFACTS/23-locked-after-suspend.png" >/dev/null
pass G-SUSPEND-LOCK "Suspend asks logind, and PrepareForSleep locks the session"

# GNOME's lock screen (ext-session-lock): a click lifts the curtain, a
# wrong password is refused and the session stays locked, the right one
# unlocks it and the windows come back.
if [ -n "$PAM_ON" ]; then
    sleep 1
    xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT * 3 / 4)) click 1
    sleep 1
    scrot "$ARTIFACTS/24-unlock-prompt.png" >/dev/null
    xdotool type --delay 30 "not-the-password"
    xdotool key Return
    sleep 2
    cstate '.locked' "still locked after a wrong password" 5 ||
        fail G-UNLOCK "a wrong password unlocked the session"
    scrot "$ARTIFACTS/25-unlock-denied.png" >/dev/null
    xdotool type --delay 30 "$UNLOCK_PASSWORD"
    xdotool key Return
    cstate '(.locked | not) and (.windows | length) > 0' "unlocked" 15 ||
        fail G-UNLOCK "the right password did not unlock the session"
    scrot "$ARTIFACTS/26-unlocked.png" >/dev/null
    pass G-UNLOCK "a wrong password is refused, the right one unlocks through PAM"
else
    echo "roost-gtk-shell-proof: G-UNLOCK skipped (no pam_wrapper)"
fi

"$ROOT/scripts/roost-a11y-golden" check "$ARTIFACTS" ||
    fail A11Y-GOLDEN "accessible trees differ from tests/a11y/ (see above)"
pass A11Y-GOLDEN "panel, calendar, quick settings and overview trees match their goldens"

grep -q panicked "$LOG" && fail G-NOPANIC "panic in nested log"
# The shell must survive the whole journey: a crash the supervisor
# quietly restarts is still a failure (the overview-close teardown bug
# hid behind exactly that).
if grep -q 'ShellExited' "$LOG"; then
    fail G-SHELL-STABLE "the shell exited during the journey: $(grep -c ShellExited "$LOG") time(s)"
fi
pass G-SHELL-STABLE "the shell never exited or restarted"
echo "roost-gtk-shell-proof: OK, artifacts in $ARTIFACTS"
