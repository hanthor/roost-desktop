# Quick-settings services (#55): each toggle is read back from its daemon.
sysprop() {
    gdbus call --system --dest "$1" --object-path "$2" \
        --method org.freedesktop.DBus.Properties.Get "$3" "$4" 2>>"$ARTIFACTS/stubs.log"
}
open_qs() {
    xdotool mousemove --window "$WID" $((WIDTH - 50)) 16 click 1
    sleep 2
}
qs_press() {
    "$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-$2.json" 20 --press "$1"
}
open_qs
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-services.json" 20 ||
    fail G-QS-SERVICES "accessibility dump failed"
scrot "$ARTIFACTS/15-quick-settings-services.png" >/dev/null
for label in "Wi-Fi" "Wired" "Bluetooth" "Power Mode" "Brightness" "Volume"; do
    showing "$ARTIFACTS/a11y-qs-services.json" "$label" ||
        fail G-QS-SERVICES "no '$label' control with its daemon on the bus"
done
pass G-QS-SERVICES "quick settings shows a tile per service on the bus"

# GNOME's Wi-Fi menu: opening it scans; the saved network comes first,
# then by signal; the hidden one is left out; a saved network activates
# its connection and becomes the tile's subtitle.
qs_press "Wi-Fi Menu" wifi-menu || fail G-QS-WIFI-MENU "could not open the Wi-Fi menu"
sleep 1.5
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-wifi-menu.json" 20 ||
    fail G-QS-WIFI-MENU "accessibility dump failed"
scrot "$ARTIFACTS/15b-wifi-menu.png" >/dev/null
grep -q '^RequestScan' "$ROOST_STUB_NM_LOG" 2>/dev/null ||
    fail G-QS-WIFI-MENU "opening the menu did not ask NetworkManager to scan"
order="$(jq -r '[.[] | select(.showing) | .name | select(test("Signal strength"))] | join("|")' \
    "$ARTIFACTS/a11y-qs-wifi-menu.json")"
want="Roost Home, Secure, Signal strength 70%|Roost Cafe, Not secure, Signal strength 85%|Roost Office, Secure, Signal strength 60%|Roost Guest, Secure, Signal strength 50%"
[ "$order" = "$want" ] || fail G-QS-WIFI-MENU "networks are '$order', not '$want'"
qs_press "Roost Home, Secure, Signal strength 70%" wifi-home ||
    fail G-QS-WIFI-MENU "could not press Roost Home"
grep -q "^ActivateConnection /org/freedesktop/NetworkManager/Settings/1" "$ROOST_STUB_NM_LOG" ||
    fail G-QS-WIFI-MENU "Roost Home did not activate its saved connection"
# Picking a network closes the panel, as GNOME's menus do.
sleep 1.5
open_qs
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-wifi-on.json" 20 ||
    fail G-QS-WIFI-MENU "accessibility dump failed"
showing "$ARTIFACTS/a11y-qs-wifi-on.json" "Roost Home" ||
    fail G-QS-WIFI-MENU "the tile does not name the connected network"
pass G-QS-WIFI-MENU "the Wi-Fi menu scans, lists networks as GNOME does, and activates a saved one"

# GNOME's wired menu: the active profile is one row named for the device
# with a Disconnect subtitle; it takes the device down. The toggle then
# brings the profile back and shows checked.
wired_checked() {
    jq -e --arg want "$2" 'any(.[]; .name == "Wired" and .role == "toggle button"
        and (.checked | tostring) == $want)' "$1" >/dev/null
}
wired_checked "$ARTIFACTS/a11y-qs-wifi-on.json" true ||
    fail G-QS-WIRED "the Wired tile is not checked with its profile up"
qs_press "Wired Menu" wired-menu || fail G-QS-WIRED "could not open the wired menu"
sleep 1.5
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-wired-menu.json" 20 ||
    fail G-QS-WIRED "accessibility dump failed"
scrot "$ARTIFACTS/15e-wired-menu.png" >/dev/null
showing "$ARTIFACTS/a11y-qs-wired-menu.json" "Disconnect Wired" ||
    fail G-QS-WIRED "the menu has no Disconnect row for the active profile"
showing "$ARTIFACTS/a11y-qs-wired-menu.json" "Wired Settings" ||
    fail G-QS-WIRED "the menu has no Wired Settings item"
qs_press "Disconnect Wired" wired-off || fail G-QS-WIRED "could not press Disconnect"
grep -q "^Disconnect /org/freedesktop/NetworkManager/Devices/1" "$ROOST_STUB_NM_LOG" ||
    fail G-QS-WIRED "Disconnect did not take the device down"
sleep 1.5
open_qs
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-wired-off.json" 20 ||
    fail G-QS-WIRED "accessibility dump failed"
wired_checked "$ARTIFACTS/a11y-qs-wired-off.json" false ||
    fail G-QS-WIRED "the Wired tile stayed checked with the device down"
qs_press "Wired" wired-on || fail G-QS-WIRED "could not press the Wired tile"
grep -q "^ActivateConnection /org/freedesktop/NetworkManager/Settings/3 /org/freedesktop/NetworkManager/Devices/1" \
    "$ROOST_STUB_NM_LOG" || fail G-QS-WIRED "the Wired tile did not bring its profile back"
sleep 1.5
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-wired-on.json" 20 ||
    fail G-QS-WIRED "accessibility dump failed"
wired_checked "$ARTIFACTS/a11y-qs-wired-on.json" true ||
    fail G-QS-WIRED "the Wired tile is not checked again"
pass G-QS-WIRED "the wired menu disconnects the profile and the Wired tile brings it back, as GNOME's do"

# GNOME's network agent: an unsaved WPA2 network makes NetworkManager
