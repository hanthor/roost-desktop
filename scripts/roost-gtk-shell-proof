if ! cstate '.overview_open | not' "closed" 3; then
    xdotool key Super_L
    cstate '.overview_open | not' "closed" || fail G-APP-FOLDERS "overview would not close"
fi
FOLDER=org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/ProbeTools/
gsettings set org.gnome.desktop.app-folders folder-children "['ProbeTools']"
gsettings set "$FOLDER" name 'Probe Tools'
gsettings set "$FOLDER" apps "['roost-probe.desktop']"
xdotool key Super_L
cstate '.overview_open' "overview" || fail G-APP-FOLDERS "overview did not open"
sleep 1
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-folders.json" 20 --press "Show Apps" ||
    fail G-APP-FOLDERS "could not press Show Apps"
showing "$ARTIFACTS/a11y-folders.json" "Probe Tools" ||
    fail G-APP-FOLDERS "the grid has no Probe Tools folder"
if showing "$ARTIFACTS/a11y-folders.json" "Roost Probe"; then
    fail G-APP-FOLDERS "a foldered app still shows loose in the grid"
fi
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-folder-open.json" 20 --press "Probe Tools" ||
    fail G-APP-FOLDERS "could not open the folder"
