sysprop org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
    org.freedesktop.NetworkManager WirelessEnabled | grep -q false ||
    fail G-QS-WIFI "NetworkManager's WirelessEnabled is still true"
pass G-QS-WIFI "the Wi-Fi tile turns NetworkManager's radio off"

