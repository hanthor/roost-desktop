    fail G-NM-AGENT "NetworkManager got $(grep "^Secrets" "$ROOST_STUB_NM_LOG" || echo nothing), not the typed password"
pass G-NM-AGENT "an unsaved secured network asks for its password in GNOME's dialog"
sleep 1
open_qs

