    fail G-NM-AGENT "accessibility dump failed"
showing "$ARTIFACTS/a11y-nm-agent.json" "Authentication required" ||
    fail G-NM-AGENT "no Authentication required dialog"
scrot "$ARTIFACTS/15d-network-agent.png" >/dev/null
xdotool type --delay 30 "guest-pass-$$"
xdotool key Return
for _ in $(seq 1 20); do grep -q "^Secrets" "$ROOST_STUB_NM_LOG" && break; sleep 0.5; done
