# GNOME's microphone: while an app records, an orange indicator leads
# the panel and a Microphone slider sets the default source; both go
# when the recording stops.
mic_shown() {
    "$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-mic-$1.json" 20 &&
        showing "$ARTIFACTS/a11y-mic-$1.json" "$2"
}
mic_shown idle Microphone && fail G-QS-MIC "the Microphone slider shows with nothing recording"
touch "$RECORDING_FILE"
sleep 3
mic_shown recording Microphone || fail G-QS-MIC "no Microphone slider while an app records"
showing "$ARTIFACTS/a11y-mic-recording.json" "Microphone in use" ||
    fail G-QS-MIC "no microphone indicator in the panel while an app records"
scrot "$ARTIFACTS/16b-microphone.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-mic.json" 20 \
    --set Microphone 30 || fail G-QS-MIC "could not set Microphone"
[ "$(cat "$MIC_FILE")" = 0.30 ] ||
    fail G-QS-MIC "source volume is $(cat "$MIC_FILE"), not 0.30"
rm -f "$RECORDING_FILE"
sleep 3
mic_shown stopped "Microphone in use" &&
    fail G-QS-MIC "the microphone indicator stayed after the recording stopped"
pass G-QS-MIC "an app recording shows the microphone indicator and slider; the slider sets the source"
scrot "$ARTIFACTS/16-quick-settings-toggled.png" >/dev/null
xdotool key Escape
sleep 1

kill "$STUBS_PID" 2>/dev/null || true
STUBS_PID=""
sleep 2
scrot "$ARTIFACTS/17-before-absent.png" >/dev/null
open_qs
scrot "$ARTIFACTS/18-quick-settings-absent.png" >/dev/null
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-qs-absent.json" 20 ||
    fail G-QS-ABSENT "accessibility dump failed (shell hung?)"
for label in "Wi-Fi" "Bluetooth" "Power Mode"; do
    if showing "$ARTIFACTS/a11y-qs-absent.json" "$label"; then
        fail G-QS-ABSENT "'$label' still showing with its daemon gone"
    fi
done
showing "$ARTIFACTS/a11y-qs-absent.json" "Dark Style" ||
    fail G-QS-ABSENT "the settings tiles went away with the daemons"
pass G-QS-ABSENT "tiles hide when their daemons leave the bus"
xdotool key Escape

# GPU clients (#89): with linux-dmabuf advertised, a GTK window on the
# GL renderer maps and paints instead of hanging.
WAYLAND_DISPLAY="$SOCKET_NAME" GSK_RENDERER=gl "$PY" "$ROOT/scripts/lib/roost-test-window.py" \
    Delta "#c01c28" >"$ARTIFACTS/window-Delta.log" 2>&1 &
cstate '.windows | any(.app_id == "roost-test-delta")' "gl window" ||
    fail G-GL-WINDOW "a GL-rendered GTK window never mapped"
sleep 2
scrot "$ARTIFACTS/19-gl-window.png" >/dev/null
centre="$(jq -r '.windows[] | select(.app_id == "roost-test-delta") | .rect | "\(.[0] + .[2] / 2) \(.[1] + .[3] / 3)"' "$CSTATE")"
# shellcheck disable=SC2086
set -- $centre
rgb="$(px "$ARTIFACTS/19-gl-window.png" "${1%.*}" "${2%.*}")"
# shellcheck disable=SC2086
set -- $rgb
if [ "$1" -lt 150 ] || [ "$2" -gt 80 ] || [ "$3" -gt 80 ]; then
    fail G-GL-WINDOW "GL window did not paint its red body (pixel $rgb)"
fi
pass G-GL-WINDOW "a GL-rendered GTK window maps and paints"

# X11 by default (#59): the compositor starts XWayland when it is
# installed, tells the shell DISPLAY, and apps launched from search get it.
if command -v Xwayland >/dev/null 2>&1 && command -v xeyes >/dev/null 2>&1; then
    cstate '.x11_display != null' "xwayland" 30 || fail G-X11-APP "XWayland never came up"
    x11_display="$(jq -r '.x11_display' "$CSTATE")"
    before="$(jq '.windows | length' "$CSTATE")"
    xdotool key Super_L
    cstate '.overview_open' "overview" || fail G-X11-APP "overview did not open"
    sleep 1
    xdotool type --delay 40 "roost x probe"
    sleep 1
    xdotool key Return
    end=$(($(date +%s) + 15))
    until [ -s "$X11_MARKER" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
    [ "$(cat "$X11_MARKER" 2>/dev/null)" = "$x11_display" ] ||
        fail G-X11-APP "launched app saw DISPLAY='$(cat "$X11_MARKER" 2>/dev/null)', not $x11_display"
    cstate "(.windows | length) > $before" "x11 window" 20 ||
        fail G-X11-APP "the X11 app never mapped a window"
    # Like a native app: focused, and placed below the top bar.
    cstate '.focused_app_id == "XEyes"' "x11 focus" ||
        fail G-X11-APP "the X11 window was not focused after launch"
    cstate '.windows[] | select(.app_id == "XEyes") | .rect[1] >= 32' "x11 placement" ||
        fail G-X11-APP "the X11 window was placed under the top bar"
    sleep 1
    scrot "$ARTIFACTS/20-x11-app.png" >/dev/null
    pass G-X11-APP "an X11 app launched from search gets DISPLAY $x11_display and maps"
else
    echo "roost-gtk-shell-proof: G-X11-APP skipped (no Xwayland or xeyes)"
fi

# GNOME's clock keys reach the panel clock within its 1 s tick.
gsettings set org.gnome.desktop.interface clock-show-seconds true
sleep 2
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-clock.json" 20 ||
    fail G-SETTINGS-CLOCK "accessibility dump failed"
jq -e 'any(.[]; .role == "label" and (.name | test("[0-9]+:[0-9]{2}:[0-9]{2}")))' \
    "$ARTIFACTS/a11y-clock.json" >/dev/null ||
    fail G-SETTINGS-CLOCK "clock-show-seconds did not add seconds to the panel clock"
gsettings set org.gnome.desktop.interface clock-show-seconds false
pass G-SETTINGS-CLOCK "GNOME's clock-show-seconds changes the panel clock"

# GNOME's input settings (#60).
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('xkb', 'de')]"
cstate '.keyboard.layouts == ["English (US)", "German"]' "two sources" ||
    fail G-SETTINGS-INPUT "input sources did not become the keymap"
xdotool key super+space
cstate '.keyboard.layout == "German"' "next source" ||
    fail G-SETTINGS-INPUT "Super+Space did not switch to the next input source"
gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 50
cstate '.keyboard.repeat_rate == 20' "repeat" ||
    fail G-SETTINGS-INPUT "repeat-interval 50 ms did not set 20 keys/s"
gsettings set org.gnome.desktop.interface enable-hot-corners false
sleep 1
xdotool mousemove --window "$WID" 1 1
sleep 1
xdotool mousemove --window "$WID" 0 0
sleep 1
if jq -e '.overview_open' "$CSTATE" >/dev/null; then
    fail G-SETTINGS-INPUT "the hot corner opened the overview with enable-hot-corners off"
fi
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
gsettings set org.gnome.desktop.interface enable-hot-corners true
gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 30
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us')]"
cstate '.keyboard.layouts == ["English (US)"]' "one source" ||
    fail G-SETTINGS-INPUT "the keymap did not return to us"
pass G-SETTINGS-INPUT "input sources, Super+Space, key repeat and the hot corner follow GNOME"

# GNOME settings (#63): the idle lock follows idle-delay and
# lock-enabled as they change.
gsettings set org.gnome.desktop.session idle-delay 600
cstate '.idle_timeout_ms == 600000' "idle 600" ||
    fail G-SETTINGS-IDLE "idle-delay 600 did not reach the compositor"
gsettings set org.gnome.desktop.screensaver lock-enabled false
cstate '.idle_timeout_ms > 1e18' "lock off" ||
    fail G-SETTINGS-IDLE "lock-enabled false did not turn the idle lock off"
gsettings set org.gnome.desktop.screensaver lock-enabled true
gsettings set org.gnome.desktop.session idle-delay 300
cstate '.idle_timeout_ms == 300000' "idle 300" ||
    fail G-SETTINGS-IDLE "the idle lock did not follow back to 300 s"
pass G-SETTINGS-IDLE "GNOME's idle-delay and lock-enabled set the idle lock live"

# org.gnome.Shell for gnome-settings-daemon: a caller outside GNOME's
# allowlist is refused; the media-keys daemon's grab takes the key away
# from apps, fires AcceleratorActivated, and its ShowOSD shows the OSD.
if gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
    --method org.gnome.Shell.GrabAccelerator "<Super>F9" 1 0 >/dev/null 2>&1; then
    fail G-ACCEL "a caller outside the allowlist grabbed an accelerator"
fi
ACCEL_MARKER="$ARTIFACTS/accel-marker"
rm -f "$ACCEL_MARKER"
"$PY" "$ROOT/scripts/lib/roost-accel-probe.py" "$ACCEL_MARKER" >"$ARTIFACTS/accel.log" 2>&1 &
ACCEL_PID=$!
end=$(($(date +%s) + 10))
until grep -q grabbed "$ACCEL_MARKER" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "grabbed [1-9]" "$ACCEL_MARKER" 2>/dev/null ||
    fail G-ACCEL "the media-keys stand-in could not grab XF86AudioRaiseVolume"
xdotool key XF86AudioRaiseVolume
end=$(($(date +%s) + 5))
until grep -q activated "$ACCEL_MARKER" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "activated" "$ACCEL_MARKER" ||
    fail G-ACCEL "pressing the grabbed key fired no AcceleratorActivated"
sleep 0.5
scrot "$ARTIFACTS/24b-osd.png" >/dev/null
pass G-ACCEL "gnome-settings-daemon's grab fires on its key and its ShowOSD shows the OSD"

# GNOME Shell's own keybindings (org.gnome.shell.keybindings defaults).
sleep 2
xdotool key super+s
sleep 1.5
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$ARTIFACTS/a11y-key-qs.json" 20 ||
