#!/bin/sh
# Capture Roost in the states scripts/roost-gnome-reference captures GNOME
# 51 in, at the same size and with the same service stubs.
#
# Usage: roost-parity-capture [--out DIR]
#
# Runs the nested compositor and GTK shell on a private Xvfb and buses,
# then writes DIR/<state>.png for: 00-startup-overview, 01-desktop, 02-calendar,
# 03-quick-settings, 03b-power-mode-menu, 04-overview-empty, 05-app-grid, 05b-app-folder, 06-windows, 06b-switcher,
# 07-overview-windows, 07b-overview-hover, 08-notification, 09-calendar-with-notification,
# 10-end-session, 12-osd-volume, 12b-osd-label, 12c-osd-overdrive, 13-window-menu,
# 14-screenshot-ui, 15-workspace-popup, 16-overview-workspaces, 17-tile-preview,
# 11-lock-screen, 11b-unlock-prompt.
# Run scripts/roost-gnome-reference first: it exports GNOME's wallpapers.
# Compare with scripts/lib/roost-parity-compare.py.
set -eu
if [ -z "${ROOST_PARITY_PRIVATE_BUS:-}" ]; then
    ROOST_PARITY_PRIVATE_BUS=1 exec dbus-run-session -- "$0" "$@"
fi
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
OUT="$ROOT/target/roost-parity"
WIDTH=1280
HEIGHT=800
while [ $# -gt 0 ]; do
    case "$1" in
        --out) OUT="$2"; shift 2 ;;
        --help|-h) sed -n '2,11p' "$0"; exit 0 ;;
        *) echo "roost-parity-capture: unknown argument $1" >&2; exit 1 ;;
    esac
done
mkdir -p "$OUT"
OUT="$(cd "$OUT" && pwd)"
WORK="$(mktemp -d)"
PY=/usr/bin/python3
[ -x "$PY" ] || PY=python3
PIDS=""
cleanup() {
    # shellcheck disable=SC2086
    [ -n "$PIDS" ] && kill $PIDS 2>/dev/null || true
    rm -rf "$WORK"
}
trap cleanup EXIT INT TERM

DISPLAY=":97"
export DISPLAY
Xvfb "$DISPLAY" -screen 0 "${WIDTH}x${HEIGHT}x24" >"$WORK/xvfb.log" 2>&1 &
PIDS="$PIDS $!"
for _ in $(seq 1 30); do xdotool getdisplaygeometry >/dev/null 2>&1 && break; sleep 0.5; done
if [ -x /usr/libexec/at-spi-bus-launcher ]; then
    /usr/libexec/at-spi-bus-launcher --launch-immediately >"$WORK/atspi.log" 2>&1 &
    PIDS="$PIDS $!"
fi
GSETTINGS_BACKEND=keyfile
XDG_CONFIG_HOME="$WORK/config"
XDG_STATE_HOME="$WORK/state"
XDG_DATA_HOME="$WORK/data"
export GSETTINGS_BACKEND XDG_CONFIG_HOME XDG_STATE_HOME XDG_DATA_HOME
# GNOME 51's icons and fonts from the reference run, ahead of the host's.
REF="$ROOT/target/gnome-reference"
# Icons go last on XDG_DATA_DIRS: with two copies of a theme, GTK
# 4.14 takes the icon from the later directory.
if [ -d "$REF/share" ]; then
    mkdir -p "$XDG_DATA_HOME" "$WORK/gnome51"
    cp -r "$REF/share/fonts" "$XDG_DATA_HOME/"
    fc-cache "$XDG_DATA_HOME/fonts" >/dev/null 2>&1 || true
    cp -r "$REF/share/icons" "$WORK/gnome51/"
    mkdir -p "$XDG_DATA_HOME/applications"
    # GNOME's installed apps, not the host's: each host entry is hidden
    # by a Hidden copy in the user directory (the desktop-entry spec's
    # override), then GNOME's entries and folder names go in.
    for dir in $(printf '%s' "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' '); do
        for entry in "$dir"/applications/*.desktop; do
            [ -f "$entry" ] || continue
            printf '[Desktop Entry]\nType=Application\nName=Hidden\nHidden=true\n' \
                >"$XDG_DATA_HOME/applications/$(basename "$entry")"
        done
    done
    cp "$REF"/share/applications/*.desktop "$XDG_DATA_HOME/applications/" 2>/dev/null || true
    if [ -d "$REF/share/desktop-directories" ]; then
        cp -r "$REF/share/desktop-directories" "$XDG_DATA_HOME/"
    fi
    # GNOME 51's schemas ahead of the host's: GNOME Shell's keys (dash
    # favorites) and its app folders.
    if [ -d "$REF/share/glib-2.0/schemas" ]; then
        mkdir -p "$WORK/schemas"
        cp /usr/share/glib-2.0/schemas/*.xml /usr/share/glib-2.0/schemas/*.override \
            "$WORK/schemas/" 2>/dev/null || true
        # A second cp: one cp will not overwrite a file it just created,
        # so GNOME's copies would silently lose to the host's.
        cp "$REF"/share/glib-2.0/schemas/*.xml "$WORK/schemas/" 2>/dev/null || true
        glib-compile-schemas "$WORK/schemas" && GSETTINGS_SCHEMA_DIR="$WORK/schemas"
        export GSETTINGS_SCHEMA_DIR
    fi
    XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:$WORK/gnome51"
    export XDG_DATA_DIRS
fi
# GNOME's reference runs as a GNOME session; so does this one, so
# OnlyShowIn and NotShowIn decide the same way.
XDG_CURRENT_DESKTOP=GNOME
export XDG_CURRENT_DESKTOP
# The same services GNOME's headless reference has: power profiles and
# logind, no network or Bluetooth daemons, no backlight (a virtual
# monitor has none) and no audio server.
mkdir -p "$WORK/backlight/none" "$WORK/bin"
ROOST_BACKLIGHT_ROOT="$WORK/backlight/none"
ROOST_STUB_SERVICES=ppd,logind
export ROOST_BACKLIGHT_ROOT ROOST_STUB_SERVICES
ROOST_SHELL_DBUS_UNRESTRICTED=1
export ROOST_SHELL_DBUS_UNRESTRICTED
cat >"$WORK/bin/wpctl" <<'WPCTL'
#!/bin/sh
exit 1
WPCTL
chmod +x "$WORK/bin/wpctl"
PATH="$WORK/bin:$PATH"
export PATH
SYSBUS_INFO="$(dbus-daemon --session --fork --print-address=1 --print-pid=1)"
DBUS_SYSTEM_BUS_ADDRESS="$(echo "$SYSBUS_INFO" | sed -n 1p)"
PIDS="$PIDS $(echo "$SYSBUS_INFO" | sed -n 2p)"
export DBUS_SYSTEM_BUS_ADDRESS
"$PY" "$ROOT/scripts/lib/roost-service-stubs.py" "$WORK/backlight/none" >"$WORK/stubs.log" 2>&1 &
PIDS="$PIDS $!"
for _ in $(seq 1 20); do grep -q ready "$WORK/stubs.log" 2>/dev/null && break; sleep 0.5; done
# GNOME's reference has its calendar server with the default local
# calendar and no events: so does this session.
"$PY" "$ROOT/scripts/lib/roost-calendar-server-stub.py" >"$WORK/calendar.log" 2>&1 &
PIDS="$PIDS $!"
for _ in $(seq 1 20); do grep -q ready "$WORK/calendar.log" 2>/dev/null && break; sleep 0.5; done

# GNOME 51's defaults: the reference run exports its wallpapers.
gsettings set org.gnome.desktop.background primary-color '#023c88'
# GNOME's defaults where the host's schemas may differ (Ubuntu: Yaru).
gsettings set org.gnome.desktop.interface icon-theme Adwaita
# GNOME 51's interface fonts (the host's schema may still say Cantarell),
# so apps render text as they do under GNOME.
gsettings set org.gnome.desktop.interface font-name 'Adwaita Sans 11'
gsettings set org.gnome.desktop.interface document-font-name 'Adwaita Sans 11'
gsettings set org.gnome.desktop.interface monospace-font-name 'Adwaita Mono 11'
gsettings set org.gnome.shell favorite-apps "['org.mozilla.firefox.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Calculator.desktop']"
gsettings set org.gnome.desktop.background picture-options zoom
for variant in l d; do
    key=picture-uri
    [ "$variant" = d ] && key=picture-uri-dark
    if [ -f "$REF/adwaita-$variant.jxl" ]; then
        gsettings set org.gnome.desktop.background "$key" "file://$REF/adwaita-$variant.jxl"
    else
        gsettings set org.gnome.desktop.background "$key" ''
    fi
done

cargo build --quiet --manifest-path "$ROOT/Cargo.toml" -p roost-compositor -p roost-shell-gtk
LOG="$OUT/nested.log"
"$ROOT/target/debug/roost-compositor" --backend winit --socket "roost-parity-$$" \
    --startup-overview --shell-bin "$ROOT/target/debug/roost-shell-gtk" >"$LOG" 2>&1 &
PIDS="$PIDS $!"
WID=""
for _ in $(seq 1 60); do
    WID="$(xdotool search --name Smithay 2>/dev/null | head -1 || true)"
    [ -n "$WID" ] && break
    sleep 1
done
[ -n "$WID" ] || { echo "roost-parity-capture: no nested window" >&2; exit 1; }
xdotool windowfocus --sync "$WID"
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
"$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$WORK/a11y.json" 60 >/dev/null ||
    { echo "roost-parity-capture: shell never came up" >&2; exit 1; }
SOCKET_NAME="$(sed -n 's/.*nested session on \([^ ]*\) .*/\1/p' "$LOG" | head -1)"

shot() { sleep "${2:-1.5}"; scrot -o "$OUT/$1.png" >/dev/null; echo "roost-parity-capture: $1"; }
press() { "$PY" "$ROOT/scripts/lib/roost-a11y-dump.py" roost-shell-gtk "$WORK/press.json" 20 --press "$1" >/dev/null; }
# Park the pointer where nothing reacts to it: GNOME's scripted
# reference has no pointer motion, so nothing there shows hover.
park() { xdotool mousemove --window "$WID" $((WIDTH - 4)) $((HEIGHT - 4)); }

# A fresh wallpaper decodes once (then comes from the cache): wait for it.
for _ in $(seq 1 60); do grep -q "wallpaper decoded" "$LOG" 2>/dev/null && break; sleep 0.5; done
# A login opens on the overview, as GNOME's does; Escape leaves it.
shot 00-startup-overview 3
xdotool key Escape
park
shot 01-desktop 2
xdotool mousemove --window "$WID" $((WIDTH / 2)) 16 click 1
park
shot 02-calendar
xdotool key Escape
xdotool mousemove --window "$WID" $((WIDTH - 30)) 16 click 1
park
shot 03-quick-settings
press "Power Mode Menu"
shot 03b-power-mode-menu
press "Power Mode Menu"
press "Power Off Menu"
shot 03c-power-menu
xdotool key Escape
sleep 1
xdotool key Super_L
shot 04-overview-empty
press "Show Apps"
shot 05-app-grid
# The System folder from the grid (its tile at 271,256, 113px square):
# GNOME's folder dialog. (The panel's System menu shares the name.)
xdotool mousemove --window "$WID" 327 312 click 1
park
shot 05b-app-folder 1.5
xdotool key Escape
sleep 0.5
xdotool key Escape
sleep 0.5
xdotool key Escape
sleep 1
park
for spec in Alpha:#3584e4 Beta:#2ec27e Gamma:#e66100; do
    name="${spec%%:*}"
    WAYLAND_DISPLAY="$SOCKET_NAME" "$PY" "$ROOT/scripts/lib/roost-test-window.py" "$name" "${spec#*:}" \
        >"$WORK/window-$name.log" 2>&1 &
    PIDS="$PIDS $!"
    # One at a time, as GNOME's reference maps them.
    sleep 1.5
done
shot 06-windows 4
xdotool keydown Alt_L key Tab
shot 06b-switcher 1
xdotool keyup Alt_L
sleep 1
xdotool key Super_L
shot 07-overview-windows
xdotool mousemove --window "$WID" 415 232
shot 07b-overview-hover
park
xdotool key Escape
sleep 1
# GNOME's reference uses Main.notify(): the "System" source with
# cog-wheel-symbolic, which this app name and icon reproduce.
gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify -- "System" 0 "cog-wheel-symbolic" \
    "Roost reference" "A notification banner, as GNOME 51 draws it" "[]" "{}" 5000 >/dev/null
shot 08-notification 1
# The user moves: the banner, shown while they were away, goes 2 s later.
xdotool mousemove --window "$WID" $((WIDTH - 8)) $((HEIGHT - 8))
park
sleep 6
xdotool mousemove --window "$WID" $((WIDTH / 2)) 16 click 1
park
shot 09-calendar-with-notification
xdotool key Escape
sleep 1
xdotool mousemove --window "$WID" $((WIDTH - 30)) 16 click 1
park
sleep 1
press "Power Off Menu"
press "Log Out…"
shot 10-end-session 2
xdotool key Escape
sleep 1
# The OSD through org.gnome.Shell.ShowOSD, as gnome-settings-daemon
# calls it (the harness is allowed in, as GNOME's unsafe mode would).
osd() { gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
    --method org.gnome.Shell.ShowOSD "$1" >/dev/null; }
osd "{'icon': <'audio-volume-medium-symbolic'>, 'level': <0.5>, 'max_level': <1.0>}"
shot 12-osd-volume 0.5
osd "{'icon': <'input-keyboard-symbolic'>, 'label': <'English (US)'>}"
shot 12b-osd-label 0.5
osd "{'icon': <'audio-volume-overamplified-symbolic'>, 'level': <1.25>, 'max_level': <1.5>}"
shot 12c-osd-overdrive 0.5
sleep 2
# The window menu: a right click on the focused window's header bar.
xdotool mousemove --window "$WID" 500 280 click 3
shot 13-window-menu 1
xdotool key Escape
park
sleep 1
# The workspace switcher popup: to the empty second workspace and back.
xdotool key super+Page_Down
shot 15-workspace-popup 0.35
xdotool key super+Page_Up
sleep 1.2
# The screenshot UI (Print).
xdotool key Print
shot 14-screenshot-ui 6
xdotool key Escape
sleep 1
# Three workspaces (the focused window moved one to the right through
# its window menu, the view staying put): the overview's thumbnails.
xdotool mousemove --window "$WID" 500 280 click 3
sleep 1
press "Move to Workspace Right"
park
sleep 0.5
xdotool key Super_L
shot 16-overview-workspaces 1.5
xdotool key Escape
sleep 1
# Edge tiling: Gamma's header dragged to the left edge shows the tile
# preview; dragged back before release, nothing tiles.
glide() {
    for i in $(seq 1 "$5"); do
        xdotool mousemove --window "$WID" $(($1 + ($3 - $1) * i / $5)) $(($2 + ($4 - $2) * i / $5))
        sleep 0.016
    done
}
# GTK starts the move past its drag threshold: press 11px away, cross
# it onto the start point and let the move begin there, so the window
# travels exactly the glide (GNOME's reference moves it by that).
xdotool mousemove --window "$WID" 611 328
sleep 0.2
xdotool mousedown 1
sleep 0.1
xdotool mousemove --window "$WID" 600 328
sleep 0.5
glide 600 328 1 400 40
shot 17-tile-preview 1
glide 1 400 600 328 40
xdotool mouseup 1
park
sleep 0.8
xdotool mousemove --window "$WID" $((WIDTH - 30)) 16 click 1
park
sleep 1
press "Lock"
shot 11-lock-screen 3
xdotool mousemove 640 650 click 1
shot 11b-unlock-prompt 2
echo "roost-parity-capture: frames in $OUT"
