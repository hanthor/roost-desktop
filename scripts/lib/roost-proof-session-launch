#!/bin/sh
# Fixed launch seam shared by the original source proof and installed mode.
set -eu
[ "$#" = 3 ] || exit 1
mode="$1"; root="$2"; socket="$3"
case "$mode" in
    1)
        [ -z "${ROOST_SHELL_BIN:-}" ] && [ -z "${ROOST_PROOF_SHELL_BIN:-}" ] || exit 1
        exec /usr/bin/roost-session --backend winit --socket "$socket"
        ;;
    0)
        exec "$root/target/debug/roost-compositor" --backend winit --socket "$socket" \
            --shell-bin "${ROOST_PROOF_SHELL_BIN:-$root/target/debug/roost-shell-gtk}"
        ;;
    *) exit 1 ;;
esac
