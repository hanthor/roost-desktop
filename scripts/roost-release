#!/bin/sh
# roost-release — build the Roost Debian package from a clean checkout.
#
# Usage:
#   scripts/roost-release [--out DIR] [--allow-dirty] [--help]
#
# Builds the six release binaries with the version stamped from the git tag,
# stages the documented install layout (binaries side by side plus the
# login-screen session entry), generates the package metadata from the same
# stamp, and produces roost_<version>_amd64.deb via dpkg-deb.
#
# The tree must be clean and HEAD must carry a vX.Y.Z tag unless --allow-dirty
# is given (dev builds; the version is still stamped from the tag or falls
# back to the crate version when no tag resolves).
set -eu

unset CDPATH

OUT="dist"
ALLOW_DIRTY="no"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --out)
            OUT="$2"
            shift 2
            ;;
        --allow-dirty)
            ALLOW_DIRTY="yes"
            shift
            ;;
        --help | -h)
            sed -n '2,13p' "$0"
            exit 0
            ;;
        *)
            echo "roost-release: unknown argument $1" >&2
            exit 1
            ;;
    esac
done

if [ "$ALLOW_DIRTY" != "yes" ]; then
    if [ -n "$(git status --porcelain)" ]; then
        echo "roost-release: working tree is dirty (use --allow-dirty for dev builds)" >&2
        exit 1
    fi
    # Recorded human visual review (#67): a release tag needs a filled
    # docs/reviews/<tag>.md comparing Roost frames against the GNOME 51
    # baseline bundle.
    RELEASE_TAG="$(git describe --tags --exact-match HEAD 2>/dev/null || true)"
    if [ -n "$RELEASE_TAG" ]; then
        REVIEW="docs/reviews/$RELEASE_TAG.md"
        if [ ! -f "$REVIEW" ]; then
            echo "roost-release: missing visual review $REVIEW (copy docs/reviews/TEMPLATE.md)" >&2
            exit 1
        fi
        if grep -q 'TBD' "$REVIEW"; then
            echo "roost-release: $REVIEW still has TBD placeholders" >&2
            exit 1
        fi
    fi
fi

TAG="$(git describe --tags --exact-match HEAD 2>/dev/null || true)"
if [ -z "$TAG" ]; then
    TAG="$(git describe --tags 2>/dev/null || true)"
fi
VERSION="$(printf '%s' "$TAG" | sed -e 's/^v//' -e 's/-.*//')"
if [ -z "$VERSION" ]; then
    echo "roost-release: no tag found and no version given; crate fallback applies" >&2
fi

export ROOST_VERSION="$VERSION"
cargo build --locked --release -p roost-compositor -p roost-shell-gtk -p roost-shell-host -p roost-greeter

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT INT TERM
chmod 0755 "$STAGE"
mkdir -p "$STAGE/DEBIAN" "$STAGE/usr/bin" "$STAGE/usr/share/wayland-sessions" "$STAGE/etc/pam.d"

for bin in roost-compositor roost-session roost-shell-gtk roost-shell-host roost-ibus-bridge roost-greeter; do
    install -m0755 "target/release/$bin" "$STAGE/usr/bin/$bin"
done
install -m0644 share/wayland-sessions/roost.desktop \
    "$STAGE/usr/share/wayland-sessions/roost.desktop"
install -Dm0644 share/systemd/user/roost-session.target \
    "$STAGE/usr/lib/systemd/user/roost-session.target"
# Lock-screen PAM service (#62); a conffile, so local edits survive.
install -m0644 share/pam.d/roost-lock "$STAGE/etc/pam.d/roost-lock"
echo /etc/pam.d/roost-lock >"$STAGE/DEBIAN/conffiles"
# One release of compatibility with the former name (#505): the old
# binary names, the session entry display managers remember, and the PAM
# service a session started before the upgrade still asks for.
# tuna-rename: keep-begin
LEGACY_PACKAGE=roost
for bin in compositor session shell-gtk shell-host ibus-bridge greeter; do
    ln -s "tuna-$bin" "$STAGE/usr/bin/roost-$bin"
done
install -m0644 share/compat/wayland-sessions/roost.desktop "$STAGE/usr/share/wayland-sessions/roost.desktop"
install -m0644 share/compat/pam.d/roost-lock "$STAGE/etc/pam.d/roost-lock"
echo /etc/pam.d/roost-lock >>"$STAGE/DEBIAN/conffiles"
# tuna-rename: keep-end

# Agreement check: the stamped binaries must report the stamped version.
for bin in roost-compositor roost-session roost-shell-gtk roost-shell-host roost-ibus-bridge roost-greeter; do
    (ulimit -f 8; timeout 10 "$STAGE/usr/bin/$bin" --version) >"$STAGE/version-output" || { echo "roost-release: version command failed" >&2; exit 1; }
    [ "$(wc -c <"$STAGE/version-output")" -le 256 ] || exit 1
    LINE="$(cat "$STAGE/version-output")"
    REPORTED="${LINE#"$bin "}"
    [ "$LINE" = "$bin $REPORTED" ] && [ -n "$REPORTED" ] && [ "$REPORTED" = "$(printf '%s' "$REPORTED" | tr -d '[:space:]')" ] || { echo "roost-release: malformed version line" >&2; exit 1; }
    printf '%s\n' "$bin $REPORTED" >"$STAGE/version-expected"
    cmp -s "$STAGE/version-output" "$STAGE/version-expected" || exit 1
    [ -n "$VERSION" ] || VERSION="$REPORTED"
    if [ "$REPORTED" != "$VERSION" ]; then
        echo "roost-release: $bin reports $REPORTED, expected $VERSION" >&2
        exit 1
    fi
done

rm "$STAGE/version-output" "$STAGE/version-expected"

# Resolve the real selected-distribution ELF ABI closure; never ignore missing
# shlibs/symbols information. Explicit dependencies below cover dlopen/tools.
mkdir "$STAGE/debian"
printf 'Source: roost\nSection: x11\nPriority: optional\nMaintainer: Tuna Desktop Developers <roost@example.invalid>\n\nPackage: roost\nArchitecture: any\nDescription: Tuna Desktop\n' >"$STAGE/debian/control"
SHLIBS="$(cd "$STAGE" && dpkg-shlibdeps -O -eusr/bin/roost-compositor -eusr/bin/roost-session -eusr/bin/roost-shell-gtk -eusr/bin/roost-shell-host -eusr/bin/roost-ibus-bridge -eusr/bin/roost-greeter)" || exit 1
case "$SHLIBS" in shlibs:Depends=*) SHLIBS="${SHLIBS#shlibs:Depends=}" ;; *) echo "roost-release: missing ELF dependency closure" >&2; exit 1 ;; esac
[ -n "$SHLIBS" ] || exit 1
rm -r "$STAGE/debian"
cat >"$STAGE/DEBIAN/control" <<EOF
Package: roost
Version: $VERSION
Replaces: $LEGACY_PACKAGE
Conflicts: $LEGACY_PACKAGE
Provides: $LEGACY_PACKAGE
Section: x11
Priority: optional
Architecture: amd64
Depends: $SHLIBS, libgtk4-layer-shell0 (>= 1.1), libgtk-4-1 (>= 4.12), libadwaita-1-0 (>= 1.0), libpam0g, gsettings-desktop-schemas, libsecret-tools, libxkbcommon0, libxkbcommon-x11-0, libegl1, libgl1, libgbm1, libseat1, libinput10, libudev1, libdrm2, libgtk-4-1, libadwaita-1-0, libpipewire-0.3-0t64 | libpipewire-0.3-0, libglib2.0-0t64 | libglib2.0-0
Recommends: ibus, gstreamer1.0-tools, gstreamer1.0-pipewire, gstreamer1.0-plugins-good
Maintainer: Tuna Desktop Developers <roost@example.invalid>
Description: Tuna Desktop Wayland desktop session
 A GNOME-style Wayland desktop with an optional scrollable tiling shell,
 with the preferred GTK shell and a supervised compositor.
 .
 Installs the compositor, GTK and legacy shell hosts, session launcher, IBus bridge, and greeter plus
 the login-screen session entry.
EOF

mkdir -p "$OUT"
PKG="$OUT/roost_${VERSION}_amd64.deb"
dpkg-deb --root-owner-group --build "$STAGE" "$PKG" >/dev/null
echo "roost-release: wrote $PKG"
