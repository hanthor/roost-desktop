#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ "$#" != 4 ] || [ "$1" != --candidate ] || [ "$3" != --out ]; then echo 'usage: roost-portal-security --candidate DIR --out DIR' >&2; exit 2; fi
candidate="$(realpath "$2")"
out="$(realpath -m "$4")"
if [ ! -x "$candidate/usr/bin/roost-compositor" ] || [ ! -x "$candidate/usr/bin/roost-shell-gtk" ]; then
    echo 'packaged compositor and GTK shell required' >&2
    exit 2
fi
[ ! -f "$out/assertions.txt" ] || { echo 'use a fresh artifact directory' >&2; exit 2; }
mkdir -p "$out"
podman build --tag localhost/roost-portal-reference --file "$ROOT/tests/portal-reference/Containerfile" "$ROOT/tests/portal-reference"
podman run --rm --network=none --security-opt label=disable --volume "$ROOT:/repo:ro" --volume "$candidate:/candidate:ro" --volume "$out:/out" localhost/roost-portal-reference /repo/tests/portal-reference/run.sh
# Remove unsupported file types (sockets, pipes, devices) that cannot be zipped
find "$out" \( -type s -o -type p -o -type b -o -type c \) -delete
