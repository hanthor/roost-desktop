#!/bin/sh
# Capture the Wayland globals GNOME 51's Mutter advertises (P-SY-06, #89).
#
# Usage: roost-gnome-wayland-info [--out FILE]
#
# Builds tests/gnome-reference/Containerfile (Fedora 45, GNOME Shell and
# Mutter 51) with podman, starts gnome-shell headless at 1280x800 and
# runs wayland-info against it. FILE (default
# tests/protocols/gnome51-wayland-info.txt) gets the package versions
# and the raw wayland-info output; scripts/roost-wayland-info-compare
# reads its globals. Headless Mutter has no KMS device, so globals that
# need one (wp_drm_lease_device_v1) are absent from the capture.
set -eu
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
OUT="$ROOT/tests/protocols/gnome51-wayland-info.txt"
while [ $# -gt 0 ]; do
    case "$1" in
        --out) OUT="$2"; shift 2 ;;
        --help|-h) sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "roost-gnome-wayland-info: unknown argument $1" >&2; exit 1 ;;
    esac
done
command -v podman >/dev/null 2>&1 || { echo "roost-gnome-wayland-info: needs podman" >&2; exit 1; }
mkdir -p "$(dirname "$OUT")"
IMAGE=localhost/roost-gnome51-reference
podman build -q -t "$IMAGE" "$ROOT/tests/gnome-reference" >/dev/null
BASE_DIGEST="$(podman image inspect quay.io/fedora/fedora:45 --format '{{.Digest}}' 2>/dev/null || echo unknown)"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
# shellcheck disable=SC2016 # expands in the container's shell
podman run --rm -e BASE_DIGEST="$BASE_DIGEST" "$IMAGE" sh -c '
  set -eu
  export XDG_RUNTIME_DIR=/tmp/xdg LANG=C.UTF-8
  export XDG_CURRENT_DESKTOP=GNOME XDG_SESSION_DESKTOP=gnome
  mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"
  dbus-daemon --session --address=unix:path=/tmp/sysbus --fork --nopidfile
  export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/tmp/sysbus
  echo "# GNOME 51 Wayland globals, captured by scripts/roost-gnome-wayland-info"
  echo "# image: quay.io/fedora/fedora:45@$BASE_DIGEST (tests/gnome-reference/Containerfile)"
  echo "# packages: $(rpm -q gnome-shell mutter wayland-utils | tr "\n" " ")"
  echo "# session: gnome-shell --headless --wayland --virtual-monitor 1280x800"
  dbus-run-session -- sh -c "
    gnome-shell --headless --wayland --virtual-monitor 1280x800 >/tmp/shell.log 2>&1 &
    i=0
    while [ ! -S \$XDG_RUNTIME_DIR/wayland-0 ] && [ \$i -lt 120 ]; do sleep 1; i=\$((i+1)); done
    sleep 5
    WAYLAND_DISPLAY=wayland-0 wayland-info || { cat /tmp/shell.log >&2; exit 1; }
    kill %1 2>/dev/null || true
  "
' >"$TMP"
grep -q "interface: 'wl_compositor'" "$TMP" || {
    echo "roost-gnome-wayland-info: no globals captured" >&2
    cat "$TMP" >&2
    exit 1
}
mv "$TMP" "$OUT"
trap - EXIT
echo "roost-gnome-wayland-info: $(grep -c "^interface: " "$OUT") globals in $OUT"
