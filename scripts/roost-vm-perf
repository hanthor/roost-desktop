#!/usr/bin/env python3
"""Measure one GNOME or Roost guest using the same VM profile (#73)."""
import argparse
import base64
import hashlib
import importlib.machinery
import importlib.util
import json
import math
import os
from pathlib import Path
import statistics
import subprocess
import sys
import time

HERE = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader("vm_lane", str(HERE / "roost-vm-lane"))
spec = importlib.util.spec_from_loader("vm_lane", loader)
lane = importlib.util.module_from_spec(spec)
loader.exec_module(lane)
sys.path.insert(0, str(HERE / "lib"))
from vm_guest_agent import GuestAgent  # noqa: E402
from perf_trace_diagnostics import decode as decode_trace_failure, MAX_BYTES as TRACE_FAILURE_BYTES
from gnome_failed_capture import validate_receipt as validate_failed_capture, validate_chunk as validate_failed_chunk
from gnome_stop_boundary import capture_stop_boundary_evidence
from gnome_sysprof import capture_boundary_evidence, decode as decode_gnome_sysprof, required_scope_counts, overview_frame_bounds, frame_source_evidence  # noqa: E402


def guest_probe(agent, action, index=None, out=None):
    """Only this immutable CI helper is executed; no command/path input."""
    if action not in ("clock", "notify", "frames", "gnome-trace-start",
                      "gnome-trace-stop", "gnome-trace-read",
                      "gnome-trace-failed-stop", "gnome-trace-failed-stop-read",
                      "kernel-trace-stop", "kernel-trace-read", "kernel-formats-read"):
        raise ValueError("unsupported performance probe")
    arguments = [action]
    if action == "notify":
        if type(index) is not int or not 0 <= index < 10:
            raise ValueError("notification index outside the fixed workload")
        arguments += ["--index", str(index)]
    if action in ("gnome-trace-read","gnome-trace-failed-stop-read"):
        if type(index) is not int or not 0 <= index < 128:
            raise ValueError("capture chunk index outside the bounded file")
        arguments += ["--index", str(index)]
    if action in ("kernel-trace-read", "kernel-formats-read"):
        if type(index) is not int or not 0 <= index < 1024:
            raise ValueError("kernel capture chunk index outside the bounded file")
        arguments += ["--index", str(index)]
    pid = agent.command("guest-exec", path="/usr/libexec/roost-perf-phase",
                        arg=arguments, **{"capture-output": True})["pid"]
    deadline = time.monotonic() + (30 if action in ("gnome-trace-stop","gnome-trace-failed-stop") else 20)
    while time.monotonic() < deadline:
        status = agent.command("guest-exec-status", pid=pid)
        if status["exited"]:
            if status.get("exitcode") != 0 or status.get("out-truncated") or status.get("err-truncated"):
                # Fixed observer actions do not accept application text. Keep
                # bounded QGA stderr so an acquisition failure is diagnosable.
                encoded = status.get("err-data", "")
                try:
                    if not isinstance(encoded, str):
                        raise ValueError("invalid stderr type")
                    stderr = base64.b64decode(encoded[:8192], validate=True)[:4096].decode(
                        "utf-8", errors="replace")
                except ValueError:
                    stderr = "<invalid guest stderr encoding>"
                details = {"exitcode": status.get("exitcode"),
                           "stdout_truncated": bool(status.get("out-truncated")),
                           "stderr_truncated": bool(status.get("err-truncated")), "stderr": stderr}
                if action in ("gnome-trace-start","gnome-trace-stop","gnome-trace-failed-stop") and out is not None:
                    retain_trace_failure(status,action,out)
                    if action=="gnome-trace-stop":retain_failed_gnome_capture(agent,out)
                raise RuntimeError(f"guest performance {action} failed: {json.dumps(details)}")
            result = json.loads(base64.b64decode(status.get("out-data", ""), validate=True))
            if action in ("gnome-trace-start","gnome-trace-stop","gnome-trace-failed-stop") and isinstance(result,dict) and "trace_failure" in result:
                if out is not None:
                    retain_trace_failure(status,action,out)
                    if action=="gnome-trace-stop":retain_failed_gnome_capture(agent,out)
                raise RuntimeError(f"guest performance {action} failed")
            clock = result.get("boottime_s")
            if type(clock) not in (int, float) or not math.isfinite(clock) or clock <= 0:
                raise ValueError("invalid guest clock marker")
            if action == "notify":
                identity = result.get("notification_id")
                if type(identity) is not int or not 1 <= identity <= 0xffffffff:
                    raise ValueError("invalid accepted notification ID")
            return result
        time.sleep(.1)
    raise RuntimeError(f"guest performance {action} timed out")


def retain_trace_failure(status,action,out):
    receipt={"action":action,"diagnostic_accepted":False}
    exitcode=status.get("exitcode")
    if type(exitcode) is int and -255 <= exitcode <= 255:
        receipt["guest_exitcode"]=exitcode
    try:
        encoded=status.get("out-data","")
        if status.get("out-truncated") or status.get("err-truncated") or not isinstance(encoded,str) or len(encoded)>((TRACE_FAILURE_BYTES+2)//3)*4:
            raise ValueError("incomplete bounded trace failure")
        value=decode_trace_failure(base64.b64decode(encoded,validate=True),("stop" if action=="gnome-trace-failed-stop" else action.removeprefix("gnome-trace-")))
        receipt.update(diagnostic_accepted=True,diagnostic=value)
    except (ValueError,TypeError,RecursionError):
        # A fixed rejection receipt survives malformed input without retaining
        # its body/stderr. This is still the original failed guest execution.
        receipt["diagnostic_rejected"]=True
    target=out/(action+"-failure.json")
    with target.open("x") as stream:
        json.dump(receipt,stream,indent=2)


def retain_failed_gnome_capture(agent,out):
    """One separate read-only bounded acquisition; original failure survives."""
    report={"qualified":False,"raw_retained":False}
    try:
        metadata=validate_failed_capture(guest_probe(agent,"gnome-trace-failed-stop",out=out)["gnome_trace"])
        if metadata.get("qualified") is not False:
            raise ValueError("failed capture cannot qualify")
        size=metadata.get("bytes");digest=metadata.get("sha256")
        if (type(size) is not int or not 256<=size<=8*1024*1024
                or type(digest) is not str or __import__('re').fullmatch(r'[0-9a-f]{64}',digest) is None):
            raise ValueError("failed original capture bounds refused")
        (out/"gnome-overview-failed-source.json").write_text(json.dumps(metadata,indent=2))
        chunks=[]
        for index in range((size+65535)//65536):
            row=guest_probe(agent,"gnome-trace-failed-stop-read",index)["gnome_trace"]
            chunk=validate_failed_chunk(row,index,metadata)
            chunks.append(chunk)
        raw=b''.join(chunks)
        if hashlib.sha256(raw).hexdigest()!=digest:
            raise ValueError("failed original capture hash refused")
        (out/"gnome-overview-failed.syscap").write_bytes(raw)
        report.update(raw_retained=True,bytes=size,sha256=digest,
                      writer_closure_observed=metadata.get("writer_closure_observed") is True)
    except Exception as error:
        # No raw exception/provider body/credentials; original status unchanged.
        report["acquisition_refused"]=True
        report["reason"]=("file-io-refused" if isinstance(error,OSError) else
                          "validation-refused" if isinstance(error,(ValueError,TypeError,KeyError)) else
                          "guest-action-failed")
    try:
        with (out/"gnome-overview-failed-acquisition.json").open('x') as stream:
            json.dump(report,stream,indent=2)
    except OSError:
        # Retain any prior owned receipt; finalization cannot mask original Stop.
        print("Failed GNOME raw acquisition receipt could not be finalized",file=sys.stderr)


def distribution(values):
    values = sorted(values)
    if not values:
        return {"count": 0}
    def percentile(p):
        return values[min(len(values)-1, max(0, __import__("math").ceil(p * len(values))-1))]
    return {"count": len(values), "p50": percentile(.50), "p95": percentile(.95),
            "p99": percentile(.99), "min": values[0], "max": values[-1],
            "mean": statistics.mean(values)}


def retain_kernel_trace(agent, out, metadata):
    """Retain the whole observer before rejecting loss or invalid acquisition."""
    (out / "kernel-vblank-source.json").write_text(json.dumps(metadata, indent=2))
    for kind, action, name, minimum, maximum in (
        ("raw", "kernel-trace-read", "kernel-vblank-trace.txt", 1, 64 * 1024 * 1024),
        ("formats", "kernel-formats-read", "kernel-vblank-formats.json", 1, 2 * 1024 * 1024),
    ):
        source = metadata.get(kind, {})
        size, digest = source.get("bytes"), source.get("sha256")
        if type(size) is not int or not minimum <= size <= maximum or not isinstance(digest, str):
            raise ValueError("kernel observer artifact metadata is missing or invalid")
        with (out / name).open("wb") as stream:
            hashed = hashlib.sha256()
            for index in range((size + 65535) // 65536):
                row = guest_probe(agent, action, index)["kernel_trace"]
                chunk = base64.b64decode(row["data"], validate=True)
                if row["index"] != index or len(chunk) != min(65536, size - index * 65536):
                    raise ValueError("incomplete actual kernel observer chunk")
                stream.write(chunk)
                hashed.update(chunk)
        if hashed.hexdigest() != digest:
            raise ValueError("kernel observer artifact changed during acquisition")
    if metadata.get("qualified_acquisition") is not True or metadata.get("errors") or metadata.get("cleanup_errors"):
        raise ValueError("kernel observer reports actual loss, missing probes or invalid acquisition")


def retain_gnome_trace(agent, out, metadata):
    size = metadata.get("bytes")
    digest = metadata.get("sha256")
    if type(size) is not int or not 256 <= size <= 8 * 1024 * 1024:
        raise ValueError("invalid GNOME Sysprof capture size")
    chunks = []
    for index in range((size + 65535) // 65536):
        row = guest_probe(agent, "gnome-trace-read", index)["gnome_trace"]
        chunk = base64.b64decode(row["data"], validate=True)
        if row["index"] != index or len(chunk) != min(65536, size - index * 65536):
            raise ValueError("incomplete GNOME Sysprof capture chunk")
        chunks.append(chunk)
    raw = b"".join(chunks)
    if hashlib.sha256(raw).hexdigest() != digest:
        raise ValueError("GNOME Sysprof capture checksum changed")
    (out / "gnome-overview.syscap").write_bytes(raw)
    (out / "gnome-overview-source.json").write_text(json.dumps(metadata, indent=2))
    decoded = decode_gnome_sysprof(raw)
    # Preserve decoded evidence even if a required semantic scope is absent.
    (out / "gnome-overview-marks.json").write_text(json.dumps(decoded, indent=2))
    package = metadata.get("mutter_cogl_library", {}).get("package")
    diagnostic = package in ("mutter 51.0-1.2", "mutter 51.0-1.3", "mutter 51.0-1.5", "mutter 51.0-1.6", "mutter 51.0-1.7")
    observer_error = None
    # Acquire independent whole kernel bytes before any diagnostic validation.
    if "kernel_trace" in metadata:
        try:
            retain_kernel_trace(agent, out, metadata["kernel_trace"])
        except Exception as error:
            observer_error = str(error)
            (out / "kernel-vblank-acquisition-rejection.json").write_text(json.dumps({"reason": observer_error}, indent=2))
    evidence = {}
    if diagnostic:
        try:
            evidence = frame_source_evidence(decoded, metadata["pid"])
            (out / "gnome-overview-source-frames.json").write_text(json.dumps(evidence, indent=2))
        except ValueError as error:
            observer_error = str(error)
            (out / "gnome-overview-source-rejection.json").write_text(json.dumps({"reason": str(error)}, indent=2))
    if package in ("mutter 51.0-1.5", "mutter 51.0-1.6", "mutter 51.0-1.7"):
        boundary = capture_boundary_evidence(decoded, metadata)
        (out / "gnome-overview-capture-boundary.json").write_text(json.dumps(boundary, indent=2))
    if package in ("mutter 51.0-1.6", "mutter 51.0-1.7"):
        stop_boundary = capture_stop_boundary_evidence(decoded, metadata)
        (out / "gnome-overview-capture-stop-boundary.json").write_text(json.dumps(stop_boundary, indent=2))
    if metadata.get("mutter_cogl_library", {}).get("package") == "mutter 51.0-1.3":
        if not evidence.get("kernel_callback_identities") or not evidence.get("kernel_commit_listener_observations"):
            observer_error = observer_error or "instrumented Mutter lacks actual callback/commit/listener identity observations"
        if "kernel_trace" not in metadata:
            observer_error = observer_error or "instrumented kernel diagnostic capture lacks independent observer metadata"
    if metadata.get("capture_writers_after_stop") != []:
        raise ValueError("GNOME capture writer did not close after Stop")
    kernel = metadata.get("guest_kernel_provenance")
    if kernel is not None and (not isinstance(kernel, dict) or kernel.get("cleanup_error") or
                               kernel.get("unchanged") is not True or
                               not kernel.get("before") or kernel.get("before") != kernel.get("after")):
        raise ValueError("guest kernel provenance is missing or changed during profiling")
    counts = required_scope_counts(decoded, metadata["pid"])
    if not all(counts.values()):
        raise ValueError("GNOME profile lacks actual event/dispatch/presentation scopes")
    if metadata.get("gnome_shell_version") != "GNOME Shell 51.0":
        raise ValueError("frame ownership requires the pinned GNOME Shell 51.0")
    frames = overview_frame_bounds(decoded, metadata["pid"])
    (out / "gnome-overview-frame-ownership.json").write_text(json.dumps(frames, indent=2))
    if observer_error is not None:
        raise ValueError(observer_error)
    frames["latency_lower_ms"] = distribution([row["latency_lower_ms"] for row in frames["inputs"]])
    frames["latency_upper_ms"] = distribution([row["latency_upper_ms"] for row in frames["inputs"]])
    return {"bytes": size, "sha256": digest, "frame_count": decoded["frame_count"],
            "mark_count": len(decoded["marks"]), "scope_counts": counts, "frame_ownership": frames,
            "limitation": (evidence["limitation"] if diagnostic else frames["limitation"])}


def presentation_summary(trace):
    """Validate actual feedback; retain unknown refresh and absent hardware flags."""
    rows = trace.get("frames")
    if not isinstance(rows, list) or len(rows) != 240:
        raise ValueError("expected 240 presented frames")
    for name in ("clock_id", "commits", "discarded", "pending"):
        value = trace.get(name)
        if type(value) is not int or value < 0:
            raise ValueError(f"invalid presentation {name}")
    if (trace["clock_id"] > 0xffffffff or not 240 <= trace["commits"] <= 1200
            or trace["commits"] != len(rows) + trace["discarded"] + trace["pending"]):
        raise ValueError("incomplete presentation accounting")
    commits = set()
    for row in rows:
        for name in ("commit", "presented_ns", "refresh_ns", "sequence", "flags"):
            if type(row.get(name)) is not int or row[name] < 0:
                raise ValueError(f"invalid frame {name}")
        if (not 1 <= row["commit"] <= trace["commits"] or row["commit"] in commits
                or not 1 <= row["presented_ns"] <= 0xffffffffffffffff or row["refresh_ns"] > 0xffffffff
                or row["flags"] > 15 or row["sequence"] > 0xffffffffffffffff):
            raise ValueError("invalid or duplicate presented frame")
        commits.add(row["commit"])
    rows = sorted(rows, key=lambda row: row["commit"])
    intervals = [right["presented_ns"] - left["presented_ns"]
                 for left, right in zip(rows, rows[1:])]
    if any(value <= 0 for value in intervals):
        raise ValueError("nonmonotonic presentation timestamps")
    return {"presented_count": len(rows), "commits": trace["commits"],
            "discarded_count": trace["discarded"], "pending_count": trace["pending"],
            "clock_id": trace["clock_id"],
            "interval_ms": distribution([value / 1e6 for value in intervals]),
            "reported_refresh_ms": distribution([row["refresh_ns"] / 1e6 for row in rows if row["refresh_ns"]]),
            "unknown_refresh_count": sum(row["refresh_ns"] == 0 for row in rows),
            "flag_counts": {name: sum(bool(row["flags"] & flag) for row in rows)
                            for name, flag in (("vsync", 1), ("hw_clock", 2), ("hw_completion", 4), ("zero_copy", 8))},
            "scope": "Native SHM xdg-toplevel with alternating damage, paced by wl_surface.frame. wp_presentation timestamps measure this client's presentation cadence, not compositor input-to-frame tracing. Hardware flags and unknown refresh are explicit."}


def raw_samples(serial):
    result = []
    for line in serial.splitlines():
        if "roost-perf-sample: " in line:
            try:
                result.append(json.loads(line.split("roost-perf-sample: ", 1)[1]))
            except json.JSONDecodeError:
                continue
    return result


def drm_memory_summary(samples):
    counters, status = {}, {}
    for sample in samples:
        gpu = sample.get("drm_memory", {"status": "unavailable", "clients": []})
        status[gpu["status"]] = status.get(gpu["status"], 0) + 1
        if gpu["status"] != "available":
            continue
        totals = {}
        for client in gpu["clients"]:
            for name, value in client["memory_bytes"].items():
                key = (client["driver"], client["device"], name)
                totals[key] = totals.get(key, 0) + value
        for key, value in totals.items():
            counters.setdefault(key, []).append(value)
    return {"sample_status_counts": status,
            "client_accounted_bytes": [dict(driver=key[0], device=key[1], counter=key[2],
                                            distribution=distribution(values))
                                       for key, values in sorted(counters.items())],
            "scope": "Test UID DRM client counters; duplicate handles counted once. Shared buffers across distinct clients may be counted more than once. Unsupported or incomplete samples are not zero."}


def idle_cpu(samples, start, end):
    if not 0 < start < end:
        raise ValueError("invalid guest idle interval")
    values = []
    for sample in samples:
        begin = sample.get("cpu_interval_start_boottime_s")
        finish = sample.get("boottime_s")
        value = sample.get("cpu_observed_percent")
        if (begin is not None and finish is not None and value is not None
                and start <= begin <= finish <= end):
            values.append(value)
    if len(values) < 20:
        raise ValueError("fewer than 20 wholly idle CPU intervals were observed")
    return distribution(values)


def raw_globals(serial):
    parts = {}
    for line in serial.splitlines():
        if "roost-perf-globals: " not in line:
            continue
        record = json.loads(line.split("roost-perf-globals: ", 1)[1])
        if (type(record["count"]) is not int or not 1 <= record["count"] <= 1024
                or len(record["sha256"]) != 64):
            raise ValueError("invalid Wayland capture metadata")
        key = (record["sha256"], record["socket"], record["count"])
        chunks = parts.setdefault(key, {})
        index = record["index"]
        if type(index) is not int or not 0 <= index < record["count"]:
            raise ValueError("invalid Wayland capture chunk index")
        if index in chunks:
            raise ValueError("duplicate Wayland capture chunk")
        chunks[index] = base64.b64decode(record["data"], validate=True)
    if len(parts) != 1:
        raise ValueError("expected one actual-session Wayland globals capture")
    (digest, socket_name, count), chunks = next(iter(parts.items()))
    if set(chunks) != set(range(count)):
        raise ValueError("incomplete Wayland globals capture")
    raw = b"".join(chunks[index] for index in range(count))
    if hashlib.sha256(raw).hexdigest() != digest:
        raise ValueError("Wayland globals capture digest mismatch")
    text = raw.decode("utf-8")
    if "interface: 'wl_compositor'" not in text or "interface: 'xdg_wm_base'" not in text:
        raise ValueError("capture does not describe a desktop Wayland session")
    return text, {"sha256": digest, "socket": socket_name}


def frame(qmp, path):
    qmp.cmd("screendump", filename=str(path), format="ppm")
    return lane.read_ppm(str(path))[2]


def changed(before, after):
    # Ignore the clock/top panel and a five-pixel cursor region by requiring
    # a broad visible response, rather than treating one changed pixel as input.
    return sum(abs(x-y) > 24 for x, y in zip(before[32*1280*3:], after[32*1280*3:])) > 1280*800*3*.10


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--disk", required=True)
    ap.add_argument("--desktop", required=True, choices=("gnome", "roost"))
    ap.add_argument("--out", required=True)
    ap.add_argument("--timeout", type=int, default=900)
    ap.add_argument("--meta", action="append", default=[])
    args = ap.parse_args()
    out = Path(args.out).resolve()
    out.mkdir(parents=True, exist_ok=False)
    scratch = out / ".work"
    scratch.mkdir()
    vm, qmp_path, serial_path, kvm, agent_path = lane.boot(
        os.path.abspath(args.disk), str(out), str(scratch), args.timeout, guest_agent=True)
    started = time.monotonic()
    observations, phases, guest_phases, notifications = [], {}, {}, []
    agent = None
    gnome_trace_active = False
    gnome_trace_summary = None
    try:
        if not kvm:
            raise RuntimeError("paired performance comparison requires actual KVM")
        qmp = lane.baseline.Qmp(qmp_path)
        ready = False
        while time.monotonic()-started < args.timeout and vm.poll() is None:
            if raw_samples(lane.read_text(serial_path)):
                qmp.keys("esc")
                time.sleep(2)
                path = scratch / "ready.ppm"
                frame(qmp, path)
                ready, _ = lane.check_panel(str(path))
                if ready:
                    break
            time.sleep(2)
        if not ready:
            raise RuntimeError("the guest never displayed its desktop panel")
        panel_upper_s = time.monotonic()-started
        qmp.frame(str(out / "panel.png"))
        agent = GuestAgent(agent_path)
        time.sleep(30)  # Equal post-panel settle, before the idle measurement.
        phases["idle_start"] = time.clock_gettime(time.CLOCK_BOOTTIME)
        guest_phases["idle_start"] = guest_probe(agent, "clock")["boottime_s"]
        time.sleep(30)
        guest_phases["idle_end"] = guest_probe(agent, "clock")["boottime_s"]
        phases["idle_end"] = time.clock_gettime(time.CLOCK_BOOTTIME)
        presentation = guest_probe(agent, "frames")["presentation"]
        (out / "presentation.json").write_text(json.dumps(presentation, indent=2))
        pacing = presentation_summary(presentation)
        for query in ("disks", "system monitor", "files"):
            qmp.keys("meta_l")
            time.sleep(1)
            qmp.type_text(query)
            time.sleep(1)
            qmp.keys("ret")
            time.sleep(8)
        if args.desktop == "gnome":
            guest_probe(agent, "gnome-trace-start", out=out)
            gnome_trace_active = True
            time.sleep(1)  # Preserve pre-input scopes after the actual drained boundary.
        phases["workload_start"] = time.clock_gettime(time.CLOCK_BOOTTIME)
        for index in range(20):
            before = frame(qmp, scratch / "before.ppm")
            start = time.monotonic()
            qmp.keys("meta_l")
            previous_start = start
            while time.monotonic()-start < 10:
                poll_start = time.monotonic()
                after = frame(qmp, scratch / "after.ppm")
                poll_end = time.monotonic()
                if changed(before, after):
                    observations.append({"index": index, "action": "overview-open" if index % 2 == 0 else "overview-close",
                                         "lower_s": previous_start-start, "upper_s": poll_end-start,
                                         "capture_s": poll_end-poll_start})
                    qmp.frame(str(out / f"overview-{index:02d}.png"))
                    break
                previous_start = poll_start
                time.sleep(.02)
            else:
                raise RuntimeError(f"overview input {index} produced no broad visible response")
            time.sleep(1)
        if gnome_trace_active:
            metadata = guest_probe(agent, "gnome-trace-stop", out=out)["gnome_trace"]
            gnome_trace_active = False
            gnome_trace_summary = retain_gnome_trace(agent, out, metadata)
        for _ in range(10):
            qmp.keys("meta_l", "pgdn")
            time.sleep(1)
            qmp.keys("meta_l", "pgup")
            time.sleep(1)
        phases["workload_end"] = time.clock_gettime(time.CLOCK_BOOTTIME)
        guest_phases["notifications_start"] = guest_probe(agent, "clock")["boottime_s"]
        for index in range(10):
            notifications.append(dict(index=index, **guest_probe(agent, "notify", index)))
            if index == 0:
                time.sleep(.5)
                qmp.frame(str(out / "notification-first.png"))
            time.sleep(1)
        guest_phases["notifications_end"] = guest_probe(agent, "clock")["boottime_s"]
        if len({row["notification_id"] for row in notifications}) != 10:
            raise RuntimeError("notification workload did not accept ten distinct notifications")
        time.sleep(30)
        serial = lane.read_text(serial_path)
        samples = raw_samples(serial)
        if not samples or any(s["unreadable"] for s in samples):
            raise RuntimeError("resource samples are missing or incomplete; inspect raw serial")
        globals_text, globals_meta = raw_globals(serial)
        if presentation.get("socket") != globals_meta["socket"]:
            raise RuntimeError("presentation probe did not use the captured desktop socket")
        (out / "wayland-info.txt").write_text(globals_text)
        (out / "wayland-info-source.json").write_text(json.dumps(globals_meta, indent=2))
        (out / "samples.json").write_text(json.dumps(samples, indent=2))
        (out / "observations.json").write_text(json.dumps(observations, indent=2))
        (out / "guest-phases.json").write_text(json.dumps(guest_phases, indent=2))
        (out / "notifications.json").write_text(json.dumps(notifications, indent=2))
        # Host and guest boottime clocks are different. Keep host phases as
        # provenance, and summarize guest samples only by their guest timestamps.
        report = {"desktop": args.desktop, "vm_profile": {"memory_mib":6144,"vcpus":4,"resolution":[1280,800],"kvm":kvm,
                      "gpu_profile":lane.baseline.GPU_PROFILE,"gpu_devices":lane.baseline.gpu_devices()},
                  "meta": args.meta, "host": {"kernel":os.uname().release,"cpu":Path("/proc/cpuinfo").read_text(),
                                              "qemu":subprocess.check_output(["qemu-system-x86_64","--version"],text=True)},
                  "panel_observed_upper_s":panel_upper_s,"host_phases_boottime_s":phases,
                  "whole_user_pss_kib":distribution([s["pss_kib"] for s in samples]),
                  "whole_user_cpu_observed_percent":distribution([s["cpu_observed_percent"] for s in samples if s["cpu_observed_percent"] is not None]),
                  "idle_user_cpu_observed_percent": idle_cpu(samples, guest_phases["idle_start"], guest_phases["idle_end"]),
                  "guest_phases_boottime_s": guest_phases,
                  "accepted_notification_count": len(notifications),
                  "drm_memory": drm_memory_summary(samples),
                  "presentation_cadence": pacing,
                  "gnome_overview_sysprof": gnome_trace_summary,
                  "overview_observed_upper_s":distribution([s["upper_s"] for s in observations]),
                  "limitations":["QMP observations are bounded host-visible response times, not compositor input-to-frame tracing.",
                                 "CPU counts surviving sampled processes; exited processes can consume unobserved CPU.",
                                 "PSS covers the test UID and excludes the observer and its descendants; root/GDM shared services are outside this scope.",
                                 "Whole-run summaries include startup and workload. Idle CPU uses guest-clock markers and only intervals wholly within the idle phase.",
                                 "DRM memory is optional driver-provided client accounting, not unique physical GPU allocation; unavailable samples are explicit.",
                                 "Notification IDs prove service acceptance, not notification input-to-frame latency. Presentation cadence is a native client workload; compositor input tracing, multiple cold/warm boots and 24-hour soak remain open.",
                                 "No release threshold or claim of within-10-percent parity is introduced."]}
        (out / "report.json").write_text(json.dumps(report, indent=2))
        print(json.dumps({"desktop":args.desktop,"samples":len(samples),"observations":len(observations)}))
    finally:
        if gnome_trace_active and agent is not None:
            try:
                guest_probe(agent, "gnome-trace-stop", out=out)
            except Exception as error:
                print(f"GNOME profile cleanup failed: {error}", file=sys.stderr)
        if agent is not None and args.desktop == "gnome":
            try:
                observer = guest_probe(agent, "kernel-trace-stop")["kernel_trace"]
                if not (out / "kernel-vblank-source.json").exists():
                    retain_kernel_trace(agent, out, observer)
            except Exception as error:
                print(f"Kernel observer cleanup/acquisition failed: {error}", file=sys.stderr)
        if agent is not None:
            agent.close()
        vm.terminate()
        try:
            vm.wait(timeout=10)
        except subprocess.TimeoutExpired:
            vm.kill();vm.wait()


if __name__ == "__main__":
    main()
