#!/usr/bin/env python3
"""Measure one GNOME or Roost guest using the same VM profile (#73)."""
import argparse
import base64
import hashlib
import importlib.machinery
import importlib.util
import json
import math
import os
from pathlib import Path
import statistics
import subprocess
import sys
import time

HERE = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader("vm_lane", str(HERE / "roost-vm-lane"))
spec = importlib.util.spec_from_loader("vm_lane", loader)
lane = importlib.util.module_from_spec(spec)
loader.exec_module(lane)
sys.path.insert(0, str(HERE / "lib"))
from vm_guest_agent import GuestAgent  # noqa: E402


def guest_probe(agent, action, index=None):
    """Only this immutable CI helper is executed; no command/path input."""
    if action not in ("clock", "notify"):
        raise ValueError("unsupported performance probe")
    arguments = [action]
    if action == "notify":
        if type(index) is not int or not 0 <= index < 10:
            raise ValueError("notification index outside the fixed workload")
        arguments += ["--index", str(index)]
    pid = agent.command("guest-exec", path="/usr/libexec/roost-perf-phase",
                        arg=arguments, **{"capture-output": True})["pid"]
    deadline = time.monotonic() + 20
    while time.monotonic() < deadline:
        status = agent.command("guest-exec-status", pid=pid)
        if status["exited"]:
            if status.get("exitcode") != 0 or status.get("out-truncated") or status.get("err-truncated"):
                raise RuntimeError(f"guest performance {action} failed")
            result = json.loads(base64.b64decode(status.get("out-data", ""), validate=True))
            clock = result.get("boottime_s")
            if type(clock) not in (int, float) or not math.isfinite(clock) or clock <= 0:
                raise ValueError("invalid guest clock marker")
            if action == "notify":
                identity = result.get("notification_id")
                if type(identity) is not int or not 1 <= identity <= 0xffffffff:
                    raise ValueError("invalid accepted notification ID")
            return result
        time.sleep(.1)
    raise RuntimeError(f"guest performance {action} timed out")


def distribution(values):
    values = sorted(values)
    if not values:
        return {"count": 0}
    def percentile(p):
        return values[min(len(values)-1, max(0, __import__("math").ceil(p * len(values))-1))]
    return {"count": len(values), "p50": percentile(.50), "p95": percentile(.95),
            "p99": percentile(.99), "min": values[0], "max": values[-1],
            "mean": statistics.mean(values)}


def raw_samples(serial):
    result = []
    for line in serial.splitlines():
        if "roost-perf-sample: " in line:
            try:
                result.append(json.loads(line.split("roost-perf-sample: ", 1)[1]))
            except json.JSONDecodeError:
                continue
    return result


def drm_memory_summary(samples):
    counters, status = {}, {}
    for sample in samples:
        gpu = sample.get("drm_memory", {"status": "unavailable", "clients": []})
        status[gpu["status"]] = status.get(gpu["status"], 0) + 1
        if gpu["status"] != "available":
            continue
        totals = {}
        for client in gpu["clients"]:
            for name, value in client["memory_bytes"].items():
                key = (client["driver"], client["device"], name)
                totals[key] = totals.get(key, 0) + value
        for key, value in totals.items():
            counters.setdefault(key, []).append(value)
    return {"sample_status_counts": status,
            "client_accounted_bytes": [dict(driver=key[0], device=key[1], counter=key[2],
                                            distribution=distribution(values))
                                       for key, values in sorted(counters.items())],
            "scope": "Test UID DRM client counters; duplicate handles counted once. Shared buffers across distinct clients may be counted more than once. Unsupported or incomplete samples are not zero."}


def idle_cpu(samples, start, end):
    if not 0 < start < end:
        raise ValueError("invalid guest idle interval")
    values = []
    for sample in samples:
        begin = sample.get("cpu_interval_start_boottime_s")
        finish = sample.get("boottime_s")
        value = sample.get("cpu_observed_percent")
        if (begin is not None and finish is not None and value is not None
                and start <= begin <= finish <= end):
            values.append(value)
    if len(values) < 20:
        raise ValueError("fewer than 20 wholly idle CPU intervals were observed")
    return distribution(values)


def raw_globals(serial):
    parts = {}
    for line in serial.splitlines():
        if "roost-perf-globals: " not in line:
            continue
        record = json.loads(line.split("roost-perf-globals: ", 1)[1])
        if (type(record["count"]) is not int or not 1 <= record["count"] <= 1024
                or len(record["sha256"]) != 64):
            raise ValueError("invalid Wayland capture metadata")
        key = (record["sha256"], record["socket"], record["count"])
        chunks = parts.setdefault(key, {})
        index = record["index"]
        if type(index) is not int or not 0 <= index < record["count"]:
            raise ValueError("invalid Wayland capture chunk index")
        if index in chunks:
            raise ValueError("duplicate Wayland capture chunk")
        chunks[index] = base64.b64decode(record["data"], validate=True)
    if len(parts) != 1:
        raise ValueError("expected one actual-session Wayland globals capture")
    (digest, socket_name, count), chunks = next(iter(parts.items()))
    if set(chunks) != set(range(count)):
        raise ValueError("incomplete Wayland globals capture")
    raw = b"".join(chunks[index] for index in range(count))
    if hashlib.sha256(raw).hexdigest() != digest:
        raise ValueError("Wayland globals capture digest mismatch")
    text = raw.decode("utf-8")
    if "interface: 'wl_compositor'" not in text or "interface: 'xdg_wm_base'" not in text:
        raise ValueError("capture does not describe a desktop Wayland session")
    return text, {"sha256": digest, "socket": socket_name}


def frame(qmp, path):
    qmp.cmd("screendump", filename=str(path), format="ppm")
    return lane.read_ppm(str(path))[2]


def changed(before, after):
    # Ignore the clock/top panel and a five-pixel cursor region by requiring
    # a broad visible response, rather than treating one changed pixel as input.
    return sum(abs(x-y) > 24 for x, y in zip(before[32*1280*3:], after[32*1280*3:])) > 1280*800*3*.10


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--disk", required=True)
    ap.add_argument("--desktop", required=True, choices=("gnome", "roost"))
    ap.add_argument("--out", required=True)
    ap.add_argument("--timeout", type=int, default=900)
    ap.add_argument("--meta", action="append", default=[])
    args = ap.parse_args()
    out = Path(args.out).resolve()
    out.mkdir(parents=True, exist_ok=False)
    scratch = out / ".work"
    scratch.mkdir()
    vm, qmp_path, serial_path, kvm, agent_path = lane.boot(
        os.path.abspath(args.disk), str(out), str(scratch), args.timeout, guest_agent=True)
    started = time.monotonic()
    observations, phases, guest_phases, notifications = [], {}, {}, []
    agent = None
    try:
        if not kvm:
            raise RuntimeError("paired performance comparison requires actual KVM")
        qmp = lane.baseline.Qmp(qmp_path)
        ready = False
        while time.monotonic()-started < args.timeout and vm.poll() is None:
            if raw_samples(lane.read_text(serial_path)):
                qmp.keys("esc")
                time.sleep(2)
                path = scratch / "ready.ppm"
                frame(qmp, path)
                ready, _ = lane.check_panel(str(path))
                if ready:
                    break
            time.sleep(2)
        if not ready:
            raise RuntimeError("the guest never displayed its desktop panel")
        panel_upper_s = time.monotonic()-started
        qmp.frame(str(out / "panel.png"))
        agent = GuestAgent(agent_path)
        time.sleep(30)  # Equal post-panel settle, before the idle measurement.
        phases["idle_start"] = time.clock_gettime(time.CLOCK_BOOTTIME)
        guest_phases["idle_start"] = guest_probe(agent, "clock")["boottime_s"]
        time.sleep(30)
        guest_phases["idle_end"] = guest_probe(agent, "clock")["boottime_s"]
        phases["idle_end"] = time.clock_gettime(time.CLOCK_BOOTTIME)
        for query in ("disks", "system monitor", "files"):
            qmp.keys("meta_l")
            time.sleep(1)
            qmp.type_text(query)
            time.sleep(1)
            qmp.keys("ret")
            time.sleep(8)
        phases["workload_start"] = time.clock_gettime(time.CLOCK_BOOTTIME)
        for index in range(20):
            before = frame(qmp, scratch / "before.ppm")
            start = time.monotonic()
            qmp.keys("meta_l")
            previous_start = start
            while time.monotonic()-start < 10:
                poll_start = time.monotonic()
                after = frame(qmp, scratch / "after.ppm")
                poll_end = time.monotonic()
                if changed(before, after):
                    observations.append({"index": index, "action": "overview-open" if index % 2 == 0 else "overview-close",
                                         "lower_s": previous_start-start, "upper_s": poll_end-start,
                                         "capture_s": poll_end-poll_start})
                    qmp.frame(str(out / f"overview-{index:02d}.png"))
                    break
                previous_start = poll_start
                time.sleep(.02)
            else:
                raise RuntimeError(f"overview input {index} produced no broad visible response")
            time.sleep(1)
        for _ in range(10):
            qmp.keys("meta_l", "pgdn")
            time.sleep(1)
            qmp.keys("meta_l", "pgup")
            time.sleep(1)
        phases["workload_end"] = time.clock_gettime(time.CLOCK_BOOTTIME)
        guest_phases["notifications_start"] = guest_probe(agent, "clock")["boottime_s"]
        for index in range(10):
            notifications.append(dict(index=index, **guest_probe(agent, "notify", index)))
            if index == 0:
                time.sleep(.5)
                qmp.frame(str(out / "notification-first.png"))
            time.sleep(1)
        guest_phases["notifications_end"] = guest_probe(agent, "clock")["boottime_s"]
        if len({row["notification_id"] for row in notifications}) != 10:
            raise RuntimeError("notification workload did not accept ten distinct notifications")
        time.sleep(30)
        serial = lane.read_text(serial_path)
        samples = raw_samples(serial)
        if not samples or any(s["unreadable"] for s in samples):
            raise RuntimeError("resource samples are missing or incomplete; inspect raw serial")
        globals_text, globals_meta = raw_globals(serial)
        (out / "wayland-info.txt").write_text(globals_text)
        (out / "wayland-info-source.json").write_text(json.dumps(globals_meta, indent=2))
        (out / "samples.json").write_text(json.dumps(samples, indent=2))
        (out / "observations.json").write_text(json.dumps(observations, indent=2))
        (out / "guest-phases.json").write_text(json.dumps(guest_phases, indent=2))
        (out / "notifications.json").write_text(json.dumps(notifications, indent=2))
        # Host and guest boottime clocks are different. Keep host phases as
        # provenance, and summarize guest samples only by their guest timestamps.
        report = {"desktop": args.desktop, "vm_profile": {"memory_mib":6144,"vcpus":4,"resolution":[1280,800],"kvm":kvm},
                  "meta": args.meta, "host": {"kernel":os.uname().release,"cpu":Path("/proc/cpuinfo").read_text(),
                                              "qemu":subprocess.check_output(["qemu-system-x86_64","--version"],text=True)},
                  "panel_observed_upper_s":panel_upper_s,"host_phases_boottime_s":phases,
                  "whole_user_pss_kib":distribution([s["pss_kib"] for s in samples]),
                  "whole_user_cpu_observed_percent":distribution([s["cpu_observed_percent"] for s in samples if s["cpu_observed_percent"] is not None]),
                  "idle_user_cpu_observed_percent": idle_cpu(samples, guest_phases["idle_start"], guest_phases["idle_end"]),
                  "guest_phases_boottime_s": guest_phases,
                  "accepted_notification_count": len(notifications),
                  "drm_memory": drm_memory_summary(samples),
                  "overview_observed_upper_s":distribution([s["upper_s"] for s in observations]),
                  "limitations":["QMP observations are bounded host-visible response times, not compositor input-to-frame tracing.",
                                 "CPU counts surviving sampled processes; exited processes can consume unobserved CPU.",
                                 "PSS covers the test UID and excludes the observer and its descendants; root/GDM shared services are outside this scope.",
                                 "Whole-run summaries include startup and workload. Idle CPU uses guest-clock markers and only intervals wholly within the idle phase.",
                                 "DRM memory is optional driver-provided client accounting, not unique physical GPU allocation; unavailable samples are explicit.",
                                 "Notification IDs prove service acceptance, not notification input-to-frame latency. Frame pacing, multiple cold/warm boots and 24-hour soak remain open.",
                                 "No release threshold or claim of within-10-percent parity is introduced."]}
        (out / "report.json").write_text(json.dumps(report, indent=2))
        print(json.dumps({"desktop":args.desktop,"samples":len(samples),"observations":len(observations)}))
    finally:
        if agent is not None:
            agent.close()
        vm.terminate()
        try:
            vm.wait(timeout=10)
        except subprocess.TimeoutExpired:
            vm.kill();vm.wait()


if __name__ == "__main__":
    main()
