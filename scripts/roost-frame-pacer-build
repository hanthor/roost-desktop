#!/usr/bin/env bash
# Build the small CI fixture without pulling desktop Rust/GTK build dependencies.
set -euo pipefail
if [[ $# != 1 ]]; then
    echo 'usage: roost-frame-pacer-build OUTPUT_DIRECTORY' >&2
    exit 2
fi
script_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
protocol_root=$(pkg-config --variable=pkgdatadir wayland-protocols)
mkdir -p -- "$1"
output_root=$(cd -- "$1" && pwd)
for protocol in xdg-shell presentation-time; do
    wayland-scanner client-header "$protocol_root/stable/$protocol/$protocol.xml" "$output_root/$protocol-client-protocol.h"
    wayland-scanner private-code "$protocol_root/stable/$protocol/$protocol.xml" "$output_root/$protocol-protocol.c"
done
# pkg-config emits compiler/linker arguments, intentionally split into arrays.
read -r -a compile_flags <<< "$(pkg-config --cflags wayland-client)"
read -r -a link_flags <<< "$(pkg-config --libs wayland-client)"
cc -std=c11 -O2 -Wall -Wextra -Werror "${compile_flags[@]}" -I "$output_root" \
    "$script_root/lib/roost-frame-pacer.c" "$output_root/xdg-shell-protocol.c" \
    "$output_root/presentation-time-protocol.c" "${link_flags[@]}" -o "$output_root/roost-frame-pacer"
