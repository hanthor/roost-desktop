COMPOSITOR_PID=$!

WID=""
for _ in $(seq 1 60); do
    kill -0 "$COMPOSITOR_PID" 2>/dev/null || fail G-PANEL "compositor exited during startup"
    WID="$(xdotool search --name Smithay 2>/dev/null | head -1 || true)"
    [ -n "$WID" ] && break
    sleep 1
done
[ -n "$WID" ] || fail G-PANEL "no nested window"
if [ "$INSTALLED_PACKAGE" = 1 ]; then
    # The installed launcher intentionally opens GNOME's startup overview.
    # Authenticate the original installed session before any physical input.
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-installed-startup.json" 60 ||
        fail A11Y-PANEL "installed shell never registered on the accessibility bus"
    python3 "$ROOT/scripts/lib/installed-deb-proof.py" start "$COMPOSITOR_PID" "tuna-gtk-proof-$$" "$ARTIFACTS/installed-package.json" unused "$ARTIFACTS/installed-start.json"
    installed_host="$(timeout 5 xdotool search --onlyvisible --name Smithay)"
    if [ "$installed_host" != "$WID" ] || [ "$(timeout 5 xdotool getwindowpid "$WID")" != "$COMPOSITOR_PID" ]; then
        fail G-INSTALLED-START "nested host is not the unique original installed compositor"
    fi
    pass G-INSTALLED-START "original installed compositor selects its package-owned preferred GTK shell"
fi
xdotool windowfocus --sync "$WID"
# Park the pointer mid-screen: (0,0) is the hot corner, which opens the
# overview (and the overview then claims Escape).
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))

if [ "$INSTALLED_PACKAGE" = 1 ]; then
    end=$(($(date +%s) + 20))
    until [ -s "$CSTATE" ] && jq -e '.overview_open == true and .overview_progress == 1 and .locked == false' "$CSTATE" >/dev/null; do
        [ "$(date +%s)" -le "$end" ] || fail G-INSTALLED-START "installed startup overview never became ready"
        sleep 0.3
    done
    cp "$CSTATE" "$ARTIFACTS/installed-startup-overview.json"
    scrot "$ARTIFACTS/installed-startup-overview.png" >/dev/null
    installed_focus="$(timeout 5 xdotool getwindowfocus)"
    installed_host_pid="$(timeout 5 xdotool getwindowpid "$WID")"
    if [ "$installed_focus" != "$WID" ] || [ "$installed_host_pid" != "$COMPOSITOR_PID" ]; then
        fail G-INSTALLED-START "original installed host does not own genuine keyboard focus"
    fi
    jq -n --argjson window "$WID" --argjson focus "$installed_focus" --argjson pid "$installed_host_pid" \
        '{window: $window, actual_focus: $focus, compositor_pid: $pid}' >"$ARTIFACTS/installed-host-input.json"
    python3 "$ROOT/scripts/lib/installed-deb-proof.py" stable "$COMPOSITOR_PID" "tuna-gtk-proof-$$" "$ARTIFACTS/installed-package.json" "$ARTIFACTS/installed-start.json" "$ARTIFACTS/installed-before-escape.json"
    # Exactly one genuine Escape; the readiness loop never replays input.
    timeout 5 xdotool key Escape
    end=$(($(date +%s) + 20))
    until [ -s "$CSTATE" ] && jq -e ".overview_open == false and .overview_progress == 0 and .locked == false and .pointer_position == [$((WIDTH / 2)), $((HEIGHT / 2))]" "$CSTATE" >/dev/null; do
        [ "$(date +%s)" -le "$end" ] || fail G-INSTALLED-START "genuine Escape did not restore the installed desktop at center"
        sleep 0.3
    done
    python3 "$ROOT/scripts/lib/installed-deb-proof.py" stable "$COMPOSITOR_PID" "tuna-gtk-proof-$$" "$ARTIFACTS/installed-package.json" "$ARTIFACTS/installed-start.json" "$ARTIFACTS/installed-after-escape.json"
    cp "$CSTATE" "$ARTIFACTS/installed-desktop-before-panel.json"
fi

# The panel is up once the shell registers on the a11y bus with its
# controls; that also proves the accessible tree.
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-panel.json" 60 ||
    fail A11Y-PANEL "shell never registered on the accessibility bus"
sleep 2
scrot "$ARTIFACTS/01-panel.png" >/dev/null
# GNOME 51's top bar is pure black; the session background is not. An
# empty spot in the strip must be black and the desktop below must not.
strip="$(px "$ARTIFACTS/01-panel.png" 300 5)"
desk="$(px "$ARTIFACTS/01-panel.png" 300 200)"
[ "$strip" = "0 0 0" ] || fail G-PANEL "panel strip is '$strip', not black"
[ "$desk" != "0 0 0" ] || fail G-PANEL "desktop below the panel is black too"
pass G-PANEL "GTK panel mapped as a black top strip"
for label in "Activities" "Date and Time" "System"; do
    jq -e --arg n "$label" 'any(.[]; .name == $n)' "$ARTIFACTS/a11y-panel.json" >/dev/null ||
        fail A11Y-PANEL "no accessible control named '$label'"
done
pass A11Y-PANEL "Activities, Date and Time, System exposed"

# GNOME Settings uses escaped GFile URIs. Observe actual compositor pixels,
# including a literal %20 filename whose double-decoded neighbour is red.
wallpaper_before_uri=$(gsettings get org.gnome.desktop.background picture-uri)
wallpaper_before_dark=$(gsettings get org.gnome.desktop.background picture-uri-dark)
wallpaper_before_options=$(gsettings get org.gnome.desktop.background picture-options)
wallpaper_fixture="$ARTIFACTS/wallpaper café %20.png"
wallpaper_decoy="$ARTIFACTS/wallpaper café  .png"
ffmpeg -loglevel error -y -f lavfi -i color=c=0x0000ff:s=64x64 -frames:v 1 -threads 1 "$wallpaper_fixture"
ffmpeg -loglevel error -y -f lavfi -i color=c=0xff0000:s=64x64 -frames:v 1 -threads 1 "$wallpaper_decoy"
wallpaper_uri=$("$PY" -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve().as_uri())' "$wallpaper_fixture")
printf '%s\n' "$wallpaper_uri" > "$ARTIFACTS/wallpaper-file-uri.txt"
gsettings set org.gnome.desktop.background picture-options zoom
gsettings set org.gnome.desktop.background picture-uri "$wallpaper_uri"
gsettings set org.gnome.desktop.background picture-uri-dark "$wallpaper_uri"
end=$(($(date +%s) + 15))
while :; do
    scrot -o "$ARTIFACTS/01b-wallpaper-file-uri.png" >/dev/null
    rgb=$(px "$ARTIFACTS/01b-wallpaper-file-uri.png" 10 $((HEIGHT - 10)))
    # px emits exactly three decimal RGB fields; split them intentionally.
    # shellcheck disable=SC2086
    set -- $rgb
    if [ "${1:-255}" -lt 20 ] && [ "${2:-255}" -lt 20 ] && [ "${3:-0}" -gt 220 ]; then break; fi
    [ "$(date +%s)" -ge "$end" ] && fail G-WALLPAPER-URI "escaped filename did not paint blue (double-decode decoy is red): $rgb"
    sleep 0.3
done
gsettings set org.gnome.desktop.background picture-uri "$wallpaper_before_uri"
gsettings set org.gnome.desktop.background picture-uri-dark "$wallpaper_before_dark"
gsettings set org.gnome.desktop.background picture-options "$wallpaper_before_options"
sleep 1
pass G-WALLPAPER-URI "spaces, Unicode and literal percent escapes identify the actual selected wallpaper pixels"

# A popover counts as open only when its contents are showing in the
# accessible tree: a pixel diff passes on a mere hover highlight.
showing() {
    jq -e --arg n "$2" 'any(.[]; .name == $n and .showing)' "$1" >/dev/null
}

xdotool mousemove --window "$WID" $((WIDTH / 2)) 16 click 1
sleep 2
scrot "$ARTIFACTS/02-calendar.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-calendar.json" 20 ||
    fail G-CAL-OPEN "accessibility dump failed"
showing "$ARTIFACTS/a11y-calendar.json" "No Notifications" ||
    fail G-CAL-OPEN "calendar popover contents not showing"
pass G-CAL-OPEN "clock opens the calendar and notification list"
for name in "Design review" "Release day" "All Day" "10:00 – 10:30"; do
    showing "$ARTIFACTS/a11y-calendar.json" "$name" ||
        fail G-CAL-EVENTS "the events card does not show \"$name\""
done
if showing "$ARTIFACTS/a11y-calendar.json" "Retro"; then
    fail G-CAL-EVENTS "tomorrow's event shows under today"
fi
pass G-CAL-EVENTS "today's calendar-server events list in the events card, timed as GNOME does"
# The open popover must update from real GSettings changes without a restart.
"$PY" "$ROOT/scripts/lib/tuna-calendar-preferences-proof.py" "$ARTIFACTS/a11y-calendar.json" default false ||
    fail G-CAL-PREFS "initial locale calendar is invalid"
for first in Monday Thursday Sunday; do
    gsettings set org.gnome.desktop.calendar week-start-day "$(printf '%s' "$first" | tr '[:upper:]' '[:lower:]')"
    gsettings set org.gnome.desktop.calendar show-weekdate true
    sleep 1
    "$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-calendar-$first.json" 20 ||
        fail G-CAL-PREFS "live calendar tree is unavailable"
    "$PY" "$ROOT/scripts/lib/tuna-calendar-preferences-proof.py" "$ARTIFACTS/a11y-calendar-$first.json" "$first" true ||
        fail G-CAL-PREFS "weekday order or ISO week numbers did not follow $first"
done
gsettings reset org.gnome.desktop.calendar week-start-day
gsettings reset org.gnome.desktop.calendar show-weekdate
sleep 1
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-calendar-reset.json" 20 ||
    fail G-CAL-PREFS "reset calendar tree is unavailable"
"$PY" "$ROOT/scripts/lib/tuna-calendar-preferences-proof.py" "$ARTIFACTS/a11y-calendar-reset.json" default false ||
    fail G-CAL-PREFS "locale reset or hiding week numbers failed"
jq '[.[] | select(.showing and .role == "label" and (.name | test("^(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$"))) | .name]' "$ARTIFACTS/a11y-calendar.json" >"$ARTIFACTS/calendar-initial-headings.json"
jq '[.[] | select(.showing and .role == "label" and (.name | test("^(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)$"))) | .name]' "$ARTIFACTS/a11y-calendar-reset.json" >"$ARTIFACTS/calendar-reset-headings.json"
cmp "$ARTIFACTS/calendar-initial-headings.json" "$ARTIFACTS/calendar-reset-headings.json" ||
    fail G-CAL-PREFS "reset did not restore the initial locale headings"
scrot "$ARTIFACTS/02-calendar-reset.png" >/dev/null
pass G-CAL-PREFS "live weekday changes, six ISO week labels and locale reset are visible in the same shell"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-calendar-launch.json" 20 --press "Open Calendar" ||
    fail G-CAL-LAUNCH "events card has no accessible launch action"
sleep 1
[ "$(cat "$ARTIFACTS/calendar-launch" 2>/dev/null)" = "calendar:///$(date +%F)" ] ||
    fail G-CAL-LAUNCH "default calendar did not launch at the selected day"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-calendar-closed.json" 20
if showing "$ARTIFACTS/a11y-calendar-closed.json" "Open Calendar"; then
    fail G-CAL-LAUNCH "calendar popover stayed open after launch"
