if [ "$INSTALLED_PACKAGE" = 0 ]; then
    cargo build --quiet --manifest-path "$ROOT/Cargo.toml" -p tuna-compositor -p tuna-shell-gtk -p tuna-shell-host
    cargo build --quiet --manifest-path "$ROOT/Cargo.toml" -p tuna-compositor --example icon-probe
    cargo build --quiet --manifest-path "$ROOT/Cargo.toml" -p tuna-compositor --example shortcut-inhibit-client
fi
if [ -n "$PAM_ON" ]; then
    env IBUS_ADDRESS="unix:path=$ARTIFACTS/not-the-private-ibus" \
        LD_PRELOAD="$PAM_WRAPPER_LIB" PAM_WRAPPER=1 \
        PAM_WRAPPER_SERVICE_DIR="$ARTIFACTS/pam/services" \
        "$ROOT/scripts/lib/tuna-proof-session-launch" "$INSTALLED_PACKAGE" "$ROOT" "tuna-gtk-proof-$$" >"$LOG" 2>&1 &
else
    env IBUS_ADDRESS="unix:path=$ARTIFACTS/not-the-private-ibus" \
        "$ROOT/scripts/lib/tuna-proof-session-launch" "$INSTALLED_PACKAGE" "$ROOT" "tuna-gtk-proof-$$" >"$LOG" 2>&1 &
