    glib-compile-schemas --strict "$ARTIFACTS/schemas"
    GSETTINGS_SCHEMA_DIR="$ARTIFACTS/schemas"
    export GSETTINGS_SCHEMA_DIR
fi
gsettings set org.gnome.desktop.a11y.interface reduced-motion 'no-preference'
if ! gsettings range org.gnome.desktop.calendar week-start-day >/dev/null 2>&1; then
    mkdir -p "$ARTIFACTS/schemas"
    cp "$ROOT/tests/settings/gnome51-calendar.gschema.xml" "$ARTIFACTS/schemas/"
    glib-compile-schemas --strict "$ARTIFACTS/schemas"
    GSETTINGS_SCHEMA_DIR="$ARTIFACTS/schemas"
    export GSETTINGS_SCHEMA_DIR
fi
gsettings reset org.gnome.desktop.calendar week-start-day
gsettings reset org.gnome.desktop.calendar show-weekdate
gsettings set org.gnome.settings-daemon.plugins.color night-light-enabled false
# Candidate and thumbnail pixel gates assume GNOME's blue accent; pin it so
# a vendor default (orange on Ubuntu) cannot move the highlight (#566).
# Hosts without the key fall back to libadwaita's built-in blue.
if gsettings range org.gnome.desktop.interface accent-color >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface accent-color 'blue'
fi
# An out-of-process Settings portal would read the runner's own dconf
# database rather than this proof's keyfile; pin blue there as well.
# Ephemeral CI workers only; never fail the proof on it.
env -u GSETTINGS_BACKEND -u XDG_CONFIG_HOME GSETTINGS_BACKEND=dconf \
    gsettings set org.gnome.desktop.interface accent-color 'blue' >/dev/null 2>&1 || true
echo "tuna-gtk-shell-proof: accent setup: keyfile: $(gsettings get org.gnome.desktop.interface accent-color 2>&1) gtk-theme: $(gsettings get org.gnome.desktop.interface gtk-theme 2>&1) host-dconf: $(env -u GSETTINGS_BACKEND -u XDG_CONFIG_HOME GSETTINGS_BACKEND=dconf gsettings get org.gnome.desktop.interface accent-color 2>&1)"
# Quick-settings daemons: stubs on a private "system" bus (#55), a fake
# backlight, and a fake wpctl that records the sink volume.
BACKLIGHT="$ARTIFACTS/backlight/tuna-bl"
mkdir -p "$BACKLIGHT" "$ARTIFACTS/bin"
echo 1000 >"$BACKLIGHT/max_brightness"
echo 500 >"$BACKLIGHT/brightness"
TUNA_BACKLIGHT_ROOT="$ARTIFACTS/backlight"
export TUNA_BACKLIGHT_ROOT
VOLUME_FILE="$ARTIFACTS/volume"
echo 0.80 >"$VOLUME_FILE"
VOLUME_MUTED_FILE="$ARTIFACTS/volume-muted"
MIC_MUTED_FILE="$ARTIFACTS/mic-muted"
echo 0 >"$VOLUME_MUTED_FILE"
echo 0 >"$MIC_MUTED_FILE"
SINK_FILE="$ARTIFACTS/default-sink"
echo 48 >"$SINK_FILE"
# The default source, and an app recording from it while RECORDING_FILE
# exists.
MIC_FILE="$ARTIFACTS/mic-volume"
echo 0.50 >"$MIC_FILE"
RECORDING_FILE="$ARTIFACTS/recording"
cat >"$ARTIFACTS/bin/wpctl" <<WPCTL
#!/bin/sh
mark() { [ "\$(cat "$SINK_FILE")" = "\$1" ] && echo "*" || echo " "; }
muted() { [ "\$(cat "\$1")" = 1 ] && printf ' [MUTED]' || true; }
case "\$1" in
    get-volume)
        case "\$2" in
            *SOURCE*) echo "Volume: \$(cat "$MIC_FILE")\$(muted "$MIC_MUTED_FILE")" ;;
            *) echo "Volume: \$(cat "$VOLUME_FILE")\$(muted "$VOLUME_MUTED_FILE")" ;;
        esac ;;
    set-volume)
        case "\$2" in
            *SOURCE*) echo "\$3" >"$MIC_FILE" ;;
            *) echo "\$3" >"$VOLUME_FILE" ;;
        esac ;;
    set-mute)
        case "\$2" in *SOURCE*) mute_file="$MIC_MUTED_FILE" ;; *) mute_file="$VOLUME_MUTED_FILE" ;; esac
        case "\$3" in toggle) echo "\$((1 - \$(cat "\$mute_file")))" >"\$mute_file" ;; *) echo "\$3" >"\$mute_file" ;; esac ;;
    set-default) echo "\$2" >"$SINK_FILE" ;;
    status)
        printf 'Audio\n ├─ Sinks:\n'
        printf ' │  %s   48. Built-in Audio Analog Stereo    [vol: 0.80]\n' "\$(mark 48)"
        printf ' │  %s   52. Tuna Desktop HDMI Output               [vol: 1.00]\n' "\$(mark 52)"
        printf ' │\n ├─ Sources:\n'
        printf ' │  *   49. Built-in Audio Analog Stereo    [vol: 0.50]\n'
        printf ' │\n └─ Streams:\n'
        if [ -e "$RECORDING_FILE" ]; then
            printf '        70. Voice Recorder\n'
            printf '             71. input_MONO      < Built-in Audio Analog Stereo:capture_FL\t[active]\n'
        fi ;;
    *) ;;
esac
"$PY" "$ROOT/scripts/lib/tuna-audio-fixture.py" "$ARTIFACTS" --event
WPCTL
# Only audio monitoring uses the event fixture. Capture revocation must inspect
# actual PipeWire nodes with the installed one-shot tool, never the endless FIFO.
PW_DUMP_REAL="$(command -v pw-dump || true)"
cat >"$ARTIFACTS/bin/pw-dump" <<PW_DUMP
#!/bin/sh
for arg do
    if [ "\$arg" = --monitor ] || [ "\$arg" = -m ]; then
        exec "$PY" "$ROOT/scripts/lib/tuna-audio-fixture.py" "$ARTIFACTS"
    fi
done
[ -n "$PW_DUMP_REAL" ] || exit 127
exec "$PW_DUMP_REAL" "\$@"
PW_DUMP
cat >"$ARTIFACTS/bin/pw-cli" <<PW_CLI
#!/bin/sh
printf '%s\\n' "\$*" >>"$ARTIFACTS/audio-route-calls"
case "\$*" in
    'set-param 40 Route { index: 2, device: 0, save: true }') echo 2 >"$ARTIFACTS/audio-route" ;;
    'set-param 40 Route { index: 1, device: 0, save: true }') echo 1 >"$ARTIFACTS/audio-route" ;;
    *) exit 1 ;;
esac
"$PY" "$ROOT/scripts/lib/tuna-audio-fixture.py" "$ARTIFACTS" --event
PW_CLI
chmod +x "$ARTIFACTS/bin/wpctl" "$ARTIFACTS/bin/pw-dump" "$ARTIFACTS/bin/pw-cli"
PATH="$ARTIFACTS/bin:$PATH"
export PATH
