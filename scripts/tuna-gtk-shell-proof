cstate '.overview_open and (.overview_app_grid | not)' "picker again" || fail G-OVERVIEW-STATE-KEYS "down did not return to picker"
fkey_tap Super_L ffc4 || fail G-OVERVIEW-STATE-KEYS "Super+F7 tap failed"
cstate '(.overview_open | not)' "session" || fail G-OVERVIEW-STATE-KEYS "down did not return to session"
