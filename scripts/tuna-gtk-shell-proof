# GNOME's window menu on a header bar's right click: Always on Top, then
# Hide; the hidden window still shows in the overview, and picking it
# there brings it back.
pick_alpha() {
    xdotool key Super_L
    cstate '.overview_open and (.previews | length) > 0' "overview" || return 1
    sleep 1
    alpha="$(jq -r '.previews[] | select(.app_id == "tuna-test-alpha") | .rect | "\(.[0] + .[2] / 2) \(.[1] + .[3] / 2)"' "$CSTATE")"
    [ -n "$alpha" ] || return 1
    # shellcheck disable=SC2086
    xdotool mousemove --window "$WID" $alpha click 1
    cstate '(.overview_open | not) and .focused_app_id == "tuna-test-alpha"' "alpha"
}
window_menu() {
    header="$(jq -r '.focused_rect | "\(.[0] + 60) \(.[1] + 20)"' "$CSTATE")"
    # shellcheck disable=SC2086
    xdotool mousemove --window "$WID" $header click 3
    sleep 1.5
}
pick_alpha || fail G-WINDOW-MENU "could not focus Alpha from the overview"
alpha_id="$(jq -r .focused "$CSTATE")"
window_menu
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-window-menu.json" 20 ||
    fail G-WINDOW-MENU "accessibility dump failed"
showing "$ARTIFACTS/a11y-window-menu.json" "Hide" ||
    fail G-WINDOW-MENU "the right click opened no window menu"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-window-menu-press.json" 20 \
    --press "Always on Top" || fail G-WINDOW-MENU "the window menu has no Always on Top"
cstate "any(.above[]; . == $alpha_id)" "above" ||
    fail G-WINDOW-MENU "Always on Top did not keep the window above"
window_menu
scrot "$ARTIFACTS/24d-window-menu.png" >/dev/null
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-window-menu-2.json" 20 \
    --press "Hide" || fail G-WINDOW-MENU "could not press Hide"
cstate "any(.minimized[]; . == $alpha_id) and .focused != $alpha_id" "hidden" ||
    fail G-WINDOW-MENU "Hide did not take the window away"
pick_alpha || fail G-WINDOW-MENU "the hidden window could not be picked from the overview"
cstate "any(.minimized[]; . == $alpha_id) | not" "restored" ||
    fail G-WINDOW-MENU "picking the hidden window did not bring it back"
pass G-WINDOW-MENU "the header-bar menu keeps a window on top, hides it, and the overview brings it back"
# Restore the fixture's stacking state so later pointer-driven tests do
# not hit pinned Alpha through another application's window.
window_menu
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-window-menu-unpin.json" 20 \
    --press "Always on Top" || fail G-WINDOW-MENU "could not restore ordinary stacking"
cstate "any(.above[]; . == $alpha_id) | not" "Alpha unpinned" || fail G-WINDOW-MENU "Alpha stayed above later test windows"

# GNOME's window-manager keys (org.gnome.desktop.wm.keybindings).
sleep 1
xdotool key alt+space
sleep 1.5
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-wm-menu.json" 20 ||
