# GPU clients (#89): with linux-dmabuf advertised, a GTK window on the
# GL renderer maps and paints instead of hanging.
WAYLAND_DISPLAY="$SOCKET_NAME" GSK_RENDERER=gl "$PY" "$ROOT/scripts/lib/tuna-test-window.py" \
    Delta "#c01c28" >"$ARTIFACTS/window-Delta.log" 2>&1 &
cstate '.windows | any(.app_id == "tuna-test-delta")' "gl window" ||
    fail G-GL-WINDOW "a GL-rendered GTK window never mapped"
sleep 2
scrot "$ARTIFACTS/19-gl-window.png" >/dev/null
centre="$(jq -r '.windows[] | select(.app_id == "tuna-test-delta") | .rect | "\(.[0] + .[2] / 2) \(.[1] + .[3] / 3)"' "$CSTATE")"
# shellcheck disable=SC2086
set -- $centre
rgb="$(px "$ARTIFACTS/19-gl-window.png" "${1%.*}" "${2%.*}")"
# shellcheck disable=SC2086
set -- $rgb
if [ "$1" -lt 150 ] || [ "$2" -gt 80 ] || [ "$3" -gt 80 ]; then
    fail G-GL-WINDOW "GL window did not paint its red body (pixel $rgb)"
fi
pass G-GL-WINDOW "a GL-rendered GTK window maps and paints"

# The globals a client finds (P-SY-06, #89): wayland-info against this
# session, compared with GNOME 51's capture. Here, after G-GL-WINDOW,
# the renderer has reported its formats, so linux-dmabuf is advertised.
if command -v wayland-info >/dev/null 2>&1; then
    WAYLAND_DISPLAY="$SOCKET_NAME" wayland-info >"$ARTIFACTS/wayland-info.txt" 2>&1 ||
        fail G-WAYLAND-INFO "wayland-info could not talk to the session"
    "$PY" "$ROOT/scripts/tuna-wayland-info-compare" "$ARTIFACTS/wayland-info.txt" \
        --report "$ARTIFACTS/wayland-info-compare.txt" ||
        fail G-WAYLAND-INFO "globals short of GNOME 51's (see wayland-info-compare.txt)"
    "$PY" "$ROOT/scripts/tuna-wayland-info-compare" "$ARTIFACTS/wayland-info.txt" \
        --reference "$ROOT/tests/protocols/marlin-gnome51-globals.tsv" \
        --report "$ARTIFACTS/wayland-info-marlin-compare.txt" ||
        fail G-WAYLAND-INFO "globals short of native Marlin GNOME 51's recorded expectations"
    pass G-WAYLAND-INFO "headless and native Marlin GNOME 51 comparisons satisfy version floors, with gaps recorded"
elif [ "${TUNA_REQUIRE_WAYLAND_INFO:-0}" = 1 ]; then
    fail G-WAYLAND-INFO "wayland-info is required (TUNA_REQUIRE_WAYLAND_INFO=1) but not installed"
else
    echo "tuna-gtk-shell-proof: G-WAYLAND-INFO skipped (no wayland-info)"
fi

# X11 by default (#59/#219): the shell advertises reserved sockets; the
# first real X11 connection starts the server and maps that queued client.
if command -v Xwayland >/dev/null 2>&1 && command -v xeyes >/dev/null 2>&1; then
    cstate '.x11_display != null' "xwayland" 30 || fail G-X11-APP "XWayland never came up"
    x11_display="$(jq -r '.x11_display' "$CSTATE")"
    before="$(jq '.windows | length' "$CSTATE")"
    xdotool key Super_L
    cstate '.overview_open' "overview" || fail G-X11-APP "overview did not open"
    sleep 1
    xdotool type --delay 40 "tuna x probe"
    sleep 1
    xdotool key Return
    end=$(($(date +%s) + 15))
    until [ -s "$X11_MARKER" ] || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
    [ "$(cat "$X11_MARKER" 2>/dev/null)" = "$x11_display" ] ||
        fail G-X11-APP "launched app saw DISPLAY='$(cat "$X11_MARKER" 2>/dev/null)', not $x11_display"
    cstate "(.windows | length) > $before" "x11 window" 20 ||
        fail G-X11-APP "the X11 app never mapped a window"
    # Like a native app: focused, and placed below the top bar.
    cstate '.focused_app_id == "XEyes"' "x11 focus" ||
        fail G-X11-APP "the X11 window was not focused after launch"
    cstate '.windows[] | select(.app_id == "XEyes") | .rect[1] >= 32' "x11 placement" ||
        fail G-X11-APP "the X11 window was placed under the top bar"
    sleep 1
    scrot "$ARTIFACTS/20-x11-app.png" >/dev/null
    cstate '.x11_ready' "X11 manager ready" || fail G-X11-APP "manager not ready"
    x11_pid="$(pgrep -P "$COMPOSITOR_PID" -x Xwayland)"
    [ "$(printf '%s\n' "$x11_pid" | wc -l)" -eq 1 ] || fail G-X11-DEMAND "expected one owned compatibility process"
    native_ids="$(jq -c '[.windows[] | select(.app_id != "XEyes") | .id] | sort' "$CSTATE")"
    old_xim_pid=""
    if command -v ibus-daemon >/dev/null 2>&1; then
        for _ in $(seq 1 30); do
            old_xim_pid="$(pgrep -P "$COMPOSITOR_PID" -x ibus-x11 || true)"
            [ -n "$old_xim_pid" ] && break
            sleep 0.2
        done
        [ -n "$old_xim_pid" ] || fail G-X11-RESTART "XIM did not start after actual X11 readiness"
    fi
    kill "$x11_pid"
    cstate 'all(.windows[]; .app_id != "XEyes")' "old X11 windows removed" 10 || fail G-X11-RESTART "stale X11 model survived server loss"
    cstate '.x11_ready' "bounded compatibility restart" 15 || fail G-X11-RESTART "server did not restart"
    [ "$(jq -c '[.windows[] | .id] | sort' "$CSTATE")" = "$native_ids" ] || fail G-X11-RESTART "native windows changed across restart"
    restarted_pid="$(pgrep -P "$COMPOSITOR_PID" -x Xwayland)"
    [ "$restarted_pid" != "$x11_pid" ] || fail G-X11-RESTART "old compatibility process remained"
    if [ -n "$old_xim_pid" ]; then
        for _ in $(seq 1 30); do
            new_xim_pid="$(pgrep -P "$COMPOSITOR_PID" -x ibus-x11 || true)"
            [ -n "$new_xim_pid" ] && [ "$new_xim_pid" != "$old_xim_pid" ] && break
            sleep 0.2
        done
        if [ -z "$new_xim_pid" ] || [ "$new_xim_pid" = "$old_xim_pid" ]; then
            fail G-X11-RESTART "XIM helper did not restart for the fresh X11 server"
        fi
        ! kill -0 "$old_xim_pid" 2>/dev/null || fail G-X11-RESTART "old XIM helper survived server loss"
    fi
    env DISPLAY="$x11_display" xeyes >/dev/null 2>&1 &
    cstate '.focused_app_id == "XEyes" and .x11_ready' "reconnected X11 client" 15 || fail G-X11-RESTART "client did not reconnect on the same reserved display"
    pass G-X11-RESTART "server loss removes compatibility windows, preserves native IDs and accepts a new client on the same display"
    pass G-X11-APP "the first X11 app launched from search gets DISPLAY $x11_display and maps"
    # An app without a matching desktop file supplies its window icon.
    x11_window="$(DISPLAY="$x11_display" xdotool search --class XEyes | head -1)"
    DISPLAY="$x11_display" xprop -id "$x11_window" -f _NET_WM_ICON 32c -set _NET_WM_ICON '2,2,4293935280,4280340624,4280340624,4293935280'
    cstate '.windows[] | select(.app_id == "XEyes") | .icon != null' "X11 icon" || fail G-WINDOW-ICONS "X11 icon never reached model"
    x11_icon="$(jq -r '.windows[] | select(.app_id == "XEyes") | .icon' "$CSTATE")"
    [ -s "$x11_icon" ] || fail G-WINDOW-ICONS "X11 icon cache missing"
    cp "$x11_icon" "$ARTIFACTS/x11-window-icon.png"
    # Change the actual mapped X11 client's EWMH role, rather than testing
    # only synthetic snapshot flags. The same live policy feeds GetWindows.
    x11_model_id="$(jq -r '.windows[] | select(.app_id == "XEyes") | .id' "$CSTATE")"
    while read -r x11_kind x11_pickable; do
        DISPLAY="$x11_display" xprop -id "$x11_window" -f _NET_WM_WINDOW_TYPE 32a \
            -set _NET_WM_WINDOW_TYPE "_NET_WM_WINDOW_TYPE_$x11_kind"
        cstate ".windows[] | select(.id == $x11_model_id) | .introspect_eligible == $x11_pickable" \
            "X11 $x11_kind picker eligibility" ||
            fail G-INTROSPECT-TYPES "actual X11 $x11_kind role did not yield $x11_pickable"
        cp "$CSTATE" "$ARTIFACTS/introspect-type-$x11_kind.json"
    done <<EOF
NORMAL true
DIALOG true
UTILITY true
DESKTOP false
DOCK false
COMBO false
DND false
DROPDOWN_MENU false
MENU false
NOTIFICATION false
POPUP_MENU false
SPLASH false
TOOLBAR false
TOOLTIP false
EOF
    DISPLAY="$x11_display" xprop -id "$x11_window" -remove _NET_WM_WINDOW_TYPE
    cstate ".windows[] | select(.id == $x11_model_id) | .introspect_eligible" \
        "X11 absent type is normal" || fail G-INTROSPECT-TYPES "absent type did not restore eligibility"
    cp "$CSTATE" "$ARTIFACTS/introspect-type-absent.json"
    pass G-INTROSPECT-TYPES "actual mapped X11 role changes follow all fourteen EWMH types and restore the absent-type default"
    DISPLAY="$x11_display" "$COMPANIONS/icon-probe" --x11-hints >"$ARTIFACTS/hints-probe.log" 2>&1 &
    HINTS_PID=$!
    cstate '.windows[] | select(.app_id == "TunaHintsProbe") | .icon != null' "WM_HINTS icon" || fail G-WINDOW-ICONS "legacy pixmap icon never reached model"
    hints_icon="$(jq -r '.windows[] | select(.app_id == "TunaHintsProbe") | .icon' "$CSTATE")"
    [ -s "$hints_icon" ] || fail G-WINDOW-ICONS "WM_HINTS icon cache missing"
    cp "$hints_icon" "$ARTIFACTS/wm-hints-window-icon.png"
else
    echo "tuna-gtk-shell-proof: G-X11-APP skipped (no Xwayland or xeyes)"
fi

# Raw Wayland SHM icon: GTK versions on the runner need not implement the new protocol.
WAYLAND_DISPLAY="$SOCKET_NAME" "$COMPANIONS/icon-probe" >"$ARTIFACTS/icon-probe.log" 2>&1 &
ICON_PID=$!
cstate '.windows[] | select(.app_id == "tuna-window-icon-probe") | .icon != null' "Wayland icon" || fail G-WINDOW-ICONS "Wayland icon never reached model"
native_icon="$(jq -r '.windows[] | select(.app_id == "tuna-window-icon-probe") | .icon' "$CSTATE")"
[ -s "$native_icon" ] || fail G-WINDOW-ICONS "Wayland icon cache missing"
cp "$native_icon" "$ARTIFACTS/wayland-window-icon.png"
xdotool key Super_L
cstate '.overview_open' "icon overview" || fail G-WINDOW-ICONS "overview did not open"
sleep 1
scrot "$ARTIFACTS/20a-window-icons-overview.png" >/dev/null
cp "$CSTATE" "$ARTIFACTS/window-icons-state.json"
xdotool key Escape
cstate '.overview_open == false' "icon overview closed" || fail G-WINDOW-ICONS "overview did not close"
xdotool keydown Alt_L key Tab
cstate 'any(.layers[]; .namespace == "tuna-shell-switcher")' "icon switcher" || fail G-WINDOW-ICONS "switcher did not open"
sleep 1
scrot "$ARTIFACTS/20b-window-icons-switcher.png" >/dev/null
"$PY" - "$ARTIFACTS/20a-window-icons-overview.png" "$ARTIFACTS/20b-window-icons-switcher.png" <<'PYICON'
from PIL import Image
import sys
for path in sys.argv[1:]:
    pixels = Image.open(path).convert("RGB").getdata()
    # The native probe has a distinctive magenta quadrant absent from its client.
    magenta = sum(r > 200 and 35 < g < 110 and 120 < b < 220 for r, g, b in pixels)
    if magenta < 16:
        raise SystemExit(path + ": native window icon pixels missing")
PYICON
xdotool keyup Alt_L
kill "$ICON_PID" 2>/dev/null || true
ICON_PID=""
if [ -n "$HINTS_PID" ]; then kill "$HINTS_PID" 2>/dev/null || true; fi
HINTS_PID=""
pass G-WINDOW-ICONS "native SHM and X11 window icons reach PNG cache, overview chrome/dash and switcher"

# GNOME's clock keys reach the panel clock within its 1 s tick.
gsettings set org.gnome.desktop.interface clock-show-seconds true
sleep 2
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-clock.json" 20 ||
    fail G-SETTINGS-CLOCK "accessibility dump failed"
jq -e 'any(.[]; .role == "label" and (.name | test("[0-9]+:[0-9]{2}:[0-9]{2}")))' \
    "$ARTIFACTS/a11y-clock.json" >/dev/null ||
    fail G-SETTINGS-CLOCK "clock-show-seconds did not add seconds to the panel clock"
gsettings set org.gnome.desktop.interface clock-show-seconds false
pass G-SETTINGS-CLOCK "GNOME's clock-show-seconds changes the panel clock"

# CSS inherits GNOME's user font; text scale reaches GTK's Wayland settings.
original_font="$(gsettings get org.gnome.desktop.interface font-name)"
original_scale="$(gsettings get org.gnome.desktop.interface text-scaling-factor)"
gsettings set org.gnome.desktop.interface font-name 'Sans 11'
gsettings set org.gnome.desktop.interface text-scaling-factor 1.0
sleep 1
scrot "$ARTIFACTS/settings-font-before.png" >/dev/null
gsettings set org.gnome.desktop.interface font-name 'Monospace 20'
sleep 1
scrot "$ARTIFACTS/settings-font-after.png" >/dev/null
gsettings set org.gnome.desktop.interface font-name 'Monospace Bold Italic Condensed 20'
sleep 1
scrot "$ARTIFACTS/settings-font-styled.png" >/dev/null
gsettings set org.gnome.desktop.interface font-name 'Sans 11'
gsettings set org.gnome.desktop.interface text-scaling-factor 1.75
sleep 1
scrot "$ARTIFACTS/settings-scale-after.png" >/dev/null
"$PY" - "$ARTIFACTS" <<'PYFONT' || fail G-SETTINGS-FONT "font or text scale did not change the live panel"
from PIL import Image, ImageChops
import sys
from pathlib import Path
root = Path(sys.argv[1])
before = Image.open(root / "settings-font-before.png").convert("RGB").crop((500, 0, 780, 32))
for name in ["settings-font-after.png", "settings-scale-after.png"]:
    after = Image.open(root / name).convert("RGB").crop((500, 0, 780, 32))
    hist = ImageChops.difference(before, after).convert("L").histogram()
    changed = sum(hist[25:]) / (280 * 32)
    assert changed > 0.03, (name, changed)
# Same family and size: this change must come from the selected font's style.
plain = Image.open(root / "settings-font-after.png").convert("RGB").crop((500, 0, 780, 32))
styled = Image.open(root / "settings-font-styled.png").convert("RGB").crop((500, 0, 780, 32))
hist = ImageChops.difference(plain, styled).convert("L").histogram()
changed = sum(hist[25:]) / (280 * 32)
assert changed > 0.01, ("styled font", changed)
print(f"styled font changed {changed:.3%} of panel pixels")
PYFONT
gsettings set org.gnome.desktop.interface font-name "$original_font"
gsettings set org.gnome.desktop.interface text-scaling-factor "$original_scale"
sleep 1
pass G-SETTINGS-FONT "font-name family/size/style and text-scaling-factor change the running panel"

# GNOME's input settings (#60).
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('xkb', 'de')]"
cstate '.keyboard.layouts == ["English (US)", "German"]' "two sources" ||
    fail G-SETTINGS-INPUT "input sources did not become the keymap"
xdotool key super+space
cstate '.keyboard.layout == "German"' "next source" ||
    fail G-SETTINGS-INPUT "Super+Space did not switch to the next input source"
gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 50
cstate '.keyboard.repeat_rate == 20' "repeat" ||
    fail G-SETTINGS-INPUT "repeat-interval 50 ms did not set 20 keys/s"
gsettings set org.gnome.desktop.interface enable-hot-corners false
sleep 1
xdotool mousemove --window "$WID" 1 1
sleep 1
xdotool mousemove --window "$WID" 0 0
sleep 1
if jq -e '.overview_open' "$CSTATE" >/dev/null; then
    fail G-SETTINGS-INPUT "the hot corner opened the overview with enable-hot-corners off"
fi
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
gsettings set org.gnome.desktop.interface enable-hot-corners true
sleep 1
xdotool mousemove --window "$WID" 1 1
cstate '.overview_open' "hot corner enabled" ||
    fail G-HOT-CORNER "enabling GNOME hot corners did not open the actual overview"
cp "$CSTATE" "$ARTIFACTS/hot-corner-enabled.json"
scrot "$ARTIFACTS/hot-corner-enabled.png" >/dev/null
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key Escape
cstate '.overview_open | not' "hot corner dismissed" ||
    fail G-HOT-CORNER "the corner-opened overview did not close"
pass G-HOT-CORNER "live GNOME disable rejects the corner; enable opens the actual overview"

# A genuine GTK fullscreen request blocks accidental corner opening, while
# deliberate Super access remains available and unfullscreen restores it.
corner_requests="$ARTIFACTS/hot-corner-requests.json"
rm -f "$corner_requests" "$corner_requests.ack"
corner_count="$(jq '.windows | length' "$CSTATE")"
WAYLAND_DISPLAY="$SOCKET_NAME" TUNA_TEST_REQUESTS="$corner_requests" "$PY" "$ROOT/scripts/lib/tuna-test-window.py" "Fullscreen Corner Proof" '#804000' >"$ARTIFACTS/hot-corner-fullscreen.log" 2>&1 &
HOT_CORNER_PID=$!
cstate ".windows | length == $((corner_count + 1))" "corner proof mapped" ||
    fail G-HOT-CORNER-FULLSCREEN "genuine GTK proof window did not map"
cstate '([.windows[] | select(.app_id == "tuna-test-fullscreen corner proof")] | length) == 1' "unique actual corner client identity" ||
    fail G-HOT-CORNER-FULLSCREEN "actual corner client identity was not unique"
corner_window_id="$(jq '.windows[] | select(.app_id == "tuna-test-fullscreen corner proof") | .id' "$CSTATE")"
# The toplevel enters the model before its first buffer, in a provisional
# cascade slot; that commit places it. Read the restore rect only once it
# holds still (and no size change is in flight), not the pre-commit slot.
corner_rect_query=".windows[] | select(.id == $corner_window_id) | .rect"
corner_restored_rect=""
corner_end=$(($(date +%s) + 20))
while [ "$(date +%s)" -le "$corner_end" ]; do
    corner_rect_now="$(jq -c "if ((.size_changes.in_flight // []) | any(.window == $corner_window_id)) then null else ($corner_rect_query) end" "$CSTATE" 2>/dev/null || true)"
    if [ -n "$corner_rect_now" ] && [ "$corner_rect_now" != null ] && [ "$corner_rect_now" = "$corner_restored_rect" ]; then
        break
    fi
    corner_restored_rect="$corner_rect_now"
    sleep 0.5
done
if [ -z "$corner_restored_rect" ] || [ "$corner_restored_rect" = null ]; then
    fail G-HOT-CORNER-FULLSCREEN "genuine GTK proof window never settled in place"
fi
cp "$CSTATE" "$ARTIFACTS/hot-corner-client-before-fullscreen.json"
printf '{"generation":1,"request":"fullscreen"}\n' >"$corner_requests"
cstate ".focused_rect == [0, 0, $WIDTH, $HEIGHT]" "corner proof fullscreen" ||
    fail G-HOT-CORNER-FULLSCREEN "actual GTK fullscreen request did not cover the output"
# The client's own fullscreen request runs GNOME's size-change
# transition too (#496).
cstate "(.size_changes.in_flight | length) == 0 and any(.size_changes.history[]; .window == $corner_window_id and .last == [0, 0, $WIDTH, $HEIGHT] and .outcome == \"completed\" and (.samples | length) >= 2)" "fullscreen transition" 10 ||
    fail G-SIZE-CHANGE-ANIM "the GTK fullscreen request did not ease to the output"
xdotool mousemove --window "$WID" 1 1
sleep 1
cstate '.pointer_position == [1, 1] and .pointer_fullscreen_blocked' "fullscreen corner motion delivered" ||
    fail G-HOT-CORNER-FULLSCREEN "actual corner coordinates or fullscreen guard were not observed"
cstate '.overview_open | not' "fullscreen corner blocked" ||
    fail G-HOT-CORNER-FULLSCREEN "the corner opened over the fullscreen window"
cp "$CSTATE" "$ARTIFACTS/hot-corner-fullscreen-blocked.json"
scrot "$ARTIFACTS/hot-corner-fullscreen-blocked.png" >/dev/null
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key super
cstate '.overview_open' "fullscreen deliberate overview" ||
    fail G-HOT-CORNER-FULLSCREEN "fullscreen blocked deliberate Super access"
xdotool key Escape
cstate '.overview_open | not' "fullscreen deliberate overview dismissed" ||
    fail G-HOT-CORNER-FULLSCREEN "fullscreen overview did not close"
# Observe a real corner exit after overview teardown before the one fresh
# entry after unfullscreen.
# Retain actual delivered coordinates, not just xdotool's successful exit.
# Leave the corner after overview teardown before making the one fresh entry.
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
cstate ".pointer_position == [$((WIDTH / 2)), $((HEIGHT / 2))]" "fullscreen corner exit delivered" ||
    fail G-HOT-CORNER-FULLSCREEN "backend did not deliver the requested corner exit"
cp "$CSTATE" "$ARTIFACTS/hot-corner-fullscreen-before-unfullscreen.json"
printf '{"generation":2,"request":"unfullscreen"}\n' >"$corner_requests"
# A null focus during overview teardown is not an unfullscreen completion.
# Observe the original mapped client and its exact saved rectangle with the
# real pointer still at the center, before the one genuine corner entry.
cstate ".focused == $corner_window_id and .focused_rect == $corner_restored_rect and (.windows | any(.id == $corner_window_id and .rect == $corner_restored_rect)) and .pointer_position == [$((WIDTH / 2)), $((HEIGHT / 2))] and (.pointer_fullscreen_blocked | not)" "original corner proof restored at center" ||
    fail G-HOT-CORNER-FULLSCREEN "actual GTK unfullscreen request did not restore geometry"
cp "$CSTATE" "$ARTIFACTS/hot-corner-unfullscreen-before-entry.json"
xdotool mousemove --window "$WID" 1 1
xdotool getmouselocation --shell >"$ARTIFACTS/hot-corner-unfullscreen-host-pointer.txt"
cstate '.pointer_position == [1, 1]' "unfullscreen corner entry delivered" ||
    fail G-HOT-CORNER-FULLSCREEN "backend did not deliver the requested corner entry"
cp "$CSTATE" "$ARTIFACTS/hot-corner-unfullscreen-entry.json"
cstate '.pointer_fullscreen_blocked | not' "unfullscreen corner guard removed" ||
    fail G-HOT-CORNER-FULLSCREEN "actual fullscreen guard remained after restoring geometry"
cstate '.overview_open' "corner restored after fullscreen" ||
    fail G-HOT-CORNER-FULLSCREEN "unfullscreen did not restore corner opening"
xdotool mousemove --window "$WID" $((WIDTH / 2)) $((HEIGHT / 2))
xdotool key Escape
cstate '.overview_open | not' "restored corner overview dismissed" ||
    fail G-HOT-CORNER-FULLSCREEN "restored corner overview did not close"
kill "$HOT_CORNER_PID" 2>/dev/null || true
HOT_CORNER_PID=""
cstate ".windows | length == $corner_count" "corner proof removed" ||
    fail G-HOT-CORNER-FULLSCREEN "corner proof window did not unmap"
pass G-HOT-CORNER-FULLSCREEN "genuine fullscreen blocks corner opening, Super remains available, and unfullscreen restores it"

# Occlusion culling (#503): an opaque fullscreen window hides the windows
# beneath it, so the compositor skips drawing them (frame_cost, published
# per output for the last drawn frame). Unfullscreened, the top window's
# client shadow and rounded corners are translucent, so the window under
# it is drawn again.
occlusion_requests="$ARTIFACTS/occlusion-requests.json"
rm -f "$occlusion_requests" "$occlusion_requests.ack"
occlusion_count="$(jq '.windows | length' "$CSTATE")"
WAYLAND_DISPLAY="$SOCKET_NAME" "$PY" "$ROOT/scripts/lib/tuna-test-window.py" "Occlusion Below" '#204080' >"$ARTIFACTS/occlusion-below.log" 2>&1 &
OCCLUSION_PIDS="$!"
cstate '.windows | any(.app_id == "tuna-test-occlusion below")' "occlusion lower window mapped" ||
    fail G-OCCLUSION-CULL "lower proof window did not map"
below_id="$(jq '.windows[] | select(.app_id == "tuna-test-occlusion below") | .id' "$CSTATE")"
cstate "[.frame_cost[] | .drawn_windows[]] | index($below_id) != null" "lower window drawn" ||
    fail G-OCCLUSION-CULL "frame_cost did not report the visible lower window as drawn"
WAYLAND_DISPLAY="$SOCKET_NAME" TUNA_TEST_REQUESTS="$occlusion_requests" "$PY" "$ROOT/scripts/lib/tuna-test-window.py" "Occlusion Above" '#408020' >"$ARTIFACTS/occlusion-above.log" 2>&1 &
OCCLUSION_PIDS="$OCCLUSION_PIDS $!"
cstate '.windows | any(.app_id == "tuna-test-occlusion above")' "occlusion upper window mapped" ||
    fail G-OCCLUSION-CULL "upper proof window did not map"
above_id="$(jq '.windows[] | select(.app_id == "tuna-test-occlusion above") | .id' "$CSTATE")"
printf '{"generation":1,"request":"fullscreen"}\n' >"$occlusion_requests"
cstate ".focused == $above_id and .focused_rect == [0, 0, $WIDTH, $HEIGHT]" "occlusion upper fullscreen" ||
    fail G-OCCLUSION-CULL "upper proof window did not fullscreen"
# The lower proof window sits wholly under the opaque fullscreen window.
cstate "([.frame_cost[] | .culled_windows[]] | index($below_id) != null) and ([.frame_cost[] | .drawn_windows[]] | index($above_id) != null)" "lower window culled" ||
    fail G-OCCLUSION-CULL "the window under an opaque fullscreen window was still drawn"
cstate ".throttled_windows | index($below_id) != null and index($above_id) == null" "lower window frame callbacks throttled" ||
    fail G-OCCLUSION-CULL "the hidden window kept full-rate frame callbacks"
cp "$CSTATE" "$ARTIFACTS/occlusion-fullscreen.json"
scrot "$ARTIFACTS/occlusion-fullscreen.png" >/dev/null
printf '{"generation":2,"request":"unfullscreen"}\n' >"$occlusion_requests"
cstate ".focused == $above_id and .focused_rect != [0, 0, $WIDTH, $HEIGHT]" "occlusion upper restored" ||
    fail G-OCCLUSION-CULL "upper proof window did not unfullscreen"
cstate "([.frame_cost[] | .drawn_windows[]] | index($below_id) != null) and ([.frame_cost[] | .culled_windows[]] | index($below_id) == null)" "lower window drawn again" ||
    fail G-OCCLUSION-CULL "the lower window stayed culled under a translucent-edged window"
cstate ".throttled_windows | index($below_id) == null" "lower window frame callbacks restored" ||
    fail G-OCCLUSION-CULL "the shown window stayed throttled"
cp "$CSTATE" "$ARTIFACTS/occlusion-restored.json"
# shellcheck disable=SC2086
kill $OCCLUSION_PIDS 2>/dev/null || true
OCCLUSION_PIDS=""
cstate ".windows | length == $occlusion_count" "occlusion proof windows removed" ||
    fail G-OCCLUSION-CULL "occlusion proof windows did not unmap"
pass G-OCCLUSION-CULL "an opaque fullscreen window culls and throttles the windows beneath it; translucent edges do not"
gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 30
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us')]"
cstate '.keyboard.layouts == ["English (US)"]' "one source" ||
    fail G-SETTINGS-INPUT "the keymap did not return to us"
pass G-SETTINGS-INPUT "input sources, Super+Space, key repeat and the hot corner follow GNOME"

# Disabling animations is live and snaps compositor and GTK transitions.
gsettings set org.gnome.desktop.interface enable-animations false
cstate '(.animations_enabled | not)' "animations disabled" ||
    fail G-ANIMATIONS-OFF "enable-animations false did not reach the compositor"
xdotool key Super_L
cstate '.overview_open and .overview_progress == 1' "instant overview" ||
    fail G-ANIMATIONS-OFF "the disabled overview did not jump to its open state"
cp "$CSTATE" "$ARTIFACTS/animations-disabled-open.json"
xdotool key Escape
cstate '(.overview_open | not) and .overview_progress == 0' "instant desktop" ||
    fail G-ANIMATIONS-OFF "the disabled overview did not jump to its closed state"
xdotool key super+shift+t
cstate '.session_mode == "scroll" and .strip_view == .strip_offset' "instant strip" ||
    fail G-ANIMATIONS-OFF "the disabled strip view did not match its target"
xdotool key super+Left
cstate '.strip_view == .strip_offset' "instant focus" ||
    fail G-ANIMATIONS-OFF "the disabled strip view lagged after a focus move"
xdotool key super+shift+t
cstate '.session_mode == "gnome"' "floating" || fail G-ANIMATIONS-OFF "could not restore floating mode"
# The Alt+Tab popup closes without its fade (#501).
fade_mark="$(wc -c <"$LOG")"
xdotool keydown Alt_L key Tab
cstate 'any(.layers[]; .namespace == "tuna-shell-switcher")' "switcher without motion" 5 ||
    { xdotool keyup Alt_L; fail G-ANIMATIONS-OFF "the switcher did not open"; }
sleep 0.3
# Escape cancels, leaving the focus where the later gates expect it.
xdotool key Escape keyup Alt_L
cstate 'all(.layers[]; .namespace != "tuna-shell-switcher")' "switcher closed without motion" 5 ||
    fail G-ANIMATIONS-OFF "the switcher did not close"
tail -c +"$((fade_mark + 1))" "$LOG" | grep -q 'switcher fade popup-out start animated=false' ||
    fail G-ANIMATIONS-OFF "the switcher popup still faded with animations off"
gsettings set org.gnome.desktop.interface enable-animations true
cstate '.animations_enabled' "animations enabled" ||
    fail G-ANIMATIONS-OFF "enable-animations true did not restore live animation"
# Settings' Reduced Motion switch must work even with enable-animations true.
# GNOME 51 keeps fades and drops motion: enable-animations (and Introspect's
# AnimationsEnabled) stays true while the policy turns fade-only.
gsettings set org.gnome.desktop.a11y.interface reduced-motion 'reduce'
cstate '.animations_enabled and .motion_policy == "fade-only"' "reduced motion" ||
    fail G-ANIMATIONS-OFF "Reduced Motion did not reach the compositor as fade-only"
xdotool key Super_L
cstate '.overview_open and .overview_progress == 1' "reduced overview" ||
    fail G-ANIMATIONS-OFF "Reduced Motion overview did not jump to its open state"
cp "$CSTATE" "$ARTIFACTS/reduced-motion-open.json"
xdotool key Escape
cstate '(.overview_open | not) and .overview_progress == 0' "reduced desktop" ||
    fail G-ANIMATIONS-OFF "Reduced Motion overview did not jump to its closed state"
# The Alt+Tab popup's fade-out is a fade: Reduced Motion keeps it.
fade_mark="$(wc -c <"$LOG")"
xdotool keydown Alt_L key Tab
cstate 'any(.layers[]; .namespace == "tuna-shell-switcher")' "reduced switcher" 5 ||
    { xdotool keyup Alt_L; fail G-ANIMATIONS-OFF "the Reduced Motion switcher did not open"; }
sleep 0.3
xdotool key Escape keyup Alt_L
cstate 'all(.layers[]; .namespace != "tuna-shell-switcher")' "reduced switcher closed" 5 ||
    fail G-ANIMATIONS-OFF "the Reduced Motion switcher did not close"
tail -c +"$((fade_mark + 1))" "$LOG" | grep -q 'switcher fade popup-out start animated=true' ||
    fail G-ANIMATIONS-OFF "Reduced Motion dropped the switcher popup's fade"
# The idle shield is a fade: Reduced Motion keeps it (GNOME's screenShield
# uses adjustAnimationTime), while animations off removes it.
gsettings set org.gnome.desktop.screensaver lock-enabled true
gsettings set org.gnome.desktop.screensaver lock-delay 0
gsettings set org.gnome.desktop.session idle-delay 600
cstate '.idle_timeout_ms == 610000' "reduced idle" ||
    fail G-ANIMATIONS-OFF "Reduced Motion dropped the ten-second idle fade from the lock timeout"
[ "$(sed -n '2p' "$XDG_RUNTIME_DIR/tuna-idle-blank")" = 10000 ] ||
    fail G-ANIMATIONS-OFF "Reduced Motion dropped the screen-blank fade"
gsettings set org.gnome.desktop.interface enable-animations false
cstate '(.animations_enabled | not) and .motion_policy == "off" and .idle_timeout_ms == 600000' "animations off idle" ||
    fail G-ANIMATIONS-OFF "enable-animations false left the idle fade in the lock timeout"
[ "$(sed -n '2p' "$XDG_RUNTIME_DIR/tuna-idle-blank")" = 0 ] ||
    fail G-ANIMATIONS-OFF "enable-animations false left the screen-blank fade enabled"
gsettings reset org.gnome.desktop.a11y.interface reduced-motion
cstate '(.animations_enabled | not) and .motion_policy == "off"' "explicit animation disable" ||
    fail G-ANIMATIONS-OFF "resetting Reduced Motion overrode enable-animations false"
gsettings set org.gnome.desktop.interface enable-animations true
cstate '.animations_enabled and .motion_policy == "full" and .idle_timeout_ms == 610000' "motion restored" ||
    fail G-ANIMATIONS-OFF "resetting both preferences did not restore motion and idle fade"
pass G-ANIMATIONS-OFF "enable-animations and GNOME 51 Reduced Motion are live; off snaps everything, fade-only snaps overview/strip motion and keeps the idle fade"
python3 "$ROOT/scripts/lib/tuna-introspect-motion-client.py" "$CSTATE" \
    "$ARTIFACTS/introspect-motion.json" >"$ARTIFACTS/introspect-motion.log" 2>&1 || \
    fail G-INTROSPECT-MOTION "live D-Bus motion properties/signals disagree with actual compositor policy"
pass G-INTROSPECT-MOTION "GNOME clients receive four enable-animations changes; Reduced Motion leaves AnimationsEnabled true as in GNOME 51; property and compositor agree"

# The proof-driven animation clock samples the overview transition at
# exact delays: 250 ms each way, so 125 ms is exactly half.
anim_clock() {
    printf '%s\n' "$1" >"$TUNA_ANIMATION_CLOCK.tmp"
    mv "$TUNA_ANIMATION_CLOCK.tmp" "$TUNA_ANIMATION_CLOCK"
}
anim_clock 0
cstate '.animation_clock_manual and .motion_policy == "full" and (.overview_open | not) and .overview_progress == 0' "frozen clock" ||
    fail G-ANIMATION-CLOCK "the clock file did not freeze compositor animation time"
xdotool key Super_L
cstate '.overview_open and .overview_progress == 0' "frozen overview" ||
    fail G-ANIMATION-CLOCK "the overview moved while animation time was frozen"
anim_clock 125
# Opening eases out-sine (#499): sin(pi/4) of the way at half time.
cstate '(.overview_progress - 0.7071067811865476 | if . < 0 then -. else . end) < 1e-9' "overview at 125 ms" ||
    fail G-ANIMATION-CLOCK "the overview was not sin(pi/4) open 125 ms in (EASE_OUT_SINE)"
cp "$CSTATE" "$ARTIFACTS/animation-clock-125ms.json"
anim_clock 250
cstate '.overview_progress == 1' "overview at 250 ms" ||
    fail G-ANIMATION-CLOCK "the overview had not settled 250 ms in"
xdotool key Escape
cstate '(.overview_open | not) and .overview_progress == 1' "frozen close" ||
    fail G-ANIMATION-CLOCK "the closing overview moved while animation time was frozen"
anim_clock 375
# Closing eases out-quad: three quarters of the way gone at half time.
cstate '(.overview_progress - 0.25 | if . < 0 then -. else . end) < 1e-9' "close at 125 ms" ||
    fail G-ANIMATION-CLOCK "the closing overview was not a quarter open 125 ms in (EASE_OUT_QUAD)"
anim_clock 500
cstate '.overview_progress == 0' "close at 250 ms" ||
    fail G-ANIMATION-CLOCK "the closing overview had not settled 250 ms in"
rm -f "$TUNA_ANIMATION_CLOCK"
cstate '.animation_clock_manual | not' "real clock" ||
    fail G-ANIMATION-CLOCK "removing the clock file did not resume real time"
pass G-ANIMATION-CLOCK "a proof-driven clock freezes compositor animation time and samples the overview's out-sine opening and out-quad closing at exact 125/250 ms delays"

# GNOME settings (#63): the idle lock follows idle-delay and
# lock-enabled as they change.
gsettings set org.gnome.desktop.session idle-delay 600
cstate '.idle_timeout_ms == 610000' "idle 600" ||
    fail G-SETTINGS-IDLE "idle-delay 600 did not reach the compositor"
gsettings set org.gnome.desktop.screensaver lock-enabled false
cstate '.idle_timeout_ms > 1e18' "lock off" ||
    fail G-SETTINGS-IDLE "lock-enabled false did not turn the idle lock off"
gsettings set org.gnome.desktop.screensaver lock-enabled true
gsettings set org.gnome.desktop.session idle-delay 300
cstate '.idle_timeout_ms == 310000' "idle 300" ||
    fail G-SETTINGS-IDLE "the idle lock did not follow back to 300 s"
pass G-SETTINGS-IDLE "GNOME's idle-delay and lock-enabled set the idle lock live"

# org.gnome.Shell for gnome-settings-daemon: a caller outside GNOME's
# allowlist is refused; the media-keys daemon's grab takes the key away
# from apps, fires AcceleratorActivated, and its ShowOSD shows the OSD.
if gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
    --method org.gnome.Shell.GrabAccelerator "<Super>F9" 1 0 >/dev/null 2>&1; then
    fail G-ACCEL "a caller outside the allowlist grabbed an accelerator"
fi
ACCEL_MARKER="$ARTIFACTS/accel-marker"
rm -f "$ACCEL_MARKER"
"$PY" "$ROOT/scripts/lib/tuna-accel-probe.py" "$ACCEL_MARKER" >"$ARTIFACTS/accel.log" 2>&1 &
ACCEL_PID=$!
end=$(($(date +%s) + 10))
until grep -q grabbed "$ACCEL_MARKER" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "grabbed [1-9]" "$ACCEL_MARKER" 2>/dev/null ||
    fail G-ACCEL "the media-keys stand-in could not grab XF86AudioPlay"
xdotool key XF86AudioPlay
end=$(($(date +%s) + 5))
until grep -q activated "$ACCEL_MARKER" 2>/dev/null || [ "$(date +%s)" -gt "$end" ]; do sleep 0.3; done
grep -q "activated" "$ACCEL_MARKER" ||
    fail G-ACCEL "pressing the grabbed key fired no AcceleratorActivated"
sleep 0.5
scrot "$ARTIFACTS/24b-osd.png" >/dev/null
pass G-ACCEL "gnome-settings-daemon's grab fires on its key and its ShowOSD shows the OSD"

# Native media actions work even without gsd-media-keys. These assert
# the actual asynchronous backend mutations, including GNOME's unmute rule.
echo 0.40 >"$VOLUME_FILE"
echo 0 >"$VOLUME_MUTED_FILE"
media_volume() {
    expected=$1
    for _ in $(seq 1 30); do
        [ "$(cat "$VOLUME_FILE")" = "$expected" ] && return 0
        sleep 0.1
    done
    return 1
}
xdotool key XF86AudioRaiseVolume
media_volume 0.4600 || fail G-MEDIA-VOLUME "volume up did not apply the 6% step"
xdotool key XF86AudioLowerVolume
media_volume 0.4000 || fail G-MEDIA-VOLUME "volume down did not apply the 6% step"
xdotool key shift+XF86AudioRaiseVolume
media_volume 0.4200 || fail G-MEDIA-VOLUME "precise volume up did not use 2%"
xdotool key XF86AudioMute
for _ in $(seq 1 30); do [ "$(cat "$VOLUME_MUTED_FILE")" = 1 ] && break; sleep 0.1; done
[ "$(cat "$VOLUME_MUTED_FILE")" = 1 ] || fail G-MEDIA-VOLUME "volume mute did not mute"
xdotool key XF86AudioRaiseVolume
for _ in $(seq 1 30); do [ "$(cat "$VOLUME_MUTED_FILE")" = 0 ] && break; sleep 0.1; done
if [ "$(cat "$VOLUME_MUTED_FILE")" != 0 ] || [ "$(cat "$VOLUME_FILE")" != 0.4200 ]; then
    fail G-MEDIA-VOLUME "unmuting increased or lost the existing volume"
fi
xdotool key XF86AudioMicMute
for _ in $(seq 1 30); do [ "$(cat "$MIC_MUTED_FILE")" = 1 ] && break; sleep 0.1; done
[ "$(cat "$MIC_MUTED_FILE")" = 1 ] || fail G-MEDIA-VOLUME "microphone mute did not mute"
xdotool key XF86AudioMicMute
for _ in $(seq 1 30); do [ "$(cat "$MIC_MUTED_FILE")" = 0 ] && break; sleep 0.1; done
[ "$(cat "$MIC_MUTED_FILE")" = 0 ] || fail G-MEDIA-VOLUME "microphone unmute did not unmute"
# This headed fixture uses a wpctl stand-in; the native VM separately checks
# actual HDA/PipeWire channel volume. Same live shell and real hardware keys.
SOUND_SCHEMA=org.gnome.desktop.sound
gsettings set "$SOUND_SCHEMA" allow-volume-above-100-percent false
sleep 0.3
echo 0.98 >"$VOLUME_FILE"
xdotool key XF86AudioRaiseVolume
media_volume 1.0000 || fail G-MEDIA-AMPLIFICATION "disabled amplification did not cap at 100%"
gsettings set "$SOUND_SCHEMA" allow-volume-above-100-percent true
sleep 0.3
echo 0.98 >"$VOLUME_FILE"
xdotool key XF86AudioRaiseVolume
media_volume 1.0400 || fail G-MEDIA-AMPLIFICATION "live enabled amplification did not cross 100%"
echo 1.50 >"$VOLUME_FILE"
xdotool key XF86AudioRaiseVolume
media_volume 1.5252 || fail G-MEDIA-AMPLIFICATION "amplified key did not obey GNOME's +11dB limit"
gsettings set "$SOUND_SCHEMA" allow-volume-above-100-percent false
sleep 0.3
echo 0.98 >"$VOLUME_FILE"
xdotool key XF86AudioRaiseVolume
media_volume 1.0000 || fail G-MEDIA-AMPLIFICATION "live disable did not restore the ordinary limit"
gsettings reset "$SOUND_SCHEMA" allow-volume-above-100-percent
echo 0.4200 >"$VOLUME_FILE"
pass G-MEDIA-AMPLIFICATION "same shell follows live opt-in and reset; native VM qualifies real PipeWire separately"

# Live rebinding and an empty static array must take effect without restart.
MEDIA_SCHEMA=org.gnome.settings-daemon.plugins.media-keys
gsettings set "$MEDIA_SCHEMA" volume-up-static '[]'
sleep 0.7
xdotool key XF86AudioRaiseVolume
sleep 0.7
[ "$(cat "$VOLUME_FILE")" = 0.4200 ] || fail G-MEDIA-VOLUME "an explicitly disabled hardware key still changed volume"
gsettings set "$MEDIA_SCHEMA" volume-up "['F8']"
gsettings set "$MEDIA_SCHEMA" volume-step 10
sleep 0.7
fkey_tap "" ffc5 || fail G-MEDIA-VOLUME "F8 tap failed"
media_volume 0.5200 || fail G-MEDIA-VOLUME "live rebound volume key ignored the configured step"
gsettings reset "$MEDIA_SCHEMA" volume-up
gsettings reset "$MEDIA_SCHEMA" volume-up-static
gsettings reset "$MEDIA_SCHEMA" volume-step
sleep 0.7
echo 0.4200 >"$VOLUME_FILE"
scrot "$ARTIFACTS/media-volume-osd.png" >/dev/null
pass G-MEDIA-VOLUME "native volume/precise/mute/microphone keys mutate PipeWire state; unmute preserves the level"

