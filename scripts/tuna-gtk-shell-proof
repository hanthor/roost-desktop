"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-group-cleared.json" 20 \
    --press "Clear" || fail G-NOTIFY-GROUP "could not press Clear"
