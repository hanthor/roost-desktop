# App stages: three libadwaita windows (scripts/lib/tuna-test-window.py).
cstate() {
    end=$(($(date +%s) + ${3:-20}))
    while [ "$(date +%s)" -le "$end" ]; do
        [ -s "$CSTATE" ] && jq -e "$1" "$CSTATE" >/dev/null 2>&1 && return 0
        sleep 0.3
    done
    echo "tuna-gtk-shell-proof: compositor state was:" >&2
    cat "$CSTATE" >&2 2>/dev/null || true
    return 1
}
# Reserving an X11 display must not launch a compatibility process. The
# panel/calendar are already real native Wayland clients at this point.
if command -v Xwayland >/dev/null 2>&1; then
    cstate '.x11_display != null and (.x11_ready | not)' "reserved X11 sockets" 10 ||
        fail G-X11-DEMAND "native startup did not reserve an idle display"
    if pgrep -P "$COMPOSITOR_PID" -x Xwayland >/dev/null; then
        fail G-X11-DEMAND "native startup spawned XWayland"
    fi
    if command -v ibus-daemon >/dev/null 2>&1; then
        pgrep -P "$COMPOSITOR_PID" -f '(^|/)tuna-ibus-bridge( |$)' >/dev/null ||
            fail G-X11-DEMAND "native IBus bridge is not running"
        if pgrep -P "$COMPOSITOR_PID" -x ibus-x11 >/dev/null; then
            fail G-X11-DEMAND "XIM connected before an application needed X11"
        fi
    fi
    pass G-X11-DEMAND "native GTK and IBus startup advertise sockets without an XWayland or XIM process"
fi
SOCKET_NAME="$(sed -n 's/.*nested session on \([^ ]*\) .*/\1/p' "$LOG" | head -1)"
# One at a time, so window ids (and with them GNOME's running-app order
# in the dash) follow Alpha, Beta, Gamma.
n=0
for spec in Alpha:#3584e4 Beta:#2ec27e Gamma:#e66100; do
    WAYLAND_DISPLAY="$SOCKET_NAME" "$PY" "$ROOT/scripts/lib/tuna-test-window.py" \
        "${spec%%:*}" "${spec#*:}" >"$ARTIFACTS/window-${spec%%:*}.log" 2>&1 &
    n=$((n + 1))
    cstate "(.windows | length) == $n" "window $n" ||
        fail G-WINDOWS "${spec%%:*} never mapped"
done
cstate '(.windows | length) == 3' "three app windows" ||
    fail G-WINDOWS "three libadwaita windows never mapped"
pass G-WINDOWS "three libadwaita windows mapped"
sleep 2
scrot "$ARTIFACTS/04-windows.png" >/dev/null

