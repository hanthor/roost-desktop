import json, sys
nodes = json.load(open(sys.argv[1]))
start = next(i for i, n in enumerate(nodes) if n['name'] == 'Wired (enp1s0)' and n['role'] != 'label')
end = next((i for i in range(start + 1, len(nodes)) if nodes[i]['depth'] <= nodes[start]['depth']), len(nodes))
assert any(n['showing'] and n['name'] == 'Disconnect Wired' for n in nodes[start + 1:end])
WIREDTREE
scrot "$ARTIFACTS/15g-wired-submenus.png" >/dev/null
