sleep 0.1
for step in $(seq 1 6); do
    xdotool mousemove --window "$WID" $((folder_source_x + step * 10)) "$folder_source_y"
    sleep 0.05
done
sleep 0.25
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-folder-page-peek.json" 20 || fail G-GRID-DRAG-CANCEL "folder preview dump failed"
scrot "$ARTIFACTS/11h-folder-page-peek.png" >/dev/null
showing "$ARTIFACTS/a11y-folder-page-peek.json" "Next page preview" || fail G-GRID-DRAG-CANCEL "real local folder drag has no neighboring-page hint"
xdotool key Escape
xdotool mouseup 1
sleep 1
# Escape may cancel DnD or close the overview; either route must release
