# GNOME's switch-group: with a second Alpha window, Alt+Above_Tab shows
# Alpha's windows as thumbnails (drawn by the compositor) and moves to
# the other one; W closes the focused thumbnail's window.
WAYLAND_DISPLAY="$SOCKET_NAME" "$PY" "$ROOT/scripts/lib/tuna-test-window.py" \
    Alpha "#1c71d8" >"$ARTIFACTS/window-Alpha2.log" 2>&1 &
cstate '[.windows[] | select(.app_id == "tuna-test-alpha")] | length == 2' "second alpha" ||
    fail G-SWITCHER-GROUP "a second Alpha window never mapped"
cstate '.focused_app_id == "tuna-test-alpha"' "alpha focused" ||
    fail G-SWITCHER-GROUP "the new Alpha window did not take the focus"
sleep 1
new_alpha="$(jq -r .focused "$CSTATE")"
# Rebound window-only and direct-cycle keys (#216), with two windows
# from Alpha proving that window switching does not group by app.
grab_mark="$(wc -c <"$LOG")"
gsettings set org.gnome.desktop.wm.keybindings cycle-group "['<Super>F1']"
gsettings set org.gnome.desktop.wm.keybindings cycle-group-backward "['<Super><Shift>F1']"
gsettings set org.gnome.desktop.wm.keybindings cycle-windows "['<Super>F2']"
gsettings set org.gnome.desktop.wm.keybindings cycle-windows-backward "['<Super><Shift>F2']"
gsettings set org.gnome.desktop.wm.keybindings switch-windows "['<Control>k']"
gsettings set org.gnome.desktop.wm.keybindings switch-windows-backward "['<Control><Shift>k']"
# The session bus can deliver the settings change notifications late; wait
# for the shell's actual re-grab line before sending the rebound keys.
grab_end=$(($(date +%s) + 30))
while [ "$(date +%s)" -le "$grab_end" ]; do
    if [ "$(wc -c <"$LOG")" -gt "$grab_mark" ] && tail -c +"$((grab_mark + 1))" "$LOG" | grep -q "tuna-shell-gtk: keybindings:"; then
        break
    fi
    sleep 0.3
done
if tail -c +"$((grab_mark + 1))" "$LOG" | grep -q "tuna-shell-gtk: keybindings:"; then
    # Five rapid rebinds land as a burst of re-grabs; the first new line
    # does not mean the final Super+F1 binding is live yet. Wait for two
    # consecutive quiet seconds before sending keys.
    settled=0
    previous=$(grep -c 'tuna-shell-gtk: keybindings:' "$LOG")
    for _ in $(seq 1 30); do
        sleep 1
        current=$(grep -c 'tuna-shell-gtk: keybindings:' "$LOG")
        if [ "$current" = "$previous" ]; then settled=$((settled + 1)); else settled=0; fi
        previous=$current
        [ "$settled" -ge 2 ] && break
    done
else
    fail G-CYCLE-KEYS "shell never re-grabbed the rebound cycle keys"
fi
# A stray held modifier from the harness (an XTEST press the server
# delivered twice, or a release it swallowed) poisons one chord press
# with extra mods and never clears itself. Releasing every modifier
# once is a no-op when nothing is held and resyncs the server,
# compositor and seat when something is; a retry that fires stays
# greppable so a systematic miss cannot hide behind it.
xdotool keyup Alt_L Super_L Shift_L Control_L
sleep 0.5
# The nested journey's IBus session can leave this X server with a
# merged keymap in which function keys resolve behind an Alt level;
# xdotool then taps Alt around every F-key press on its own. Show
# what the server offers for the chord's keysyms, then restore the
# plain layout so they resolve at their base level. Temporary until
# the stray-Alt fault is understood.
"$PY" "$ROOT/scripts/lib/xkeysym-levels.py" "$DISPLAY" ffbe ffbf ffeb ffe9 >&2 || true
setxkbmap -display "$DISPLAY" us >&2 || true
"$PY" "$ROOT/scripts/lib/xkeysym-levels.py" "$DISPLAY" ffbe ffbf >&2 || true
# Temporary: IBus-daemon X-grabs its hotkey triggers, and a trigger
# inherited (via shared dconf) from the nested journey that matches
# Super+F1 would let the daemon fiddle modifiers around every replay.
{
    echo "tuna-gtk-shell-proof: IBus general settings:"
    for key in triggers trigger next-engine previous-engine preload-engines engines-order use-system-keyboard-layout embed-preedit-text; do
        printf 'ibus.%s = ' "$key"
        gsettings get org.freedesktop.ibus.general "$key" 2>&1 || echo "(unreadable)"
    done
    echo "tuna-gtk-shell-proof: IBus engine now: $(ibus engine 2>&1 || echo '(no engine)')"
} >&2 || true
# Temporary harness introspection for the stray-Alt fault: how this
# server maps the chord's keycodes (an F1 that resolves behind an Alt
# level would explain a harness-side Alt tap around every press).
{
    echo "tuna-gtk-shell-proof: X keymap for Alt/Super/F1:"
    if command -v xmodmap >/dev/null 2>&1; then
        xmodmap -pke -display "$DISPLAY" 2>&1 | grep -E "keycode +(64|66|67|133|134) " || echo "no matching keycode lines"
    else
        echo "xmodmap not installed"
    fi
    if command -v setxkbmap >/dev/null 2>&1; then
        setxkbmap -query -display "$DISPLAY" 2>&1 || true
    else
        echo "setxkbmap not installed"
    fi
    echo "tuna-gtk-shell-proof: xdotool: $(xdotool --version 2>&1 | head -1)"
    if command -v xlsclients >/dev/null 2>&1; then
        echo "tuna-gtk-shell-proof: X clients on $DISPLAY:"
        xlsclients -display "$DISPLAY" 2>&1 || true
    else
        echo "xlsclients not installed"
    fi
    if command -v xset >/dev/null 2>&1; then
        echo "tuna-gtk-shell-proof: X bell/repeat/AccessX state:"
        xset q -display "$DISPLAY" 2>&1 | grep -vE "^ *(Bell|Pointer|Screen|Font|DPMS|auto repeat|LED)" || true
    else
        echo "xset not installed"
    fi
} >&2
# Tap a function key by raw keycode while holding $1 (space-separated
# modifier keysyms, possibly empty). $2 is the F-key keysym hex
# (F1 = ffbe ... F10 = ffc7). `xdotool key F8` taps Alt around the
# press on this server's keymap (see cycle_chord), so a bare or
# Super-chorded F-key binding never matches. Every F-key chord after
# this point goes through here instead.
fkey_tap() {
    # shellcheck disable=SC2086 # intentional word splitting of the modifier list
    for _fmod in $1; do xdotool keydown "$_fmod"; done
    [ -z "$1" ] || sleep 0.3
    "$PY" "$ROOT/scripts/lib/xkeycode-tap.py" "$DISPLAY" "$2" >&2 || return 1
    # shellcheck disable=SC2086 # intentional word splitting of the modifier list
    for _fmod in $1; do xdotool keyup "$_fmod"; done
}
# $1: space-separated modifiers to hold (e.g. "Super_L" or
# "Super_L Shift_L"), $2: keysym hex of the key to tap (e.g. ffbe
# for F1), $3: cstate jq, $4: cstate label, $5: failure message.
cycle_chord() {
    # Hold the modifiers across separate xdotool invocations, like
    # the working Alt+Tab stage does, instead of one rapid `key`
    # chord: a harness-side modifier tap reacting to the opener
    # press settles before the cycling key arrives, so it cannot
    # ride along as extra mods.
    # The cycling key itself goes by raw keycode through XTEST, never
    # `xdotool key`: xdotool resolves F-keys behind an Alt level on
    # this server's keymap and taps Alt around every press, which the
    # compositor rejects as a near-miss (mods=72) instead of cycling.
    # shellcheck disable=SC2086 # intentional word splitting of the modifier list
    for _cmod in $1; do xdotool keydown "$_cmod"; done
    sleep 0.3
    "$PY" "$ROOT/scripts/lib/xkeycode-tap.py" "$DISPLAY" "$2" >&2 || fail G-CYCLE-KEYS "key tap for $2 failed"
    # shellcheck disable=SC2086 # intentional word splitting of the modifier list
    for _cmod in $1; do xdotool keyup "$_cmod"; done
    if cstate "$3" "$4" 10; then return 0; fi
    echo "tuna-gtk-shell-proof: G-CYCLE-KEYS resync: '$1+$2' missed, releasing all modifiers and pressing again" >&2
    xdotool keyup Alt_L Super_L Shift_L Control_L
    sleep 0.5
    # shellcheck disable=SC2086 # intentional word splitting of the modifier list
    for _cmod in $1; do xdotool keydown "$_cmod"; done
    sleep 0.3
    "$PY" "$ROOT/scripts/lib/xkeycode-tap.py" "$DISPLAY" "$2" >&2 || fail G-CYCLE-KEYS "key tap for $2 failed"
    # shellcheck disable=SC2086 # intentional word splitting of the modifier list
    for _cmod in $1; do xdotool keyup "$_cmod"; done
    cstate "$3" "$4" || fail G-CYCLE-KEYS "$5"
}
original="$(jq -r .focused "$CSTATE")"
cycle_chord "Super_L" "ffbe" ".focused != $original and .focused_app_id == \"tuna-test-alpha\"" "cycle group" "cycle-group did not move within Alpha"
cycle_chord "Super_L Shift_L" "ffbe" ".focused == $original" "cycle group backward" "cycle-group-backward did not return"
cycle_chord "Super_L" "ffbf" ".focused != $original" "cycle windows" "cycle-windows did not move"
cycled="$(jq -r .focused "$CSTATE")"
cycle_chord "Super_L Shift_L" "ffbf" ".focused != $cycled" "cycle windows backward" "cycle-windows-backward did not move"
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-cycle-keys.json" 20 || fail G-CYCLE-KEYS "a11y dump failed"
showing "$ARTIFACTS/a11y-cycle-keys.json" "Switch Windows" && fail G-CYCLE-KEYS "direct cycling opened a popup"
pass G-CYCLE-KEYS "bound forward/backward window and app-group cycling activate immediately without a popup"
original="$(jq -r .focused "$CSTATE")"
xdotool keydown Control_L key k
cstate '.switcher_thumbnails == 4' "all window thumbnails" || fail G-WINDOW-SWITCHER "window switcher did not draw each window's thumbnail"
sleep 0.7
"$PY" "$ROOT/scripts/lib/tuna-a11y-dump.py" tuna-shell-gtk "$ARTIFACTS/a11y-window-switcher.json" 20 || fail G-WINDOW-SWITCHER "a11y dump failed"
[ "$(jq '[.[] | select(.showing and .role == "list item" and .name == "Alpha: Alpha")] | length' "$ARTIFACTS/a11y-window-switcher.json")" = 2 ] || fail G-WINDOW-SWITCHER "Alpha windows were grouped instead of two entries"
xdotool keyup Control_L
cstate ".focused != $original" "window switcher commit" || fail G-WINDOW-SWITCHER "releasing Control did not activate the window"
original="$(jq -r .focused "$CSTATE")"
xdotool keydown Control_L keydown Shift_L key k
sleep 0.5
xdotool keyup Shift_L keyup Control_L
cstate ".focused != $original" "window switcher backward" || fail G-WINDOW-SWITCHER "backward window switching did not move"
pass G-WINDOW-SWITCHER "bound switch-windows forward/backward show separate window entries and commit on modifier release"
for key in cycle-group cycle-group-backward cycle-windows cycle-windows-backward switch-windows switch-windows-backward; do
    gsettings reset org.gnome.desktop.wm.keybindings "$key"
done
sleep 1
# Restore the precise new Alpha fixture before the original group-switch
# journey. Closing the original Alpha instead changes the legitimate dash
# creation order and invalidates its existing accessibility golden.
xdotool key Super_L
cstate ".overview_open and any(.previews[]; .id == $new_alpha)" "new Alpha preview" ||
    fail G-SWITCHER-GROUP "the overview has no preview of the second Alpha fixture"
sleep 1
read -r ax ay <<EOF2
$(jq -r ".previews[] | select(.id == $new_alpha) | .rect | \"\(.[0] + .[2] / 2 | floor) \(.[1] + .[3] / 2 | floor)\"" "$CSTATE")
EOF2
xdotool mousemove --window "$WID" "$ax" "$ay" click 1
cstate ".overview_open == false and .focused == $new_alpha" "new Alpha restored" ||
    fail G-SWITCHER-GROUP "could not restore the second Alpha fixture through its overview preview"
second="$new_alpha"
fade_mark="$(wc -c <"$LOG")"
xdotool keydown Alt_L key grave
cstate '.switcher_thumbnails == 2' "thumbnails" 5 ||
    { xdotool keyup Alt_L; fail G-SWITCHER-GROUP "Alt+Above_Tab drew no window thumbnails"; }
sleep 0.5
scrot "$ARTIFACTS/08c-switcher-thumbnails.png" >/dev/null
# GNOME keeps the strip on screen under the app row (#508): the
# thumbnails' surface, shadow room included, lies inside the output.
cstate "any(.layers[]; .namespace == \"tuna-shell-switcher-thumbnails\" and .rect[0] >= 0 and .rect[1] >= 0 and .rect[0] + .rect[2] <= $WIDTH and .rect[1] + .rect[3] <= $HEIGHT)" \
    "thumbnails on screen" 5 ||
    { xdotool keyup Alt_L; fail G-SWITCHER-GROUP "the thumbnail strip runs off the output"; }
xdotool keyup Alt_L
cstate ".focused != $second and .focused_app_id == \"tuna-test-alpha\" and .switcher_thumbnails == 0" \
    "other alpha" || fail G-SWITCHER-GROUP "Alt+Above_Tab did not move to Alpha's other window"
# GNOME's fades (#501): the thumbnails ease in and the popup eases out
# over 100 ms, each starting animated and settling.
cstate 'all(.layers[]; .namespace != "tuna-shell-switcher")' "switcher faded out" 5 ||
    fail G-SWITCHER-FADE "the switcher never finished fading out"
fades="$(tail -c +"$((fade_mark + 1))" "$LOG" | grep 'tuna-shell-gtk: switcher fade' || true)"
for fade in thumbnails-in popup-out; do
    printf '%s\n' "$fades" | grep -q "fade $fade start animated=true" ||
        fail G-SWITCHER-FADE "the $fade fade did not start animated"
    printf '%s\n' "$fades" | grep -q "fade $fade settled" ||
        fail G-SWITCHER-FADE "the $fade fade did not settle"
done
pass G-SWITCHER-FADE "the switcher's thumbnails fade in and its popup fades out, animated and settled"
sleep 0.5
xdotool keydown Alt_L key grave
sleep 1
xdotool key w
sleep 0.5
xdotool keyup Alt_L
cstate '[.windows[] | select(.app_id == "tuna-test-alpha")] | length == 1' "closed" ||
    fail G-SWITCHER-GROUP "W did not close the focused thumbnail's window"
pass G-SWITCHER-GROUP "Alt+Above_Tab shows an app's windows as thumbnails, steps to one, and W closes it"
sleep 1
scrot "$ARTIFACTS/08-dragged.png" >/dev/null

