#!/usr/bin/env python3
"""roost-baseline — capture the GNOME 51 reference journeys (#64).

Boots the TunaOS Marlin GNOME live ISO (GNOME 51; autologin into the
session) in QEMU/KVM at 1280x800, drives the same journey stages the Roost
proof harnesses run, and records a frame per stage, a short clip per
stage, and a manifest naming the exact ISO (sha256, Last-Modified). The
bundle is the evidence every parity-ledger row compares against.

Usage:
  scripts/roost-baseline [--out DIR] [--iso PATH] [--keep-iso]

Needs: qemu-system-x86_64 (KVM strongly recommended), curl, ffmpeg.
Input goes in through QMP (keys via send-key, pointer via a USB tablet);
frames come out through QMP screendump. Nothing runs inside the guest.
"""
import argparse
import hashlib
import json
import os
import shutil
import socket
import subprocess
import sys
import time

ISO_URL = "https://download.tunaos.org/live-isos/marlin-gnome-latest.iso"
SUM_URL = ISO_URL + ".sha256"
WIDTH, HEIGHT = 1280, 800
BOOT_TIMEOUT = 900


def log(msg):
    print(f"roost-baseline: {msg}", flush=True)


class Qmp:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        for _ in range(100):
            try:
                self.sock.connect(path)
                break
            except OSError:
                time.sleep(0.2)
        self.file = self.sock.makefile("rw")
        self._read()  # greeting
        self.cmd("qmp_capabilities")

    def _read(self):
        while True:
            msg = json.loads(self.file.readline())
            if "event" not in msg:
                return msg

    def cmd(self, name, **args):
        self.file.write(json.dumps({"execute": name, "arguments": args}) + "\n")
        self.file.flush()
        reply = self._read()
        if "error" in reply:
            raise RuntimeError(f"{name}: {reply['error']}")
        return reply.get("return")

    def keys(self, *names, hold_ms=80):
        """Press a chord: e.g. keys('meta_l') or keys('meta_l', 'pgdn')."""
        self.cmd("send-key", keys=[{"type": "qcode", "data": n} for n in names],
                 **{"hold-time": hold_ms})
        time.sleep(0.15)

    def type_text(self, text):
        for ch in text:
            if ch == " ":
                self.keys("spc")
            else:
                self.keys(ch.lower())

    def click(self, x, y, button="left"):
        ax, ay = int(x * 32767 / WIDTH), int(y * 32767 / HEIGHT)
        self.cmd("input-send-event", events=[
            {"type": "abs", "data": {"axis": "x", "value": ax}},
            {"type": "abs", "data": {"axis": "y", "value": ay}}])
        time.sleep(0.1)
        for down in (True, False):
            self.cmd("input-send-event", events=[
                {"type": "btn", "data": {"down": down, "button": button}}])
            time.sleep(0.08)

    def frame(self, path):
        self.cmd("screendump", filename=path, format="png")
        for _ in range(50):
            if os.path.exists(path) and os.path.getsize(path) > 0:
                return path
            time.sleep(0.1)
        return path


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 22), b""):
            h.update(chunk)
    return h.hexdigest()


def fetch_iso(dest):
    # curl, not urllib: the download host rejects urllib's user agent.
    log(f"downloading {ISO_URL}")
    head = subprocess.run(["curl", "-fsIL", ISO_URL], capture_output=True, text=True,
                          check=True).stdout
    last_modified = next((line.split(":", 1)[1].strip() for line in head.splitlines()
                          if line.lower().startswith("last-modified:")), None)
    subprocess.run(["curl", "-fL", "--retry", "5", "-o", dest, ISO_URL], check=True)
    want = subprocess.run(["curl", "-fsL", SUM_URL], capture_output=True, text=True,
                          check=True).stdout.split()[0]
    got = sha256(dest)
    if got != want:
        sys.exit(f"roost-baseline: checksum mismatch: {got} != {want}")
    return got, last_modified


def frame_bytes(qmp, scratch):
    path = os.path.join(scratch, "probe.png")
    if os.path.exists(path):
        os.remove(path)
    qmp.frame(path)
    with open(path, "rb") as fh:
        return fh.read()


def wait_for_desktop(qmp, scratch, out):
    """Ready = the screen stopped changing for 20 s after at least 90 s,
    and is not near-uniform (a black or splash screen compresses tiny)."""
    start, last, stable_since = time.time(), None, None
    n = 0
    while time.time() - start < BOOT_TIMEOUT:
        data = frame_bytes(qmp, scratch)
        n += 1
        if n % 6 == 0:
            with open(os.path.join(out, f"boot-{n:03d}.png"), "wb") as fh:
                fh.write(data)
        if data == last and len(data) > 30000:
            stable_since = stable_since or time.time()
            if time.time() - start > 90 and time.time() - stable_since > 20:
                return time.time() - start
        else:
            stable_since = None
        last = data
        time.sleep(5)
    sys.exit("roost-baseline: desktop never settled")


def record(qmp, out, scratch, name, action, seconds=3.0, fps=5):
    """Run `action`, capturing frames for a clip, then the stage still."""
    clip_dir = os.path.join(scratch, name)
    os.makedirs(clip_dir, exist_ok=True)
    frames = []
    action()
    end = time.time() + seconds
    i = 0
    while time.time() < end:
        p = os.path.join(clip_dir, f"{i:04d}.png")
        qmp.frame(p)
        frames.append(p)
        i += 1
        time.sleep(1 / fps)
    still = os.path.join(out, f"{name}.png")
    qmp.frame(still)
    if shutil.which("ffmpeg") and frames:
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-framerate", str(fps),
                        "-i", os.path.join(clip_dir, "%04d.png"), "-pix_fmt", "yuv420p",
                        "-vf", "pad=ceil(iw/2)*2:ceil(ih/2)*2",
                        os.path.join(out, f"{name}.mp4")], check=False)
    log(f"stage {name}")
    return {"stage": name, "still": f"{name}.png", "clip": f"{name}.mp4", "at": time.time()}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default="baseline-artifacts")
    ap.add_argument("--iso")
    ap.add_argument("--keep-iso", action="store_true")
    a = ap.parse_args()
    out = os.path.abspath(a.out)
    os.makedirs(out, exist_ok=True)
    scratch = os.path.join(out, ".scratch")
    os.makedirs(scratch, exist_ok=True)

    iso = a.iso or os.path.join(scratch, "marlin-gnome.iso")
    if a.iso:
        iso_sum, last_modified = sha256(iso), None
    else:
        iso_sum, last_modified = fetch_iso(iso)

    kvm = os.access("/dev/kvm", os.R_OK | os.W_OK)
    qmp_path = os.path.join(scratch, "qmp.sock")
    qemu = ["qemu-system-x86_64", "-m", "6144", "-smp", "2",
            "-cdrom", iso, "-boot", "d",
            "-device", f"virtio-vga,xres={WIDTH},yres={HEIGHT}",
            "-device", "qemu-xhci", "-device", "usb-tablet", "-device", "usb-kbd",
            "-display", "none", "-serial", f"file:{os.path.join(out, 'serial.log')}",
            "-qmp", f"unix:{qmp_path},server=on,wait=off",
            "-nic", "user,model=virtio-net-pci"]
    if kvm:
        qemu[1:1] = ["-enable-kvm", "-cpu", "host"]
    log(f"booting (kvm={kvm})")
    vm = subprocess.Popen(qemu)
    stages = []
    try:
        qmp = Qmp(qmp_path)
        boot_s = wait_for_desktop(qmp, scratch, out)
        log(f"desktop settled after {boot_s:.0f}s")
        # Close anything the live session auto-starts (welcome or
        # installer) so the baseline frame is the bare desktop.
        for _ in range(2):
            qmp.keys("esc")
        time.sleep(3)
        nothing = lambda: None  # noqa: E731
        stages.append(record(qmp, out, scratch, "B-BASE", nothing, 2))
        stages.append(record(qmp, out, scratch, "B-OV-OPEN", lambda: qmp.keys("meta_l")))
        stages.append(record(qmp, out, scratch, "B-OV-SEARCH", lambda: qmp.type_text("settings")))
        stages.append(record(qmp, out, scratch, "B-OV-LAUNCH", lambda: qmp.keys("ret"), 6))
        stages.append(record(qmp, out, scratch, "B-TILE-LEFT", lambda: qmp.keys("meta_l", "left")))
        stages.append(record(qmp, out, scratch, "B-MAXIMIZE", lambda: qmp.keys("meta_l", "up")))
        stages.append(record(qmp, out, scratch, "B-SW-STEP",
                             lambda: qmp.keys("alt", "tab", hold_ms=1500)))
        stages.append(record(qmp, out, scratch, "B-WS-NEXT",
                             lambda: qmp.keys("meta_l", "pgdn")))
        stages.append(record(qmp, out, scratch, "B-WS-PREV",
                             lambda: qmp.keys("meta_l", "pgup")))
        stages.append(record(qmp, out, scratch, "B-OV-ESC",
                             lambda: (qmp.keys("meta_l"), time.sleep(1), qmp.keys("esc"))))
        stages.append(record(qmp, out, scratch, "B-QS-OPEN",
                             lambda: qmp.click(WIDTH - 40, 12)))
        stages.append(record(qmp, out, scratch, "B-QS-CLOSE", lambda: qmp.keys("esc")))
        stages.append(record(qmp, out, scratch, "B-CAL-OPEN",
                             lambda: qmp.click(WIDTH // 2, 12)))
        stages.append(record(qmp, out, scratch, "B-CAL-CLOSE", lambda: qmp.keys("esc")))
        stages.append(record(qmp, out, scratch, "B-LOCK", lambda: qmp.keys("meta_l", "l"), 6))
        qmp.cmd("quit")
    finally:
        try:
            vm.wait(timeout=30)
        except subprocess.TimeoutExpired:
            vm.kill()
    qemu_version = subprocess.run(["qemu-system-x86_64", "--version"], capture_output=True,
                                  text=True).stdout.splitlines()[0]
    manifest = {
        "baseline": "GNOME 51",
        "image": "TunaOS Marlin GNOME live ISO",
        "iso_url": ISO_URL,
        "iso_sha256": iso_sum,
        "iso_last_modified": last_modified,
        "resolution": f"{WIDTH}x{HEIGHT}",
        "kvm": kvm,
        "qemu": qemu_version,
        "captured_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "stages": stages,
    }
    with open(os.path.join(out, "manifest.json"), "w") as fh:
        json.dump(manifest, fh, indent=2)
    if not a.keep_iso and not a.iso:
        os.remove(iso)
    shutil.rmtree(scratch, ignore_errors=True)
    missing = [s["still"] for s in stages if not os.path.exists(os.path.join(out, s["still"]))]
    if missing:
        sys.exit(f"roost-baseline: missing stills {missing}")
    log(f"OK: {len(stages)} stages in {out}")


if __name__ == "__main__":
    main()
