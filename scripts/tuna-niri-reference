#!/bin/sh
# Capture the distro niri binary nested at 1280x800 with the GTK proof windows.
# Usage: tuna-niri-reference [--out DIR]
set -eu
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
OUT="$ROOT/target/niri-reference"
while [ $# -gt 0 ]; do
    case "$1" in --out) OUT="$2"; shift 2;; --help|-h) sed -n '2,3p' "$0"; exit 0;; *) echo "unknown argument: $1" >&2; exit 1;; esac
done
mkdir -p "$OUT"
OUT="$(cd "$OUT" && pwd)"
# Refuse persistent capture state instead of accidentally comparing an old frame.
[ ! -e "$OUT/01-strip-rest.png" ] || { echo "use a fresh output directory" >&2; exit 1; }
podman build -q -t localhost/tuna-niri-reference "$ROOT/tests/niri-reference" >/dev/null
podman run --rm --pull=never -v "$ROOT/tests/niri-reference:/nref:ro,Z" -v "$ROOT/scripts/lib:/lib:ro,Z" -v "$OUT:/out:Z" localhost/tuna-niri-reference dbus-run-session -- /nref/run.sh >"$OUT/capture.log" 2>&1
printf 'niri reference frames: %s\n' "$OUT"
