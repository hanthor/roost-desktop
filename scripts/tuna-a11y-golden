#!/usr/bin/env python3
"""Golden accessibility trees for the GTK shell (#71).

Usage:
  scripts/tuna-a11y-golden check ARTIFACTS   compare dumps with tests/a11y/
  scripts/tuna-a11y-golden update ARTIFACTS  rewrite tests/a11y/ from dumps

Each golden is the shell's showing, named accessible nodes at one proof
stage, one "role: name" line each, in tree order. Plain labels are left
out: they repeat their control's name or carry live values (the clock,
calendar days). What remains is what a screen-reader user can reach and
press, so dropping or renaming a control fails the check.

Names that change with the date are normalized so the goldens hold on
any day: calendar day buttons ("01".."31") read "#", and the today
button ("Thursday October 1 2026") reads "<date>".
"""
import json
import os
import re
import sys

STAGES = {
    "panel": "a11y-panel.json",
    "calendar": "a11y-calendar.json",
    "quick-settings": "a11y-qs.json",
    "overview": "a11y-overview.json",
}
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GOLDEN = os.path.join(ROOT, "tests", "a11y")


DAY = re.compile(r"^\d{1,2}$")
DATE = re.compile(r"^(Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday) "
                  r"[A-Z][a-z]+ \d{1,2} \d{4}$")


def stable(name):
    if DAY.match(name):
        return "#"
    if DATE.match(name):
        return "<date>"
    return name


def normalize(path):
    with open(path, encoding="utf-8") as fh:
        nodes = json.load(fh)
    return [f"{n['role']}: {stable(n['name'])}" for n in nodes
            if n.get("showing") and n.get("name") and n.get("role") != "label"]


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in ("check", "update"):
        print(__doc__, file=sys.stderr)
        return 2
    mode, artifacts = sys.argv[1], sys.argv[2]
    failed = False
    for stage, dump in STAGES.items():
        got = normalize(os.path.join(artifacts, dump))
        golden = os.path.join(GOLDEN, f"{stage}.txt")
        if mode == "update":
            with open(golden, "w", encoding="utf-8") as fh:
                fh.write("\n".join(got) + "\n")
            print(f"tuna-a11y-golden: wrote {golden}")
            continue
        with open(golden, encoding="utf-8") as fh:
            want = fh.read().splitlines()
        if got != want:
            failed = True
            print(f"tuna-a11y-golden: {stage} differs from tests/a11y/{stage}.txt", file=sys.stderr)
            for line in want:
                if line not in got:
                    print(f"  missing: {line}", file=sys.stderr)
            for line in got:
                if line not in want:
                    print(f"  new:     {line}", file=sys.stderr)
            if sorted(got) == sorted(want):
                print("  (same nodes, different order)", file=sys.stderr)
    if failed:
        print("tuna-a11y-golden: run 'scripts/tuna-a11y-golden update DIR' if the change is intended",
              file=sys.stderr)
        return 1
    if mode == "check":
        print(f"tuna-a11y-golden: {len(STAGES)} trees match")
    return 0


if __name__ == "__main__":
    sys.exit(main())
