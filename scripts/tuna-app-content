#!/bin/sh
# tuna-app-content — real app client inside the nested session, for CI.
#
# Usage:
#   scripts/tuna-app-content [--display :98] [--artifacts DIR] [--socket NAME]
#
# Starts a private Xvfb (unless DISPLAY already works), builds and runs
# the nested compositor with its supervised shell, then launches headed
# Chromium via Playwright as a Wayland client of the nested session and
# captures our compositor showing the app, then Super+Left tiles it
# and captures the tiled frame. Exits nonzero on any failure (dead
# process, panic in logs, missing/identical screenshots, no
# app-content pixels, or no tile-left layout in the log). PNGs plus
# logs land in the artifacts dir.
#
# Chromium runs DISPLAY-less with --ozone-platform=wayland, so a mapped
# window proves the ozone path through our xdg-shell, shm scanout, and
# the data-device global toolkit clients require. The playwright venv
# lives outside the artifacts dir to keep the upload small. After the
# tiled frame, Alt+F4 politely closes Chromium (its exit, unprompted
# by any kill, proves the xdg_toplevel close path on a real client).
set -eu

unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
DISPLAY_ARG=""
ARTIFACTS="$ROOT/app-content-artifacts"
SOCKET="tuna-app-content-$$"
WIDTH=1280
HEIGHT=800
# Distinctive page background the pixel assert counts (sampled grid).
GREEN_MIN=10000

usage() {
    sed -n '2,20p' "$0"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --display) DISPLAY_ARG="$2"; shift 2 ;;
        --artifacts) ARTIFACTS="$2"; shift 2 ;;
        --socket) SOCKET="$2"; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) echo "tuna-app-content: unknown argument $1" >&2; usage >&2; exit 1 ;;
    esac
done

mkdir -p "$ARTIFACTS"
LOG="$ARTIFACTS/nested.log"
OWNED_XVFB=""
COMPOSITOR_PID=""
CHROMIUM_PID=""

cleanup() {
    if [ -n "$CHROMIUM_PID" ] && kill -0 "$CHROMIUM_PID" 2>/dev/null; then
        kill "$CHROMIUM_PID" 2>/dev/null || true
        wait "$CHROMIUM_PID" 2>/dev/null || true
    fi
    if [ -n "$COMPOSITOR_PID" ] && kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
        kill "$COMPOSITOR_PID" 2>/dev/null || true
        wait "$COMPOSITOR_PID" 2>/dev/null || true
    fi
    if [ -n "$OWNED_XVFB" ]; then
        kill "$OWNED_XVFB" 2>/dev/null || true
        wait "$OWNED_XVFB" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

display_works() {
    xdotool getdisplaygeometry >/dev/null 2>&1
}

if [ -n "$DISPLAY_ARG" ]; then
    DISPLAY="$DISPLAY_ARG"
    export DISPLAY
fi
if ! display_works; then
    DISPLAY=":98"
    export DISPLAY
    echo "tuna-app-content: starting Xvfb on $DISPLAY"
    Xvfb "$DISPLAY" -screen 0 "${WIDTH}x${HEIGHT}x24" >"$ARTIFACTS/xvfb.log" 2>&1 &
    OWNED_XVFB=$!
    for _ in $(seq 1 30); do
        display_works && break
        sleep 1
    done
    if ! display_works; then
        echo "tuna-app-content: Xvfb never answered on $DISPLAY" >&2
        exit 1
    fi
fi

echo "tuna-app-content: display $DISPLAY geometry $(xdotool getdisplaygeometry)"
echo "tuna-app-content: building"
cargo build --quiet --manifest-path "$ROOT/Cargo.toml" \
    -p tuna-compositor -p tuna-shell-host

echo "tuna-app-content: starting compositor on socket $SOCKET"
"$ROOT/target/debug/tuna-compositor" --socket "$SOCKET" \
    --shell-bin "$ROOT/target/debug/tuna-shell-host" \
    >"$LOG" 2>&1 &
COMPOSITOR_PID=$!

echo "tuna-app-content: waiting for the nested window"
WID=""
for _ in $(seq 1 60); do
    if ! kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
        echo "tuna-app-content: compositor died during startup" >&2
        tail -30 "$LOG" >&2 || true
        exit 1
    fi
    WID="$(xdotool search --name Smithay 2>/dev/null | head -1 || true)"
    if [ -n "$WID" ]; then
        break
    fi
    sleep 1
done
if [ -z "$WID" ]; then
    echo "tuna-app-content: no Smithay window found" >&2
    tail -30 "$LOG" >&2 || true
    exit 1
fi
echo "tuna-app-content: window $WID"
xdotool windowfocus --sync "$WID"
sleep 3

scrot "$ARTIFACTS/01-baseline.png" >/dev/null
echo "tuna-app-content: shot 01-baseline.png"

# Playwright plus Chromium, in a throwaway venv outside the artifacts
# dir. --with-deps pulls the browser system libraries via apt.
PW_ENV="${RUNNER_TEMP:-/tmp}/tuna-pw-env-$$"
python3 -m venv "$PW_ENV"
"$PW_ENV/bin/pip" install --quiet playwright pillow
"$PW_ENV/bin/python" -m playwright install --with-deps chromium

READY="$ARTIFACTS/chromium-ready"
rm -f "$READY"
cat >"$ARTIFACTS/chromium_app.py" <<'PYEOF'
import os, sys, time
from playwright.sync_api import sync_playwright

artifacts = sys.argv[1]
url = ("data:text/html,<html><body style='margin:0;background:%2300c853'>"
       "<h1 style='color:white;font-size:64px'>Tuna-APP-CONTENT</h1></body></html>")

os.environ.pop("DISPLAY", None)
with sync_playwright() as p:
    browser = p.chromium.launch(
        headless=False,
        args=["--ozone-platform=wayland",
              "--disable-gpu",
              "--no-sandbox",
              "--disable-dev-shm-usage",
              "--window-size=900,600"],
    )
    page = browser.new_page(viewport={"width": 900, "height": 600})
    page.goto(url)
    page.wait_for_timeout(5000)
    open(os.path.join(artifacts, "chromium-ready"), "w").write("ready")
    # Idle until the harness closes the window (Alt+F4 polite close).
    # `is_connected()` alone never flips without traffic, so each
    # iteration does a real round-trip: once the browser is gone the
    # call raises (or the flag drops) and the script exits on its own.
    # close() is best-effort once the browser is already gone.
    for _ in range(90):
        try:
            page.wait_for_timeout(1000)
        except Exception:
            break
        if not browser.is_connected():
            break
    try:
        browser.close()
    except Exception:
        pass
PYEOF
WAYLAND_DISPLAY="$SOCKET" \
    "$PW_ENV/bin/python" "$ARTIFACTS/chromium_app.py" "$ARTIFACTS" \
    >"$ARTIFACTS/chromium.log" 2>&1 &
CHROMIUM_PID=$!

for _ in $(seq 1 60); do
    [ -f "$READY" ] && break
    if ! kill -0 "$CHROMIUM_PID" 2>/dev/null; then
        echo "tuna-app-content: chromium exited before ready" >&2
        tail -30 "$ARTIFACTS/chromium.log" >&2 || true
        exit 1
    fi
    sleep 2
done
if [ ! -f "$READY" ]; then
    echo "tuna-app-content: chromium never signalled ready" >&2
    tail -30 "$ARTIFACTS/chromium.log" >&2 || true
    exit 1
fi
sleep 2
scrot "$ARTIFACTS/02-app.png" >/dev/null
echo "tuna-app-content: shot 02-app.png"

# Super+Left tiles the focused Chromium into the left half; the shot
# must differ from the floating frame and the layout line lands in
# the nested log (asserted below).
xdotool key Super_L+Left
sleep 2
scrot "$ARTIFACTS/03-tiled.png" >/dev/null
echo "tuna-app-content: shot 03-tiled.png"

# Alt+F4 asks Chromium to close politely; it must exit on its own —
# no kill, no DONE file. A lingering process means the chord or the
# close request regressed, and the run fails here instead of hanging
# on wait (the EXIT trap still cleans up).
# Chromium can drop a chord that lands while it is still settling from
# the tile resize; the chord is resent twice. Each send is only a
# request: the process must still exit on its own.
xdotool key Alt_L+F4
CLOSED=""
for i in $(seq 1 30); do
    if ! kill -0 "$CHROMIUM_PID" 2>/dev/null; then
        CLOSED=1
        break
    fi
    case "$i" in 5|15) xdotool key Alt_L+F4 ;; esac
    sleep 2
done
if [ -z "$CLOSED" ]; then
    echo "tuna-app-content: chromium ignored Alt+F4 polite close" >&2
    tail -30 "$LOG" >&2 || true
    exit 1
fi
wait "$CHROMIUM_PID" 2>/dev/null || true
CHROMIUM_PID=""
echo "tuna-app-content: chromium exited on polite close"

echo "tuna-app-content: asserting"
if ! kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
    echo "tuna-app-content: compositor died mid-run" >&2
    tail -30 "$LOG" >&2 || true
    exit 1
fi
if grep -q "panicked" "$LOG"; then
    echo "tuna-app-content: panic in nested log" >&2
    grep "panicked" "$LOG" >&2
    exit 1
fi
for shot_file in 01-baseline 02-app 03-tiled; do
    path="$ARTIFACTS/$shot_file.png"
    if [ ! -s "$path" ]; then
        echo "tuna-app-content: missing screenshot $path" >&2
        exit 1
    fi
done
if cmp -s "$ARTIFACTS/01-baseline.png" "$ARTIFACTS/02-app.png"; then
    echo "tuna-app-content: app shot identical to baseline (no app window visible)" >&2
    exit 1
fi
if cmp -s "$ARTIFACTS/02-app.png" "$ARTIFACTS/03-tiled.png"; then
    echo "tuna-app-content: tiled shot identical to floating (Super+Left did nothing visible)" >&2
    exit 1
fi
if ! grep -q "Tiled(Left)" "$LOG"; then
    echo "tuna-app-content: no tile-left layout in nested log" >&2
    tail -30 "$LOG" >&2 || true
    exit 1
fi
if ! grep -q "close requested" "$LOG"; then
    echo "tuna-app-content: no polite close in nested log" >&2
    tail -30 "$LOG" >&2 || true
    exit 1
fi
if GREEN_MIN_ENV="$GREEN_MIN" "$PW_ENV/bin/python" - "$ARTIFACTS/02-app.png" <<'PYEOF'
import os, sys
from PIL import Image
green_min = int(os.environ["GREEN_MIN_ENV"])
im = Image.open(sys.argv[1]).convert("RGB")
px = im.load()
w, h = im.size
green = sum(1 for x in range(0, w, 4) for y in range(0, h, 4)
            if (p := px[x, y])[1] > 150 and p[1] > p[0] + 60 and p[1] > p[2] + 60)
print(f"tuna-app-content: green pixels {green} (min {green_min})")
sys.exit(0 if green >= green_min else 1)
PYEOF
then
    :
else
    echo "tuna-app-content: app-content pixels below threshold" >&2
    exit 1
fi

echo "tuna-app-content: OK, artifacts in $ARTIFACTS"
