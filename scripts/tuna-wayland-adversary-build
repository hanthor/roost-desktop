#!/usr/bin/env bash
set -euo pipefail
if [[ $# != 1 ]]; then
    echo 'usage: tuna-wayland-adversary-build OUTPUT_DIRECTORY' >&2
    exit 2
fi
script_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
protocol_root=$(pkg-config --variable=pkgdatadir wayland-protocols)
mkdir -p -- "$1"
output_root=$(cd -- "$1" && pwd)
wayland-scanner client-header "$protocol_root/stable/xdg-shell/xdg-shell.xml" "$output_root/xdg-shell-client-protocol.h"
wayland-scanner private-code "$protocol_root/stable/xdg-shell/xdg-shell.xml" "$output_root/xdg-shell-protocol.c"
read -r -a compile_flags <<< "$(pkg-config --cflags wayland-client)"
read -r -a link_flags <<< "$(pkg-config --libs wayland-client)"
cc -std=c11 -O2 -Wall -Wextra -Werror "${compile_flags[@]}" -I "$output_root" \
    "$script_root/lib/tuna-wayland-adversary.c" "$output_root/xdg-shell-protocol.c" \
    "${link_flags[@]}" -o "$output_root/tuna-wayland-adversary"
