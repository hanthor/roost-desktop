#!/bin/sh
# check-release-package — verify a Roost .deb built by scripts/roost-release.
#
# Usage:
#   scripts/check-release-package <package.deb>
#
# Asserts the session binaries and login-screen entry are present and
# executable, and that the package metadata version matches the binaries'
# reported version.
set -eu

unset CDPATH

if [ "$#" -ne 1 ]; then
    echo "Usage: scripts/check-release-package <package.deb>" >&2
    exit 1
fi

PKG="$1"
fail() {
    echo "check-release-package: $1" >&2
    exit 1
}

CONTENTS="$(dpkg-deb -c "$PKG" 2>/dev/null)"
for path in \
    usr/bin/roost-compositor \
    usr/bin/roost-session \
    usr/bin/roost-shell-gtk \
    usr/bin/roost-shell-host \
    usr/bin/roost-ibus-bridge \
    usr/bin/roost-greeter \
    usr/share/wayland-sessions/roost.desktop \
    usr/lib/systemd/user/roost-session.target \
    etc/pam.d/roost-lock; do
    printf '%s' "$CONTENTS" | grep -q "$path" || fail "missing $path"
done

printf '%s' "$CONTENTS" | grep "usr/bin/roost-" | grep -q "^-rwx" \
    || fail "session binaries are not executable"

VERSION="$(dpkg-deb -f "$PKG" Version)"
[ -n "$VERSION" ] || fail "empty Version field"

DIR="$(mktemp -d)"
trap 'rm -rf "$DIR"' EXIT INT TERM
dpkg-deb -x "$PKG" "$DIR"
for path in usr/share/wayland-sessions/roost.desktop usr/lib/systemd/user/roost-session.target etc/pam.d/roost-lock; do
    [ -f "$DIR/$path" ] && [ ! -L "$DIR/$path" ] || fail "invalid required file $path"
done
for bin in roost-compositor roost-session roost-shell-gtk roost-shell-host roost-ibus-bridge roost-greeter; do
    [ -f "$DIR/usr/bin/$bin" ] && [ ! -L "$DIR/usr/bin/$bin" ] && [ -x "$DIR/usr/bin/$bin" ] || fail "invalid executable $bin"
    (ulimit -f 8; timeout 10 "$DIR/usr/bin/$bin" --version) >"$DIR/version-output" || fail "$bin version command failed"
    printf '%s\n' "$bin $VERSION" >"$DIR/version-expected"
    cmp -s "$DIR/version-output" "$DIR/version-expected" || fail "$bin version line differs from package"
    ldd "$DIR/usr/bin/$bin" >"$DIR/ldd.txt" || fail "$bin ELF loader check failed"
    if grep -q 'not found' "$DIR/ldd.txt"; then fail "$bin missing ELF library"; fi
done

DEPENDS="$(dpkg-deb -f "$PKG" Depends)"
for required in 'libgtk4-layer-shell0 (>= 1.1)' 'libgtk-4-1 (>= 4.12)' 'libadwaita-1-0 (>= 1.0)' 'libpam0g' 'gsettings-desktop-schemas'; do
    printf '%s\n' "$DEPENDS" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -Fxq "$required" || fail "missing runtime floor $required"
done
[ "$(cat "$DIR/DEBIAN/conffiles" 2>/dev/null || dpkg-deb --ctrl-tarfile "$PKG" | tar -xOf - ./conffiles)" = /etc/pam.d/roost-lock ] || fail "PAM conffile missing"

# Login entry must parse: run the validator when present, allowing only
# the DesktopNames session-file convention (GNOME/KDE/Sway session
# entries ship it and display managers read it; the base-spec validator
# flags it).
if command -v desktop-file-validate >/dev/null 2>&1; then
    DESKTOP_ERRORS="$(desktop-file-validate "$DIR/usr/share/wayland-sessions/roost.desktop" 2>&1 || true)"
    DESKTOP_ERRORS="$(printf '%s' "$DESKTOP_ERRORS" | grep -v 'key "DesktopNames"' || true)"
    [ -z "$DESKTOP_ERRORS" ] || fail "roost.desktop invalid: $DESKTOP_ERRORS"
fi

echo "check-release-package: $PKG OK (version $VERSION)"
