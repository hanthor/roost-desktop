#!/bin/sh
# roost-docs-shots — curated docs screenshots, regenerated from proof harnesses.
#
# Usage:
#   scripts/roost-docs-shots collect <journey-dir> <app-dir> <scroll-dir> [--dest DIR]
#   scripts/roost-docs-shots regen [--dest DIR] [--display :N]
#
# `collect` copies the curated frame set out of harness artifact
# directories (the same ones CI uploads) under stable names; CI uploads
# the result as the `docs-shots` artifact. `regen` re-runs all three
# harnesses locally first. Both fail when any source frame is missing,
# so a set is never stale or partial. The committed docs/shots set was
# removed (#506); the docs use docs/walkthrough.md instead. Without
# --dest, frames go to target/docs-shots.
set -eu

unset CDPATH
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
DEST="$ROOT/target/docs-shots"

usage() {
    sed -n '2,14p' "$0"
}

# dest src — copy one frame or fail loudly.
pick() {
    if [ ! -f "$2" ]; then
        echo "roost-docs-shots: missing source frame $2" >&2
        exit 1
    fi
    cp "$2" "$DEST/$1"
    echo "roost-docs-shots: $1 <= $2"
}

collect() {
    if [ "$#" -lt 3 ]; then
        echo "roost-docs-shots: collect needs 3 artifact dirs" >&2
        usage >&2
        exit 1
    fi
    JOURNEY="$1"; APP="$2"; SCROLL="$3"
    mkdir -p "$DEST"
    pick desktop-baseline.png "$JOURNEY/01-baseline.png"
    pick overview.png "$JOURNEY/02-overview.png"
    pick search.png "$JOURNEY/03-search.png"
    pick app-window.png "$APP/02-app.png"
    pick tiled-window.png "$APP/03-tiled.png"
    pick scroll-strip.png "$SCROLL/02-strip.png"
    pick scroll-wheel.png "$SCROLL/04-wheel.png"
}

regen() {
    TMP_BASE="${RUNNER_TEMP:-/tmp}/roost-docs-regen-$$"
    rm -rf "$TMP_BASE"
    mkdir -p "$TMP_BASE"
    # shellcheck disable=SC2064
    trap "rm -rf '$TMP_BASE'" EXIT INT TERM
    "$ROOT/scripts/roost-journey" "$@" --artifacts "$TMP_BASE/journey"
    "$ROOT/scripts/roost-app-content" "$@" --artifacts "$TMP_BASE/app"
    "$ROOT/scripts/roost-scroll-proof" "$@" --artifacts "$TMP_BASE/scroll"
    collect "$TMP_BASE/journey" "$TMP_BASE/app" "$TMP_BASE/scroll"
    trap - EXIT INT TERM
    rm -rf "$TMP_BASE"
}

CMD=""
while [ $# -gt 0 ]; do
    case "$1" in
        collect|regen) CMD="$1"; shift; break ;;
        --help|-h) usage; exit 0 ;;
        *) echo "roost-docs-shots: unknown argument $1" >&2; usage >&2; exit 1 ;;
    esac
done

ARGS=""
while [ $# -gt 0 ]; do
    case "$1" in
        --dest) DEST="$2"; shift 2 ;;
        *) ARGS="$ARGS $1"; shift ;;
    esac
done

case "$CMD" in
    collect)
        # shellcheck disable=SC2086
        collect $ARGS
        ;;
    regen)
        # shellcheck disable=SC2086
        regen $ARGS
        ;;
    *)
        echo "roost-docs-shots: need collect or regen" >&2
        usage >&2
        exit 1
        ;;
esac
