#!/usr/bin/env python3
"""Report measured LLVM line/region coverage; never infer it from test names."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[1]
SECURITY = (
    'crates/compositor/src/lock.rs',
    'crates/compositor/src/unlock.rs',
    'crates/compositor/src/session_lock.rs',
    'crates/compositor/src/control.rs',
    'crates/shell-control-schema/src/lib.rs',
)


def counts(summary, kind):
    value = summary[kind]
    total, covered = value['count'], value['covered']
    if type(total) is not int or type(covered) is not int or not 0 <= covered <= total:
        raise ValueError(f'invalid {kind} counts')
    return covered, total


def measure(document, root):
    if document.get('type') != 'llvm.coverage.json.export':
        raise ValueError('expected LLVM coverage export')
    files = {}
    for data in document['data']:
        for entry in data['files']:
            path = Path(entry['filename']).resolve()
            try:
                relative = path.relative_to(root.resolve()).as_posix()
            except ValueError:
                continue
            if not relative.startswith('crates/') or '/src/' not in relative:
                continue
            if relative in files:
                raise ValueError(f'duplicate coverage file: {relative}')
            files[relative] = {kind: counts(entry['summary'], kind) for kind in ('lines', 'regions')}
    crates = {}
    for manifest in sorted((root / 'crates').glob('*/Cargo.toml')):
        name = tomllib.loads(manifest.read_text())['package']['name']
        prefix = manifest.parent.relative_to(root).as_posix() + '/src/'
        entries = [value for path, value in files.items() if path.startswith(prefix)]
        if not entries or sum(value['lines'][1] for value in entries) == 0:
            raise ValueError(f'{name}: missing measured source coverage')
        crates[name] = {kind: tuple(sum(value[kind][index] for value in entries) for index in (0, 1))
                        for kind in ('lines', 'regions')}
    for path in SECURITY:
        if path not in files:
            raise ValueError(f'missing security module: {path}')
    return crates, files


def cell(value):
    covered, total = value
    return f'{covered}/{total} ({100 * covered / total:.2f}%)' if total else '0/0 (not instrumented)'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('coverage', type=Path)
    parser.add_argument('--out', type=Path, required=True)
    args = parser.parse_args()
    try:
        crates, files = measure(json.loads(args.coverage.read_text()), ROOT)
    except (ValueError, KeyError, TypeError) as error:
        sys.exit(f'roost-coverage-report: {error}')
    revision = subprocess.check_output(['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], text=True).strip()
    lines = ['# Measured workspace test coverage', '', f'Source revision: `{revision}`', '',
             'LLVM coverage from instrumented workspace tests. Integration-test files and external dependencies are excluded from these source-file aggregates; inline unit-test code remains included where it shares a source file. GUI journeys, hardware paths and doctests are not included. Stable-toolchain line and region coverage does not measure branch coverage.', '',
             '| Crate | Lines | Regions |', '|---|---:|---:|']
    lines += [f'| {name} | {cell(value["lines"])} | {cell(value["regions"])} |' for name, value in crates.items()]
    lines += ['', '## Security modules', '', '| Module | Lines | Regions |', '|---|---:|---:|']
    lines += [f'| `{path}` | {cell(files[path]["lines"])} | {cell(files[path]["regions"])} |' for path in SECURITY]
    lines += ['', 'This first measurement establishes the baseline for reviewed module-specific floors. Missing crate/module data fails the job; percentage thresholds, complete boundary cases and artifact enforcement remain tracked by #8. No security certification is inferred from a coverage percentage.', '']
    args.out.write_text('\n'.join(lines))


if __name__ == '__main__':
    main()
